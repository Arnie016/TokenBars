def archetype_results(traits):
    scored = []
    for archetype in ARCHETYPES:
        raw = 0.0
        for key, weight in archetype["weights"].items():
            raw += traits.get(key, 0) * weight
        raw += stable_score(archetype["name"] + json.dumps(traits, sort_keys=True), -6, 6)
        scored.append({**archetype, "raw": raw})
    min_raw = min(item["raw"] for item in scored)
    exp_scores = [pow(2.718281828, (item["raw"] - min_raw) / 28) for item in scored]
    total = sum(exp_scores) or 1
    for item, exp_score in zip(scored, exp_scores):
        item["probability"] = round((exp_score / total) * 100, 1)
    return sorted(scored, key=lambda item: item["probability"], reverse=True)

def component_results(entries, traits, salt):
    scored = []
    for entry in entries:
        raw = 0.0
        for key, weight in entry["weights"].items():
            raw += traits.get(key, 0) * weight
        raw += stable_score(entry["name"] + salt + json.dumps(traits, sort_keys=True), -4, 4)
        scored.append({**entry, "raw": raw})
    min_raw = min(item["raw"] for item in scored)
    exp_scores = [pow(2.718281828, (item["raw"] - min_raw) / 24) for item in scored]
    total = sum(exp_scores) or 1
    for item, exp_score in zip(scored, exp_scores):
        item["probability"] = round((exp_score / total) * 100, 1)
    return sorted(scored, key=lambda item: item["probability"], reverse=True)

def weighted_component(entries, traits, salt):
    return component_results(entries, traits, salt)[0]

def identity_label(primary, traits):
    modifier_results = component_results(LABEL_MODIFIERS, traits, "modifier")
    stance_results = component_results(LABEL_STANCES, traits, "stance")
    modifier = modifier_results[0]
    stance = stance_results[0]
    base = primary["name"]
    technical_title = f"{modifier['name']} {base} {stance['name']}"
    title = ARCHETYPE_DISPLAY_TITLES.get(base, base)
    return {
        "title": title,
        "technicalTitle": technical_title,
        "baseArchetype": base,
        "modifier": modifier["name"],
        "stance": stance["name"],
        "modifierProbability": modifier["probability"],
        "stanceProbability": stance["probability"],
        "bucketKey": re.sub(r"[^a-z0-9]+", "-", technical_title.lower()).strip("-"),
        "modifierDistribution": [
            {"name": item["name"], "probability": item["probability"]}
            for item in modifier_results
        ],
        "stanceDistribution": [
            {"name": item["name"], "probability": item["probability"]}
            for item in stance_results
        ],
        "catalog": {
            "baseArchetypes": len(ARCHETYPES),
            "modifiers": len(LABEL_MODIFIERS),
            "stances": len(LABEL_STANCES),
            "possibleLabels": len(ARCHETYPES) * len(LABEL_MODIFIERS) * len(LABEL_STANCES),
        },
    }

def label_bucket_distribution(archetypes, label):
    rows = []
    modifiers = label.get("modifierDistribution") or []
    stances = label.get("stanceDistribution") or []
    for archetype in archetypes:
        for modifier in modifiers:
            for stance in stances:
                technical_title = f"{modifier['name']} {archetype['name']} {stance['name']}"
                title = f"{ARCHETYPE_DISPLAY_TITLES.get(archetype['name'], archetype['name'])} · {modifier['name']} / {stance['name']}"
                probability = (
                    float(archetype.get("probability") or 0)
                    * float(modifier.get("probability") or 0)
                    * float(stance.get("probability") or 0)
                    / 10000
                )
                rows.append({
                    "title": title,
                    "technicalTitle": technical_title,
                    "bucketKey": re.sub(r"[^a-z0-9]+", "-", technical_title.lower()).strip("-"),
                    "baseArchetype": archetype["name"],
                    "modifier": modifier["name"],
                    "stance": stance["name"],
                    "npcClass": archetype["npc"],
                    "probability": round(probability, 3),
                })
    return sorted(rows, key=lambda item: item["probability"], reverse=True)

def title_from_context(label):
    return label["title"]

def score(seed, low=54, high=94):
    return low + (abs(hash(seed)) % (high - low + 1))

