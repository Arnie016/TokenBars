folder_report() {
  local context
  if [[ -n "${TOKENBAR_PROFILE_CONTEXT_JSON:-}" ]]; then
    context="$TOKENBAR_PROFILE_CONTEXT_JSON"
  else
    context="$(usage_context_json 2>/dev/null || printf '{}')"
  fi
  TOKENBAR_USAGE_CONTEXT="$context" python3 - <<'PY'
import json
import os

ctx = json.loads(os.environ.get("TOKENBAR_USAGE_CONTEXT") or "{}")
print("Folder usage")
print("------------")
if not ctx.get("ready"):
    print(ctx.get("reason", "usage index unavailable"))
    raise SystemExit(0)

folders = ctx.get("top_folders") or []
if not folders:
    print("No folder-level usage has been indexed yet.")
    raise SystemExit(0)

for item in folders[:8]:
    marker = " live" if item.get("active") else ""
    print(f"{item.get('compact', '0'):>8}  {item.get('sessions', 0):>3} sessions  {item.get('name', item.get('path', 'folder'))}{marker}")

print()
print("Ask: why is this folder high?  Or open the app dashboard for clickable folder cards.")
PY
}

profile_report() {
  local context days open_report focus output_dir pdf_report email_to latest html_path pdf_path
  days="7"
  open_report=false
  pdf_report=false
  email_to=""
  focus=""
  output_dir="$support_dir/profiles"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        cat <<'EOF'
Usage:
  tokenbar profile [--days N] [--focus TEXT] [--pdf] [--open] [--email ADDRESS]
  tokenbar analyze my identity --days 7 --pdf

Builds a private local Builder Identity report from aggregate local TokenBar
evidence. Raw prompts, transcripts, source code, credentials, and env files
stay on this machine.

Short path:
  tokenbar claim       Create the private identity token/report
  tokenbar prove       Create the private report, then publish safe proof only
EOF
        return 0
        ;;
      --days)
        shift
        days="${1:-7}"
        ;;
      --focus)
        shift
        focus="${1:-}"
        ;;
      --open)
        open_report=true
        ;;
      --pdf)
        pdf_report=true
        ;;
      --email)
        shift
        email_to="${1:-}"
        pdf_report=true
        ;;
      --output-dir)
        shift
        output_dir="${1:-$output_dir}"
        ;;
      *)
        if [[ -z "$focus" ]]; then
          focus="$1"
        else
          focus="$focus $1"
        fi
        ;;
    esac
    shift || true
  done

  mkdir -p "$output_dir"
  if [[ -n "${TOKENBAR_PROFILE_CONTEXT_JSON:-}" ]]; then
    context="$TOKENBAR_PROFILE_CONTEXT_JSON"
  else
    context="$(usage_context_json 2>/dev/null || printf '{}')"
  fi
  TOKENBAR_USAGE_CONTEXT="$context" TOKENBAR_PROFILE_DAYS="$days" TOKENBAR_PROFILE_FOCUS="$focus" TOKENBAR_PROFILE_OUTPUT_DIR="$output_dir" TOKENBAR_PROFILE_CWD="$PWD" TOKENBAR_PROFILE_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." 2>/dev/null && pwd || printf '%s' "$PWD")" TOKENBAR_PROFILE_UPLOAD_ENDPOINT="${TOKENBAR_PROFILE_UPLOAD_URL:-$site_url/api/profiles}" python3 - <<'PY'
import hashlib
import html
import json
import math
import os
import re
import subprocess
import time
from pathlib import Path
from urllib.parse import urlparse

ctx = json.loads(os.environ.get("TOKENBAR_USAGE_CONTEXT") or "{}")
days_raw = os.environ.get("TOKENBAR_PROFILE_DAYS") or "7"
try:
    days = max(1, min(30, int(days_raw)))
except Exception:
    days = 7
focus = (os.environ.get("TOKENBAR_PROFILE_FOCUS") or "").strip()
out_dir = Path(os.environ["TOKENBAR_PROFILE_OUTPUT_DIR"]).expanduser()
out_dir.mkdir(parents=True, exist_ok=True)
profile_cwd = Path(os.environ.get("TOKENBAR_PROFILE_CWD") or os.getcwd()).expanduser()
script_root = Path(os.environ.get("TOKENBAR_PROFILE_SCRIPT_DIR") or os.getcwd()).expanduser()

def esc(value):
    return html.escape(str(value), quote=True)

def compact_int(value):
    try:
        value = int(value or 0)
    except Exception:
        value = 0
    for suffix, scale in (("B", 1_000_000_000), ("M", 1_000_000), ("K", 1_000)):
        if abs(value) >= scale:
            return f"{value / scale:.1f}{suffix}".replace(".0", "")
    return str(value)

def safe_int(value):
    try:
        return int(float(value or 0))
    except Exception:
        return 0

def builder_signal_summary():
    signal_path_raw = os.environ.get("TOKENBAR_SIGNAL_STORE")
    signal_path = (
        Path(signal_path_raw).expanduser()
        if signal_path_raw
        else Path.home() / "Library" / "Application Support" / "CodexLimitBar" / "builder-signal-inbox.json"
    )
    empty = {
        "schema": "tokenbar.builder_signal_summary.v1",
        "available": False,
        "signalCount": 0,
        "topHosts": [],
        "topTags": [],
        "privacy": {
            "networkUploaded": False,
            "rawTranscriptsIncluded": False,
            "sourceCodeIncluded": False,
            "urlsIncluded": False,
            "titlesIncluded": False,
            "notesIncluded": False,
        },
        "source": "local builder signal inbox",
        "sourcePath": str(signal_path),
    }
    try:
        payload = json.loads(signal_path.read_text(encoding="utf-8"))
    except Exception:
        return empty

    items = payload.get("items") if isinstance(payload, dict) else []
    if not isinstance(items, list):
        return empty

    host_counts = {}
    tag_counts = {}
    safe_count = 0
    for item in items:
        if not isinstance(item, dict):
            continue
        privacy = item.get("privacy") if isinstance(item.get("privacy"), dict) else {}
        if privacy.get("networkUploaded") is not False:
            continue
        url = str(item.get("url") or "")
        host = urlparse(url).netloc.lower().removeprefix("www.")
        if host:
            host_counts[host] = host_counts.get(host, 0) + 1
        for tag in item.get("tags") or []:
            tag = str(tag).strip().lower()
            if tag:
                tag_counts[tag] = tag_counts.get(tag, 0) + 1
        safe_count += 1

    def ranked(counts, limit=8):
        return [
            {"name": name, "count": count}
            for name, count in sorted(counts.items(), key=lambda pair: (-pair[1], pair[0]))[:limit]
        ]

    summary = dict(empty)
    summary.update(
        {
            "available": safe_count > 0,
            "sourceSchema": payload.get("schema"),
            "signalCount": safe_count,
            "topHosts": ranked(host_counts),
            "topTags": ranked(tag_counts),
            "story": (
                "Local saved links are treated as builder taste signals. TokenBar includes only aggregate hosts and tags; "
                "raw URLs, titles, notes, and page content stay in the local inbox."
            ),
        }
    )
    return summary

def stable_score(seed, low=54, high=94):
    digest = hashlib.sha256(str(seed).encode("utf-8")).hexdigest()
    span = high - low + 1
    return low + (int(digest[:8], 16) % span)

def clamp(value, low=0, high=100):
    return max(low, min(high, int(round(value))))

def keyword_hits(text, terms):
    lower = text.lower()
    return sum(1 for term in terms if term in lower)

def git_shipping_analysis():
    def run_git(args):
        try:
            return subprocess.check_output(
                ["git", "-C", str(profile_cwd), *args],
                text=True,
                stderr=subprocess.DEVNULL,
                timeout=5,
            ).strip()
        except Exception:
            return ""

    root = run_git(["rev-parse", "--show-toplevel"])
    if not root:
        return {
            "available": False,
            "reason": "current directory is not inside a git repository",
            "source": str(profile_cwd),
            "sourceCodeIncluded": False,
            "rawDiffsIncluded": False,
        }

    since = f"{days} days ago"
    log = run_git(["log", f"--since={since}", "--date=short", "--pretty=format:@@%H|%ad|%s", "--shortstat"])
    commits = []
    current = None
    insertions = 0
    deletions = 0
    files_changed = 0
    commits_by_day = {}
    commit_subjects = []

    for line in log.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.startswith("@@"):
            parts = line[2:].split("|", 2)
            current = {"hash": parts[0] if parts else "", "date": parts[1] if len(parts) > 1 else "", "subject": parts[2] if len(parts) > 2 else ""}
            commits.append(current)
            if current["date"]:
                commits_by_day[current["date"]] = commits_by_day.get(current["date"], 0) + 1
            if current["subject"]:
                commit_subjects.append(current["subject"][:120])
            continue
        if " changed" in line or " insertion" in line or " deletion" in line:
            file_match = re.search(r"(\d+) files? changed", line)
            insertion_match = re.search(r"(\d+) insertions?", line)
            deletion_match = re.search(r"(\d+) deletions?", line)
            files_changed += int(file_match.group(1)) if file_match else 0
            insertions += int(insertion_match.group(1)) if insertion_match else 0
            deletions += int(deletion_match.group(1)) if deletion_match else 0

    contributors = run_git(["shortlog", "-sn", f"--since={since}"])
    contributor_count = len([line for line in contributors.splitlines() if line.strip()])
    repo_name = Path(root).name
    peak_day = None
    if commits_by_day:
        peak_day = sorted(commits_by_day.items(), key=lambda item: (-item[1], item[0]))[0]

    return {
        "available": True,
        "source": str(profile_cwd),
        "repo": repo_name,
        "repoRoot": root,
        "windowDays": days,
        "commitCount": len(commits),
        "filesChanged": files_changed,
        "insertions": insertions,
        "deletions": deletions,
        "netLoc": insertions - deletions,
        "contributors": contributor_count,
        "peakCommitDay": {"date": peak_day[0], "commits": peak_day[1]} if peak_day else None,
        "recentCommitSubjects": commit_subjects[:8],
        "sourceCodeIncluded": False,
        "rawDiffsIncluded": False,
        "method": "git log --shortstat metadata only",
    }

def build_trait_vector():
    folders = ctx.get("top_folders") or []
    session = ctx.get("session_analysis") or {}
    provider_analyses = ctx.get("provider_analyses") if isinstance(ctx.get("provider_analyses"), dict) else {}
    parsed_provider_signals = []
    for key, weight in (("claude", 0.16), ("cursor", 0.10), ("antigravity", 0.08)):
        item = provider_analyses.get(key) if isinstance(provider_analyses.get(key), dict) else {}
        if item.get("available"):
            parsed_provider_signals.append((item, weight))
    names = " ".join(str(item.get("name", "")) for item in folders[:8]).lower()
    today = int(ctx.get("today_tokens") or 0)
    daily_avg_7 = max(1, int(ctx.get("daily_avg_7_tokens") or 0))
    volatility = int(ctx.get("volatility_percent") or 0)
    active_days = int(ctx.get("active_days_last30") or 0)
    sessions = int(ctx.get("sessions_indexed") or 0)
    projected = int(ctx.get("projected_next7_tokens") or 0)
    last30 = max(1, int(ctx.get("last30_tokens") or 0))
    focus_text = focus.lower()
    all_text = f"{names} {focus_text}"
    density = min(100, sessions * 2.2 + active_days * 2.8)
    surge = min(100, (today / daily_avg_7) * 38 if daily_avg_7 else 0)
    consistency = min(100, active_days * 3.7)
    projection_pressure = min(100, (projected / last30) * 64 if last30 else 0)
    product = 38 + keyword_hits(all_text, ["stripe", "payment", "checkout", "billing", "pricing", "landing", "growth", "user", "customer", "trial", "launch"]) * 9
    artifact = 36 + keyword_hits(all_text, ["pdf", "report", "deck", "doc", "course", "video", "landing", "profile", "identity", "skill"]) * 8
    infrastructure = 34 + keyword_hits(all_text, ["token", "codex", "agent", "cursor", "claude", "antigravity", "opencode", "api", "webhook", "convex", "vercel", "stripe", "cli", "database"]) * 7
    research = 30 + keyword_hits(all_text, ["paper", "research", "analysis", "benchmark", "model", "eval", "heuristic", "proof", "math", "erdos"]) * 9
    design = 28 + keyword_hits(all_text, ["design", "ui", "frontend", "visual", "brand", "pdf", "deck", "landing", "animation", "figma"]) * 8
    monetization = 26 + keyword_hits(all_text, ["stripe", "checkout", "payment", "billing", "price", "trial", "subscription", "pro", "tax"]) * 10
    orchestration = 30 + keyword_hits(all_text, ["agent", "multi", "workflow", "automation", "connector", "webhook", "pipeline", "session", "identity"]) * 8
    local_first = 34 + keyword_hits(all_text, ["local", "privacy", "private", "offline", "machine", "transcript", "source code", "share", "upload"]) * 9
    def blended_signal(key):
        codex_value = float(session.get(key) or 0)
        provider_weight = sum(weight for _, weight in parsed_provider_signals)
        if provider_weight:
            codex_weight = max(0.66, 1 - provider_weight)
            weighted = codex_value * codex_weight
            for provider, weight in parsed_provider_signals:
                weighted += float(provider.get(key) or 0) * weight
            return weighted * 100
        return codex_value * 100

    planning_signal = blended_signal("planningSignal")
    redirection_signal = blended_signal("redirectionSignal")
    urgency_signal = blended_signal("urgencySignal")
    visual_signal = blended_signal("visualSignal")
    monetization_signal = blended_signal("monetizationSignal")
    privacy_signal = blended_signal("privacySignal")
    identity_signal = blended_signal("identitySignal")
    command_ratio = blended_signal("commandPromptRatio")
    short_ratio = blended_signal("shortPromptRatio")
    prompt_count = min(
        100,
        float(session.get("promptCount") or 0) * 1.0
        + sum(float(provider.get("promptCount") or provider.get("artifactCount") or 0) * weight for provider, weight in parsed_provider_signals),
    )
    return {
        "steering": clamp(46 + density * 0.18 + infrastructure * 0.14 + product * 0.10 + redirection_signal * 0.18 + command_ratio * 0.12),
        "execution": clamp(44 + surge * 0.22 + density * 0.15 + artifact * 0.13 + urgency_signal * 0.20 + short_ratio * 0.08),
        "engineering": clamp(42 + infrastructure * 0.32 + consistency * 0.16 + research * 0.10),
        "product_instinct": clamp(40 + product * 0.30 + monetization * 0.15 + design * 0.08 + monetization_signal * 0.14 + identity_signal * 0.08),
        "planning": clamp(42 + consistency * 0.20 + research * 0.12 + max(0, 100 - volatility) * 0.10 + planning_signal * 0.18),
        "taste": clamp(36 + design * 0.27 + artifact * 0.13 + visual_signal * 0.20),
        "research_depth": clamp(34 + research * 0.32 + infrastructure * 0.08 + prompt_count * 0.10),
        "monetization": clamp(30 + monetization * 0.34 + product * 0.12 + monetization_signal * 0.26),
        "orchestration": clamp(36 + orchestration * 0.30 + density * 0.10 + prompt_count * 0.08),
        "local_first": clamp(local_first + privacy_signal * 0.24),
        "infrastructure": clamp(infrastructure),
        "artifact": clamp(artifact),
        "density": clamp(density),
        "design": clamp(design),
        "product": clamp(product),
        "surge": clamp(surge),
        "consistency": clamp(consistency),
        "volatility": clamp(volatility),
        "projection_pressure": clamp(projection_pressure),
        "session_planning": clamp(planning_signal),
        "session_redirection": clamp(redirection_signal),
        "session_urgency": clamp(urgency_signal),
        "session_visual": clamp(visual_signal),
        "session_monetization": clamp(monetization_signal),
        "session_identity": clamp(identity_signal),
    }

