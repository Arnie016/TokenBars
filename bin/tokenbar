def polygon_points(records, cx=150, cy=150, radius=106):
    points = []
    total = len(records) or 1
    for idx, (_, value, _) in enumerate(records):
        angle = -math.pi / 2 + (math.pi * 2 * idx / total)
        r = radius * (value / 100)
        points.append(f"{cx + math.cos(angle) * r:.1f},{cy + math.sin(angle) * r:.1f}")
    return " ".join(points)

def axis_lines(records, cx=150, cy=150, radius=116):
    lines = []
    total = len(records) or 1
    for idx, (name, value, _) in enumerate(records):
        angle = -math.pi / 2 + (math.pi * 2 * idx / total)
        x = cx + math.cos(angle) * radius
        y = cy + math.sin(angle) * radius
        lx = cx + math.cos(angle) * (radius + 28)
        ly = cy + math.sin(angle) * (radius + 28)
        lines.append(f"<line x1='{cx}' y1='{cy}' x2='{x:.1f}' y2='{y:.1f}' />")
        lines.append(f"<text x='{lx:.1f}' y='{ly:.1f}' text-anchor='middle'>{esc(name[:5])}</text>")
    return "\n".join(lines)

def target_dots(records, cx=150, cy=150, radius=112):
    dots = []
    total = len(records) or 1
    for idx, (name, value, _) in enumerate(records):
        angle = -math.pi / 2 + (math.pi * 2 * idx / total)
        r = radius * (value / 100)
        x = cx + math.cos(angle) * r
        y = cy + math.sin(angle) * r
        dots.append(f"<circle cx='{x:.1f}' cy='{y:.1f}' r='7'><title>{esc(name)} {value}</title></circle>")
    return "\n".join(dots)

