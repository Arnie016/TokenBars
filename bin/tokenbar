import textwrap as _textwrap


def _para(text, indent=""):
    for _line in _textwrap.wrap(text, width=76, initial_indent=indent, subsequent_indent=indent):
        print(_line)


_NUMBER_WORDS = {
    2: "Two", 3: "Three", 4: "Four", 5: "Five", 6: "Six",
    7: "Seven", 8: "Eight", 9: "Nine", 10: "Ten", 11: "Eleven",
}


def _ordinal(value):
    if value % 100 in (11, 12, 13):
        return f"{value}th"
    return f"{value}{ {1: 'st', 2: 'nd', 3: 'rd'}.get(value % 10, 'th') }"


def _span_phrase(days):
    if days < 3:
        return "Your first days of logged work"
    if days < 14:
        return f"{days} days of logged work"
    if days < 45:
        return "About a month of logged work"
    _months = int(round(days / 30.0))
    return f"{_NUMBER_WORDS.get(_months, _months)} months of logged work"


def _run_history():
    """Read past reports so the summary can say what actually moved.

    These identity files run to megabytes each and there can be hundreds, so
    this reads the newest few for the last comparable run and the oldest few
    for the first scored one, never the whole directory.
    """
    try:
        _files = [p for p in out_dir.glob("*.identity.json") if p != identity_json_path]
    except OSError:
        return None
    if not _files:
        return None
    _files.sort(key=lambda p: p.stat().st_mtime)

    def _scored(paths):
        _out = []
        for _p in paths:
            try:
                _j = json.loads(_p.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                continue
            if isinstance(_j.get("loopMaturity"), int) and isinstance(_j.get("proofScore"), int):
                _out.append(_j)
        return _out

    # Early reports predate the current scoring schema, so the oldest files are
    # often unscored. Probe an evenly spaced sample across the whole timeline and
    # take the earliest one that actually carries scores.
    _step = max(1, len(_files) // 20)
    _sampled = _scored(_files[::_step][:20])
    return {
        "runs": len(_files),
        "first": _sampled[0] if _sampled else None,
        "span_days": max(0, int((time.time() - _files[0].stat().st_mtime) // 86400)),
    }


# Every dimension gets plain-language phrasing: what it is called in everyday
# words, what a low score feels like, what a high score looks like, and the one
# move that raises it. Written by hand so the wording is stable across runs.
LOOP_PLAIN = {
    "loopDesign": (
        "finishing what you start",
        "you open new work faster than you close the last piece",
        "you carry work to a verdict before moving on",
        "pick the thing you left half-open and take it all the way to a yes or no before starting anything new",
    ),
    "roleClarity": (
        "who does what",
        "your sessions carry a shared pile of jobs instead of one owner each",
        "each session and agent has one job and one thing it hands back",
        "give your next session one job and one thing it has to hand back",
    ),
    "contractStrength": (
        "saying what done means",
        "you start before the finish line is written down",
        "you name the finish line before you start",
        "write the one sentence that says what done looks like before you start the next task",
    ),
    "stateDiscipline": (
        "where your work ends up",
        "most of what you figure out stays in scrollback",
        "what you learn lands somewhere you can find it again",
        "write your next outcome somewhere you would still find it in a month, not in the chat",
    ),
    "restartQuality": (
        "picking a tangled session back up",
        "long runs drift and the original goal gets lost",
        "you can drop a messy run and resume without losing the goal",
        "end your next long session with five lines: goal, done, verified, stuck, next command",
    ),
    "tasteRubric": (
        "judging your own work",
        "you ship plenty, and less of it gets judged on whether it actually reads well",
        "you cut and sharpen your own output before anyone else sees it",
        "take one thing you already shipped and cut it until it is clearly better, not bigger",
    ),
    "traceLiteracy": (
        "reading the evidence",
        "you call things done before checking what the output actually says",
        "you read the log, diff, or output before believing a result",
        "read the log, diff, or output before you call the next thing done",
    ),
    "harnessHygiene": (
        "clearing out what you stopped using",
        "old scripts and half-built scaffolds are piling up behind you",
        "you retire tooling once it stops earning its keep",
        "delete one script or scaffold you have not touched in a month",
    ),
    "bottleneckSense": (
        "knowing what is actually in the way",
        "you start fresh work instead of naming what the last win exposed",
        "you find the next real constraint instead of guessing",
        "after your next win, write down the constraint it exposed instead of jumping to new work",
    ),
}


def _band(score, bands):
    for _floor, _text in bands:
        if score >= _floor:
            return _text
    return bands[-1][1]


_ranked = sorted(loop_scale, key=lambda item: item["score"])
_weak = [item for item in _ranked[:2] if item["key"] in LOOP_PLAIN]
_best = _ranked[-1] if _ranked else None

