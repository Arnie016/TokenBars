def usage_wave_svg():
    if not recent:
        values = [12, 18, 10, 24, 20, 28, 22]
        labels = ["d-6", "d-5", "d-4", "d-3", "d-2", "d-1", "today"]
    else:
        values = [int(item.get("tokens") or 0) for item in recent]
        labels = [str(item.get("date", ""))[-5:] or f"d{idx}" for idx, item in enumerate(recent)]
    max_value = max(values or [1]) or 1
    width = 760
    height = 240
    step = width / max(1, len(values) - 1)
    coords = []
    for idx, value in enumerate(values):
        x = idx * step
        y = height - 34 - ((value / max_value) * 150)
        coords.append((x, y, value, labels[idx]))
    line = " ".join(f"{x:.1f},{y:.1f}" for x, y, _, _ in coords)
    area = f"0,{height-26} " + line + f" {width},{height-26}"
    circles = "\n".join(
        f"<g><circle cx='{x:.1f}' cy='{y:.1f}' r='7'/><text x='{x:.1f}' y='{height-7}' text-anchor='middle'>{esc(label)}</text></g>"
        for x, y, _, label in coords
    )
    return f"""
<svg class="usage-wave-svg" viewBox="0 0 {width} {height}" role="img" aria-label="Undulating usage rhythm">
  <defs>
    <linearGradient id="waveFill" x1="0%" x2="100%">
      <stop offset="0%" stop-color="{theme['accent']}" stop-opacity=".18"/>
      <stop offset="100%" stop-color="{theme['warm']}" stop-opacity=".26"/>
    </linearGradient>
  </defs>
  <path d="M {area} Z"/>
  <polyline points="{line}"/>
  {circles}
</svg>
"""

