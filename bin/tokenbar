except Exception:
    print("  7d estimate:  unavailable")
print(f"  latest title: {profile_title}")
print(f"  proof/loop:   {proof_score} / {loop_score}")
print(f"  token cue:    {token}")
print()
print("30-second micro-storyboard")
for shot in shots:
    print(f"  {shot['timing']:<6} {shot['title']}")
    print(f"         {shot['direction']}")
print()
print("Voice timing")
for beat in voice_timing_plan:
    print(f"  {beat['window']:<7} {beat['voiceLine']}")
print()
print("Director Bay bridge")
print(f"  source thread: {director_bay_bridge['sourceThread']}")
print(f"  local path:    {director_bay_bridge['localPathHint']}")
print(f"  detected:      {str(director_bay_bridge['localPathDetected']).lower()}")
print("  contract:      0-3 / 3-8 / 8-16 / 16-23 / 23-30")
print()
print("Capture checklist")
for index, item in enumerate(capture_checklist, start=1):
    print(f"  {index}. {item}")
print()
print("Renderer integration note")
print("  Use `tokenbar trailer --json > tokenbar-identity-trailer.json` as the handoff for HyperFrames, Director Bay, Remotion, or another renderer.")
print("  Render locally first; publish only final video frames that exclude raw private data.")
PY
}

