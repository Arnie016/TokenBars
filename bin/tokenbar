# Raw totals mean nothing on their own, so anchor them against each other.
_bits = []
_sessions = int(ctx.get("sessions_indexed") or 0)
_active = int(ctx.get("active_days_last30") or 0)
_volume = str(ctx.get("last30_compact") or "").strip()
_folders = [f for f in (ctx.get("top_folders") or []) if isinstance(f, dict)]
if _sessions and _active:
    _bits.append(f"{_sessions} sessions across {_active} of the last 30 days")
elif _sessions:
    _bits.append(f"{_sessions} sessions")
elif _active:
    _bits.append(f"{_active} of the last 30 days worked")
if _volume:
    _bits.append(f"{_volume} tokens")
if _folders:
    # ctx carries only the top folders, so never claim a total folder count.
    # Share of the month is the honest anchor, and it reads better than raw counts.
    _top = int(_folders[0].get("tokens") or 0)
    _month = int(ctx.get("last30_tokens") or 0)
    _name = _folders[0].get("name") or "one folder"
    _share = int(round(100 * _top / _month)) if _month and _top <= _month else 0
    if _share >= 50:
        _bits.append(f"and more than half of that went into one folder, {_name}")
    elif _share >= 30:
        _bits.append(f"and about a third of it went into one folder, {_name}")
    elif _share >= 20:
        _bits.append(f"and about a fifth of it went into {_name}")
    elif _share >= 5:
        _bits.append(f"and the biggest single slice, {_share}%, went into {_name}")
    else:
        _bits.append(f"spread thin, with {_name} your busiest folder")
if _bits:
    print()
    _lead = _span_phrase(_history["span_days"]) if _history else "So far"
    _para(f"{_lead}: " + ", ".join(_bits) + ".")

print()
_para("The way you run work scores {} out of 100, which means {}. Your proof trail scores {}: {}.".format(
    loop_maturity_score,
    _band(loop_maturity_score, [
        (90, "they are tight and only edge cases are left"),
        (75, "you are running a real system and the gaps are specific now"),
        (60, "you are past improvising but not yet running a tight system"),
        (40, "habits are forming but they do not hold across sessions yet"),
        (0, "most of your work is still improvised session to session"),
    ]),
    leaderboard_score,
    _band(leaderboard_score, [
        (80, "nearly all of your work leaves something another person could check"),
        (60, "a good share of your work leaves something another person could check"),
        (40, "about half your work leaves something another person could check"),
        (0, "little of your work leaves anything another person could check"),
    ]),
))

# Someone on their hundredth report has earned a comparison, not the same
# paragraph as a stranger. Report what moved and refuse to explain why:
# a flat score can mean steady habits or a blunt measure, and the file
# cannot tell which.
if _history is None or _history["runs"] < 1:
    print()
    _para(
        "This is your first report, so there is nothing to compare it against yet. "
        "Change one habit and run it again - the next one will tell you what moved."
    )
else:
    print()
    _prior = _history.get("first")
    _opening = f"This is your {_ordinal(_history['runs'] + 1)} report"
    if _prior:
        _was = int(_prior["loopMaturity"])
        _delta = loop_maturity_score - _was
        _stamp = str(_prior.get("generatedAt") or "")[:10]
        try:
            _since = time.strftime("%B %-d", time.strptime(_stamp, "%Y-%m-%d"))
        except ValueError:
            _since = ""
        if _stamp == time.strftime("%Y-%m-%d"):
            _when = "earlier today"
        elif _since:
            _when = f"back on {_since}"
        else:
            _when = "on your earliest scored run"
        _since_phrase = f"since {_since}" if _since else "since your earliest scored run"
        _points = "point" if abs(_delta) == 1 else "points"
        if _history["runs"] >= 10 and abs(_delta) <= 2:
            _para(
                f"{_opening}, and that first number has barely moved {_since_phrase}: "
                f"{_was} then, {loop_maturity_score} now. Either your habits are genuinely steady, "
                "or the score is too blunt to see what you changed."
            )
        elif _delta == 0:
            _para(f"{_opening}, and that score has not moved since {_when}: still {loop_maturity_score}.")
        elif _delta > 0:
            _para(f"{_opening}, and that score is up {_delta} {_points} from {_was} {_when}.")
        else:
            _para(f"{_opening}, and that score is down {abs(_delta)} {_points} from {_was} {_when}.")
    else:
        _para(f"{_opening}, but the earlier ones predate this scoring model, so there is no baseline to compare against yet.")

    # Name the dimension that actually moved, if any did.
    if _prior:
        _then = {
            _i["key"]: _i["score"] for _i in (_prior.get("loopScale") or [])
            if isinstance(_i, dict) and isinstance(_i.get("score"), int)
        }
        _moves = [
            (item["score"] - _then[item["key"]], item["key"])
            for item in loop_scale if item["key"] in _then and item["key"] in LOOP_PLAIN
        ]
        if _moves:
            _mv, _mk = max(_moves, key=lambda pair: abs(pair[0]))
            # When the overall score is flat the sentence above already said so,
            # so only speak up when one habit genuinely broke away from the rest.
            if abs(_mv) >= 4:
                _para(
                    f"The one habit that did shift is {LOOP_PLAIN[_mk][0]}, "
                    f"{'up' if _mv > 0 else 'down'} {abs(_mv)} points."
                )

if _best and _best["key"] in LOOP_PLAIN:
    _label, _low, _high, _lift = LOOP_PLAIN[_best["key"]]
    print()
    _para(f"You are strongest at {_label}: {_high} ({_best['score']} out of 100).")

if _weak:
    print()
    _para(f"{'Two things are' if len(_weak) > 1 else 'One thing is'} holding you back.")
    for _item in _weak:
        _label, _low, _high, _lift = LOOP_PLAIN[_item["key"]]
        print()
        _para(f"{_label[:1].upper()}{_label[1:]}, {_item['score']} out of 100. {_low[:1].upper()}{_low[1:]}.", indent="  ")
    print()
    _para("If you change one thing this week: " + LOOP_PLAIN[_weak[0]["key"]][3] + ".")

print()
print(f"Share token for this report: {profile_token}")
print(f"Report: {path}")
print(f"Identity JSON: {identity_json_path}")
print(f"Skill.md: {skill_md_path}")
print(f"Share manifest: {manifest_path}")
print("PDF: run with --pdf to export a PDF, or --email you@example.com to email it through AgentMail.")
print("Private claim created. Nothing public was uploaded.")
print("To activate a safe public profile later, run: tokenbar publish-proof")
print("That uploads the generated identity JSON only, then returns a proof card, profile link, feed entry, and rankings evidence.")
