def copy_report_image_assets():
    asset_specs = [
        ("cover", "premium-cover-atlas.png", "tokenbar-premium-cover-atlas.png"),
        ("evidence", "premium-evidence-cards.png", "tokenbar-premium-evidence-cards.png"),
        ("plate", "premium-identity-plate.png", "tokenbar-premium-identity-plate.png"),
        ("personality_blueprint", "personality-blueprint-captain.png", "tokenbar-personality-blueprint-captain.png"),
        ("personality_cartographer", "personality-launch-cartographer.png", "tokenbar-personality-launch-cartographer.png"),
        ("personality_ronin", "personality-prompt-ronin.png", "tokenbar-personality-prompt-ronin.png"),
        ("personality_signal", "personality-signal-alchemist.png", "tokenbar-personality-signal-alchemist.png"),
    ]
    roots = [
        script_root / "docs" / "assets" / "report",
        profile_cwd / "docs" / "assets" / "report",
        profile_cwd.parent / "TokenBar" / "docs" / "assets" / "report",
    ]
    copied = {}
    for key, source_name, target_name in asset_specs:
        for root in roots:
            candidate = root / source_name
            try:
                if candidate.exists() and candidate.is_file():
                    target = out_dir / target_name
                    if not target.exists() or target.stat().st_size != candidate.stat().st_size:
                        target.write_bytes(candidate.read_bytes())
                    copied[key] = target
                    break
            except Exception:
                continue
    return copied

report_assets = copy_report_image_assets()

def selected_personality_asset_key():
    text = f"{title} {primary_archetype.get('name', '')} {label.get('baseArchetype', '')} {label.get('modifier', '')} {label.get('stance', '')}".lower()
    if any(word in text for word in ["cartographer", "route", "launch"]):
        return "personality_cartographer"
    if any(word in text for word in ["ronin", "operator", "velocity", "prompt", "chaos"]):
        return "personality_ronin"
    if any(word in text for word in ["alchemist", "research", "signal", "philosopher", "synthesizer"]):
        return "personality_signal"
    if any(word in text for word in ["architect", "captain", "systems", "scaffold", "commander"]):
        return "personality_blueprint"
    return "cover"

personality_asset_key = selected_personality_asset_key()

