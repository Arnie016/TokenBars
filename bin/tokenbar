reminders_command() {
  local json_mode=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        cat <<'EOF'
Usage:
  tokenbar reminders
  tokenbar reminders json

Build an aggregate-only reminder plan from local TokenBar evidence. This command
does not schedule notifications, write settings, close apps, change accounts,
upload reports, or contact providers. It only explains which reminders would be
useful before the next coding-agent run.
EOF
        return 0
        ;;
      --json|json)
        json_mode=true
        ;;
      *)
        printf 'Unknown tokenbar reminders option: %s\n' "$1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  local context_json
  context_json="$(usage_context_json 2>/dev/null || printf '{}')"

  TOKENBAR_REMINDERS_JSON="$json_mode" \
  TOKENBAR_USAGE_CONTEXT="$context_json" \
  python3 - <<'PY'
import json
import os
import sys
from datetime import datetime, timezone

json_mode = os.environ.get("TOKENBAR_REMINDERS_JSON") == "true"

try:
    ctx = json.loads(os.environ.get("TOKENBAR_USAGE_CONTEXT") or "{}")
except Exception:
    ctx = {}

def compact(value):
    try:
        value = float(value or 0)
    except Exception:
        value = 0
    value = max(0, value)
    if value >= 1_000_000_000:
        return f"{value / 1_000_000_000:.2f}B".replace(".00B", "B")
    if value >= 1_000_000:
        return f"{value / 1_000_000:.1f}".replace(".0", "") + "M"
    if value >= 1_000:
        return f"{value / 1_000:.1f}".replace(".0", "") + "K"
    return str(int(value))

def money(value):
    if value is None:
        return None
    try:
        value = float(value)
    except Exception:
        return None
    if value >= 100:
        return f"${value:,.0f}"
    return f"${value:,.2f}"

def pct(numer, denom):
    try:
        denom = float(denom or 0)
        if denom <= 0:
            return None
        return max(0, round(float(numer or 0) / denom * 100))
    except Exception:
        return None

def pct_label(value):
    if value is None:
        return "unknown%"
    return ">999%" if value > 999 else f"{value}%"

def reminder(kind, title, trigger, reason, action, severity="info"):
    return {
        "kind": kind,
        "title": title,
        "trigger": trigger,
        "reason": reason,
        "action": action,
        "severity": severity,
        "delivery": "suggested-only",
        "requiresApproval": True,
    }

ready = bool(ctx.get("ready"))
today = int(ctx.get("today_tokens") or 0)
last7 = int(ctx.get("last7_tokens") or 0)
last30 = int(ctx.get("last30_tokens") or 0)
projected7 = int(ctx.get("projected_next7_tokens") or 0)
projected30 = int(ctx.get("projected_next30_tokens") or 0)
uncertainty = int(ctx.get("uncertainty_percent") or 0)
daily_limit = ctx.get("daily_guardrail_tokens")
weekly_limit = ctx.get("weekly_guardrail_tokens")
thirty_limit = ctx.get("thirty_day_guardrail_tokens")
daily_limit_tokens = int(ctx.get("daily_guardrail_tokens_parsed") or 0) if ctx.get("daily_guardrail_tokens_parsed") else None

def parse_limit(raw):
    if not raw:
        return None
    text = str(raw).strip().lower().replace(",", "")
    mult = 1
    if text.endswith("b"):
        mult = 1_000_000_000
        text = text[:-1]
    elif text.endswith("m"):
        mult = 1_000_000
        text = text[:-1]
    elif text.endswith("k"):
        mult = 1_000
        text = text[:-1]
    try:
        return int(float(text) * mult)
    except Exception:
        return None

daily_limit_tokens = parse_limit(daily_limit)
weekly_limit_tokens = parse_limit(weekly_limit)
thirty_limit_tokens = parse_limit(thirty_limit)
daily_cost_limit = ctx.get("daily_cost_limit_usd")
weekly_cost_limit = ctx.get("weekly_cost_limit_usd")
today_cost = ctx.get("today_cost")
projected_weekly_cost = ctx.get("projected_weekly_cost")
price = ctx.get("price_per_million")
tracking = ctx.get("tracking_enabled")
activity = ctx.get("activity_signals_enabled")

reminders = []

if not ready:
    reminders.append(reminder(
        "setup",
        "Connect the local usage index",
        "Before opening the menu bar",
        ctx.get("reason") or "TokenBar does not have enough local aggregate usage to build live reminders.",
        "Run `tokenbar usage` after a Codex session, then reopen TokenBar.",
        "warning",
    ))

if tracking is False:
    reminders.append(reminder(
        "setup",
        "Tracking is paused",
        "Before the next agent run",
        "New local sessions will not appear in budget, cost, or cadence reminders while tracking is paused.",
        "Run `tokenbar tracking on` only if you want local aggregate tracking to resume.",
        "warning",
    ))

if daily_limit_tokens:
    daily_pressure = pct(today, daily_limit_tokens)
    if daily_pressure is not None and daily_pressure >= 80:
        reminders.append(reminder(
            "budget",
            "Daily token cap is close",
            f"{pct_label(daily_pressure)} of daily token guardrail",
            f"Today has used {compact(today)} against a {compact(daily_limit_tokens)} daily guardrail.",
            "Start the next prompt with a smaller scope and a named verifier.",
            "danger" if daily_pressure >= 100 else "warning",
        ))

if weekly_limit_tokens:
    weekly_pressure = pct(projected7, weekly_limit_tokens)
    if weekly_pressure is not None and weekly_pressure >= 70:
        reminders.append(reminder(
            "forecast",
            "Projected week is heavy",
            f"{pct_label(weekly_pressure)} of weekly token guardrail",
            f"The next 7 days project to {compact(projected7)} against a {compact(weekly_limit_tokens)} weekly guardrail.",
            "Use `tokenbar playbooks copy cost-saver` before launching a broad run.",
            "warning",
        ))

if thirty_limit_tokens:
    month_pressure = pct(projected30, thirty_limit_tokens)
    if month_pressure is not None and month_pressure >= 75:
        reminders.append(reminder(
            "forecast",
            "Monthly runway needs attention",
            f"{pct_label(month_pressure)} of 30-day token guardrail",
            f"The next 30 days project to {compact(projected30)} against a {compact(thirty_limit_tokens)} guardrail.",
            "Switch the menu-bar token scope to month/year before starting the next long task.",
            "warning",
        ))

if price is None:
    reminders.append(reminder(
        "setup",
        "Cost estimate is missing",
        "Before relying on cost views",
        "TokenBar can show token pressure, but dollar reminders need a dollars-per-million assumption.",
        "Run `tokenbar --price 2.50 cost-passport` or set TOKENBAR_PRICE_PER_MILLION.",
        "info",
    ))

if daily_cost_limit and today_cost is not None:
    daily_cost_pressure = pct(today_cost, daily_cost_limit)
    if daily_cost_pressure is not None and daily_cost_pressure >= 80:
        reminders.append(reminder(
            "cost",
            "Daily spend limit is close",
            f"{pct_label(daily_cost_pressure)} of daily cost limit",
            f"Estimated today cost is {money(today_cost)} against a {money(daily_cost_limit)} daily limit.",
            "Open `tokenbar cost-passport` before continuing.",
            "danger" if daily_cost_pressure >= 100 else "warning",
        ))

if weekly_cost_limit and projected_weekly_cost is not None:
    weekly_cost_pressure = pct(projected_weekly_cost, weekly_cost_limit)
    if weekly_cost_pressure is not None and weekly_cost_pressure >= 75:
        reminders.append(reminder(
            "cost",
            "Weekly spend forecast is high",
            f"{pct_label(weekly_cost_pressure)} of weekly cost limit",
            f"Projected weekly cost is {money(projected_weekly_cost)} against a {money(weekly_cost_limit)} limit.",
            "Use the Cost Saver playbook and reduce open-ended generation.",
            "warning",
        ))

if uncertainty >= 55:
    reminders.append(reminder(
        "forecast",
        "Forecast confidence is low",
        f"+/-{uncertainty}% uncertainty",
        "Recent usage is volatile enough that long-run cost and token forecasts may swing.",
        "Run one short verifier-first task before committing to a long autonomous loop.",
        "info",
    ))

if activity is False:
    reminders.append(reminder(
        "cadence",
        "Activity cadence is off",
        "When forecasts feel stale",
        "Optional activity signals can make quiet-day and active-day reminders more useful.",
        "Run with `--activity` for this session, or leave it off for stricter history-only forecasts.",
        "info",
    ))

if not reminders:
    reminders.append(reminder(
        "ready",
        "No urgent reminder",
        "Before the next run",
        "Token, cost, and forecast pressure are below the configured reminder thresholds.",
        "Use `tokenbar playbooks copy mission-lock` to keep the next task bounded.",
        "success",
    ))

top_reminder = reminders[0]
pressure_candidates = []

if daily_limit_tokens:
    pressure_candidates.append(pct(today, daily_limit_tokens) or 0)
if weekly_limit_tokens:
    pressure_candidates.append(pct(projected7, weekly_limit_tokens) or 0)
if thirty_limit_tokens:
    pressure_candidates.append(pct(projected30, thirty_limit_tokens) or 0)

budget_pressure = max(pressure_candidates or [0])
risk_level = "calm"
if budget_pressure >= 100:
    risk_level = "over"
elif budget_pressure >= 80:
    risk_level = "high"
elif budget_pressure >= 55:
    risk_level = "watch"

recommended_limit = "Set a daily or weekly guardrail"
if weekly_limit_tokens:
    recommended_limit = f"Keep the next 7 days under {compact(weekly_limit_tokens)}"
elif daily_limit_tokens:
    recommended_limit = f"Keep today under {compact(daily_limit_tokens)}"

runway_brief = {
    "title": "Budget brief before the next run",
    "state": risk_level,
    "window": "next agent run",
    "trigger": top_reminder.get("trigger"),
    "reason": top_reminder.get("reason"),
    "recommendedLimit": recommended_limit,
    "reminderDraft": (
        "Start with budget, route, timebox, context cap, verifier, and stop. "
        "Ask before scheduling, publishing, spending, credentials, or cleanup."
    ),
    "setupPrompt": "Budget: Focus | Route: one bounded implementation | Timebox: one verifier | Context cap: touched files only | Stop: approval-gated external actions.",
    "commands": {
        "copyPrompt": "tokenbar playbooks copy budget-runway",
        "setLimits": "tokenbar limits",
        "reviewCost": "tokenbar cost-passport --from YYYY-MM-DD --to YYYY-MM-DD json",
        "openReminders": "tokenbar reminders json",
    },
    "approvalRequired": True,
    "delivery": "suggested-only",
    "scheduledNotifications": False,
}

payload = {
    "schema": "tokenbar.reminders.v1",
    "generatedAt": datetime.now(timezone.utc).replace(microsecond=0).isoformat(),
    "source": "local-usage-index",
    "summary": {
        "today": ctx.get("today_compact") or compact(today),
        "last7": ctx.get("last7_compact") or compact(last7),
        "last30": ctx.get("last30_compact") or compact(last30),
        "projectedNext7": ctx.get("projected_next7_compact") or compact(projected7),
        "uncertainty": f"+/-{uncertainty}%",
        "basis": ctx.get("prediction_basis") or "history only",
    },
    "topReminder": top_reminder,
    "runwayBrief": runway_brief,
    "reminders": reminders[:8],
    "privacy": {
        "rawPromptsIncluded": False,
        "rawTranscriptsIncluded": False,
        "sourceCodeIncluded": False,
        "localPathsIncluded": False,
        "credentialsIncluded": False,
        "networkActions": False,
        "scheduledNotifications": False,
    },
    "disclaimer": "This is a suggested reminder plan. TokenBar does not schedule notifications or mutate accounts from this command.",
}

if json_mode:
    print(json.dumps(payload, indent=2, sort_keys=True))
    raise SystemExit(0)

use_color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")

def paint(code, text):
    return f"\033[{code}m{text}\033[0m" if use_color else str(text)

print(paint("1", "TokenBar Reminders"))
summary = payload["summary"]
print(f"{summary['today']} today · {summary['projectedNext7']} next 7d · {summary['uncertainty']} · {summary['basis']}")
print()
for item in payload["reminders"]:
    label = item["severity"].upper()
    print(f"{label:<7} {item['title']}")
    print(f"        Trigger: {item['trigger']}")
    print(f"        Why: {item['reason']}")
    print(f"        Next: {item['action']}")
print()
brief = payload["runwayBrief"]
print("Budget brief")
print(f"  State: {brief['state']} · {brief['recommendedLimit']}")
print(f"  Prompt: {brief['setupPrompt']}")
print(f"  Copy: {brief['commands']['copyPrompt']}")
print()
print("No notifications were scheduled. No accounts, providers, or files were changed.")
PY
}

memory_pressure_command() {
  local format
  format="${1:-}"
  TOKENBAR_MEMORY_PRESSURE_FORMAT="$format" python3 - <<'PY'
import json
import os
import subprocess
from collections import defaultdict
from pathlib import Path


fmt = (os.environ.get("TOKENBAR_MEMORY_PRESSURE_FORMAT") or "").strip().lower()


def run(args):
    try:
        return subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=5, check=False).stdout
    except Exception:
        return ""


def total_memory_mb():
    raw = run(["sysctl", "-n", "hw.memsize"]).strip()
    try:
        return round(int(raw) / 1024 / 1024)
    except Exception:
        return None


def process_rows():
    output = run(["ps", "-axo", "pid=,rss=,comm="])
    rows = []
    for line in output.splitlines():
        parts = line.strip().split(None, 2)
        if len(parts) != 3:
            continue
        pid_raw, rss_raw, command = parts
        try:
            rss_mb = int(rss_raw) / 1024
            pid = int(pid_raw)
        except Exception:
            continue
        name = Path(command).name or command
        if rss_mb < 20:
            continue
        rows.append({"pid": pid, "name": name[:72], "rssMb": round(rss_mb, 1)})
    return rows


def category_for(name):
    lower = name.lower()
    if any(marker in lower for marker in ["chrome", "chromium", "arc", "safari", "brave", "firefox"]):
        return "browser"
    if any(marker in lower for marker in ["codex", "chatgpt", "claude", "cursor", "antigravity", "opencode", "code helper", "electron"]):
        return "agent_workspace"
    if any(marker in lower for marker in ["node", "python", "ruby", "java", "uvicorn", "vite", "next-server"]):
        return "local_runtime"
    if any(marker in lower for marker in ["blender", "unreal", "xcode", "simulator", "figma"]):
        return "creative_runtime"
    return "other"


rows = process_rows()
category_totals = defaultdict(float)
category_counts = defaultdict(int)
top_by_name = {}
for row in rows:
    category = category_for(row["name"])
    category_totals[category] += row["rssMb"]
    category_counts[category] += 1
    current = top_by_name.get(row["name"], {"name": row["name"], "rssMb": 0, "count": 0})
    current["rssMb"] += row["rssMb"]
    current["count"] += 1
    top_by_name[row["name"]] = current

total_rss = sum(row["rssMb"] for row in rows)
memory_total = total_memory_mb()
observed_percent = round((total_rss / memory_total) * 100) if memory_total else None
browser_agent_mb = category_totals["browser"] + category_totals["agent_workspace"]

if observed_percent is None:
    pressure = "unknown"
elif observed_percent >= 72 or browser_agent_mb >= 8192:
    pressure = "high"
elif observed_percent >= 48 or browser_agent_mb >= 4096:
    pressure = "watch"
else:
    pressure = "clear"

categories = [
    {
        "name": name,
        "rssMb": round(value, 1),
        "processes": category_counts[name],
        "sharePercent": round((value / total_rss) * 100) if total_rss else 0,
    }
    for name, value in sorted(category_totals.items(), key=lambda item: item[1], reverse=True)
]

top_apps = [
    {"name": row["name"], "rssMb": round(row["rssMb"], 1), "processes": row["count"]}
    for row in sorted(top_by_name.values(), key=lambda item: item["rssMb"], reverse=True)[:6]
]

actions = []
if browser_agent_mb >= 4096:
    actions.append({
        "title": "Review browser plus agent pressure",
        "why": "Browser and AI-agent workspaces are the largest combined lane.",
        "approvalRequired": True,
        "safeNext": "Open TokenBar, review windows, then approve any close/reopen/restore plan manually.",
    })
if category_totals["local_runtime"] >= 2048:
    actions.append({
        "title": "Check local dev servers",
        "why": "Local runtimes are using enough memory to matter.",
        "approvalRequired": True,
        "safeNext": "List the relevant servers first; do not stop a process without naming it and getting approval.",
    })
if not actions:
    actions.append({
        "title": "No cleanup suggested",
        "why": "Observed app memory is below TokenBar's review threshold.",
        "approvalRequired": True,
        "safeNext": "Keep tracking. If the Mac feels slow, rerun this command before opening more heavy tools.",
    })

payload = {
    "schema": "tokenbar.memory_pressure.v1",
    "source": "local-ps-aggregate",
    "summary": {
        "pressure": pressure,
        "observedAppMemoryMb": round(total_rss, 1),
        "systemMemoryMb": memory_total,
        "observedPercent": observed_percent,
        "browserAgentMemoryMb": round(browser_agent_mb, 1),
        "basis": "process names and RSS only; no browser tabs, prompts, source files, command arguments, or credentials",
    },
    "categories": categories,
    "topApps": top_apps,
    "actions": actions[:4],
    "privacy": {
        "rawPromptsIncluded": False,
        "rawTranscriptsIncluded": False,
        "sourceCodeIncluded": False,
        "localPathsIncluded": False,
        "commandArgumentsIncluded": False,
        "credentialsIncluded": False,
        "browserTabsIncluded": False,
        "processKill": False,
        "browserRestore": False,
        "externalActions": False,
    },
    "disclaimer": "This is a read-only memory pressure explanation. TokenBar does not close apps, restore windows, contact providers, or change accounts from this command.",
}

if fmt in {"json", "--json"}:
    print(json.dumps(payload, indent=2, sort_keys=True))
    raise SystemExit(0)

print("TokenBar Memory Pressure")
summary = payload["summary"]
observed = f"{summary['observedPercent']}%" if summary["observedPercent"] is not None else "unknown"
print(f"{summary['pressure'].upper()} · {summary['observedAppMemoryMb']:.0f} MB observed app RSS · {observed} of system memory")
print("Basis:", summary["basis"])
print()
print("Lanes")
for item in payload["categories"][:5]:
    print(f"  {item['name']:<17} {item['rssMb']:>8.0f} MB  {item['processes']} processes  {item['sharePercent']}%")
print()
print("Top apps")
for item in payload["topApps"]:
    print(f"  {item['name']:<32} {item['rssMb']:>8.0f} MB  {item['processes']} processes")
print()
print("Suggested next actions")
for item in payload["actions"]:
    print(f"  - {item['title']}")
    print(f"    Why: {item['why']}")
    print(f"    Approval: required")
    print(f"    Next: {item['safeNext']}")
print()
print("No apps were closed. No browser windows were restored. No external actions were taken.")
PY
}

