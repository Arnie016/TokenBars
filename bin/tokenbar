def render_storyboard_html(data):
    metrics = data.get("metrics", {})
    shot_cards = []
    for shot in data.get("shots", []):
        elements = "".join(f"<span>{escape(str(item))}</span>" for item in shot.get("visualElements", []))
        shot_cards.append(
            f"""
            <article class="shot-card" style="--start:{float(shot.get('start', 0))}; --end:{float(shot.get('end', 0))}">
              <div class="shot-time">{escape(str(shot.get('timing', '')))}</div>
              <h2>{escape(str(shot.get('title', '')))}</h2>
              <strong>{escape(str(shot.get('onScreenText', '')))}</strong>
              <p>{escape(str(shot.get('direction', '')))}</p>
              <div class="tags">{elements}</div>
              <small>{escape(str(shot.get('intelligenceRole', '')))}</small>
            </article>
            """
        )
    voice_rows = "".join(
        f"<li><b>{escape(str(item.get('window', '')))}</b><span>{escape(str(item.get('voiceLine', '')))}</span></li>"
        for item in data.get("voiceTimingPlan", [])
    )
    privacy_rows = "".join(f"<li>{escape(str(item))}</li>" for item in data.get("privacy", {}).get("neverShow", []))
    manifest_json = escape(json.dumps(data, indent=2, sort_keys=True))
    created = datetime.now().strftime("%Y-%m-%d %H:%M")
    return f"""<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>TokenBar Builder Identity Trailer</title>
  <style>
    :root {{
      color-scheme: dark;
      --ink:#f7fbff;
      --muted:#9aa7b8;
      --panel:#101722;
      --paper:#f8faf7;
      --blue:#2f80ff;
      --green:#63d94f;
      --amber:#ffbd2f;
      --orange:#ff7a1f;
    }}
    * {{ box-sizing:border-box; }}
    body {{
      margin:0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color:var(--ink);
      background:
        radial-gradient(circle at 20% 10%, rgba(47,128,255,.18), transparent 30%),
        radial-gradient(circle at 80% 0%, rgba(99,217,79,.12), transparent 26%),
        linear-gradient(135deg, #05070b 0%, #0a111d 50%, #f8faf7 50%, #eef4ef 100%);
      min-height:100vh;
    }}
    body::before {{
      content:"";
      position:fixed;
      inset:0;
      pointer-events:none;
      opacity:.18;
      background-image: radial-gradient(circle, rgba(255,255,255,.8) 1px, transparent 1px);
      background-size: 22px 22px;
      mix-blend-mode: soft-light;
    }}
    main {{ width:min(1180px, calc(100vw - 40px)); margin:0 auto; padding:42px 0 64px; position:relative; }}
    .hero {{ min-height:42vh; display:grid; grid-template-columns: 1.05fr .95fr; gap:28px; align-items:center; }}
    .eyebrow {{ color:var(--green); text-transform:uppercase; letter-spacing:.14em; font-size:12px; font-weight:800; }}
    h1 {{ font-size:clamp(48px, 8vw, 108px); line-height:.9; letter-spacing:0; margin:12px 0; max-width:820px; }}
    .hero p {{ color:var(--muted); font-size:20px; line-height:1.45; max-width:680px; }}
    .passport {{
      background:var(--paper);
      color:#0b1220;
      border:1px solid rgba(7,15,29,.12);
      border-radius:24px;
      padding:28px;
      box-shadow:0 34px 90px rgba(0,0,0,.34);
      transform:rotate(-1deg);
    }}
    .passport h2 {{ margin:0 0 10px; font-size:34px; line-height:1; }}
    .metric-strip {{ display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:22px; }}
    .metric-strip div {{ border:1px solid rgba(11,18,32,.13); border-radius:16px; padding:14px; background:white; }}
