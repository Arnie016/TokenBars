def build_visual_systems():
    systems = []
    image_alignments = [
        "right-anchored hero plate with a thin evidence caption",
        "centered dossier plate with generous white-space and a stamped corner",
        "left-edge field-note image bleeding into the section grid",
        "floating card stack with one dominant character plate and two tiny proof scraps",
        "wide cinematic strip above the score geometry",
    ]
    chart_grammars = [
        "spatial field map plus six scouting cards",
        "atlas route line with checkpoint dots and proof stamps",
        "target geometry with clustered decision points",
        "ledger bands with evidence-weighted callouts",
        "constellation plot with signal paths and risk labels",
    ]
    pacing_notes = [
        "open with identity, then evidence, then score, then odd human facts",
        "lead with the artifact, then explain the behavior that produced it",
        "alternate big research-paper headings with compact proof cards",
        "use one memorable number per spread and keep the rest as supporting evidence",
        "make the growth edge feel like a next mission, not a performance review",
    ]
    art_mediums = [
        "editorial watercolor, graphite margins, and a restrained premium report palette",
        "cinematic product still with shallow depth, soft paper grain, and no toy-like plastic",
        "museum specimen card with stamped provenance marks, measured labels, and quiet texture",
        "investment-bank research plate with a single custom illustration embedded into data geometry",
        "storybook dossier illustration with mature lighting, physical paper, and precise annotations",
    ]
    surprise_moments = [
        "a tiny receipt, note, or token ledger revealing the strangest measured habit",
        "a field stamp where one memorable prompt becomes a visible artifact",
        "a magnified desk clue that turns an odd statistic into a human story",
        "a side-panel micro-scene showing a pressure moment without exposing private work",
        "a premium marginalia strip with one funny but respectful behavior signal",
    ]
    asset_layers = [
        "cover hero, personality plate, surprise vignette, data object, proof seal, social crop",
        "profile portrait, evidence still-life, score geometry, career-fit plate, correction footer",
        "dossier cover, character specimen, strange-fact insert, leaderboard badge, LinkedIn crop",
        "research title page, builder creature card, proof packet mock, method diagram, share token",
        "public profile art, private-analysis diagram, artifact wall, growth mission card, report footer",
    ]
    for idx, (name, family, accent, accent2, warm, paper, soft, shape, persona, best_for) in enumerate(PROFILE_VISUAL_SYSTEM_TUPLES, start=1):
        art_medium = art_mediums[(idx - 1) % len(art_mediums)]
        surprise_moment = surprise_moments[(idx - 1) % len(surprise_moments)]
        asset_layer = asset_layers[(idx - 1) % len(asset_layers)]
        asset_prompt = (
            "TokenBar premium builder identity report art. "
            f"Profile creature: {persona} Motif: {shape}. "
            f"Visual system: {name}. Medium: {art_medium}. "
            f"Color language: {accent} primary, {accent2} secondary, {warm} rare accent, {paper} paper, {soft} quiet field. "
            "Composition: serious editorial dossier, custom character, integrated score geometry, physical paper depth, tasteful negative space. "
            "Avoid childish mascot render, stock UI collage, code screenshots, fake logos, clutter, neon gradients, and generic SaaS blobs."
        )
        systems.append({
            "id": f"tbv-{idx:02d}",
            "name": name,
            "family": family,
            "accent": accent,
            "accent2": accent2,
            "warm": warm,
            "paper": paper,
            "soft": soft,
            "shape": shape,
            "persona": persona,
            "bestFor": best_for,
            "imageAlignment": image_alignments[(idx - 1) % len(image_alignments)],
            "chartGrammar": chart_grammars[(idx - 1) % len(chart_grammars)],
            "reportPacing": pacing_notes[(idx - 1) % len(pacing_notes)],
            "pdfColorBehavior": f"Use {paper} as the paper tint, {soft} for quiet section wells, {accent} for identity claims, {accent2} for supporting evidence, and {warm} only for rare/surprise moments.",
            "assetDirection": asset_prompt,
            "assetMoment": surprise_moment,
            "assetLayer": asset_layer,
            "assetNegativePrompt": "no childish toy render, no source code, no private transcripts, no credential text, no random UI screenshots, no generic SVG mascot, no busy gradient blob background",
            "generationPrompts": {
                "coverHero": f"{asset_prompt} Create the opening cover image as a premium title-page visual with the {shape} motif and one visible identity seal.",
                "personalityPlate": f"{asset_prompt} Create a full-body character specimen plate for {name}, with field labels, score marks, and mature report-paper texture.",
                "surpriseVignette": f"{asset_prompt} Create a small visual vignette for this surprise moment: {surprise_moment}. Make it witty, premium, and readable in a PDF margin.",
                "scoreRelic": f"{asset_prompt} Create a score relic: a physical object that turns Power, Accuracy, Control, Vision, Range, and Composure into one premium artifact.",
                "careerPlate": f"{asset_prompt} Create a career-fit plate showing where this builder creature belongs professionally without using corporate stock imagery.",
                "leaderboardBadge": f"{asset_prompt} Create a leaderboard badge that feels earned by craft, strategy, useful output, and diversity of work, not raw token spend.",
                "proofPacketSpread": f"{asset_prompt} Create a polished proof packet spread with PDF, Skill.md, identity JSON, public link, and verification seal arranged like a serious portfolio artifact.",
                "installRitual": f"{asset_prompt} Create a tasteful installation ritual scene: terminal command, macOS menu bar, and local privacy boundary as physical objects on a desk.",
                "correctionFooter": f"{asset_prompt} Create a professional report footer image for feedback, dispute, correction, and contact workflow with no legalistic clutter.",
                "profileBanner": f"{asset_prompt} Create a hosted public profile banner with the creature, one rarity cue, and a clean area for a builder bio and links.",
                "socialCrop": f"{asset_prompt} Create a 16:9 social preview card with the creature, one score badge, and a clean area for the builder title.",
            },
        })
    return systems

PROFILE_VISUAL_SYSTEMS = build_visual_systems()

def select_visual_system():
    text = " ".join([
        title,
        subtitle,
        primary_archetype.get("name", ""),
        primary_archetype.get("npc", ""),
        label.get("baseArchetype", ""),
        label.get("modifier", ""),
        label.get("stance", ""),
        theme.get("name", ""),
    ]).lower()
    family_biases = {
        "architect": traits["planning"] + traits["engineering"],
        "cartographer": traits["product_instinct"] + traits["orchestration"],
        "operator": traits["steering"] + traits["surge"],
        "refiner": traits["engineering"] + traits["consistency"],
        "alchemist": traits["research_depth"] + traits["taste"],
        "closer": traits["execution"] + traits["surge"],
        "privacy": traits["local_first"] + traits["engineering"],
        "proof": traits["artifact"] + traits["taste"],
        "taste": traits["taste"] + traits["product_instinct"],
        "research": traits["research_depth"] + traits["planning"],
        "systems": traits["engineering"] + traits["orchestration"],
        "monetization": traits["monetization"] + traits["product_instinct"],
        "economist": traits["projection_pressure"] + traits["planning"],
        "orchestrator": traits["orchestration"] + traits["steering"],
    }
    best = None
    for system in PROFILE_VISUAL_SYSTEMS:
        score = family_biases.get(system["family"], 100)
        keywords = (system["name"] + " " + system["bestFor"] + " " + system["family"]).lower().replace("-", " ").split()
        score += sum(24 for word in keywords if len(word) > 3 and word in text)
        score += stable_score(f"{title}:{system['id']}", 0, 12)
        if best is None or score > best[0]:
            best = (score, system)
    return dict(best[1] if best else PROFILE_VISUAL_SYSTEMS[0])

visual_system = select_visual_system()
theme = {**theme, **{k: visual_system[k] for k in ("accent", "accent2", "warm", "paper", "soft")}}
theme["visualSystem"] = visual_system["name"]
theme["visualPersona"] = visual_system["persona"]
theme["visualShape"] = visual_system["shape"]

visual_protocol = {
    "imageAlignment": visual_system["imageAlignment"],
    "chartGrammar": visual_system["chartGrammar"],
    "reportPacing": visual_system["reportPacing"],
    "pdfColorBehavior": visual_system["pdfColorBehavior"],
    "spreadIdentity": f"{visual_system['name']} report spine",
    "assetBrief": visual_system["assetDirection"],
}
visual_protocol_cards = "\n".join(
    f"<div class='protocol-card'><span>{esc(name)}</span><p>{esc(value)}</p></div>"
    for name, value in [
        ("Image alignment", visual_protocol["imageAlignment"]),
        ("Chart grammar", visual_protocol["chartGrammar"]),
        ("Report pacing", visual_protocol["reportPacing"]),
        ("Asset brief", visual_protocol["assetBrief"]),
    ]
)

reader_name = (
    os.environ.get("TOKENBAR_REPORT_NAME")
    or os.environ.get("TOKENBAR_USER_NAME")
    or os.environ.get("TOKENBAR_PROFILE_NAME")
    or "Private Builder"
).strip()

def best_dimension_names(limit=4):
    return [name for name, _, _ in sorted(dimensions, key=lambda item: item[1], reverse=True)[:limit]]

def career_fit_from_traits():
    fits = []
    if traits["product_instinct"] >= 74 and traits["orchestration"] >= 68:
        fits.append(("Founder / product engineering lead", "Turns uncertain product surfaces into runnable systems, launch paths, and proof artifacts."))
    if traits["engineering"] >= 72 and traits["planning"] >= 70:
        fits.append(("Platform or infrastructure engineer", "Sees the operating layer: logs, APIs, connectors, local state, reliability, and handoffs."))
    if traits["taste"] >= 72 and traits["artifact"] >= 70:
        fits.append(("Design engineering / developer experience", "Cares about what the work feels like, not just whether it technically exists."))
    if traits["research_depth"] >= 72:
        fits.append(("Applied AI researcher / analyst", "Builds from evidence, comparisons, synthesis, and unusually specific decision records."))
    if traits["monetization"] >= 68:
        fits.append(("Growth systems / commercial engineering", "Connects product intent to pricing, trust, checkout, access, and support mechanics."))
    if not fits:
        fits.append(("AI product operator", "Coordinates agents, artifacts, and local proof into a repeatable work style."))
    return fits[:4]

career_fit_rows = "\n".join(
    f"<li><strong>{esc(name)}</strong><br><small>{esc(reason)}</small></li>"
    for name, reason in career_fit_from_traits()
)

def curious_fact_records():
    prompt_count = int(session_analysis.get("promptCount") or 0)
    command_pct = int(float(session_analysis.get("commandPromptRatio") or 0) * 100)
    short_pct = int(float(session_analysis.get("shortPromptRatio") or 0) * 100)
    question_count = int(session_analysis.get("questionPromptCount") or 0)
    gratitude = int(session_analysis.get("gratitudeCount") or 0)
    please_count = int(session_analysis.get("pleaseCount") or 0)
    typo_count = int(session_analysis.get("typoMarkerCount") or 0)
    caps_count = int(session_analysis.get("capsPromptCount") or 0)
    tiny_count = int(session_analysis.get("tinyPromptCount") or 0)
    longest = int(session_analysis.get("longestPromptWords") or 0)
    active_days = int(ctx.get("active_days_last30") or 0)
    sessions = int(ctx.get("sessions_indexed") or 0)
    sorted_dims = sorted(dimensions, key=lambda item: item[1], reverse=True)
    top_dim = sorted_dims[0] if sorted_dims else ("Profile", specificity_score, "Identity signal.")
    low_dim = sorted_dims[-1] if sorted_dims else ("Unknown", 0, "No local signal.")
    facts = [
        {
            "label": "Identity field",
            "value": str(label["catalog"]["possibleLabels"]),
            "copy": f"This profile was selected from {label['catalog']['possibleLabels']} possible local identity buckets, not a single fixed template.",
        },
        {
            "label": "Highest trait",
            "value": str(top_dim[1]),
            "copy": f"{top_dim[0]} is the strongest score in the dossier. In human terms: {top_dim[2]}",
        },
        {
            "label": "Growth lever",
            "value": str(low_dim[1]),
            "copy": f"{low_dim[0]} is the softest measured area. That does not mean weak; it means this is where the next report can visibly improve.",
        },
    ]
    if prompt_count:
        facts.append({
            "label": "Command gravity",
            "value": f"{command_pct}%",
            "copy": f"{command_pct}% of sampled prompts read like direct operator commands. The report treats that as steering force, not politeness.",
        })
        facts.append({
            "label": "Short-form control",
            "value": f"{tiny_count}",
            "copy": f"{tiny_count} prompts were five words or fewer. That is the profile equivalent of a one-touch pass: tiny input, expected movement.",
        })
        facts.append({
            "label": "Question engine",
            "value": f"{question_count}",
            "copy": f"{question_count} prompts were shaped as questions, which signals when you use the agent as a thinking surface rather than a task runner.",
        })
        if gratitude or please_count:
            facts.append({
                "label": "Courtesy residue",
                "value": f"{gratitude + please_count}",
                "copy": f"TokenBar counted {gratitude} thanks markers and {please_count} please markers. The social layer is part of the operating style.",
            })
        if typo_count:
            facts.append({
                "label": "Velocity typos",
                "value": f"{typo_count}",
                "copy": f"{typo_count} shorthand or typo markers appeared in the sample. That usually means the human is steering faster than they are editing.",
            })
        if caps_count:
            facts.append({
                "label": "Emergency flares",
                "value": f"{caps_count}",
                "copy": f"{caps_count} prompts looked like all-caps bursts. These are useful evidence of correction pressure and agent-control stakes.",
            })
        facts.append({
            "label": "Longest steering packet",
            "value": f"{longest}w",
            "copy": f"The longest sampled prompt was {longest} words. Long packets usually carry context, constraints, or quality bar-setting.",
        })
    facts.append({
        "label": "Active surface",
        "value": f"{active_days}/30",
        "copy": f"TokenBar saw activity on {active_days} of the last 30 tracked days across {sessions} indexed sessions.",
    })
    facts.append({
        "label": "Visual language",
        "value": theme["name"],
        "copy": f"The report uses the {theme['name']} visual system because this profile's strongest signals point toward {theme['motif']}.",
    })
    if shipping_analysis.get("available"):
        facts.append({
            "label": "Shipping pulse",
            "value": str(shipping_analysis.get("commitCount", 0)),
            "copy": f"Git metadata shows {shipping_analysis.get('commitCount', 0)} commits and {shipping_analysis.get('netLoc', 0):+} net LOC in the report window.",
        })
    return facts[:8]

curious_facts = curious_fact_records()
curious_fact_cards = "\n".join(
    f"<div class='fact-card'><span>{esc(item['label'])}</span><strong>{esc(item['value'])}</strong><p>{esc(item['copy'])}</p></div>"
    for item in curious_facts
)

def surprise_artifact_records():
    roles = [
        ("Signature tell", "Odd little proof that the profile is not generic.", "spark"),
        ("Workroom clue", "A behavior marker someone can recognize in the wild.", "compass"),
        ("Social residue", "The human trace left inside agent work.", "seal"),
        ("Pressure mark", "Where the operating style bends under speed or stakes.", "flare"),
    ]
    artifacts = []
    for idx, item in enumerate(curious_facts[:4]):
        label, caption, mark = roles[idx % len(roles)]
        artifacts.append({
            "label": label,
            "caption": caption,
            "mark": mark,
            "name": item["label"],
            "value": item["value"],
            "copy": item["copy"],
        })
    return artifacts

surprise_artifacts = surprise_artifact_records()
surprise_moment_cards = "\n".join(
    f"<div class='surprise-card surprise-{esc(item['mark'])}'>"
    f"<i>{esc(item['mark'])}</i><span>{esc(item['label'])}</span>"
    f"<strong>{esc(item['name'])}</strong><em>{esc(item['value'])}</em>"
    f"<p>{esc(item['copy'])}</p><small>{esc(item['caption'])}</small></div>"
    for item in surprise_artifacts
)

