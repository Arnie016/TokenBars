def public_text(name, default="", limit=160):
    return str(os.environ.get(name) or default or "").replace("\x00", "").strip()[:limit]

def public_url(name):
    value = str(os.environ.get(name) or "").strip()
    if not value:
        return ""
    if not value.startswith(("https://", "http://")):
        value = "https://" + value
    parsed = urlparse(value)
    if parsed.scheme not in {"https", "http"} or not parsed.netloc:
        return ""
    return value[:240]

