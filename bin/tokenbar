axis_positions = {
    "Power": ("Forward pressure", 474, 92, "How hard the profile attacks an ambiguous task."),
    "Accuracy": ("Clean finish", 386, 146, "How reliably the work lands with checks and structure."),
    "Control": ("Midfield control", 300, 180, "How tightly the builder keeps the agent inside the lane."),
    "Vision": ("Playmaker vision", 204, 146, "How clearly the work becomes a product story."),
    "Range": ("Wide range", 126, 92, "How many tools, surfaces, and handoffs the builder coordinates."),
    "Composure": ("Goalkeeper calm", 300, 260, "How stable the profile stays under pressure."),
}

def score_axis_story_records():
    rank_map = {name: idx + 1 for idx, (name, _, _) in enumerate(sorted(power_axes, key=lambda item: item[1], reverse=True))}
    coaching_questions = {
        "Power": "What proof did the session leave behind after the burst?",
        "Accuracy": "Where did the checks, constraints, or structured handoff make the work safer?",
        "Control": "How often did the human narrow the lane before the agent wandered?",
        "Vision": "Did the work become a product story someone else can understand?",
        "Range": "How many tools, repos, interfaces, and handoffs stayed coherent?",
        "Composure": "Did pressure create sharper closure or just more motion?",
    }
    records = []
    for name, score_value, copy in sorted(power_axes, key=lambda item: item[1], reverse=True):
        position, _, _, field_copy = axis_positions.get(name, (name, 0, 0, copy))
        if score_value >= 82:
            read = f"{name} is a signature strength: it behaves like a repeatable advantage, not a lucky run."
        elif score_value >= 68:
            read = f"{name} is useful and visible, but it should be watched across more reports before calling it dominant."
        elif score_value >= 55:
            read = f"{name} is present but uneven; it needs clearer evidence in future sessions."
        else:
            read = f"{name} is still emerging; the report treats it as a growth surface, not a flaw."
        records.append({
            "axis": name,
            "rank": rank_map.get(name, 0),
            "score": score_value,
            "tier": score_tier_for_report(score_value),
            "fieldRole": position,
            "interpretation": copy,
            "readerRead": read,
            "coachingQuestion": coaching_questions.get(name, "What would make this signal easier to prove next time?"),
            "fieldRead": field_copy,
        })
    return records

score_story_records = score_axis_story_records()

def score_storyline_svg():
    width = 880
    height = 620
    ordered = sorted(score_story_records, key=lambda item: item["rank"])
    points = []
    nodes = []
    field_labels = []
    for idx, item in enumerate(ordered):
        x = 82 + idx * ((width - 164) / max(1, len(ordered) - 1))
        y = 394 - (item["score"] * 2.05) + (math.sin(idx * 1.4) * 18)
        y = max(138, min(386, y))
        points.append(f"{x:.1f},{y:.1f}")
        nodes.append(
            f"<g><circle cx='{x:.1f}' cy='{y:.1f}' r='18' />"
