def personality_specimen_svg():
    records = [
        ("signal", top_dimension[1], theme["accent"]),
        ("range", second_dimension[1], theme["accent2"]),
        ("edge", weak_dimension[1], theme["warm"]),
        ("rarity", specificity_score, "#0b1220"),
    ]
    nodes = []
    rails = []
    for idx, (name, value, color) in enumerate(records):
        x = 94 + idx * 136
        y = 215 - (min(100, max(0, int(value))) * 1.08)
        rails.append(f"{x:.1f},{y:.1f}")
        nodes.append(
            f"<g><circle cx='{x:.1f}' cy='{y:.1f}' r='18' fill='{color}' />"
            f"<text x='{x:.1f}' y='{y - 28:.1f}' text-anchor='middle'>{esc(name)}</text>"
            f"<text x='{x:.1f}' y='{y + 5:.1f}' text-anchor='middle'>{int(value)}</text></g>"
        )
    return f"""
<svg class="personality-specimen-svg" viewBox="0 0 560 270" role="img" aria-label="TokenBar personality specimen mark">
  <defs>
    <pattern id="specimenGrain" width="14" height="14" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.2" fill="{theme['accent']}" opacity=".18" />
      <circle cx="10" cy="8" r="1.4" fill="{theme['warm']}" opacity=".14" />
    </pattern>
    <linearGradient id="specimenTrail" x1="0%" x2="100%">
      <stop offset="0%" stop-color="{theme['accent']}" />
      <stop offset="52%" stop-color="{theme['accent2']}" />
      <stop offset="100%" stop-color="{theme['warm']}" />
    </linearGradient>
  </defs>
  <rect class="specimen-bg" x="22" y="18" width="516" height="230" rx="30" />
  <rect class="specimen-grain" x="22" y="18" width="516" height="230" rx="30" />
  <path class="specimen-grid" d="M62 76H498M62 132H498M62 188H498M144 44V226M280 44V226M416 44V226" />
  <path class="specimen-trail" d="M{' L'.join(rails)}" />
  <path class="specimen-sigil" d="M78 206 C148 138 202 144 260 92 C320 38 408 72 484 46" />
  {''.join(nodes)}
  <text class="specimen-title" x="58" y="48">{esc(visual_system['name'])}</text>
  <text class="specimen-caption" x="58" y="230">{esc(visual_system['shape'])} / {esc(visual_system['family'])}</text>
</svg>
"""

personality_specimen = personality_specimen_svg()
