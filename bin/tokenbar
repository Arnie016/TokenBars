power_axes = [
    ("Power", clamp(traits["execution"] * 0.45 + traits["surge"] * 0.25 + traits["artifact"] * 0.30), "How hard a session turns into visible output."),
    ("Accuracy", clamp(traits["engineering"] * 0.38 + traits["planning"] * 0.30 + traits["consistency"] * 0.18 + traits["research_depth"] * 0.14), "How often the work lands with structure, checks, and context."),
    ("Control", clamp(traits["steering"] * 0.50 + traits["session_redirection"] * 0.20 + traits["local_first"] * 0.15 + traits["planning"] * 0.15), "How tightly the human keeps the agent inside the useful lane."),
    ("Vision", clamp(traits["product_instinct"] * 0.34 + traits["taste"] * 0.28 + traits["research_depth"] * 0.22 + traits["session_identity"] * 0.16), "How clearly the sessions point toward product, identity, and story."),
    ("Range", clamp(traits["orchestration"] * 0.34 + traits["infrastructure"] * 0.26 + traits["product"] * 0.20 + traits["design"] * 0.20), "How many surfaces, tools, and handoffs the builder can coordinate."),
    ("Composure", clamp(traits["consistency"] * 0.30 + max(0, 100 - traits["volatility"]) * 0.24 + traits["planning"] * 0.24 + traits["local_first"] * 0.22), "How stable the operating pattern looks under pressure."),
]

overall_builder_rating = clamp(sum(score for _, score, _ in power_axes) / max(1, len(power_axes)))
top_power_axis = max(power_axes, key=lambda item: item[1])
low_power_axis = min(power_axes, key=lambda item: item[1])

def scouting_position():
    axis_map = {name: score for name, score, _ in power_axes}
    if axis_map["Vision"] >= 84 and axis_map["Range"] >= 78:
        return ("Creative Systems Playmaker", "Turns scattered tools into a visible product story.")
    if axis_map["Control"] >= 84 and axis_map["Accuracy"] >= 78:
        return ("Technical Field General", "Keeps agents disciplined, scoped, and pointed at proof.")
    if axis_map["Power"] >= 84 and axis_map["Range"] >= 74:
        return ("Launch Forward", "Converts ambiguous work into visible output and momentum.")
    if axis_map["Composure"] >= 82 and axis_map["Accuracy"] >= 76:
        return ("Reliability Keeper", "Stabilizes messy runs and protects the final claim.")
    return ("Adaptive Builder", "Moves between steering, proof, and product judgement depending on the run.")

builder_position, builder_position_copy = scouting_position()
scout_grade = (
    "World-class signal" if overall_builder_rating >= 90 else
    "Premier signal" if overall_builder_rating >= 82 else
    "High-potential signal" if overall_builder_rating >= 72 else
    "Emerging signal"
)

def score_tier_for_report(score):
    if score >= 90:
        return "Elite"
    if score >= 80:
        return "High"
    if score >= 68:
        return "Useful"
    if score >= 55:
        return "Developing"
    return "Emerging"

