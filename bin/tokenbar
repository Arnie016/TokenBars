  fi
}

hosted_doctor() {
  local endpoint
  endpoint="${TOKENBAR_PROFILE_HEALTH_URL:-${TOKENBAR_PROFILE_UPLOAD_URL:-$site_url/api/profiles}}"

  TOKENBAR_PROFILE_HEALTH_ENDPOINT="$endpoint" python3 - <<'PY'
import json
import os
import urllib.error
import urllib.parse
import urllib.request

endpoint = os.environ["TOKENBAR_PROFILE_HEALTH_ENDPOINT"]
separator = "&" if "?" in endpoint else "?"
health_url = f"{endpoint}{separator}health=1"
request = urllib.request.Request(health_url, headers={"Accept": "application/json", "User-Agent": "TokenBar CLI"})

try:
    with urllib.request.urlopen(request, timeout=20) as response:
        payload = json.loads(response.read().decode("utf-8"))
except urllib.error.HTTPError as exc:
    body = exc.read().decode("utf-8", "replace")
    raise SystemExit(f"Hosted doctor failed: HTTP {exc.code} {body}") from exc
except Exception as exc:
    raise SystemExit(f"Hosted doctor failed: {exc}") from exc

health = payload.get("health") or {}
print("TokenBar hosted profile doctor")
print(f"Endpoint: {health_url}")
print(f"Storage: {health.get('storage', 'unknown')}")
print(f"Durable: {health.get('durable', False)}")
print(f"Reachable: {health.get('reachable', False)}")
print(f"Status: {health.get('status', 'unknown')}")
print()
print("Configuration")
print(f"  SUPABASE_URL: {'set' if health.get('supabaseUrlConfigured') else 'missing'}")
print(f"  SUPABASE_SERVICE_ROLE_KEY: {'set' if health.get('supabaseServiceRoleKeyConfigured') else 'missing'}")
print(f"  TOKENBAR_PUBLIC_BASE_URL: {'set' if health.get('publicBaseUrlConfigured') else 'optional/missing'}")
print()
print(f"Upload boundary: {health.get('uploadBoundary', 'identity JSON only')}")
if not health.get("durable"):
    print()
    print("Next durable step:")
    print("  1. Run docs/tokenbar_profiles_supabase.sql in Supabase.")
    print("  2. Set SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY in Vercel.")
    print("  3. Redeploy, then run tokenbar hosted-doctor again.")
elif not health.get("reachable"):
    print()
    print(f"Storage error: {health.get('error', 'unknown')}")
PY
}

render_profile_pdf() {
  local html_path="$1"
  local pdf_path="$2"
  local renderer="${TOKENBAR_PDF_RENDERER:-playwright}"
  local chrome_path="${TOKENBAR_CHROME_PATH:-}"
  local chrome_profile chrome_pid chrome_status timeout_seconds elapsed timed_out

  if [[ "$renderer" != "chrome" ]]; then
    render_profile_pdf_playwright "$html_path" "$pdf_path" && return 0
    echo "Playwright PDF export failed; trying Chrome/Chromium fallback." >&2
  fi

  if [[ -z "$chrome_path" ]]; then
    if [[ -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]]; then
      chrome_path="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    elif command -v chromium >/dev/null 2>&1; then
      chrome_path="$(command -v chromium)"
    elif command -v google-chrome >/dev/null 2>&1; then
      chrome_path="$(command -v google-chrome)"
    fi
  fi

  if [[ -z "$chrome_path" || ! -x "$chrome_path" ]]; then
    render_profile_pdf_playwright "$html_path" "$pdf_path" && return 0
    cat >&2 <<'EOF'
PDF export needs Chrome/Chromium or a Node.js Playwright runtime.
Set TOKENBAR_CHROME_PATH to Chrome, or TOKENBAR_PLAYWRIGHT_NODE plus TOKENBAR_PLAYWRIGHT_NODE_PATH, then retry:
  tokenbar profile --pdf
EOF
    return 1
  fi

  chrome_profile="$(mktemp -d "${TMPDIR:-/tmp}/tokenbar-pdf-chrome.XXXXXX")"
  timeout_seconds="${TOKENBAR_PDF_TIMEOUT_SECONDS:-45}"
  elapsed=0
  timed_out=false
  "$chrome_path" \
    --headless \
    --disable-gpu \
    --disable-extensions \
    --disable-background-networking \
    --disable-sync \
    --disable-dev-shm-usage \
    --run-all-compositor-stages-before-draw \
    --virtual-time-budget="${TOKENBAR_PDF_VIRTUAL_TIME_MS:-10000}" \
    --user-data-dir="$chrome_profile" \
    --no-pdf-header-footer \
    --print-to-pdf="$pdf_path" \
    "file://$html_path" >/dev/null 2>&1 &
  chrome_pid=$!

  while kill -0 "$chrome_pid" >/dev/null 2>&1; do
    if (( elapsed >= timeout_seconds )); then
      timed_out=true
      kill "$chrome_pid" >/dev/null 2>&1 || true
      sleep 1
      kill -9 "$chrome_pid" >/dev/null 2>&1 || true
      break
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done

  set +e
  wait "$chrome_pid"
  chrome_status=$?
  set -e
  rm -rf "$chrome_profile"

  if [[ -s "$pdf_path" ]]; then
    return 0
  fi

  if [[ "$timed_out" == true ]]; then
    echo "Chrome PDF export timed out after ${timeout_seconds}s; trying Playwright fallback." >&2
    render_profile_pdf_playwright "$html_path" "$pdf_path" && return 0
    return 1
  fi

  if [[ "$chrome_status" -ne 0 ]]; then
    echo "Chrome PDF export failed with exit code $chrome_status; trying Playwright fallback." >&2
    render_profile_pdf_playwright "$html_path" "$pdf_path" && return 0
    return 1
  fi

  echo "Chrome did not create a PDF at $pdf_path" >&2
  render_profile_pdf_playwright "$html_path" "$pdf_path" && return 0
  return 1
}

render_profile_pdf_playwright() {
  local html_path="$1"
  local pdf_path="$2"
  local node_bin="${TOKENBAR_PLAYWRIGHT_NODE:-}"
  local node_path="${TOKENBAR_PLAYWRIGHT_NODE_PATH:-}"
  local bundled_node="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node"
  local bundled_modules="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/node_modules"

  if [[ -z "$node_bin" && -x "$bundled_node" ]]; then
    node_bin="$bundled_node"
  fi
  if [[ -z "$node_bin" && -n "$(command -v node 2>/dev/null || true)" ]]; then
    node_bin="$(command -v node)"
  fi
  if [[ -z "$node_path" && -d "$bundled_modules" ]]; then
    node_path="$bundled_modules"
  fi
  if [[ -z "$node_bin" ]]; then
    return 1
  fi

  NODE_PATH="$node_path" TOKENBAR_PDF_HTML="$html_path" TOKENBAR_PDF_OUTPUT="$pdf_path" "$node_bin" - <<'NODE' >/dev/null 2>&1
const fs = require("fs");
const path = require("path");
let chromium;
try {
  ({ chromium } = require("playwright"));
} catch (error) {
  process.exit(2);
}

(async () => {
  const htmlPath = process.env.TOKENBAR_PDF_HTML;
  const pdfPath = process.env.TOKENBAR_PDF_OUTPUT;
  const browser = await chromium.launch({ headless: true });
  const page = await browser.newPage({ viewport: { width: 1500, height: 2200 }, deviceScaleFactor: 1 });
  await page.goto("file://" + path.resolve(htmlPath), { waitUntil: "load", timeout: 30000 });
  await page.pdf({
    path: pdfPath,
    printBackground: true,
    width: "1120px",
    height: "1584px",
    margin: { top: "20px", right: "20px", bottom: "20px", left: "20px" },
  });
  await browser.close();
  if (!fs.existsSync(pdfPath) || fs.statSync(pdfPath).size < 1024) process.exit(3);
})().catch(() => process.exit(1));
NODE
}

send_profile_email() {
  local to="$1"
  local pdf_path="$2"

  if [[ -z "${AGENTMAIL_API_KEY:-}" || -z "${AGENTMAIL_INBOX_ID:-}" ]]; then
    cat >&2 <<'EOF'
Email delivery needs AgentMail credentials:
  export AGENTMAIL_API_KEY="am_..."
  export AGENTMAIL_INBOX_ID="tokenbar@agentmail.to"

Then run:
  tokenbar profile --pdf --email you@example.com
EOF
    return 1
  fi

  AGENTMAIL_TO="$to" AGENTMAIL_PDF_PATH="$pdf_path" python3 - <<'PY'
import base64
import json
import os
import sys
import urllib.error
import urllib.request

api_key = os.environ.get("AGENTMAIL_API_KEY")
inbox_id = os.environ.get("AGENTMAIL_INBOX_ID")
to = os.environ.get("AGENTMAIL_TO")
pdf_path = os.environ.get("AGENTMAIL_PDF_PATH")

with open(pdf_path, "rb") as handle:
    encoded = base64.b64encode(handle.read()).decode("ascii")

payload = {
    "to": to,
    "subject": "Your TokenBar AI Builder Profile",
    "text": "Your TokenBar AI Builder Profile PDF is attached. Source code is not included in this report.",
    "attachments": [
        {
            "content": encoded,
            "filename": os.path.basename(pdf_path),
            "content_type": "application/pdf",
        }
    ],
}

request = urllib.request.Request(
    f"https://api.agentmail.to/v0/inboxes/{inbox_id}/messages/send",
    data=json.dumps(payload).encode("utf-8"),
    headers={
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
    },
    method="POST",
)
try:
    with urllib.request.urlopen(request, timeout=30) as response:
        body = response.read().decode("utf-8", "replace")
except urllib.error.HTTPError as exc:
    sys.stderr.write(f"AgentMail send failed: HTTP {exc.code} {exc.read().decode('utf-8', 'replace')}\n")
    raise SystemExit(1)

print(f"Email sent to {to}: {body}")
PY
}

power_report() {
  local context
  context="$(usage_context_json 2>/dev/null || printf '{}')"
  TOKENBAR_USAGE_CONTEXT="$context" python3 - <<'PY'
import json
import os
import subprocess

ctx = json.loads(os.environ.get("TOKENBAR_USAGE_CONTEXT") or "{}")

def thermal_summary():
    try:
        output = subprocess.check_output(["/usr/bin/pmset", "-g", "therm"], text=True, timeout=2)
    except Exception:
        return "unknown", "pmset thermal state unavailable"
    text = " ".join(line.strip() for line in output.splitlines() if line.strip())
    lower = text.lower()
    if "no thermal warning" in lower and "no performance warning" in lower:
        return "nominal", "no thermal or performance warning recorded"
    return "watch", text or "thermal output was empty"

print("Mac power + heat")
print("----------------")
thermal_title, thermal_detail = thermal_summary()
print(f"Thermal: {thermal_title} - {thermal_detail}")

watts = ctx.get("mac_power_watts")
temp = ctx.get("battery_celsius")
if watts:
    temp_text = f" | battery {temp}C" if temp is not None else ""
    print(f"Current draw: {watts}W{temp_text} | {ctx.get('power_source', 'battery sample')}")
else:
    print("Current draw: unavailable from ioreg")

if ctx.get("ready"):
    print(f"Tokens: today {ctx.get('today_compact', '0')} | 30d {ctx.get('last30_compact', '0')} | next 7d {ctx.get('projected_next7_compact', '0')}")
    print("Energy note: this is a live Mac sample, not precise wall power. TokenBar can estimate tokens/W and joules/token once it stores samples over time.")
else:
    print(ctx.get("reason", "usage index unavailable"))
PY
}

controls_report() {
  cat <<'EOF'
TokenBar controls
-----------------
Tokens   local token movement by day, model, and active session
Cost     estimated dollars from local tokens and configured price assumptions
Reset    expected 5-hour and weekly windows when a provider exposes them
Budget   runway against quota, credits, and user-set soft limits
Hours    active coding rhythm inferred from local session activity

Current public build reads Codex locally. Antigravity and other providers stay connector-ready until reliable usage exports or APIs are available.
EOF
  printf '\n'
  guardrail_report
}

guardrail_report() {
  local context
  context="$(usage_context_json 2>/dev/null || printf '{}')"
  TOKENBAR_USAGE_CONTEXT="$context" python3 - <<'PY'
import json
import os

ctx = json.loads(os.environ.get("TOKENBAR_USAGE_CONTEXT") or "{}")
print("Prediction controls")
print("-------------------")
print(f"Tracking: {'on' if ctx.get('tracking_enabled', True) else 'paused'}")
print(f"Activity-aware forecast: {'on' if ctx.get('activity_signals_enabled') else 'off'}")
print(f"Prediction basis: {ctx.get('prediction_basis', 'history only')}")
if ctx.get("ready"):
    print(f"Uncertainty: ±{ctx.get('uncertainty_percent', 0)}% ({ctx.get('uncertainty_label', 'Unknown')})")
    print(f"Next 7d: {ctx.get('projected_next7_compact', '0')}")
    print(f"Next 30d: {ctx.get('projected_next30_compact', '0')}")
else:
    print(f"State: {ctx.get('reason', 'usage index unavailable')}")
print(f"Daily token limit: {ctx.get('daily_guardrail_compact') or 'off'}")
print(f"Weekly token limit: {ctx.get('weekly_guardrail_compact') or 'off'}")
print(f"30d token limit: {ctx.get('thirty_day_guardrail_compact') or 'off'}")
print(f"Daily cost limit: ${ctx.get('daily_cost_limit_usd')}" if ctx.get("daily_cost_limit_usd") else "Daily cost limit: off")
print(f"Weekly cost limit: ${ctx.get('weekly_cost_limit_usd')}" if ctx.get("weekly_cost_limit_usd") else "Weekly cost limit: off")
PY
}

guardrail_command() {
  local scope="${1:-}"
  local value="${2:-}"
  case "$scope" in
    ""|show|status)
      guardrail_report
      ;;
    daily|day)
      if [[ -z "$value" || "$value" == "off" ]]; then
        set_control_value dailyGuardrailTokens none
        printf 'Daily token limit cleared.\n'
      else
        set_control_value dailyGuardrailTokens "$value"
        printf 'Daily token limit set to %s.\n' "$value"
      fi
      ;;
    weekly|week)
      if [[ -z "$value" || "$value" == "off" ]]; then
        set_control_value weeklyGuardrailTokens none
        printf 'Weekly token limit cleared.\n'
      else
        set_control_value weeklyGuardrailTokens "$value"
        printf 'Weekly token limit set to %s.\n' "$value"
      fi
      ;;
    30d|30|monthly|month)
      if [[ -z "$value" || "$value" == "off" ]]; then
        set_control_value thirtyDayGuardrailTokens none
        printf '30-day token limit cleared.\n'
      else
        set_control_value thirtyDayGuardrailTokens "$value"
        printf '30-day token limit set to %s.\n' "$value"
      fi
      ;;
    daily-cost|day-cost|cost-daily)
      if [[ -z "$value" || "$value" == "off" ]]; then
        set_control_value dailyCostLimitUSD none
        printf 'Daily cost limit cleared.\n'
      else
        set_control_value dailyCostLimitUSD "$value"
        printf 'Daily cost limit set to $%s.\n' "$value"
      fi
      ;;
    weekly-cost|week-cost|cost-weekly)
      if [[ -z "$value" || "$value" == "off" ]]; then
        set_control_value weeklyCostLimitUSD none
        printf 'Weekly cost limit cleared.\n'
      else
        set_control_value weeklyCostLimitUSD "$value"
        printf 'Weekly cost limit set to $%s.\n' "$value"
      fi
      ;;
    *)
      printf 'Usage: tokenbar limits [daily 100M|weekly 2B|30d 20B|daily-cost 25|weekly-cost 100|status]\n'
      return 1
      ;;
  esac
}

playbooks_command() {
  local action="${1:-show}"
  local key="${2:-}"
  local playbooks_url="${site_url%/}/playbooks"
  local catalog_url="${site_url%/}/prompt-playbooks.md"
  local prompt=""

  case "$action" in
    ""|show|list|free|status)
      cat <<EOF
TokenBar Playbooks
------------------
Free starters:
  mission-lock       Budget, route, context cap, stop condition, verifier.
  budget-runway      Pre-run budget brief with threshold, verifier, and approval gates.
  cost-saver         Start cheap, cap context, stop on secrets or paid scope.
  verifier-first     Name the proof before changing code.
  connector-truth    Mark providers as measured, demo, setup needed, or unsupported.

Pro library preview:
  system-prompt-hardener, no-submit-launch-draft, cost-passport,
  thread-handoff, comparison-engine, memory-pressure-story.

Commands:
  tokenbar playbooks copy mission-lock
  tokenbar playbooks copy budget-runway
  tokenbar playbooks json
  tokenbar playbooks open
  tokenbar playbooks catalog

Privacy: playbooks never require raw transcripts, source code, or credentials.
EOF
      ;;
    json|--json)
      cat <<EOF
{
  "schema": "tokenbar.playbooks.v1",
  "source": "local-cli",
  "privacy": {
    "raw_transcripts_required": false,
    "source_code_required": false,
    "credentials_required": false,
    "external_actions_require_approval": true
  },
  "tiers": [
    {
      "name": "Free",
      "description": "Starter prompts for budget, scope, verification, and connector truth.",
      "playbooks": [
        {
          "key": "mission-lock",
          "title": "Mission Lock",
          "category": "Launch and scope",
          "command": "tokenbar playbooks copy mission-lock",
          "prompt": "Budget: Medium | Route: smallest useful implementation | Context cap: only directly affected files | Stop: destructive scope, credentials, paid services, or unclear ownership. First restate the outcome, then implement one verified improvement."
        },
        {
          "key": "budget-runway",
          "title": "Budget Brief",
          "category": "Cost and budget",
          "command": "tokenbar playbooks copy budget-runway",
          "prompt": "Budget: Focus | Route: one bounded implementation | Timebox: one verifier | Context cap: touched files only | Stop: approval-gated external actions. Start by naming budget pressure, expected proof, and the exact condition that would pause the run."
        },
        {
          "key": "cost-saver",
          "title": "Cost Saver Header",
          "category": "Cost and budget",
          "command": "tokenbar playbooks copy cost-saver",
          "prompt": "Budget: Low unless blocked | Route: inspect first, edit second | Context cap: 6 files max | Stop: secrets, paid services, or broad refactor. Return only decision-relevant output."
        },
        {
          "key": "verifier-first",
          "title": "Verifier First",
          "category": "Verification",
          "command": "tokenbar playbooks copy verifier-first",
          "prompt": "Before editing, identify the verifier. After editing, run it. If it is too slow, run the closest narrow check and state the limitation."
        },
        {
          "key": "connector-truth",
          "title": "Connector Truth Table",
          "category": "Connectors",
          "command": "tokenbar playbooks copy connector-truth",
          "prompt": "For each connector, label measured, connected, demo, setup needed, or unsupported. Never draw usage from unmeasured providers."
        }
      ]
    },
    {
      "name": "Pro",
      "description": "Premium prompts for system prompts, launch prep, cost passports, handoffs, comparisons, and memory recovery.",
      "playbooks": [
        {"key": "system-prompt-hardener", "title": "System Prompt Hardener", "category": "System prompt"},
        {"key": "no-submit-launch-draft", "title": "No-Submit Launch Draft", "category": "Launch"},
        {"key": "cost-passport", "title": "Cost Passport", "category": "Costs"},
        {"key": "thread-handoff", "title": "Thread Handoff", "category": "Threads"},
        {"key": "comparison-engine", "title": "Comparison Engine", "category": "Team"},
        {"key": "memory-pressure-story", "title": "Memory Pressure Story", "category": "System"}
      ]
    }
  ],
  "connector_targets": ["Codex", "Claude Code", "Cursor", "Antigravity", "OpenCode"],
  "links": {
    "marketplace": "$playbooks_url",
    "catalog": "$catalog_url"
  }
}
EOF
      ;;
    open|site|web)
      if command -v open >/dev/null 2>&1; then
        open "$playbooks_url"
      fi
      printf 'TokenBar Playbooks: %s\n' "$playbooks_url"
      ;;
    catalog|source|md)
      if command -v open >/dev/null 2>&1; then
        open "$catalog_url"
      fi
      printf '100-template catalog: %s\n' "$catalog_url"
      ;;
    copy)
      case "$key" in
        mission-lock|mission|scope)
          prompt='Budget: Medium | Route: smallest useful implementation | Context cap: only directly affected files | Stop: destructive scope, credentials, paid services, or unclear ownership. First restate the outcome, then implement one verified improvement.'
          ;;
        budget-runway|runway|budget-brief)
          prompt='Budget: Focus | Route: one bounded implementation | Timebox: one verifier | Context cap: touched files only | Stop: approval-gated external actions. Start by naming budget pressure, expected proof, and the exact condition that would pause the run.'
          ;;
        cost-saver|cost|budget)
          prompt='Budget: Low unless blocked | Route: inspect first, edit second | Context cap: 6 files max | Stop: secrets, paid services, or broad refactor. Return only decision-relevant output.'
          ;;
        verifier-first|verify|proof)
          prompt='Before editing, identify the verifier. After editing, run it. If it is too slow, run the closest narrow check and state the limitation.'
          ;;
        connector-truth|connectors|providers)
          prompt='For each connector, label measured, connected, demo, setup needed, or unsupported. Never draw usage from unmeasured providers.'
          ;;
        *)
          printf 'Usage: tokenbar playbooks copy [mission-lock|budget-runway|cost-saver|verifier-first|connector-truth]\n' >&2
          return 1
          ;;
      esac
      if command -v pbcopy >/dev/null 2>&1; then
        printf '%s' "$prompt" | pbcopy
        printf 'Copied playbook: %s\n' "$key"
      else
        printf '%s\n' "$prompt"
      fi
      ;;
    *)
      printf 'Usage: tokenbar playbooks [show|json|open|catalog|copy KEY]\n' >&2
      return 1
      ;;
  esac
}

comparison_lens_command() {
  local format="${1:-}"
  TOKENBAR_COMPARISON_FORMAT="$format" TOKENBAR_SUPPORT_DIR="$support_dir" python3 - <<'PY'
import json
import os
import time
from pathlib import Path

fmt = (os.environ.get("TOKENBAR_COMPARISON_FORMAT") or "").strip().lower()
root = Path(os.environ.get("TOKENBAR_SUPPORT_DIR") or "").expanduser()
index_path = root / "usage-index.json"


def number(value):
    try:
        return int(float(value))
    except Exception:
        return 0


def compact(value):
    value = number(value)
    if value >= 1_000_000_000:
        return f"{value / 1_000_000_000:.2f}".rstrip("0").rstrip(".") + "B"
    if value >= 1_000_000:
        return f"{value / 1_000_000:.1f}".rstrip("0").rstrip(".") + "M"
    if value >= 1_000:
        return f"{value / 1_000:.1f}".rstrip("0").rstrip(".") + "K"
    return str(value)


try:
    data = json.loads(index_path.read_text(encoding="utf-8"))
except Exception:
    data = {}

day_tokens = data.get("dayTokens") if isinstance(data.get("dayTokens"), dict) else {}
values = [number(value) for _, value in sorted(day_tokens.items())[-90:]]
recent = values[-30:]
active = [value for value in recent if value > 0]
last7 = sum(values[-7:])
previous7 = sum(values[-14:-7])
last30 = sum(recent)
active_days = len(active)
quiet_days = max(0, len(recent) - active_days)
peak = max(recent or [0])
avg_active = int(sum(active) / max(1, len(active))) if active else 0

consistency = 0
if active:
    variance = sum(abs(value - avg_active) for value in active) / max(1, len(active))
    consistency = max(0, min(100, round(100 - (variance / max(1, avg_active)) * 45)))
momentum = 50
if previous7:
    momentum = max(0, min(100, round(50 + ((last7 - previous7) / max(1, previous7)) * 35)))
elif last7:
    momentum = 68
efficiency = max(0, min(100, 84 - round((peak / max(1, avg_active) - 1) * 18))) if avg_active else 50
scope = max(0, min(100, 45 + active_days * 2 - min(25, quiet_days)))

payload = {
    "schema": "tokenbar.comparison_lens.v1",
    "generatedAt": int(time.time()),
    "source": "local-aggregate-self-comparison",
    "headline": "Compare the work pattern, not the person.",
    "summary": {
        "cohortState": "local-only",
        "localWindows": min(4, max(1, len(recent) // 7)),
        "optInCohortSize": 0,
        "percentile": None,
        "percentileStatus": "locked until an opt-in cohort exists",
        "basis": "Self-over-time comparison from aggregate token counts only.",
    },
    "cards": [
        {"key": "cadence", "label": "Cadence", "value": f"{active_days}/30 active days", "score": consistency, "basis": "Compares active days and burstiness inside this local 30-day window."},
        {"key": "momentum", "label": "Momentum", "value": f"{compact(last7)} last 7d", "score": momentum, "basis": "Compares the latest 7 days with the previous 7 days."},
        {"key": "cost-control", "label": "Cost control", "value": f"{compact(avg_active)} active-day baseline", "score": efficiency, "basis": "Rewards steadier usage over one-day spikes. It does not judge output quality."},
        {"key": "scope", "label": "Scope discipline", "value": f"{compact(last30)} in 30d", "score": scope, "basis": "A local proxy from active days, quiet days, and aggregate token shape only."},
    ],
    "claimPolicy": {
        "allowed": ["self-over-time comparison", "opt-in public proof-card cohorts", "metric-specific ranks"],
        "blocked": ["top-percentile claims without cohort data", "identity worth rankings", "raw transcript or source-code comparisons"],
        "minimumCohortForPercentile": 10,
    },
    "proPreview": {
        "title": "Pro comparison engine",
        "description": "Team and community benchmarks unlock only after users opt in with safe proof cards.",
    },
    "privacy": {
        "rawPromptsIncluded": False,
        "rawTranscriptsIncluded": False,
        "sourceCodeIncluded": False,
        "localPathsIncluded": False,
        "credentialsIncluded": False,
        "providerCalls": False,
        "externalActions": False,
        "populationClaims": False,
    },
    "disclaimer": "Local data can compare your own windows. It cannot claim top-percentile status until an opt-in cohort exists.",
}

if fmt in {"json", "--json"}:
    print(json.dumps(payload, indent=2, sort_keys=True))
    raise SystemExit(0)

print("TokenBar Comparison Lens")
print("------------------------")
print(payload["headline"])
print(f"{compact(last30)} in 30d · {active_days}/30 active days · percentile: locked")
print()
for card in payload["cards"]:
    print(f"{card['label']:<16} {card['score']:>3}/100  {card['value']}")
    print(f"                  {card['basis']}")
print()
print("Allowed: self-over-time, opt-in cohorts, metric-specific ranks.")
print("Blocked: top-percentile claims without cohort data; no raw logs or source code.")
PY
}

proof_packet_command() {
  local format="${1:-}"
  TOKENBAR_PROOF_PACKET_FORMAT="$format" TOKENBAR_SUPPORT_DIR="$support_dir" python3 - <<'PY'
import json
import os
import time
from pathlib import Path

fmt = (os.environ.get("TOKENBAR_PROOF_PACKET_FORMAT") or "").strip().lower()
root = Path(os.environ.get("TOKENBAR_SUPPORT_DIR") or "").expanduser()
index_path = root / "usage-index.json"


def number(value):
    try:
        return int(float(value))
    except Exception:
        return 0


def compact(value):
    value = number(value)
    if value >= 1_000_000_000:
        return f"{value / 1_000_000_000:.2f}".rstrip("0").rstrip(".") + "B"
    if value >= 1_000_000:
        return f"{value / 1_000_000:.1f}".rstrip("0").rstrip(".") + "M"
    if value >= 1_000:
        return f"{value / 1_000:.1f}".rstrip("0").rstrip(".") + "K"
    return str(value)


try:
    data = json.loads(index_path.read_text(encoding="utf-8"))
except Exception:
    data = {}

day_tokens = data.get("dayTokens") if isinstance(data.get("dayTokens"), dict) else {}
model_tokens = data.get("modelTokens") if isinstance(data.get("modelTokens"), dict) else {}
sessions = data.get("sessionPaths") if isinstance(data.get("sessionPaths"), list) else []
values = [number(value) for _, value in sorted(day_tokens.items())[-90:]]
last7 = sum(values[-7:])
last30 = sum(values[-30:])
total = sum(number(value) for value in model_tokens.values()) or sum(values)
active_days = sum(1 for value in values[-30:] if value > 0)
peak_day, peak_tokens = max(day_tokens.items(), key=lambda item: number(item[1]), default=("", 0))
provider_targets = {
    "Codex": ("codex", "gpt", "openai"),
    "Claude Code": ("claude", "sonnet", "opus"),
    "Cursor": ("cursor",),
    "Antigravity": ("antigravity", "anti-gravity"),
    "OpenCode": ("opencode", "open code", "open-code"),
}
measured = []
for label, aliases in provider_targets.items():
    provider_total = 0
    for model, tokens in model_tokens.items():
        lowered = str(model).lower()
        if any(alias in lowered for alias in aliases):
            provider_total += number(tokens)
    if provider_total:
        measured.append({"name": label, "tokens": provider_total})

payload = {
    "schema": "tokenbar.launch_proof_packet.v1",
    "generatedAt": int(time.time()),
    "title": "TokenBar Launch Proof Packet",
    "headline": "Show the generated proof, not the private work.",
    "source": "local-aggregate-launch-proof",
    "summary": {
        "sessionCount": len(sessions),
        "activeDayCount": active_days,
        "totalTokens": total,
        "last7Tokens": last7,
        "last30Tokens": last30,
        "peakDay": str(peak_day)[:32] if peak_day else None,
        "peakDayTokens": number(peak_tokens),
        "measuredProviderCount": len(measured),
        "setupProviderCount": max(0, len(provider_targets) - len(measured)),
        "topReminder": "Open a verifier-first playbook before the next long run.",
        "wasteScore": 42 if total else 0,
        "comparisonState": "locked until an opt-in cohort exists",
        "playbookCount": 100,
    },
    "cards": [
        {"key": "usage", "title": "Usage evidence", "value": compact(total), "copy": f"{len(sessions)} sessions across {active_days} active days.", "command": "tokenbar usage"},
        {"key": "cost", "title": "Cost passport", "value": compact(last30), "copy": "Estimate-only until a price assumption or invoice source is reviewed.", "command": "tokenbar cost-passport json"},
        {"key": "waste", "title": "Waste lens", "value": "42" if total else "0", "copy": "Aggregate usage shape points to the next saver playbook.", "command": "tokenbar waste json"},
        {"key": "comparison", "title": "Comparison lens", "value": "locked", "copy": "Population percentile claims stay locked until measured opt-in cohorts exist.", "command": "tokenbar comparison-lens json"},
        {"key": "playbooks", "title": "Prompt playbooks", "value": "100", "copy": "Free starters are copy-ready; Pro templates require account/subscription later.", "command": "tokenbar playbooks json"},
    ],
    "approvalGates": [
        "No Product Hunt or Macapp Supply submission from this packet.",
        "No Stripe, subscription, or entitlement changes from this packet.",
        "No account switching, provider calls, browser scraping, cleanup, posting, or uploads.",
        "Public proof requires explicit review and approval of the generated artifact.",
    ],
    "blockedFields": [
        "raw prompts",
        "transcripts",
        "source code",
        "private diffs",
        "local paths",
        "credentials",
        "provider cookies",
        "official invoice claims",
        "top-percentile claims without opt-in cohorts",
    ],
    "commands": ["tokenbar proof-packet json", "tokenbar launch-kit", "tokenbar runway", "tokenbar browser-companion", "tokenbar playbooks"],
    "privacy": {
        "rawPromptsIncluded": False,
        "rawTranscriptsIncluded": False,
        "sourceCodeIncluded": False,
        "localPathsIncluded": False,
        "credentialsIncluded": False,
        "providerCalls": False,
        "paymentActions": False,
        "externalActions": False,
        "publicPosting": False,
    },
    "disclaimer": "This proof packet is safe local launch evidence. It is not a submission, billing record, provider invoice, or public ranking.",
}

if fmt in {"json", "--json"}:
    print(json.dumps(payload, indent=2, sort_keys=True))
    raise SystemExit(0)

print(payload["title"])
print("----------------------------")
print(payload["headline"])
print(f"{compact(total)} total · {compact(last30)} in 30d · {active_days}/30 active days · {len(measured)} measured providers")
print()
for card in payload["cards"]:
    print(f"{card['title']:<18} {card['value']:<10} {card['command']}")
    print(f"                   {card['copy']}")
print()
print("Approval gates")
for gate in payload["approvalGates"]:
    print(f"  - {gate}")
print()
print("Blocked from packet")
print("  " + ", ".join(payload["blockedFields"]))
PY
}

tracking_command() {
  local action="${1:-status}"
  case "$action" in
    status|show|"")
      guardrail_report
      ;;
    on|resume|start)
      set_control_value logTrackingEnabled true
      printf 'Local log tracking resumed. Run tokenbar forecast to refresh from the app index.\n'
      ;;
    off|pause|stop)
      set_control_value logTrackingEnabled false
      printf 'Local log tracking paused. Historical usage remains readable with tokenbar usage.\n'
      ;;
    clear|delete|erase)
      set_control_value logTrackingEnabled false
      delete_usage_index
      printf 'Local log tracking paused and usage-index.json removed.\n'
      ;;
    *)
      printf 'Usage: tokenbar tracking [status|on|off|clear]\n'
      return 1
      ;;
  esac
}

activity_command() {
  local action="${1:-status}"
  case "$action" in
    status|show|"")
      guardrail_report
      ;;
    on|allow|enable)
      set_control_value activitySignalsEnabled true
      printf 'Activity-aware forecasting enabled. It uses local active/quiet cadence only.\n'
      ;;
    off|deny|disable)
      set_control_value activitySignalsEnabled false
      printf 'Activity-aware forecasting disabled. Forecasts are history-only.\n'
      ;;
    *)
      printf 'Usage: tokenbar activity [status|on|off]\n'
      return 1
      ;;
  esac
}

doctor_report() {
  local app_path launcher pid
  app_path="$(find_app || true)"
  launcher="$(command -v tokenbar 2>/dev/null || true)"
  pid="$(running_pid)"

  printf 'TokenBar doctor\n'
  printf '%s\n' '---------------'
  printf 'Launcher: %s\n' "${launcher:-not on PATH}"
  printf 'App: %s\n' "${app_path:-not installed}"
  if [[ -n "$pid" ]]; then
    printf 'Running: yes (pid %s)\n' "$pid"
  else
    printf 'Running: no\n'
  fi
  printf 'Usage index: %s\n' "$([[ -f "$usage_index" ]] && printf found || printf missing)"
  printf 'Download: %s\n' "$download_url"
  printf 'Install command: %s\n' "$install_command"
  printf '\n'
  usage_summary
}

explain_topic() {
  local topic="${1:-overview}"
  case "$(printf '%s' "$topic" | tr '[:upper:]' '[:lower:]')" in
    quota|limit|pressure)
      cat <<'EOF'
Quota pressure means the tighter of the live Codex 5-hour and weekly windows.
If either bucket reaches 100 percent used, Codex can pause until that bucket resets.
EOF
      ;;
    forecast|pace|runout)
      cat <<'EOF'
Forecasts are local hypotheses from recent token pace, active-day average, and reset windows.
The app shows today as the boundary: solid history before it, dotted forecast after it.
EOF
      ;;
    cost|billing|dollar|credits)
      cat <<'EOF'
Cost is estimated from local tokens times the configured dollars-per-million value.
Purchased credits, billing, project attribution, and org totals must be verified in the official dashboard.
EOF
      ;;
    energy|watt|power|joule)
      cat <<'EOF'
Power reads a live Mac battery/adapter sample when macOS exposes it, then pairs it with token pace.
Joules per token and tokens per watt-hour remain estimates until TokenBar stores a power sample timeline.
EOF
      ;;
    antigravity|anti-gravity|google)
      cat <<'EOF'
Antigravity is treated as a connector target, not as a live source yet.
TokenBar should only wire it in through explicit usage APIs, exports, or user-approved local files.
EOF
      ;;
    controls|control|budget|hours|timing|time)
      controls_report
      ;;
    provider|providers|connector|connectors)
      provider_report
      ;;
    *)
      cat <<'EOF'
Topics: quota, forecast, cost, energy, providers, antigravity, controls.
Example: tokenbar explain forecast
EOF
      ;;
  esac
}

terminal_movie() {
  local app_path="${1:-}"
  local mode="${2:-prompt}"

  [[ "$animate" == true ]] || return 0
  if [[ "${force_animation:-false}" != true ]]; then
    supports_animation || return 1
  fi
  command -v python3 >/dev/null 2>&1 || return 0

  TOKENBAR_APP_PATH="$app_path" \
  TOKENBAR_MOVIE_MODE="$mode" \
  TOKENBAR_ANIM_CONTEXT="$(usage_context_json 2>/dev/null || printf '{}')" \
  TOKENBAR_API_STATUS="$(agent_api_status)" \
  python3 - <<'PY' >&2
import json
import os
import sys
import time

ctx = json.loads(os.environ.get("TOKENBAR_ANIM_CONTEXT") or "{}")
app_path = os.environ.get("TOKENBAR_APP_PATH", "")
api_status = os.environ.get("TOKENBAR_API_STATUS", "")
mode = os.environ.get("TOKENBAR_MOVIE_MODE", "prompt")

hide = "\033[?25l"
show = "\033[?25h"
cyan = "\033[36m"
green = "\033[32m"
amber = "\033[33m"
dim = "\033[2m"
red = "\033[31m"
reset = "\033[0m"

def compact_value(key, fallback="0"):
    return str(ctx.get(key) or fallback)

def gate(value, maximum, size=16):
    try:
        value = max(0, float(value or 0))
        maximum = max(1, float(maximum or 1))
    except Exception:
        value = 0
        maximum = 1
    filled = min(size, int(round((value / maximum) * size)))
    return "#" * filled + "-" * (size - filled)

def metric_text():
    if not ctx.get("ready"):
        return f"{amber}logs pending{reset} - {ctx.get('reason', 'usage index missing')}"
    return f"{green}today {compact_value('today_compact')}{reset} | 7d {compact_value('projected_next7_compact')} | 30d {compact_value('last30_compact')}"

if not ctx.get("ready"):
    print(f"{green}TokenBar opened{reset} · {metric_text()}")
    print(f"{dim}{app_path}{reset}")
    raise SystemExit(0)

today = int(ctx.get("today_tokens") or 0)
last30 = int(ctx.get("last30_tokens") or 0)
peak = max(1, int(ctx.get("peak_tokens") or 1))
budget = int(ctx.get("budget_tokens") or 0)
gate_value = last30 if budget > 0 else today
gate_max = budget if budget > 0 else max(today, peak, 1)
gate_name = "budget gate" if budget > 0 else "today gate"
quota_gate = gate(gate_value, gate_max, 18)
api_label = "OpenAI ready" if api_status.startswith("OpenAI") else "local analyst"
watts = ctx.get("mac_power_watts")
heat = f"{watts}W" if watts else "sample"
runout = ctx.get("estimated_runout_date") or "reset first"
budget_label = ctx.get("budget_compact") or "set budget"

scenes = [
    ("BOOT", 2, "o o", "opening native menu-bar surface", "[logs]----[forecast]----[budget]----[chat]"),
    ("LOGS", 10, "o ^", "reading local Codex sessions", "[LOGS]====[forecast]----[budget]----[chat]"),
    ("FORECAST", 22, "^ o", f"projecting next 7d {compact_value('projected_next7_compact')}", "[logs]====[FORECAST]====[budget]----[chat]"),
    ("BUDGET", 34, "- ^", f"checking limits: {budget_label}", "[logs]====[forecast]====[BUDGET]====[chat]"),
    ("HEAT", 45, "* ^", f"sampling Mac power: {heat}", "[logs]====[forecast]====[budget]====[HEAT]"),
    ("READY", 54, "^ ^", "chat prompt armed", "[logs]====[forecast]====[budget]====[CHAT]"),
]

def scene_rows(label, pos, eyes, caption, rail):
    width = 62
    sprite = [
        " .----. ",
        f"(  {eyes}  )",
        " /|__|\\ ",
        "  /  \\  ",
    ]
    pos = max(0, min(width - max(len(line) for line in sprite), pos))
    sprite_rows = [" " + " " * pos + cyan + line + reset for line in sprite]
    rail_colored = rail
    for word, color in (
        ("LOGS", green),
        ("FORECAST", cyan),
        ("BUDGET", amber),
        ("HEAT", red),
        ("CHAT", green),
    ):
        rail_colored = rail_colored.replace(word, color + word + reset)
    return [
        f"{dim}+----------------------------------------------------------------+{reset}",
        f"{green} TokenBar terminal movie{reset}  {dim}{api_label}{reset}  {amber}{label}{reset}",
        f" {rail_colored}",
        *sprite_rows,
        f" {caption}",
        f" {metric_text()}",
        f" {gate_name} {green}{quota_gate}{reset} | runout {runout}",
        f"{dim}+----------------------------------------------------------------+{reset}",
    ]

line_count = 10
sys.stdout.write(hide)
try:
    for index, scene in enumerate(scenes):
        rows = scene_rows(*scene)
        if index:
            sys.stdout.write(f"\033[{line_count}F")
        for row in rows:
            sys.stdout.write("\033[K" + row + "\n")
        sys.stdout.flush()
        time.sleep(0.23)
    if mode == "prompt":
        time.sleep(0.18)
        sys.stdout.write(f"\033[{line_count}F")
        for _ in range(line_count):
            sys.stdout.write("\033[K\n")
        sys.stdout.write(f"\033[{line_count}F")
finally:
    sys.stdout.write(show)
    sys.stdout.flush()
PY
}

animated_open_message() {
  local app_path="$1"

  if [[ "${sound_enabled:-false}" == true ]] && command -v afplay >/dev/null 2>&1; then
    afplay "/System/Library/Sounds/Tink.aiff" >/dev/null 2>&1 &
  fi

  if ! command -v python3 >/dev/null 2>&1; then
    printf 'TokenBar opened: %s\n' "$app_path"
    return 0
  fi

  terminal_movie "$app_path" "open" || plain_open_message "$app_path"
}

plain_open_message() {
  printf 'Opened TokenBar: %s\n' "$1"
}

chat_hint() {
  cat <<'EOF'
Ask TokenBar in plain English:
  will I run out this week?
  why did today spike?
  show folders
  set daily limit 100M
  set weekly limit 2B
  set daily cost 25
  how hot is my Mac?
EOF
}

clean_value() {
  printf '%s' "$1" | tr -d '[:space:],'
}

clean_token_value() {
  clean_value "$1" | tr '[:lower:]' '[:upper:]'
}

natural_limit_command() {
  local input="$1"
  local lower value
  lower="$(printf '%s' "$input" | tr '[:upper:]' '[:lower:]')"

  if [[ "$lower" =~ (clear|unset|remove|disable|turn[[:space:]]+off|off).*(daily|day|per[[:space:]]+day).*(cost|dollar|spend|usd) ]]; then
    guardrail_command daily-cost off
    return 0
  fi
  if [[ "$lower" =~ (clear|unset|remove|disable|turn[[:space:]]+off|off).*(weekly|week|per[[:space:]]+week).*(cost|dollar|spend|usd) ]]; then
    guardrail_command weekly-cost off
    return 0
  fi
  if [[ "$lower" =~ (daily|day|per[[:space:]]+day).*(cost|dollar|spend|usd)[^0-9\$]*\$?([0-9][0-9,.]*([.][0-9]+)?) ]]; then
    value="$(clean_value "${BASH_REMATCH[3]}")"
    guardrail_command daily-cost "$value"
    return 0
  fi
  if [[ "$lower" =~ (weekly|week|per[[:space:]]+week).*(cost|dollar|spend|usd)[^0-9\$]*\$?([0-9][0-9,.]*([.][0-9]+)?) ]]; then
    value="$(clean_value "${BASH_REMATCH[3]}")"
    guardrail_command weekly-cost "$value"
    return 0
  fi

  if [[ "$lower" =~ (clear|unset|remove|disable|turn[[:space:]]+off|off).*(daily|day|per[[:space:]]+day).*(limit|budget|guardrail|cap) ]]; then
    guardrail_command daily off
    return 0
  fi
  if [[ "$lower" =~ (clear|unset|remove|disable|turn[[:space:]]+off|off).*(weekly|week|per[[:space:]]+week).*(limit|budget|guardrail|cap) ]]; then
    guardrail_command weekly off
    return 0
  fi
  if [[ "$lower" =~ (clear|unset|remove|disable|turn[[:space:]]+off|off).*(30d|30-day|thirty|monthly|month|overall).*(limit|budget|guardrail|cap) ]]; then
    guardrail_command 30d off
    return 0
  fi

  if [[ "$lower" =~ (daily|day|per[[:space:]]+day).*(limit|budget|guardrail|cap)[^0-9]*([0-9][0-9,.]*[[:space:]]*[kmb]?) ]]; then
    value="$(clean_token_value "${BASH_REMATCH[3]}")"
    guardrail_command daily "$value"
    return 0
  fi
  if [[ "$lower" =~ (weekly|week|per[[:space:]]+week).*(limit|budget|guardrail|cap)[^0-9]*([0-9][0-9,.]*[[:space:]]*[kmb]?) ]]; then
    value="$(clean_token_value "${BASH_REMATCH[3]}")"
    guardrail_command weekly "$value"
    return 0
  fi
  if [[ "$lower" =~ (30d|30-day|thirty|monthly|month|overall|budget).*(limit|budget|guardrail|cap)?[^0-9]*([0-9][0-9,.]*[[:space:]]*[kmb]?) ]]; then
    value="$(clean_token_value "${BASH_REMATCH[3]}")"
    guardrail_command 30d "$value"
    return 0
  fi
  if [[ "$lower" =~ (set|cap|limit).*(budget|quota)[^0-9]*([0-9][0-9,.]*[[:space:]]*[kmb]?) ]]; then
    value="$(clean_token_value "${BASH_REMATCH[3]}")"
    guardrail_command 30d "$value"
    return 0
  fi

  return 1
}

answer_agent_prompt() {
  local app_path="$1"
  local input="$2"
  local lower
  lower="$(printf '%s' "$input" | tr '[:upper:]' '[:lower:]')"

  if natural_limit_command "$input"; then
    return 0
  fi
  if [[ "$lower" == *"how hot"* || "$lower" == *"heat"* || "$lower" == *"power"* || "$lower" == *"watt"* || "$lower" == *"joule"* ]]; then
    power_report
    return 0
  fi
  if [[ "$lower" == *"folder"* || "$lower" == *"project"* || "$lower" == *"workspace"* ]]; then
    folder_report
    return 0
  fi

  case "$lower" in
    help|commands|\?|"/help")
      chat_hint
      ;;
    open|launch|"open app"|"launch app")
      if [[ -n "$app_path" ]]; then
        open "$app_path"
        printf 'Opened TokenBar again: %s\n' "$app_path"
      else
        printf 'TokenBar app path is not installed yet. You can still ask questions from local logs.\n'
      fi
      ;;
    status|doctor-status)
      status_report
      ;;
    usage|summary|"usage summary")
      usage_report
      ;;
    forecast)
      agent_answer "forecast my next usage window from the local logs"
      ;;
    controls)
      controls_report
      ;;
    limits|limit|budgets)
      guardrail_report
      ;;
    guardrails|guardrail|"guardrails "*|"guardrail "*)
      read -r _ arg1 arg2 <<< "$input"
      guardrail_command "${arg1:-}" "${arg2:-}"
      ;;
    power|heat|energy|"how hot is my mac"|"mac heat"|"mac power")
      power_report
      ;;
    folders|folder|projects|project|workspaces|workspace|"show folders"|"show projects")
      folder_report
      ;;
    tracking|"tracking "*|"track "*)
      read -r _ arg1 _ <<< "$input"
      tracking_command "${arg1:-status}"
      ;;
    activity|"activity "*)
      read -r _ arg1 _ <<< "$input"
      activity_command "${arg1:-status}"
      ;;
    doctor|bug|debug|diagnostic|diagnostics)
      doctor_report
      ;;
    site|website)
      open_site
      ;;
    skills|repo|github)
      open_skills_repo
      ;;
    install|download|update)
      printf '%s\n' "$install_command"
      ;;
    config|settings|"config "*|"settings "*|model|"model "*|budget|"budget "*|price|"price "*)
      configure_agent_session "$input"
      ;;
    quit|exit|bye)
      return 10
      ;;
    "")
      ;;
    *)
      agent_answer "$input"
      ;;
  esac
}

agent_config_report() {
  printf 'TokenBar Agent configuration\n'
  printf '%s\n' '----------------------------'
  printf 'Model: %s\n' "$agent_model"
  printf 'API: %s\n' "$(agent_api_status)"
  printf 'Usage index: %s\n' "$usage_index"
  printf 'Budget: %s\n' "${agent_budget_tokens:-not configured}"
  printf 'Price: %s\n' "${agent_price_per_million:-not configured}"
  printf '\n'
  printf 'Prompt config examples:\n'
  printf '  config model gpt-5.4\n'
  printf '  config budget 20B\n'
  printf '  config price 0.30\n'
}

configure_agent_session() {
  local input="$1"
  local words=()
  local first field value
  read -r -a words <<< "$input"
  first="${words[0]:-}"

  case "$first" in
    config|settings)
      field="${words[1]:-}"
      value="${words[*]:2}"
      ;;
    model|budget|price)
      field="$first"
      value="${words[*]:1}"
      ;;
    *)
      agent_config_report
      return 0
      ;;
  esac

  case "$field" in
    ""|show|status)
      agent_config_report
      ;;
    model)
      if [[ -z "$value" ]]; then
        printf 'Model is %s\n' "$agent_model"
      else
        agent_model="$value"
        printf 'Agent model set for this session: %s\n' "$agent_model"
      fi
      ;;
    budget|tokens|limit)
      if [[ -z "$value" ]]; then
        printf 'Budget is %s\n' "${agent_budget_tokens:-not configured}"
      else
        agent_budget_tokens="$value"
        printf 'Session budget set: %s tokens\n' "$agent_budget_tokens"
      fi
      ;;
    price|cost)
      if [[ -z "$value" ]]; then
        printf 'Price is %s\n' "${agent_price_per_million:-not configured}"
      else
        agent_price_per_million="$value"
        printf 'Session price set: $%s per million tokens\n' "$agent_price_per_million"
      fi
      ;;
    *)
      printf 'Unknown config field: %s\n' "$field"
      agent_config_report
      ;;
  esac
}

prompt_separator() {
  local dim=$'\033[2m'
  local reset=$'\033[0m'
  local label="${1:-}"
  if [[ -n "$label" ]]; then
    printf '%s-------- ---------- %s ----------%s\n' "$dim" "$label" "$reset"
  else
    printf '%s-------- ---------- -------- ----------%s\n' "$dim" "$reset"
  fi
}

agent_editor_header() {
  local green=$'\033[32m'
  local cyan=$'\033[36m'
  local amber=$'\033[33m'
  local dim=$'\033[2m'
  local reset=$'\033[0m'

  if ! command -v python3 >/dev/null 2>&1; then
    printf '%sTokenBar Chat%s\n' "$green" "$reset" >&2
    printf '%sAsk about tokens, budget, reset, folders, or cost.%s\n' "$dim" "$reset" >&2
    return 0
  fi

  TOKENBAR_CHAT_CONTEXT="$(usage_context_json 2>/dev/null || printf '{}')" \
  TOKENBAR_API_STATUS="$(agent_api_status)" \
  python3 - <<'PY' >&2
import json
import os

ctx = json.loads(os.environ.get("TOKENBAR_CHAT_CONTEXT") or "{}")
api_status = os.environ.get("TOKENBAR_API_STATUS") or "local analyst"

green = "\033[32m"
cyan = "\033[36m"
amber = "\033[33m"
dim = "\033[2m"
reset = "\033[0m"

api_label = "OpenAI ready" if str(api_status).startswith("OpenAI") else "local analyst"
today = ctx.get("today_compact", "0")
next7 = ctx.get("projected_next7_compact", "0")
last30 = ctx.get("last30_compact", "0")
reset_date = ctx.get("hypothetical_reset_date") or "set reset"
budget = ctx.get("budget_compact") or "set budget"
uncertainty = ctx.get("uncertainty_percent", 0)
watts = ctx.get("mac_power_watts")
power = f" | power {watts}W" if watts else ""

print(f"{green}TokenBar Chat{reset}  {cyan}.--. (o ^){reset}  {dim}{api_label}{reset}")
print(f"today {green}{today}{reset} | 7d {next7} | 30d {last30} | reset {reset_date} | budget {amber}{budget}{reset}{power}")
print(f"{dim}Ask naturally: will I run out? | why spike? | show folders | set daily limit 100M | heat? | +/-{uncertainty}%{reset}")
PY
}

prompt_agent_animation() {
  terminal_movie "" "prompt"
}

read_agent_input() {
  local cyan=$'\033[36m'
  local reset=$'\033[0m'
  printf '%sTokenBar >%s ' "$cyan" "$reset" >&2
  IFS= read -r REPLY
  local status=$?
  if [[ ! -t 0 ]]; then
    printf '\n' >&2
  fi
  printf '%s\n' "$REPLY"
  return "$status"
}

agent_interface() {
  local app_path="$1"
  local cyan=$'\033[36m'
  local green=$'\033[32m'
  local dim=$'\033[2m'
  local reset=$'\033[0m'
  local input status

  prompt_agent_animation
  agent_editor_header
  while true; do
    if ! input="$(read_agent_input)"; then
      break
    fi
    set +e
    answer_agent_prompt "$app_path" "$input"
    status=$?
    set -e
    if [[ "$status" == "10" ]]; then
      break
    fi
  done
}

builder_signal_save() {
  TOKENBAR_SIGNAL_STORE="${TOKENBAR_SIGNAL_STORE:-$support_dir/builder-signal-inbox.json}" python3 - "$@" <<'PY'
import hashlib
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import urlparse

args = sys.argv[1:]
if not args or args[0] in {"-h", "--help", "help"}:
    print("Usage: tokenbar save URL [--tag TAG] [--note TEXT] [--title TEXT]")
    print("Saves a builder/social reference locally. Nothing is uploaded.")
    raise SystemExit(0)

url = args[0].strip()
parsed = urlparse(url)
if parsed.scheme not in {"http", "https"} or not parsed.netloc:
    raise SystemExit("tokenbar save expects a full http(s) URL.")

tags = []
note = ""
title = ""
i = 1
while i < len(args):
    arg = args[i]
    if arg in {"--tag", "-t"}:
        i += 1
        if i >= len(args):
            raise SystemExit("--tag requires a value")
        tags.extend(part.strip() for part in args[i].split(",") if part.strip())
    elif arg in {"--note", "-n"}:
        i += 1
        if i >= len(args):
            raise SystemExit("--note requires a value")
        note = args[i].strip()
    elif arg == "--title":
        i += 1
        if i >= len(args):
            raise SystemExit("--title requires a value")
        title = args[i].strip()
    else:
        note = f"{note} {arg}".strip()
    i += 1

store_path = Path(os.environ["TOKENBAR_SIGNAL_STORE"]).expanduser()
store_path.parent.mkdir(parents=True, exist_ok=True)
if store_path.exists():
    try:
        store = json.loads(store_path.read_text(encoding="utf-8"))
    except Exception:
        store = {}
else:
    store = {}
if not isinstance(store, dict):
    store = {}
items = store.get("items")
if not isinstance(items, list):
    items = []

now = datetime.now(timezone.utc).isoformat()
signal_id = "sig_" + hashlib.sha256(url.lower().encode("utf-8")).hexdigest()[:12]
existing = next((item for item in items if item.get("id") == signal_id), None)
if existing:
    existing["lastSeenAt"] = now
    existing["captures"] = int(existing.get("captures") or 1) + 1
    if title:
        existing["title"] = title
    if note:
        existing["note"] = note
    existing_tags = set(existing.get("tags") or [])
    existing_tags.update(tags)
    existing["tags"] = sorted(existing_tags)
    item = existing
    action = "Updated"
else:
    item = {
        "id": signal_id,
        "url": url,
        "host": parsed.netloc.lower(),
        "title": title or parsed.netloc.lower(),
        "note": note,
        "tags": sorted(set(tags)),
        "savedAt": now,
        "lastSeenAt": now,
        "captures": 1,
        "source": "tokenbar-cli",
        "privacy": {
            "networkUploaded": False,
            "rawTranscriptsIncluded": False,
            "sourceCodeIncluded": False,
        },
    }
    items.insert(0, item)
    action = "Saved"

store = {
    "schema": "tokenbar.builder_signal_inbox.v1",
    "updatedAt": now,
    "items": items[:500],
}
store_path.write_text(json.dumps(store, indent=2, sort_keys=True), encoding="utf-8")

print(f"{action} builder signal: {item['title']}")
print(f"  URL: {item['url']}")
print(f"  Host: {item['host']}")
if item.get("tags"):
    print(f"  Tags: {', '.join(item['tags'])}")
if item.get("note"):
    print(f"  Note: {item['note']}")
print("  Privacy: local only; no upload")
print(f"  Store: {store_path}")
print("Next: tokenbar inbox")
PY
}

builder_signal_inbox() {
  TOKENBAR_SIGNAL_STORE="${TOKENBAR_SIGNAL_STORE:-$support_dir/builder-signal-inbox.json}" python3 - "$@" <<'PY'
import json
import os
import sys
from collections import Counter
from pathlib import Path

args = sys.argv[1:]
json_mode = "--json" in args
digest_mode = "digest" in args or "--digest" in args
limit = 12
for i, arg in enumerate(args):
    if arg in {"--limit", "-n"} and i + 1 < len(args):
        try:
            limit = max(1, min(100, int(args[i + 1])))
        except ValueError:
            pass

store_path = Path(os.environ["TOKENBAR_SIGNAL_STORE"]).expanduser()
if not store_path.exists():
    empty = {
        "schema": "tokenbar.builder_signal_inbox.v1",
        "items": [],
        "privacy": {"networkUploaded": False, "rawTranscriptsIncluded": False, "sourceCodeIncluded": False},
    }
    if json_mode:
        print(json.dumps(empty, indent=2, sort_keys=True))
    else:
        print("TokenBar builder signal inbox")
        print("No saved links yet.")
        print("Save one with: tokenbar save https://example.com --tag agent-loop")
    raise SystemExit(0)

store = json.loads(store_path.read_text(encoding="utf-8"))
items = store.get("items") if isinstance(store, dict) else []
if not isinstance(items, list):
    items = []
if json_mode:
    print(json.dumps(store, indent=2, sort_keys=True))
    raise SystemExit(0)

print("TokenBar builder signal inbox")
print(f"Store: {store_path}")
print(f"Saved signals: {len(items)}")
print("Privacy: local only; no upload")
print()

if not items:
    print("No saved links yet.")
    print("Save one with: tokenbar save https://example.com --tag agent-loop")
    raise SystemExit(0)

host_counts = Counter(str(item.get("host") or "unknown") for item in items)
tag_counts = Counter(tag for item in items for tag in (item.get("tags") or []))
if digest_mode:
    print("Digest")
    print("  Top hosts: " + ", ".join(f"{host} ({count})" for host, count in host_counts.most_common(5)))
    if tag_counts:
        print("  Top tags: " + ", ".join(f"{tag} ({count})" for tag, count in tag_counts.most_common(6)))
    print("  Use these as curated builder signals; public sharing still requires explicit proof/profile commands.")
    print()

for index, item in enumerate(items[:limit], start=1):
    title = str(item.get("title") or item.get("host") or "Untitled signal")
    url = str(item.get("url") or "")
    tags = ", ".join(item.get("tags") or [])
    note = str(item.get("note") or "")
    print(f"{index:>2}. {title}")
    print(f"    {url}")
    if tags:
        print(f"    tags: {tags}")
    if note:
        print(f"    note: {note}")
PY
}

threads_report() {
  local state_path="${TOKENBAR_CODEX_STATE_PATH:-$HOME/.codex/state_5.sqlite}"
  local goals_path="${TOKENBAR_CODEX_GOALS_PATH:-$HOME/.codex/goals_1.sqlite}"
  local goal_join=""
  local goal_status="''"
  local sql=""

  if ! command -v sqlite3 >/dev/null 2>&1; then
    printf 'TokenBar Threads needs sqlite3, which is included with macOS.\n' >&2
    return 1
  fi
  if [[ ! -f "$state_path" ]]; then
    printf 'Codex thread state was not found at %s\nOpen Codex once, then run tokenbar threads again.\n' "$state_path" >&2
    return 1
  fi
  if [[ -f "$goals_path" ]]; then
    goal_join="LEFT JOIN goals_db.thread_goals g ON g.thread_id = t.id"
    goal_status="COALESCE(g.status, '')"
    sql="ATTACH DATABASE '$goals_path' AS goals_db;"
  fi

  sql+="
    SELECT
      CASE
        WHEN COALESCE(t.archived, 0) = 1 OR $goal_status = 'complete' THEN 'DONE'
        WHEN $goal_status = 'active' THEN 'ACTIVE'
        WHEN $goal_status IN ('blocked', 'usage_limited', 'budget_limited') THEN 'ATTENTION'
        WHEN $goal_status = 'paused' THEN 'PAUSED'
        WHEN COALESCE(t.recency_at_ms, t.updated_at_ms, t.updated_at * 1000) >= (strftime('%s','now') - 259200) * 1000 THEN 'RECENT'
        ELSE 'PAUSED'
      END,
      datetime(COALESCE(t.recency_at_ms, t.updated_at_ms, t.updated_at * 1000) / 1000, 'unixepoch', 'localtime'),
      COALESCE(t.tokens_used, 0),
      COALESCE(t.cwd, ''),
      substr(replace(replace(t.title, char(10), ' '), char(9), ' '), 1, 78)
    FROM threads t
    $goal_join
    WHERE COALESCE(t.title, '') != ''
    ORDER BY
      CASE
        WHEN $goal_status = 'active' THEN 0
        WHEN $goal_status IN ('blocked', 'usage_limited', 'budget_limited') THEN 1
        WHEN $goal_status = 'paused' THEN 2
        WHEN COALESCE(t.archived, 0) = 0 THEN 3
        ELSE 4
      END,
      COALESCE(t.recency_at_ms, t.updated_at_ms, t.updated_at * 1000) DESC
    LIMIT 30;"

  printf '\nTokenBar Threads\n'
  printf 'Read only: Codex task state + goals. No transcripts, source code, or full paths.\n\n'
  printf '%-11s  %-16s  %12s  %-18s  %s\n' 'LANE' 'UPDATED' 'TOKENS' 'PROJECT' 'THREAD'
  printf '%-11s  %-16s  %12s  %-18s  %s\n' '-----------' '----------------' '------------' '------------------' '------'
  sqlite3 -noheader -separator $'\t' "$state_path" "$sql" | while IFS=$'\t' read -r lane updated tokens cwd title; do
    local project="${cwd%/}"
    local path_prefix=""
    project="${project##*/}"
    [[ -n "$project" ]] || project="No project"
    for path_prefix in /Users/ /home/ /private/ /var/ /tmp/ /Volumes/; do
      if [[ "$title" == *"$path_prefix"* ]]; then
        title="${title%%"$path_prefix"*}[local path]"
      fi
    done
    printf '%-11s  %-16s  %12s  %-18.18s  %s\n' "$lane" "${updated:0:16}" "$tokens" "$project" "$title"
  done
  cat <<'EOF'

Lanes: ACTIVE is being pursued; ATTENTION is blocked or usage-limited; PAUSED is backlog; RECENT has no goal yet; DONE is complete or archived.
Web board: python3 scripts/tokenbar_local_server.py --port 8768
Then open: http://127.0.0.1:8768/threads
EOF
}

identity_api() {
  local script_dir api_script
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  api_script=""
  for candidate in \
    "$script_dir/identity_api.py" \
    "$script_dir/../src/tokenbar/identity_api.py"; do
    if [[ -f "$candidate" ]]; then
      api_script="$candidate"
      break
    fi
  done
  if [[ -z "$api_script" ]]; then
    echo "TokenBar identity API module is missing. Reinstall or update TokenBar." >&2
    return 1
  fi
  python3 "$api_script" "$@"
}

identity_mcp() {
  local script_dir mcp_script
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  mcp_script=""
  for candidate in \
    "$script_dir/identity_mcp.py" \
    "$script_dir/../src/tokenbar/identity_mcp.py"; do
    if [[ -f "$candidate" ]]; then
      mcp_script="$candidate"
      break
    fi
  done
  if [[ -z "$mcp_script" ]]; then
    echo "TokenBar identity MCP module is missing. Reinstall or update TokenBar." >&2
    return 1
  fi
  python3 "$mcp_script" "$@"
}

quiet=false
animate=true
force_animation=false
agent=true
sound_enabled=false
command="open"
command_args=()

if [[ "${TOKENBAR_SOUND:-0}" == "1" || "${TOKENBAR_SOUND:-}" == "true" ]]; then
  sound_enabled=true
fi

if [[ $# -gt 0 && "$1" != --* && "$1" != -* ]]; then
  command="$1"
  shift
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help|help)
      if [[ "$command" == "open" ]]; then
        usage
        exit 0
      fi
      command_args+=("$1")
      ;;
    -v|--version)
      command="version"
      ;;
    --install)
      command="install"
      ;;
    --path)
      command="path"
      ;;
    --quiet|-q)
      quiet=true
      animate=false
      agent=false
      ;;
    --no-animation|--plain)
      animate=false
      ;;
    --movie)
      force_animation=true
      ;;
    --sound)
      sound_enabled=true
      ;;
    --no-agent)
      agent=false
      ;;
    --model)
      shift
      if [[ $# -eq 0 ]]; then
        echo "--model requires a value" >&2
        exit 2
      fi
      agent_model="$1"
      ;;
    --budget)
      shift
      if [[ $# -eq 0 ]]; then
        echo "--budget requires a value" >&2
        exit 2
      fi
      agent_budget_tokens="$1"
      ;;
    --price)
      shift
      if [[ $# -eq 0 ]]; then
        echo "--price requires a value" >&2
        exit 2
      fi
      agent_price_per_million="$1"
      ;;
    --activity)
      set_control_value activitySignalsEnabled true
      ;;
    *)
      if [[ "$command" == "open" && ${#command_args[@]} -eq 0 && "$1" != -* ]]; then
        command="$1"
      else
        command_args+=("$1")
      fi
      ;;
  esac
  shift
done

case "$command" in
  version)
    printf 'tokenbar %s\n' "$tokenbar_version"
    ;;
  help|\?|chat-help)
    usage
    ;;
  install|update)
    install_tokenbar
    ;;
  path)
    find_app
    ;;
  status)
    status_report
    ;;
  usage|summary|usage-summary)
    usage_report "${command_args[@]}"
    ;;
  cost-passport|costs-passport|costs|spend-passport|billing-passport)
    cost_passport_command "${command_args[@]}"
    ;;
  waste|waste-lens|run-saver|saver|token-saver)
    waste_lens_report "${command_args[0]:-}"
    ;;
  comparison-lens|compare-lens|benchmark|benchmarks|cohort)
    comparison_lens_command "${command_args[0]:-}"
    ;;
  proof-packet|launch-proof|proofpack|demo-proof)
    proof_packet_command "${command_args[0]:-}"
    ;;
  reminders|reminder|nudges|alerts)
    reminders_command "${command_args[@]}"
    ;;
  memory-pressure|memory|pressure|overload|cleanup-plan)
    memory_pressure_command "${command_args[0]:-}"
    ;;
  threads|tasks|kanban|workboard)
    threads_report
    ;;
  api|identity-api|local-api|serve-api)
    identity_api "${command_args[@]}"
    ;;
  mcp|identity-mcp|codex-mcp)
    identity_mcp "${command_args[@]}"
    ;;
  forecast)
    forecast_report
    ;;
  controls|control|budget|timing|hours)
    controls_report
    ;;
  guardrails|guardrail|limits|limit|budgets)
    guardrail_command "${command_args[0]:-}" "${command_args[1]:-}"
    ;;
  power|heat|energy)
    power_report
    ;;
  playbooks|playbook|prompts|prompt-templates|templates)
    if [[ ${#command_args[@]} -gt 0 ]]; then
      playbooks_command "${command_args[@]}"
    else
      playbooks_command
    fi
    ;;
  folders|folder|projects|project|workspaces|workspace)
    folder_report
    ;;
  identity|who-am-i|builder-identity)
    profile_report --pdf "${command_args[@]}"
    ;;
  profile|builder-profile|report|analyze|analyse)
    case "${command_args[0]:-}" in
      latest|--latest|TBAR-*) open_proof_surface profile "${command_args[@]}" ;;
      *) profile_report "${command_args[@]}" ;;
    esac
    ;;
  quickstart|identity-quickstart|profile-quickstart|start)
    identity_quickstart
    ;;
  coach|guide|next-action|next)
    coach_command "${command_args[0]:-}"
    ;;
  launch-kit|launchkit|product-hunt|producthunt|macapp|macapp-supply)
    launch_kit_command "${command_args[0]:-}"
    ;;
  ecosystem|system-map|product-system|surfaces)
    ecosystem_command "${command_args[0]:-}"
    ;;
  runway|launch-runway|launch-day|launch-board)
    runway_command "${command_args[0]:-}"
    ;;
  browser-companion|companion|extension|browser-extension)
    browser_companion_command "${command_args[0]:-}"
    ;;
  video|demo-video|shot-list|hyperframes|hyperframe|trailer|identity-trailer)
    video_brief "${command_args[0]:-}"
    ;;
  readiness|ready|identity-ready|profile-ready|launch-ready)
    identity_readiness
    ;;
  prove|claim-proof|get-token)
    claim_profile --publish-proof "${command_args[@]}"
    ;;
  submit|submit-repo|hackathon|join|join-hackathon)
    submit_profile "${command_args[@]}"
    ;;
  proof-latest|latest-proof|proof-status)
    proof_latest "${command_args[@]}"
    ;;
  revoke|unpublish|withdraw-proof)
    revoke_proof "${command_args[@]}"
    ;;
  claim|builder-token|profile-token)
    claim_profile "${command_args[@]}"
    ;;
  share|upload-profile|publish-profile)
    case "${command_args[0]:-}" in
      latest|status|receipt)
        proof_latest "${command_args[@]:1}"
        ;;
      latest-public|public)
        proof_latest --public "${command_args[@]:1}"
        ;;
      *)
        share_profile "${command_args[0]:-}"
        ;;
    esac
    ;;
  publish-proof|activate|activate-profile|proof-share|proof-card)
    if [[ ${#command_args[@]} -gt 0 ]]; then
      builder_identity_action "${command_args[@]}"
    else
      builder_identity_action latest
    fi
    ;;
  action|act|builder-action|proof-action)
    if [[ ${#command_args[@]} -gt 0 ]]; then
      builder_identity_action "${command_args[@]}"
    else
      builder_identity_action latest
    fi
    ;;
  publish|publish-profile-now)
    publish_profile "${command_args[@]}"
    ;;
  card|identity-card|profile-card|whoami)
    identity_card "${command_args[0]:-}"
    ;;
  skill|skill-md|identity-skill|profile-skill)
    identity_skill "${command_args[@]}"
    ;;
  compare|compare-profile|diff-profile|profile-diff)
    compare_identity_profiles "${command_args[0]:-}" "${command_args[1]:-}"
    ;;
  history|profile-history|identity-history|reports)
    identity_history "${command_args[0]:-8}"
    ;;
  rankings|ranking|local-rankings|identity-rankings|profile-rankings)
    case "${command_args[0]:-}" in
      latest|--latest|TBAR-*) open_proof_surface rankings "${command_args[@]}" ;;
      *) identity_rankings "${command_args[0]:-25}" ;;
    esac
    ;;
  timeline|profile-timeline|identity-timeline)
    identity_timeline "${command_args[@]}"
    ;;
  verify|verify-profile|audit-profile|privacy-check)
    verify_identity_artifact "${command_args[0]:-}"
    ;;
  bundle|profile-bundle|export-profile)
    profile_bundle "${command_args[@]}"
    ;;
  proof|proof-packet|portfolio|portfolio-packet|identity-packet)
    case "${command_args[0]:-}" in
      latest|status|receipt)
        proof_latest "${command_args[@]:1}"
        ;;
      *)
        identity_proof_packet "${command_args[@]}"
        ;;
    esac
    ;;
  stats|profile-stats|identity-stats)
    profile_stats
    ;;
  social|profiles|network|leaderboard)
    if [[ ${#command_args[@]} -gt 0 ]]; then
      open_proof_surface social "${command_args[@]}"
    else
      open_social_layer
    fi
    ;;
  open-proof|proof-open|open-surface)
    if [[ "${command_args[0]:-}" == "--help" || "${command_args[0]:-}" == "-h" ]]; then
      open_proof_surface profile --help
    else
      proof_surface="${command_args[0]:-profile}"
      open_proof_surface "$proof_surface" "${command_args[@]:1}"
    fi
    ;;
  save|bookmark|capture|signal)
    builder_signal_save "${command_args[@]}"
    ;;
  inbox|signals|link-vault|vault)
    builder_signal_inbox "${command_args[@]}"
    ;;
  hosted-doctor|profile-doctor|share-doctor)
    hosted_doctor
    ;;
  tracking|track|logs)
    tracking_command "${command_args[0]:-status}"
    ;;
  activity|activity-signals)
    activity_command "${command_args[0]:-status}"
    ;;
  ask)
    if [[ ${#command_args[@]} -gt 0 ]]; then
      agent_answer "${command_args[*]}"
    else
      app_path="$(find_app || true)"
      agent_interface "$app_path"
    fi
    ;;
  doctor|diagnose|diagnostic)
    doctor_report
    ;;
  providers|provider)
    provider_report "${command_args[0]:-}"
    ;;
  connectors|connector|sources|source)
    connector_report
    ;;
  explain)
    explain_topic "${command_args[0]:-overview}"
    ;;
  site|website)
    open_site
    ;;
  skills|repo|github)
    open_skills_repo
    ;;
  copy-install|copy)
    copy_install_command
    ;;
  prompt|agent)
    app_path="$(find_app || true)"
    agent_interface "$app_path"
    ;;
  open|launch)
    if app_path="$(find_app)"; then
      open "$app_path"
      if [[ "$quiet" == true ]]; then
        exit 0
      elif [[ "$agent" == true ]] && supports_agent_interface; then
        agent_interface "$app_path"
      elif [[ "$animate" == true && "$force_animation" == true ]]; then
        animated_open_message "$app_path"
      elif [[ "$animate" == true ]] && supports_animation; then
        animated_open_message "$app_path"
      else
        plain_open_message "$app_path"
      fi
    else
      cat >&2 <<EOF
TokenBar CLI is installed, but the macOS menu-bar app is not installed yet.

Install the app with:
  tokenbar install

One-line CLI + app installer:
  $install_command

Manual app download:
  $download_url
EOF
      exit 1
    fi
    ;;
  *)
    natural_input="$command ${command_args[*]:-}"
    if natural_limit_command "$natural_input"; then
      exit 0
    fi
    agent_answer "$natural_input"
    ;;
esac
