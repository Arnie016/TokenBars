if html_mode:
    trailers_dir = support_dir / "trailers"
    trailers_dir.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    output_path = trailers_dir / f"tokenbar-identity-trailer-{stamp}.html"
    output_path.write_text(render_storyboard_html(payload), encoding="utf-8")
    print(f"TokenBar identity trailer storyboard: {output_path}")
    print("Privacy: raw transcripts false, source code false, credentials false, private diffs false.")
    print("Next: open the HTML locally, then hand `tokenbar trailer --json` to HyperFrames/Director Bay/Remotion for MP4 rendering.")
    raise SystemExit(0)

if json_mode:
    print(json.dumps(payload, indent=2, sort_keys=True))
    raise SystemExit(0)

