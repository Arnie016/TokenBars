find_app() {
  local candidate
  for candidate in "${APP_CANDIDATES[@]}"; do
    if [[ -n "$candidate" && -d "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

running_pid() {
  pgrep -f "TokenBar.app/Contents/MacOS/CodexLimitBar|CodexLimitBar.app/Contents/MacOS/CodexLimitBar" | head -n 1 || true
}

install_tokenbar() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    cat >&2 <<'EOF'
TokenBar's menu-bar app is macOS-only.
The CLI can still inspect exported/local usage files on other systems when available.
EOF
    return 1
  fi

  local install_dir app_path tmp_dir source_app
  install_dir="$HOME/Applications"
  app_path="$install_dir/TokenBar.app"
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/tokenbar-install.XXXXXX")"

  trap 'rm -rf "$tmp_dir"; trap - RETURN' RETURN

  printf 'Downloading TokenBar menu-bar app...\n'
  curl -fL "$download_url" -o "$tmp_dir/TokenBar.zip"

  printf 'Unpacking TokenBar...\n'
  ditto -x -k "$tmp_dir/TokenBar.zip" "$tmp_dir/unpacked"

  source_app="$(find "$tmp_dir/unpacked" -maxdepth 2 -name '*.app' -type d | head -n 1)"
  if [[ -z "$source_app" ]]; then
    echo "Could not find a .app bundle in the downloaded zip." >&2
    return 1
  fi

  mkdir -p "$install_dir"
  rm -rf "$app_path"
  ditto "$source_app" "$app_path"

  printf 'Installed TokenBar app:\n  %s\n\n' "$app_path"
  printf 'Open it with:\n  tokenbar\n'
}

supports_animation() {
  [[ -t 1 && "${TERM:-dumb}" != "dumb" && -z "${NO_COLOR:-}" ]]
}

supports_agent_interface() {
  [[ -t 0 && -t 1 ]]
}

looks_like_session_id() {
  local value="${1:-}"
  [[ "$value" =~ ^[0-9a-fA-F]{8,}-[0-9a-fA-F-]{8,}$ || "$value" =~ ^[0-9a-fA-F]{24,}$ || "$value" =~ ^run_[0-9a-fA-F]{8,}$ ]]
}

copy_install_command() {
  if command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$install_command" | pbcopy
    printf 'Copied install command:\n  %s\n' "$install_command"
  else
    printf 'pbcopy is unavailable. Install command:\n  %s\n' "$install_command"
  fi
}

open_site() {
  local script_dir local_site
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local candidates=(
    "${TOKENBAR_SITE_PATH:-}"
    "$PWD/docs/index.html"
    "$script_dir/../docs/index.html"
  )

  for local_site in "${candidates[@]}"; do
    if [[ -n "$local_site" && -f "$local_site" ]]; then
      open "$local_site"
      printf 'Opened local TokenBar site: %s\n' "$local_site"
      return 0
    fi
  done

  open "$site_url"
  printf 'Opened TokenBar site: %s\n' "$site_url"
}

open_skills_repo() {
  open "$skills_url"
  printf 'Opened Codex Goated Skills: %s\n' "$skills_url"
}

set_control_value() {
  local key="$1"
  local value="$2"
  mkdir -p "$support_dir"
  TOKENBAR_CONTROL_PATH="$control_file" TOKENBAR_CONTROL_KEY="$key" TOKENBAR_CONTROL_VALUE="$value" python3 - <<'PY'
import hashlib
import json
import os

path = os.environ["TOKENBAR_CONTROL_PATH"]
key = os.environ["TOKENBAR_CONTROL_KEY"]
raw = os.environ["TOKENBAR_CONTROL_VALUE"]

try:
    with open(path, "r", encoding="utf-8") as handle:
        data = json.load(handle)
except Exception:
    data = {}

if raw.lower() in ("true", "false"):
    value = raw.lower() == "true"
elif raw.lower() in ("none", "null", "off"):
    value = None
else:
    value = raw

data[key] = value
with open(path, "w", encoding="utf-8") as handle:
    json.dump(data, handle, indent=2, sort_keys=True)
    handle.write("\n")
PY
}

delete_usage_index() {
  rm -f "$usage_index"
}

tracking_is_paused() {
  command -v python3 >/dev/null 2>&1 || return 1
  [[ "$(TOKENBAR_CONTROL_PATH="$control_file" python3 - <<'PY'
import json
import os

path = os.environ["TOKENBAR_CONTROL_PATH"]
try:
    with open(path, "r", encoding="utf-8") as handle:
        data = json.load(handle)
except Exception:
    data = {}
print("false" if data.get("logTrackingEnabled", True) is False else "true")
PY
)" == "false" ]]
}

usage_summary() {
  if [[ ! -f "$usage_index" ]]; then
    if tracking_is_paused; then
      cat <<EOF
Usage index: missing
Tracking: paused (new local log indexing is off)
Path: $usage_index
Existing profile files may still be readable with tokenbar history.
Resume new local indexing: tokenbar tracking on
EOF
    else
      cat <<EOF
Usage index: not found
Tracking: on (waiting for the app to write the first local index)
Path: $usage_index
EOF
    fi
    return 0
  fi

  if ! command -v python3 >/dev/null 2>&1; then
cat <<EOF
Usage index: found
Path: $usage_index
Python 3 is unavailable, so token totals were not decoded.
EOF
    return 0
  fi

  INDEX_PATH="$usage_index" TOKENBAR_TRACKING_PAUSED="$(tracking_is_paused && printf true || printf false)" python3 - <<'PY'
import json
import os
import re
import sqlite3
import time
from collections import Counter
from datetime import datetime, timedelta
from pathlib import Path

path = os.environ["INDEX_PATH"]
tracking_paused = os.environ.get("TOKENBAR_TRACKING_PAUSED") == "true"
try:
    with open(path, "r", encoding="utf-8") as handle:
        data = json.load(handle)
except Exception as exc:
    print(f"Usage index: unreadable ({exc})")
    print(f"Path: {path}")
    raise SystemExit(0)

day_tokens = data.get("dayTokens") or {}
model_tokens = data.get("modelTokens") or {}
today_key = datetime.now().strftime("%Y-%m-%d")
today = int(day_tokens.get(today_key, 0) or 0)
last30 = sum(int(value or 0) for value in day_tokens.values())
active_days = sum(1 for value in day_tokens.values() if int(value or 0) > 0)
sessions = len(data.get("sessionPaths") or [])
updated = data.get("updatedAt") or 0
updated_text = time.strftime("%Y-%m-%d %H:%M", time.localtime(updated)) if updated else "unknown"
top_model = max(model_tokens.items(), key=lambda item: item[1])[0] if model_tokens else "unknown"

def compact(value):
    value = int(max(0, value))
    if value >= 1_000_000_000:
        return f"{value / 1_000_000_000:.2f}B".replace(".00B", "B")
    if value >= 1_000_000:
        return f"{value / 1_000_000:.1f}M".replace(".0M", "M")
    if value >= 1_000:
        return f"{value / 1_000:.1f}K".replace(".0K", "K")
    return str(value)

print("Usage index: ready")
print("Tracking: paused (new local log indexing is off; historical usage is still readable)" if tracking_paused else "Tracking: on")
print(f"Today: {compact(today)}")
print(f"Last 30d: {compact(last30)}")
print(f"Active days: {active_days}/30")
print(f"Sessions indexed: {sessions}")
print(f"Top local model: {top_model}")
print(f"Updated: {updated_text}")
if tracking_paused:
    print("Resume new local indexing: tokenbar tracking on")
if last30 >= 1_000_000_000:
    print(f"Read: {compact(last30)} tokens in the local 30-day trace. TokenBar treats this as evidence to inspect, not a score to worship.")
PY
}

usage_context_json() {
  INDEX_PATH="$usage_index" \
  TOKENBAR_CONTROL_PATH="$control_file" \
  TOKENBAR_BUDGET_TOKENS="$agent_budget_tokens" \
  TOKENBAR_PRICE_PER_MILLION="$agent_price_per_million" \
  python3 - <<'PY'
import json
import os
import re
import sqlite3
import time
from collections import Counter
from datetime import datetime, timedelta
from pathlib import Path

path = os.environ["INDEX_PATH"]
control_path = os.environ.get("TOKENBAR_CONTROL_PATH") or ""
budget_raw = os.environ.get("TOKENBAR_BUDGET_TOKENS") or ""
price_raw = os.environ.get("TOKENBAR_PRICE_PER_MILLION") or ""

def compact(value):
    value = int(max(0, value))
    if value >= 1_000_000_000:
        return f"{value / 1_000_000_000:.2f}B".replace(".00B", "B")
    if value >= 1_000_000:
        return f"{value / 1_000_000:.1f}M".replace(".0M", "M")
    if value >= 1_000:
        return f"{value / 1_000:.1f}K".replace(".0K", "K")
    return str(value)

def parse_tokens(text):
    if not text:
        return None
    raw = str(text).strip().upper().replace(",", "")
    multiplier = 1
    if raw.endswith("B"):
        multiplier = 1_000_000_000
        raw = raw[:-1]
    elif raw.endswith("M"):
        multiplier = 1_000_000
        raw = raw[:-1]
    elif raw.endswith("K"):
        multiplier = 1_000
        raw = raw[:-1]
    try:
        return int(float(raw) * multiplier)
    except ValueError:
        return None

def parse_money(text):
    if text in (None, ""):
        return None
    try:
        return float(str(text).strip().replace("$", "").replace(",", ""))
    except ValueError:
        return None

def signed_64(value):
    value = int(value)
    if value >= 2 ** 63:
        value -= 2 ** 64
    return value

def mac_power_sample():
    import re
    import subprocess
    try:
        output = subprocess.check_output(
            ["/usr/sbin/ioreg", "-r", "-n", "AppleSmartBattery", "-d", "1"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=2,
        )
    except Exception:
        return {}

    def number(key):
        match = re.search(rf'"{re.escape(key)}" = (-?\d+)', output)
        if not match:
            return None
        return signed_64(match.group(1))

    voltage = number("Voltage") or number("AppleRawBatteryVoltage")
    current = number("InstantAmperage") or number("Amperage")
    temperature = number("Temperature")
    external = '"ExternalConnected" = Yes' in output or '"AppleRawExternalConnected" = Yes' in output
    watts = None
    if voltage and current:
        watts = abs(voltage / 1000 * current / 1000)
    return {
        "mac_power_watts": round(watts, 2) if watts else None,
        "battery_celsius": round(temperature / 100, 1) if temperature else None,
        "power_source": "adapter/battery sample" if external else "battery discharge sample",
    }

def redact_session_text(text):
    text = re.sub(r"[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}", "[email]", str(text or ""))
    text = re.sub(r"https?://\S+", "[url]", text)
    text = re.sub(r"(?<!\w)(?:sk|pk|rk|whsec)_[A-Za-z0-9_=-]{12,}", "[secret]", text)
    text = re.sub(r"(?<!\w)[A-Fa-f0-9]{32,}(?!\w)", "[secret]", text)
    text = re.sub(r"/Users/[^\s,;:)]+", "[path]", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text

def message_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for item in content:
            if isinstance(item, dict):
                value = item.get("text") or item.get("content")
                if isinstance(value, str):
                    parts.append(value)
        return "\n".join(parts)
    if isinstance(content, dict):
        value = content.get("text") or content.get("content")
        if isinstance(value, str):
            return value
    return ""

def behavior_patterns_from_signals(summary):
    prompt_count = int(summary.get("promptCount") or 0)
    if prompt_count <= 0:
        return []

    def pct(key):
        return float(summary.get(key) or 0) * 100

    avg_words = float(summary.get("avgPromptWords") or 0)
    patterns = []

    def add(name, score, evidence, coaching):
        patterns.append({
            "name": name,
            "score": round(max(0, min(100, score)), 1),
            "evidence": evidence,
            "coaching": coaching,
        })

    add(
        "Command compression",
        pct("commandPromptRatio") * 0.72 + max(0, 30 - avg_words) * 0.9,
        f"{pct('commandPromptRatio'):.1f}% command-style prompts; {avg_words:.1f} average words.",
        "You get leverage from short imperatives. Add acceptance criteria when the task is ambiguous.",
    )
    add(
        "Course correction",
        pct("redirectionSignal") * 1.8 + pct("questionPromptRatio") * 0.18,
        f"{pct('redirectionSignal'):.1f}% redirection/correction signal.",
        "You actively steer. Preserve the latest decision and stop condition so corrections compound.",
    )
    add(
        "Planning before execution",
        pct("planningSignal") * 1.65 + min(35, avg_words) * 0.35,
        f"{pct('planningSignal'):.1f}% planning language; {avg_words:.1f} average words.",
        "You create structure before action. Keep the plan small enough to verify in one run.",
    )
    add(
        "Visual proof bias",
        pct("visualSignal") * 1.55 + pct("identitySignal") * 0.22,
        f"{pct('visualSignal'):.1f}% UI/report/brand language.",
        "You care whether work can be inspected. Attach screenshot/PDF proof to major changes.",
    )
    add(
        "Monetization coupling",
        pct("monetizationSignal") * 1.75 + pct("urgencySignal") * 0.15,
        f"{pct('monetizationSignal'):.1f}% pricing/payment/trial language.",
        "You connect build work to revenue. Keep buyer promise, entitlement, and support path together.",
    )
    add(
        "Local-first boundary keeping",
        pct("privacySignal") * 1.55 + pct("identitySignal") * 0.30,
        f"{pct('privacySignal'):.1f}% privacy/local/upload language.",
        "You treat trust as infrastructure. Make every export say what stayed local and what can be shared.",
    )
    add(
        "Identity packaging",
        pct("identitySignal") * 1.75 + pct("visualSignal") * 0.20,
        f"{pct('identitySignal'):.1f}% profile/archetype/report language.",
        "You package workflow into portable identity. Keep Skill.md, PDF, and share link mutually consistent.",
    )

    patterns.sort(key=lambda item: item["score"], reverse=True)
    return patterns[:5]

def operating_mode_from_patterns(patterns):
    if not patterns:
        return "insufficient local signal"
    top = patterns[0]["name"]
    second = patterns[1]["name"] if len(patterns) > 1 else ""
    if top == "Command compression" and second == "Course correction":
        return "compressed steering loop"
    if top == "Visual proof bias":
        return "proof-first product loop"
    if top == "Planning before execution":
        return "structured planning loop"
    if top == "Monetization coupling":
        return "revenue-connected build loop"
    if top == "Local-first boundary keeping":
        return "privacy-bounded analysis loop"
    if top == "Identity packaging":
        return "portfolio identity loop"
    return top.lower()

def codex_session_analysis():
    root = Path.home() / ".codex" / "sessions"
    if not root.exists():
        return {
            "available": False,
            "source": "~/.codex/sessions",
            "reason": "no local Codex session directory",
            "rawTranscriptsIncluded": False,
        }
    try:
        files = sorted(
            [path for path in root.rglob("*.jsonl") if path.is_file()],
            key=lambda item: item.stat().st_mtime,
            reverse=True,
        )[:80]
    except Exception:
        files = []

    prompts = []
    tool_calls = 0
    assistant_messages = 0
    workspaces = Counter()
    ignored_prefixes = (
        "# AGENTS.md instructions",
        "# Files mentioned by the user:",
        "# Applications mentioned by the user:",
        "<appshot",
        "<image ",
    )

    for session_path in files:
        try:
            workspace = ""
            with session_path.open("r", encoding="utf-8", errors="replace") as handle:
                bytes_seen = 0
                for line_number, line in enumerate(handle):
                    if line_number >= 500:
                        break
                    bytes_seen += len(line.encode("utf-8", errors="ignore"))
                    if bytes_seen > 2_000_000:
                        break
                    try:
                        record = json.loads(line)
                    except Exception:
                        continue
                    payload = record.get("payload") if isinstance(record, dict) else {}
                    if not isinstance(payload, dict):
                        continue
                    if record.get("type") == "turn_context":
                        workspace = str(payload.get("cwd") or "")
                        if workspace:
                            workspaces[os.path.basename(workspace.rstrip("/")) or workspace] += 1
                        continue
                    if record.get("type") != "response_item":
                        continue
                    role = payload.get("role")
                    item_type = payload.get("type")
                    if item_type in {"function_call", "web_search_call", "mcp_tool_call"}:
                        tool_calls += 1
                        continue
                    if role == "assistant":
                        assistant_messages += 1
                        continue
                    if role != "user":
                        continue
                    text = message_text(payload.get("content"))
                    if not text:
                        continue
                    text = text.strip()
                    if "## My request for Codex:" in text:
                        text = text.split("## My request for Codex:", 1)[1].strip()
                    elif "# My request for Codex:" in text:
                        text = text.split("# My request for Codex:", 1)[1].strip()
                    if any(text.startswith(prefix) for prefix in ignored_prefixes):
                        continue
                    if len(text) > 2200 and ("<appshot" in text or "AGENTS.md" in text):
                        continue
                    redacted = redact_session_text(text)
                    if redacted:
                        prompts.append(redacted)
        except Exception:
            continue

    prompt_count = len(prompts)
    words = [re.findall(r"[A-Za-z0-9_']+", prompt) for prompt in prompts]
    word_counts = [len(item) for item in words if item]
    capped_word_counts = [min(count, 120) for count in word_counts]
    total_words = sum(capped_word_counts)

    def ratio_for(terms):
        if not prompt_count:
            return 0
        pattern = re.compile("|".join(re.escape(term) for term in terms), re.I)
        hits = sum(1 for prompt in prompts if pattern.search(prompt))
        return round(hits / prompt_count, 3)

    command_like = 0
    question_like = 0
    gratitude_count = 0
    please_count = 0
    apology_count = 0
    caps_prompt_count = 0
    typo_markers = 0
    for prompt, count in zip(prompts, capped_word_counts):
        lower = prompt.lower()
        if count <= 12 or lower.startswith(("do ", "make ", "add ", "fix ", "run ", "ship ", "create ", "set ", "wire ")):
            command_like += 1
        if "?" in prompt or lower.startswith(("can ", "could ", "what ", "how ", "why ", "where ", "is ")):
            question_like += 1
        gratitude_count += len(re.findall(r"\b(thank you|thanks|tysm|ty)\b", lower))
        please_count += len(re.findall(r"\b(please|pls|plz)\b", lower))
        apology_count += len(re.findall(r"\b(sorry|my bad|apologize)\b", lower))
        letters = re.sub(r"[^A-Za-z]", "", prompt)
        if len(letters) >= 16 and letters.upper() == letters:
            caps_prompt_count += 1
        typo_markers += len(re.findall(r"\b(teh|wrok|jsut|u|ur|pls|thx|dont|cant)\b", lower))

    phrase_scores = []
    seen = set()
    for prompt, count in zip(prompts, word_counts):
        if count < 3 or count > 34:
            continue
        phrase = prompt[:120].strip()
        key = phrase.lower()
        if key in seen:
            continue
        seen.add(key)
        distinctiveness = count + min(24, len(set(re.findall(r"[A-Za-z]{4,}", phrase.lower()))))
        if any(term in key for term in ("make", "ship", "stripe", "pdf", "profile", "analyze", "identity", "launch", "webhook", "local")):
            distinctiveness += 10
        phrase_scores.append((distinctiveness, phrase))
    phrase_scores.sort(reverse=True)

    summary = {
        "available": True,
        "source": "~/.codex/sessions",
        "sampledFiles": len(files),
        "promptCount": prompt_count,
        "assistantMessageCount": assistant_messages,
        "toolCallCount": tool_calls,
        "avgPromptWords": round(total_words / max(1, prompt_count), 1),
        "longestPromptWords": max(word_counts or [0]),
        "tinyPromptCount": sum(1 for count in word_counts if count <= 5),
        "questionPromptCount": question_like,
        "gratitudeCount": gratitude_count,
        "pleaseCount": please_count,
        "apologyCount": apology_count,
        "capsPromptCount": caps_prompt_count,
        "typoMarkerCount": typo_markers,
        "shortPromptRatio": round(sum(1 for count in word_counts if count <= 10) / max(1, prompt_count), 3),
        "commandPromptRatio": round(command_like / max(1, prompt_count), 3),
        "questionPromptRatio": round(question_like / max(1, prompt_count), 3),
        "planningSignal": ratio_for(["plan", "architecture", "strategy", "roadmap", "sequence", "design first"]),
        "redirectionSignal": ratio_for(["not that", "wrong", "instead", "stop", "revert", "don't", "dont", "actually"]),
        "urgencySignal": ratio_for(["now", "asap", "quick", "immediately", "done", "ship", "launch", "ruthlessly"]),
        "visualSignal": ratio_for(["ui", "design", "page", "landing", "pdf", "image", "brand", "animation", "screenshot"]),
        "monetizationSignal": ratio_for(["stripe", "payment", "pricing", "checkout", "subscription", "trial", "billing"]),
        "privacySignal": ratio_for(["local", "private", "privacy", "upload", "source code", "transcript", "leak", "control"]),
        "identitySignal": ratio_for(["identity", "profile", "archetype", "persona", "report", "skill.md", "proof layer"]),
        "topWorkspaces": [{"name": name, "sessions": count} for name, count in workspaces.most_common(5)],
        "signaturePhrases": [phrase for _, phrase in phrase_scores[:6]],
        "rawTranscriptsIncluded": False,
        "redactedExcerptsOnly": True,
    }
    summary["behaviorPatterns"] = behavior_patterns_from_signals(summary)
    summary["operatingMode"] = operating_mode_from_patterns(summary["behaviorPatterns"])
    return summary

def summarize_prompt_signals(prompts, source, sampled_files=0, extra=None):
    prompt_count = len(prompts)
    words = [re.findall(r"[A-Za-z0-9_']+", prompt) for prompt in prompts]
    word_counts = [len(item) for item in words if item]
    capped_word_counts = [min(count, 120) for count in word_counts]
    total_words = sum(capped_word_counts)

    def ratio_for(terms):
        if not prompt_count:
            return 0
        pattern = re.compile("|".join(re.escape(term) for term in terms), re.I)
        hits = sum(1 for prompt in prompts if pattern.search(prompt))
        return round(hits / prompt_count, 3)

    command_like = 0
    question_like = 0
    gratitude_count = 0
    please_count = 0
    apology_count = 0
    caps_prompt_count = 0
    typo_markers = 0
    for prompt, count in zip(prompts, capped_word_counts):
        lower = prompt.lower()
        if count <= 12 or lower.startswith(("do ", "make ", "add ", "fix ", "run ", "ship ", "create ", "set ", "wire ")):
            command_like += 1
        if "?" in prompt or lower.startswith(("can ", "could ", "what ", "how ", "why ", "where ", "is ")):
            question_like += 1
        gratitude_count += len(re.findall(r"\b(thank you|thanks|tysm|ty)\b", lower))
        please_count += len(re.findall(r"\b(please|pls|plz)\b", lower))
        apology_count += len(re.findall(r"\b(sorry|my bad|apologize)\b", lower))
        letters = re.sub(r"[^A-Za-z]", "", prompt)
        if len(letters) >= 16 and letters.upper() == letters:
            caps_prompt_count += 1
        typo_markers += len(re.findall(r"\b(teh|wrok|jsut|u|ur|pls|thx|dont|cant)\b", lower))

    phrase_scores = []
    seen = set()
    for prompt, count in zip(prompts, word_counts):
        if count < 3 or count > 34:
            continue
        phrase = prompt[:120].strip()
        key = phrase.lower()
        if key in seen:
            continue
        seen.add(key)
        distinctiveness = count + min(24, len(set(re.findall(r"[A-Za-z]{4,}", phrase.lower()))))
        if any(term in key for term in ("make", "ship", "stripe", "pdf", "profile", "analyze", "identity", "launch", "webhook", "local")):
            distinctiveness += 10
        phrase_scores.append((distinctiveness, phrase))
    phrase_scores.sort(reverse=True)

    summary = {
        "available": bool(prompt_count),
        "source": source,
        "sampledFiles": sampled_files,
        "promptCount": prompt_count,
        "avgPromptWords": round(total_words / max(1, prompt_count), 1),
        "longestPromptWords": max(word_counts or [0]),
        "tinyPromptCount": sum(1 for count in word_counts if count <= 5),
        "questionPromptCount": question_like,
        "gratitudeCount": gratitude_count,
        "pleaseCount": please_count,
        "apologyCount": apology_count,
        "capsPromptCount": caps_prompt_count,
        "typoMarkerCount": typo_markers,
        "shortPromptRatio": round(sum(1 for count in word_counts if count <= 10) / max(1, prompt_count), 3),
        "commandPromptRatio": round(command_like / max(1, prompt_count), 3),
        "questionPromptRatio": round(question_like / max(1, prompt_count), 3),
        "planningSignal": ratio_for(["plan", "architecture", "strategy", "roadmap", "sequence", "design first"]),
        "redirectionSignal": ratio_for(["not that", "wrong", "instead", "stop", "revert", "don't", "dont", "actually"]),
        "urgencySignal": ratio_for(["now", "asap", "quick", "immediately", "done", "ship", "launch", "ruthlessly"]),
        "visualSignal": ratio_for(["ui", "design", "page", "landing", "pdf", "image", "brand", "animation", "screenshot"]),
        "monetizationSignal": ratio_for(["stripe", "payment", "pricing", "checkout", "subscription", "trial", "billing"]),
        "privacySignal": ratio_for(["local", "private", "privacy", "upload", "source code", "transcript", "leak", "control"]),
        "identitySignal": ratio_for(["identity", "profile", "archetype", "persona", "report", "skill.md", "proof layer"]),
        "signaturePhrases": [phrase for _, phrase in phrase_scores[:6]],
        "rawTranscriptsIncluded": False,
        "redactedExcerptsOnly": True,
    }
    if extra:
        summary.update(extra)
    summary["behaviorPatterns"] = behavior_patterns_from_signals(summary)
    summary["operatingMode"] = operating_mode_from_patterns(summary["behaviorPatterns"])
    return summary

def claude_session_analysis():
    home = Path.home()
    history_path = home / ".claude" / "history.jsonl"
    projects_root = home / ".claude" / "projects"
    prompts = []
    projects = Counter()
    sampled_files = 0

    if history_path.exists():
        sampled_files += 1
        try:
            with history_path.open("r", encoding="utf-8", errors="replace") as handle:
                for line_number, line in enumerate(handle):
                    if line_number >= 800:
                        break
                    try:
                        record = json.loads(line)
                    except Exception:
                        continue
                    text = record.get("display")
                    if isinstance(text, str) and text.strip() and not text.startswith("[Pasted text"):
                        prompts.append(redact_session_text(text))
                    project = record.get("project")
                    if isinstance(project, str) and project:
                        projects[os.path.basename(project.rstrip("/")) or project] += 1
        except Exception:
            pass

    if projects_root.exists():
        try:
            files = sorted(
                [path for path in projects_root.rglob("*.jsonl") if path.is_file()],
                key=lambda item: item.stat().st_mtime,
                reverse=True,
            )[:60]
        except Exception:
            files = []
        sampled_files += len(files)
        for session_path in files:
            try:
                bytes_seen = 0
                with session_path.open("r", encoding="utf-8", errors="replace") as handle:
                    for line_number, line in enumerate(handle):
                        if line_number >= 350:
                            break
                        bytes_seen += len(line.encode("utf-8", errors="ignore"))
                        if bytes_seen > 1_500_000:
                            break
                        try:
                            record = json.loads(line)
                        except Exception:
                            continue
                        if record.get("type") != "user":
                            continue
                        message = record.get("message") if isinstance(record.get("message"), dict) else {}
                        if message.get("role") != "user":
                            continue
                        text = message_text(message.get("content"))
                        if text:
                            prompts.append(redact_session_text(text))
                        cwd = record.get("cwd")
                        if isinstance(cwd, str) and cwd:
                            projects[os.path.basename(cwd.rstrip("/")) or cwd] += 1
            except Exception:
                continue

    summary = summarize_prompt_signals(
        prompts,
        "~/.claude/history.jsonl + ~/.claude/projects",
        sampled_files,
        {
            "provider": "Claude Code",
            "topWorkspaces": [{"name": name, "sessions": count} for name, count in projects.most_common(5)],
        },
    )
    if not summary["available"]:
        summary["reason"] = "no parseable local Claude user prompts found"
    return summary

def cursor_session_analysis():
    root = Path.home() / "Library" / "Application Support" / "Cursor" / "User" / "workspaceStorage"
    if not root.exists():
        return {
            "available": False,
            "provider": "Cursor",
            "source": "~/Library/Application Support/Cursor/User/workspaceStorage",
            "reason": "no local Cursor workspaceStorage directory",
            "rawTranscriptsIncluded": False,
        }
    try:
        dbs = sorted(
            [path for path in root.glob("*/state.vscdb") if path.is_file()],
            key=lambda item: item.stat().st_mtime,
            reverse=True,
        )[:80]
    except Exception:
        dbs = []

    prompts = []
    workspaces = Counter()
    sampled = 0
    for db_path in dbs:
        sampled += 1
        workspace_name = db_path.parent.name
        workspace_json = db_path.parent / "workspace.json"
        try:
            if workspace_json.exists():
                loaded = json.loads(workspace_json.read_text(encoding="utf-8"))
                folder = loaded.get("folder") or loaded.get("workspace")
                if isinstance(folder, str) and folder:
                    workspace_name = os.path.basename(folder.rstrip("/")) or folder
        except Exception:
            pass
        try:
            con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
            rows = con.execute(
                "select value from ItemTable where key='aiService.generations' limit 1"
            ).fetchall()
            con.close()
        except Exception:
            continue
        for (value,) in rows:
            try:
                records = json.loads(value)
            except Exception:
                continue
            if not isinstance(records, list):
                continue
            for record in records[-200:]:
                if not isinstance(record, dict):
                    continue
                text = record.get("textDescription") or record.get("description") or record.get("prompt")
                if isinstance(text, str) and text.strip():
                    prompts.append(redact_session_text(text))
                    workspaces[workspace_name] += 1
                if len(prompts) >= 1200:
                    break
            if len(prompts) >= 1200:
                break

    summary = summarize_prompt_signals(
        prompts,
        "~/Library/Application Support/Cursor/User/workspaceStorage/*/state.vscdb:aiService.generations",
        sampled,
        {
            "provider": "Cursor",
            "topWorkspaces": [{"name": name, "sessions": count} for name, count in workspaces.most_common(5)],
        },
    )
    if not summary["available"]:
        summary["reason"] = "no parseable local Cursor generation descriptions found"
    return summary

def antigravity_session_analysis():
    root = Path.home() / ".gemini" / "antigravity" / "brain"
    if not root.exists():
        return {
            "available": False,
            "provider": "Antigravity",
            "source": "~/.gemini/antigravity/brain",
            "reason": "no local Antigravity brain directory found",
            "rawTranscriptsIncluded": False,
        }
    try:
        files = sorted(
            [
                path for path in root.glob("*/*.md")
                if path.name in {"task.md", "implementation_plan.md", "analysis_results.md", "walkthrough.md"}
            ],
            key=lambda item: item.stat().st_mtime,
            reverse=True,
        )[:80]
    except Exception:
        files = []

    artifacts = []
    workspaces = Counter()
    by_kind = Counter()
    for file_path in files:
        try:
            text = file_path.read_text(encoding="utf-8", errors="replace")
        except Exception:
            continue
        if not text.strip():
            continue
        by_kind[file_path.stem] += 1
        workspaces[file_path.parent.name[:8]] += 1
        lines = []
        for line in text.splitlines():
            stripped = line.strip(" #-*\t")
            if not stripped or stripped.lower().startswith(("metadata", "screenshot")):
                continue
            lines.append(stripped)
            if len(" ".join(lines)) > 900:
                break
        redacted = redact_session_text(" ".join(lines))
        if redacted:
            artifacts.append(redacted[:1200])
        if len(artifacts) >= 500:
            break

    summary = summarize_prompt_signals(
        artifacts,
        "~/.gemini/antigravity/brain/*/{task,implementation_plan,analysis_results,walkthrough}.md",
        len(files),
        {
            "provider": "Antigravity",
            "artifactCount": len(artifacts),
            "analysisMode": "redacted local work-artifact sampler",
            "artifactKinds": [{"name": name, "count": count} for name, count in by_kind.most_common()],
            "topWorkspaces": [{"name": name, "sessions": count} for name, count in workspaces.most_common(5)],
        },
    )
    if not summary["available"]:
        summary["reason"] = "no parseable local Antigravity work artifacts found"
    return summary

def provider_source_inventory():
    home = Path.home()
    checks = [
        {
            "name": "Codex",
            "key": "codex",
            "status": "live",
            "paths": [Path(path), home / ".codex" / "sessions"],
            "analysis": "usage totals, session heuristics, redacted signature phrases",
        },
        {
            "name": "Claude Code",
            "key": "claude",
            "status": "detected-partial-parser",
            "paths": [home / ".claude" / "projects", home / ".claude" / "history.jsonl", home / ".claude"],
            "analysis": "bounded local prompt sampler; redacted aggregate signals only",
        },
        {
            "name": "Cursor",
            "key": "cursor",
            "status": "detected-partial-parser",
            "paths": [
                home / "Library" / "Application Support" / "Cursor" / "User" / "workspaceStorage",
                home / "Library" / "Application Support" / "Cursor" / "User" / "globalStorage" / "state.vscdb",
                home / ".cursor",
            ],
            "analysis": "bounded local SQLite generation-description sampler; redacted aggregate signals only",
        },
        {
            "name": "Antigravity",
            "key": "antigravity",
            "status": "detected-partial-parser",
            "paths": [
                home / ".gemini" / "antigravity" / "brain",
                home / ".antigravity",
                home / "Library" / "Application Support" / "Antigravity",
            ],
            "analysis": "bounded local brain/task/plan artifact sampler; redacted aggregate signals only",
        },
        {
            "name": "OpenCode",
            "key": "opencode",
            "status": "planned",
            "paths": [home / ".opencode", home / "Library" / "Application Support" / "OpenCode"],
            "analysis": "connector target for open-source IDE and agent usage exports; no parser enabled yet",
        },
    ]
    inventory = []
    for check in checks:
        found = []
        file_count = 0
        latest = 0
        for candidate in check["paths"]:
            try:
                if not candidate.exists():
                    continue
                found.append(str(candidate))
                if candidate.is_file():
                    file_count += 1
                    latest = max(latest, int(candidate.stat().st_mtime))
                elif candidate.is_dir():
                    count = 0
                    for child in candidate.rglob("*"):
                        if child.is_file():
                            count += 1
                            latest = max(latest, int(child.stat().st_mtime))
                        if count >= 500:
                            break
                    file_count += count
            except Exception:
                continue
        live = check["key"] == "codex" and bool(found)
        status = "live" if live else check["status"] if found else "not-found"
        inventory.append({
            "name": check["name"],
            "key": check["key"],
            "status": status,
            "found": bool(found),
            "paths": found[:4],
            "fileCountEstimate": file_count,
            "latestModified": time.strftime("%Y-%m-%d %H:%M", time.localtime(latest)) if latest else None,
            "analysis": check["analysis"],
            "rawTranscriptsIncluded": False,
        })
    return inventory

def safe_int(value):
    try:
        return int(value or 0)
    except Exception:
        return 0

def load_controls():
    controls = {
        "logTrackingEnabled": True,
        "activitySignalsEnabled": False,
        "dailyGuardrailTokens": None,
        "weeklyGuardrailTokens": None,
        "thirtyDayGuardrailTokens": None,
        "dailyCostLimitUSD": None,
        "weeklyCostLimitUSD": None,
    }
    if control_path and os.path.exists(control_path):
        try:
            with open(control_path, "r", encoding="utf-8") as handle:
                loaded = json.load(handle)
            if isinstance(loaded, dict):
                controls.update({key: loaded.get(key, value) for key, value in controls.items()})
        except Exception:
            pass
    return controls

def mean(values):
    return sum(values) / max(1, len(values))

def winsorized(values, fallback=0):
    usable = [float(value) for value in values if float(value) >= 0]
    if not usable:
        return float(max(0, fallback))
    if len(usable) < 4:
        return mean(usable)
    sorted_values = sorted(usable)
    low = sorted_values[min(len(sorted_values) - 1, int(round((len(sorted_values) - 1) * 0.10)))]
    high = sorted_values[min(len(sorted_values) - 1, int(round((len(sorted_values) - 1) * 0.85)))]
    clamped = [min(max(value, low), high) for value in usable]
    return mean(clamped)

def volatility_percent(values):
    active = [float(value) for value in values if value > 0]
    if len(active) < 2:
        return 0
    avg = mean(active)
    if avg <= 0:
        return 0
    variance = mean([(value - avg) ** 2 for value in active])
    return int(min(250, max(0, (variance ** 0.5) / avg * 100)))

def current_streak(values, active=True):
    count = 0
    for value in reversed(values):
        if (value > 0) == active:
            count += 1
        else:
            break
    return count

def activity_multiplier(active_days, active_streak, quiet_streak):
    active_rate = active_days / 30
    cadence_lift = min(0.14, active_rate * 0.18)
    streak_lift = min(0.16, active_streak * 0.025)
    quiet_drag = min(0.22, quiet_streak * 0.055)
    return min(1.24, max(0.72, 0.94 + cadence_lift + streak_lift - quiet_drag))

def uncertainty_percent(active_days, volatility, activity_enabled):
    history_penalty = max(0, 18 - active_days) * 3
    volatility_penalty = min(52, int(round(volatility * 0.42)))
    activity_adjustment = -6 if activity_enabled else 6
    return min(95, max(8, 18 + history_penalty + volatility_penalty + activity_adjustment))

def uncertainty_label(percent):
    if percent < 25:
        return "Low"
    if percent < 55:
        return "Medium"
    return "High"

controls = load_controls()
tracking_enabled = controls.get("logTrackingEnabled") is not False

if not os.path.exists(path):
    daily_guardrail = controls.get("dailyGuardrailTokens")
    weekly_guardrail = controls.get("weeklyGuardrailTokens")
    thirty_guardrail = controls.get("thirtyDayGuardrailTokens")
    print(json.dumps({
        "ready": False,
        "path": path,
        "reason": "usage-index.json not found" if tracking_enabled else "local log tracking paused and usage-index.json not found",
        "tracking_enabled": tracking_enabled,
        "activity_signals_enabled": bool(controls.get("activitySignalsEnabled")),
        "daily_guardrail_tokens": daily_guardrail,
        "daily_guardrail_compact": compact(parse_tokens(daily_guardrail) or 0) if daily_guardrail else None,
        "weekly_guardrail_tokens": weekly_guardrail,
        "weekly_guardrail_compact": compact(parse_tokens(weekly_guardrail) or 0) if weekly_guardrail else None,
        "thirty_day_guardrail_tokens": thirty_guardrail,
        "thirty_day_guardrail_compact": compact(parse_tokens(thirty_guardrail) or 0) if thirty_guardrail else None,
        "daily_cost_limit_usd": parse_money(controls.get("dailyCostLimitUSD")),
        "weekly_cost_limit_usd": parse_money(controls.get("weeklyCostLimitUSD")),
        "budget_tokens_raw": budget_raw or None,
        "price_per_million_raw": price_raw or None,
    }))
    raise SystemExit(0)

try:
    with open(path, "r", encoding="utf-8") as handle:
        data = json.load(handle)
except Exception as exc:
    print(json.dumps({
        "ready": False,
        "path": path,
        "reason": f"usage-index.json unreadable: {exc}",
        "budget_tokens_raw": budget_raw or None,
        "price_per_million_raw": price_raw or None,
    }))
    raise SystemExit(0)

day_tokens = data.get("dayTokens") or {}
model_tokens = data.get("modelTokens") or {}
folder_tokens = data.get("folderTokens") or {}
folder_session_paths = data.get("folderSessionPaths") or {}
active_folder_paths = set(data.get("activeFolderPaths") or [])
items = sorted((date, safe_int(tokens)) for date, tokens in day_tokens.items())
today_key = datetime.now().strftime("%Y-%m-%d")
today = safe_int(day_tokens.get(today_key, 0))
last30_items = items[-30:]
last14_items = items[-14:]
last7_items = items[-7:]
last30 = sum(value for _, value in last30_items)
last14 = sum(value for _, value in last14_items)
last7 = sum(value for _, value in last7_items)
active_days = sum(1 for _, value in last30_items if value > 0)
active_all = [value for _, value in items if value > 0]
avg_active = int(sum(active_all) / len(active_all)) if active_all else 0
peak_day, peak_tokens = max(items, key=lambda item: item[1]) if items else ("", 0)
sessions = len(data.get("sessionPaths") or [])
updated = data.get("updatedAt") or 0
updated_text = time.strftime("%Y-%m-%d %H:%M", time.localtime(updated)) if updated else "unknown"
top_model = max(model_tokens.items(), key=lambda item: safe_int(item[1]))[0] if model_tokens else "unknown"
top_folders = []
for folder_path, tokens in sorted(folder_tokens.items(), key=lambda item: safe_int(item[1]), reverse=True)[:8]:
    sessions_for_folder = folder_session_paths.get(folder_path) or []
    if not isinstance(sessions_for_folder, list):
        sessions_for_folder = []
    name = os.path.basename(folder_path.rstrip("/")) or folder_path
    top_folders.append({
        "path": folder_path,
        "name": name,
        "tokens": safe_int(tokens),
        "compact": compact(safe_int(tokens)),
        "sessions": len(sessions_for_folder),
        "active": folder_path in active_folder_paths,
    })
last30_values = [value for _, value in last30_items]
last7_values = [value for _, value in last7_items]
daily_avg_7 = int(last7 / max(1, len(last7_items)))
daily_avg_30 = int(last30 / max(1, len(last30_items)))
recent = winsorized(last7_values, fallback=daily_avg_30)
active_average = winsorized(active_all, fallback=avg_active)
cap_base = max(1, recent, active_average, daily_avg_30)
today_capped = min(today, int(cap_base * 1.35))
history_depth = min(1.0, active_days / 18)
sparse_damping = 0.78 + history_depth * 0.22
base_daily = (recent * 0.40 + active_average * 0.28 + daily_avg_30 * 0.17 + today_capped * 0.15) * sparse_damping
active_streak = current_streak(last30_values, active=True)
quiet_streak = current_streak(last30_values, active=False)
activity_enabled = bool(controls.get("activitySignalsEnabled"))
if activity_enabled:
    base_daily *= activity_multiplier(active_days, active_streak, quiet_streak)
projected_daily = int(max(1, round(base_daily)))
projected_next7 = projected_daily * 7
projected_next30 = projected_daily * 30
volatility = volatility_percent(last30_values)
uncertainty = uncertainty_percent(active_days, volatility, activity_enabled)
budget_tokens = parse_tokens(budget_raw)
remaining_budget = budget_tokens - last30 if budget_tokens is not None else None
price_per_million = None
try:
    price_per_million = float(price_raw) if price_raw else None
except ValueError:
    price_per_million = None
estimated_30d_cost = (last30 / 1_000_000) * price_per_million if price_per_million is not None else None
projected_30d_cost = (projected_next30 / 1_000_000) * price_per_million if price_per_million is not None else None
today_cost = (today / 1_000_000) * price_per_million if price_per_million is not None else None
projected_daily_cost = (projected_daily / 1_000_000) * price_per_million if price_per_million is not None else None
projected_weekly_cost = (projected_next7 / 1_000_000) * price_per_million if price_per_million is not None else None
daily_cost_limit = parse_money(controls.get("dailyCostLimitUSD"))
weekly_cost_limit = parse_money(controls.get("weeklyCostLimitUSD"))
weekly_guardrail = controls.get("weeklyGuardrailTokens")
power = mac_power_sample()
reset_estimate_date = (datetime.now() + timedelta(days=7)).strftime("%Y-%m-%d")
estimated_runout_days = None
estimated_runout_date = None
if budget_tokens is not None and remaining_budget is not None:
    if remaining_budget <= 0:
        estimated_runout_days = 0
        estimated_runout_date = today_key
    elif daily_avg_7 > 0:
        estimated_runout_days = max(1, int((remaining_budget + daily_avg_7 - 1) / daily_avg_7))
        estimated_runout_date = (datetime.now() + timedelta(days=estimated_runout_days)).strftime("%Y-%m-%d")

context = {
    "ready": True,
    "path": path,
    "tracking_enabled": tracking_enabled,
    "activity_signals_enabled": activity_enabled,
    "today_key": today_key,
    "today_tokens": today,
    "today_compact": compact(today),
    "last7_tokens": last7,
    "last7_compact": compact(last7),
    "last14_tokens": last14,
    "last14_compact": compact(last14),
    "last30_tokens": last30,
    "last30_compact": compact(last30),
    "active_days_last30": active_days,
    "sessions_indexed": sessions,
    "top_local_model": top_model,
    "top_folders": top_folders,
    "updated": updated_text,
    "peak_day": peak_day,
    "peak_tokens": peak_tokens,
    "peak_compact": compact(peak_tokens),
    "avg_active_day_tokens": avg_active,
    "avg_active_day_compact": compact(avg_active),
    "daily_avg_7_tokens": daily_avg_7,
    "daily_avg_7_compact": compact(daily_avg_7),
    "projected_daily_tokens": projected_daily,
    "projected_daily_compact": compact(projected_daily),
    "projected_next7_tokens": projected_next7,
    "projected_next7_compact": compact(projected_next7),
    "projected_next30_tokens": projected_next30,
    "projected_next30_compact": compact(projected_next30),
    "volatility_percent": volatility,
    "uncertainty_percent": uncertainty,
    "uncertainty_label": uncertainty_label(uncertainty),
    "prediction_basis": "history + activity cadence" if activity_enabled else "history only",
    "daily_guardrail_tokens": controls.get("dailyGuardrailTokens"),
    "daily_guardrail_compact": compact(parse_tokens(controls.get("dailyGuardrailTokens")) or 0) if controls.get("dailyGuardrailTokens") else None,
    "weekly_guardrail_tokens": weekly_guardrail,
    "weekly_guardrail_compact": compact(parse_tokens(weekly_guardrail) or 0) if weekly_guardrail else None,
    "thirty_day_guardrail_tokens": controls.get("thirtyDayGuardrailTokens"),
    "thirty_day_guardrail_compact": compact(parse_tokens(controls.get("thirtyDayGuardrailTokens")) or 0) if controls.get("thirtyDayGuardrailTokens") else None,
    "daily_cost_limit_usd": daily_cost_limit,
    "weekly_cost_limit_usd": weekly_cost_limit,
    "budget_tokens_raw": budget_raw or None,
    "budget_tokens": budget_tokens,
    "budget_compact": compact(budget_tokens) if budget_tokens is not None else None,
    "remaining_budget_tokens": remaining_budget,
    "remaining_budget_compact": compact(remaining_budget) if remaining_budget is not None and remaining_budget >= 0 else None,
    "estimated_runout_days": estimated_runout_days,
    "estimated_runout_date": estimated_runout_date,
    "hypothetical_reset_date": reset_estimate_date,
    "price_per_million": price_per_million,
    "today_cost": round(today_cost, 2) if today_cost is not None else None,
    "projected_daily_cost": round(projected_daily_cost, 2) if projected_daily_cost is not None else None,
    "projected_weekly_cost": round(projected_weekly_cost, 2) if projected_weekly_cost is not None else None,
    "estimated_30d_cost": round(estimated_30d_cost, 2) if estimated_30d_cost is not None else None,
    "projected_30d_cost": round(projected_30d_cost, 2) if projected_30d_cost is not None else None,
    "mac_power_watts": power.get("mac_power_watts"),
    "battery_celsius": power.get("battery_celsius"),
    "power_source": power.get("power_source"),
    "recent_days": [
        {"date": date, "tokens": value, "compact": compact(value)}
        for date, value in last14_items
    ],
    "all_days": [
        {"date": date, "tokens": value, "compact": compact(value)}
        for date, value in items
    ],
    "session_analysis": codex_session_analysis(),
    "provider_analyses": {
        "claude": claude_session_analysis(),
        "cursor": cursor_session_analysis(),
        "antigravity": antigravity_session_analysis(),
    },
    "provider_sources": provider_source_inventory(),
}
print(json.dumps(context, separators=(",", ":")))
PY
}

agent_api_status() {
  if [[ -n "${OPENAI_API_KEY:-}" ]]; then
    printf 'OpenAI Responses API ready (%s)' "$agent_model"
  else
    printf 'local analyst mode; set OPENAI_API_KEY for OpenAI Responses'
  fi
}

local_agent_answer() {
  local prompt="$1"
  local context
  context="$(usage_context_json)"
  TOKENBAR_USER_PROMPT="$prompt" TOKENBAR_USAGE_CONTEXT="$context" python3 - <<'PY'
import json
import os

prompt = os.environ.get("TOKENBAR_USER_PROMPT", "").strip()
ctx = json.loads(os.environ.get("TOKENBAR_USAGE_CONTEXT", "{}") or "{}")
lower = prompt.lower()

if not ctx.get("ready"):
    print(f"I tried to read the local usage index, but it is not ready: {ctx.get('reason', 'unknown reason')}.")
    print(f"Expected path: {ctx.get('path')}")
    raise SystemExit(0)

recent = ctx.get("recent_days") or []
recent_text = ", ".join(f"{d['date']}: {d['compact']}" for d in recent[-7:])
facts = [
    f"Today is {ctx['today_compact']} tokens.",
    f"Last 30 days are {ctx['last30_compact']} across {ctx['active_days_last30']}/30 active days.",
    f"Peak day was {ctx['peak_day']} at {ctx['peak_compact']}.",
    f"Forecast is {ctx['prediction_basis']}, projecting {ctx['projected_next7_compact']} next week with ±{ctx['uncertainty_percent']}% uncertainty.",
    f"Top local model is {ctx['top_local_model']}; sessions indexed: {ctx['sessions_indexed']}.",
]

print("I read the local TokenBar logs before answering.")
if any(word in lower for word in ("spike", "peak", "why high", "highest")):
    print(f"The main spike is {ctx['peak_day']} at {ctx['peak_compact']}. Compare that against the active-day average of {ctx['avg_active_day_compact']}.")
elif any(word in lower for word in ("budget", "runout", "run out", "cap", "limit")):
    if ctx.get("budget_tokens") is not None:
        rem = ctx.get("remaining_budget_compact") or "over budget"
        print(f"Configured budget is {ctx['budget_compact']}; last 30d used {ctx['last30_compact']}; remaining estimate is {rem}.")
        if ctx.get("estimated_runout_date"):
            print(f"At the recent 7-day pace, estimated runout is {ctx['estimated_runout_date']} ({ctx['estimated_runout_days']} day(s) from today).")
            print(f"Hypothetical reset marker is {ctx['hypothetical_reset_date']}; verify the real reset in the provider dashboard.")
            if ctx["estimated_runout_date"] <= ctx["hypothetical_reset_date"]:
                print("This would run out before or on the hypothetical reset marker.")
            else:
                print("This clears the hypothetical reset marker at the current pace.")
        if ctx.get("price_per_million") is not None and any(word in lower for word in ("cost", "dollar", "spend", "price")):
            projected_cost = round((ctx["projected_next7_tokens"] / 1_000_000) * ctx["price_per_million"], 2)
            print(f"Using ${ctx['price_per_million']}/M, next 7d projects about ${projected_cost}; local 30d estimate is ${ctx['estimated_30d_cost']}.")
    else:
        print(f"No budget is configured yet. Set one with: config budget 20B. Current 30d usage is {ctx['last30_compact']} and next 7d projects {ctx['projected_next7_compact']} (±{ctx['uncertainty_percent']}%).")
elif any(word in lower for word in ("cost", "dollar", "spend", "price")):
    if ctx.get("estimated_30d_cost") is not None:
        print(f"Using ${ctx['price_per_million']}/M, the local 30d cost estimate is ${ctx['estimated_30d_cost']}.")
    else:
        print(f"Cost needs a configured price. Set one with: config price 0.30. Local 30d usage is {ctx['last30_compact']}.")
elif any(word in lower for word in ("energy", "watt", "joule", "power", "heat", "temperature", "gpu")):
    watts = ctx.get("mac_power_watts")
    temp = ctx.get("battery_celsius")
    if watts:
        temp_text = f", battery {temp}C" if temp is not None else ""
        print(f"Current Mac draw sample is about {watts}W{temp_text} ({ctx.get('power_source', 'battery sample')}).")
    else:
        print("I could not read a live Mac battery power sample from ioreg in this shell.")
    print(f"Token side: today {ctx['today_compact']}, 30d {ctx['last30_compact']}, recent pace {ctx['daily_avg_7_compact']}/day.")
    print("Energy per token is still an estimate until TokenBar stores a power time series over each session.")
elif any(word in lower for word in ("folder", "folders", "project", "projects", "workspace", "workspaces")):
    folders = ctx.get("top_folders") or []
    if not folders:
        print("No folder-level token totals are indexed yet.")
    else:
        print("Top folders by local tokens:")
        for item in folders[:6]:
            active = " active" if item.get("active") else ""
            print(f"- {item['name']}: {item['compact']} across {item.get('sessions', 0)} session(s){active}")
elif any(word in lower for word in ("provider", "connector", "antigravity", "anti-gravity", "claude", "cursor", "opencode", "open code")):
    print(f"The live source is the local Codex usage index at {ctx['path']}.")
    print("Other agent providers should stay explicit connectors until they expose a reliable API, export, or user-approved local file.")
    print(f"Current local baseline: {ctx['last30_compact']} in 30d, top model {ctx['top_local_model']}.")
elif any(word in lower for word in ("forecast", "pace", "next week", "next 7")):
    print(f"Forecast basis is {ctx['prediction_basis']}: projected pace is {ctx['projected_daily_compact']}/day, next 7d {ctx['projected_next7_compact']}, next 30d {ctx['projected_next30_compact']}.")
    print(f"Uncertainty is ±{ctx['uncertainty_percent']}% ({ctx['uncertainty_label']}) from active-day history and volatility.")
    print(f"The reset marker shown here is hypothetical: {ctx['hypothetical_reset_date']}. Official reset windows need provider confirmation.")
elif any(word in lower for word in ("uncertain", "uncertainty", "confidence", "guardrail", "tracking", "activity")):
    print(f"Prediction basis is {ctx['prediction_basis']}; uncertainty is ±{ctx['uncertainty_percent']}% ({ctx['uncertainty_label']}).")
    print(f"Activity-aware forecasting is {'on' if ctx.get('activity_signals_enabled') else 'off'}; tracking is {'on' if ctx.get('tracking_enabled', True) else 'paused'}.")
    print(f"Limits: daily {ctx.get('daily_guardrail_compact') or 'off'}, weekly {ctx.get('weekly_guardrail_compact') or 'off'}, 30d {ctx.get('thirty_day_guardrail_compact') or 'off'}.")
    if ctx.get("daily_cost_limit_usd") or ctx.get("weekly_cost_limit_usd"):
        print(f"Cost limits: daily ${ctx.get('daily_cost_limit_usd') or 'off'}, weekly ${ctx.get('weekly_cost_limit_usd') or 'off'}.")
else:
    for line in facts:
        print(line)

if recent_text:
    print(f"Recent daily trail: {recent_text}.")
print("OpenAI API is not active in this shell, so this answer used the local analyst path only.")
PY
}

openai_agent_answer() {
  local prompt="$1"
  local context
  context="$(usage_context_json)"

  TOKENBAR_USER_PROMPT="$prompt" \
  TOKENBAR_USAGE_CONTEXT="$context" \
  TOKENBAR_MODEL="$agent_model" \
  TOKENBAR_BUDGET_TOKENS="$agent_budget_tokens" \
  TOKENBAR_PRICE_PER_MILLION="$agent_price_per_million" \
  python3 - <<'PY'
import json
import os
import sys
import urllib.error
import urllib.request

api_key = os.environ.get("OPENAI_API_KEY")
if not api_key:
    raise SystemExit(2)

prompt = os.environ.get("TOKENBAR_USER_PROMPT", "")
context = os.environ.get("TOKENBAR_USAGE_CONTEXT", "{}")
model = os.environ.get("TOKENBAR_MODEL") or "gpt-5.4"
budget = os.environ.get("TOKENBAR_BUDGET_TOKENS") or "not configured"
price = os.environ.get("TOKENBAR_PRICE_PER_MILLION") or "not configured"

instructions = """You are TokenBar Agent, a CLI analyst for AI coding-agent usage.
Use the supplied local usage-index JSON as the source of truth before answering.
Respect user controls in the JSON: if tracking is paused say so; treat activity signals as opt-in; mention uncertainty and guardrails when relevant.
If the user asks about folders/projects/workspaces, use top_folders from the JSON and name the largest folders.
If the user asks about power or heat, use mac_power_watts and battery_celsius when present; do not pretend this is precise wall power.
Do not give generic metric definitions unless the user explicitly asks for definitions.
Answer with concrete observations, likely next action, and any uncertainty.
Clearly label forecasts as estimates and never claim official billing, purchased credits, or organization-level truth.
If data is missing, name the exact missing source.
Keep answers concise enough for a terminal prompt."""

payload = {
    "model": model,
    "instructions": instructions,
    "input": (
        f"User prompt: {prompt}\n\n"
        f"Session config: budget_tokens={budget}; price_per_million={price}\n\n"
        f"Local usage context JSON:\n{context}"
    ),
    "max_output_tokens": 650,
    "store": False,
}

request = urllib.request.Request(
    "https://api.openai.com/v1/responses",
    data=json.dumps(payload).encode("utf-8"),
    headers={
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
    },
    method="POST",
)

try:
    with urllib.request.urlopen(request, timeout=45) as response:
        data = json.loads(response.read().decode("utf-8"))
except urllib.error.HTTPError as exc:
    body = exc.read().decode("utf-8", errors="replace")
    print(f"OpenAI API request failed ({exc.code}). {body[:600]}", file=sys.stderr)
    raise SystemExit(2)
except Exception as exc:
    print(f"OpenAI API request failed: {exc}", file=sys.stderr)
    raise SystemExit(2)

parts = []
for item in data.get("output", []):
    if item.get("type") != "message":
        continue
    for content in item.get("content", []):
        if content.get("type") == "output_text":
            parts.append(content.get("text", ""))

text = "\n".join(part for part in parts if part).strip()
if not text:
    print("OpenAI returned no text output.", file=sys.stderr)
    raise SystemExit(2)

print(text)
usage = data.get("usage") or {}
total = usage.get("total_tokens")
if total is not None:
    print(f"\n[agent tokens used: {total}]")
PY
}

agent_answer() {
  local prompt="$1"
  local cyan=$'\033[36m'
  local amber=$'\033[33m'
  local reset=$'\033[0m'

  printf '%sTokenBar%s checking local logs...\n' "$cyan" "$reset"
  if [[ -n "${OPENAI_API_KEY:-}" ]]; then
    if openai_agent_answer "$prompt"; then
      return 0
    fi
    printf '%sOpenAI path failed; falling back to local log analyst.%s\n' "$amber" "$reset" >&2
  fi
  local_agent_answer "$prompt"
}

status_report() {
  local app_path pid
  app_path="$(find_app || true)"
  pid="$(running_pid)"

  if [[ -n "$app_path" ]]; then
    printf 'App: %s\n' "$app_path"
  else
    printf 'App: not installed\n'
  fi

  if [[ -n "$pid" ]]; then
    printf 'Process: running (pid %s)\n' "$pid"
  else
    printf 'Process: not running\n'
  fi

  usage_summary

  printf '\nNext:\n'
  if [[ -n "$app_path" && -z "$pid" ]]; then
    printf '  tokenbar open          Start the menu-bar app\n'
  elif [[ -z "$app_path" ]]; then
    printf '  tokenbar install       Install the macOS menu-bar app\n'
  fi
  if tracking_is_paused; then
    printf '  tokenbar tracking on   Resume indexing new local agent runs\n'
  fi
  printf '  tokenbar claim         Create a private local Builder Identity report\n'
  printf '  tokenbar prove         Opt in to a safe TBAR proof token and public surfaces\n'
  printf '  tokenbar social        Open profiles, shipped-work feed, leaderboards\n'
  printf '  tokenbar save URL      Store an X/GitHub/blog/video builder reference locally\n'
  printf '\nPrivacy: claim/prove use generated aggregate evidence; raw transcripts, source code, credentials, private diffs, and env files stay local.\n'
}

forecast_report() {
  cat <<'EOF'
Forecast model:
  facts     local coding-agent session tokens by day
  live      5-hour and weekly quota windows when a provider exposes them
  estimate  future pace, cost, runout, budget pressure, and confidence

EOF
  usage_summary
  cat <<'EOF'

Interpretation:
  tokenbar forecast is useful for direction and runway.
  official billing, purchased credits, and org attribution still belong to the provider dashboard.
EOF
}

quick_usage_context_json() {
  INDEX_PATH="$usage_index" \
  TOKENBAR_PRICE_PER_MILLION="$agent_price_per_million" \
  python3 - <<'PY'
import json
import os
from datetime import datetime, timedelta

path = os.environ.get("INDEX_PATH") or ""
price_raw = os.environ.get("TOKENBAR_PRICE_PER_MILLION") or ""

try:
    with open(path, "r", encoding="utf-8") as handle:
        data = json.load(handle)
except Exception:
    data = {}

day_tokens = data.get("dayTokens") if isinstance(data.get("dayTokens"), dict) else {}
today = datetime.now()
today_key = today.strftime("%Y-%m-%d")
last7_keys = [(today - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(7)]

def as_int(value):
    try:
        return int(value or 0)
    except Exception:
        return 0

today_tokens = as_int(day_tokens.get(today_key))
last7_tokens = sum(as_int(day_tokens.get(key)) for key in last7_keys)
active_days = sum(1 for key in last7_keys if as_int(day_tokens.get(key)) > 0)
session_count = len(data.get("sessionPaths") or [])

try:
    price = float(price_raw) if price_raw else None
except ValueError:
    price = None

out = {
    "today_tokens": today_tokens,
    "last7_tokens": last7_tokens,
    "active_days_7d": active_days,
    "sessions_indexed": session_count,
    "windows": {
        "7d": {
            "total_tokens": last7_tokens,
            "active_days": active_days,
        }
    },
}
if price is not None:
    weekly_cost = (last7_tokens / 1_000_000) * price
    out["price_per_million"] = price
    out["projected_weekly_cost"] = weekly_cost
    out["windows"]["7d"]["estimated_cost"] = weekly_cost
print(json.dumps(out, separators=(",", ":")))
PY
}

imported_usage_report() {
  local report_path="$1"
  local json_mode="${2:-false}"

  TOKENBAR_IMPORTED_USAGE_PATH="$report_path" \
  TOKENBAR_IMPORTED_USAGE_JSON="$json_mode" \
  python3 - <<'PY'
import json
import os
import re
import sys
from collections import Counter
from datetime import datetime, timedelta
from pathlib import Path

path = Path(os.environ["TOKENBAR_IMPORTED_USAGE_PATH"]).expanduser()
json_mode = os.environ.get("TOKENBAR_IMPORTED_USAGE_JSON") == "true"

try:
    text = path.read_text(encoding="utf-8", errors="replace")
except Exception as exc:
    raise SystemExit(f"Could not read usage report: {exc}")

ansi = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")
number = re.compile(r"-?[0-9][0-9,]*(?:\.[0-9]+)?")
date_pattern = re.compile(r"^\d{4}-\d{2}-\d{2}$")

def numeric(value, money=False):
    match = number.search(str(value or ""))
    if not match:
        return 0.0 if money else 0
    cleaned = match.group(0).replace(",", "")
    try:
        return float(cleaned) if money else int(float(cleaned))
    except ValueError:
        return 0.0 if money else 0

def compact(value):
    value = float(max(0, value or 0))
    if value >= 1_000_000_000:
        return f"{value / 1_000_000_000:.2f}B".replace(".00B", "B")
    if value >= 1_000_000:
        return f"{value / 1_000_000:.1f}M".replace(".0M", "M")
    if value >= 1_000:
        return f"{value / 1_000:.1f}K".replace(".0K", "K")
    return str(int(value))

daily = []
agent_totals = Counter()
models = set()
reported_total = None

for raw_line in ansi.sub("", text).splitlines():
    if "│" not in raw_line:
        continue
    cells = [cell.strip() for cell in raw_line.split("│")[1:-1]]
    if len(cells) < 9:
        continue
    day, agent, model = cells[0], cells[1], cells[2]
    if model.startswith("-"):
        model_name = re.sub(r"^\[[^\]]+\]\s*", "", model[1:].strip())
        if model_name:
            models.add(model_name)
    if day == "Total":
        reported_total = {
            "inputTokens": numeric(cells[3]),
            "outputTokens": numeric(cells[4]),
            "cacheCreateTokens": numeric(cells[5]),
            "cacheReadTokens": numeric(cells[6]),
            "totalTokens": numeric(cells[7]),
            "reportedCostUsd": numeric(cells[8], money=True),
        }
    elif date_pattern.match(day) and agent == "All":
        daily.append({
            "date": day,
            "inputTokens": numeric(cells[3]),
            "outputTokens": numeric(cells[4]),
            "cacheCreateTokens": numeric(cells[5]),
            "cacheReadTokens": numeric(cells[6]),
            "totalTokens": numeric(cells[7]),
            "reportedCostUsd": numeric(cells[8], money=True),
        })
    elif not day and agent.startswith("-"):
        agent_name = agent[1:].strip()
        agent_tokens = numeric(cells[7])
        if agent_name and agent_tokens:
            agent_totals[agent_name] += agent_tokens

if not daily:
    raise SystemExit("No daily rows found. Expected the box-table Coding (Agent) CLI Usage Report.")

daily.sort(key=lambda item: item["date"])
end_date = datetime.strptime(daily[-1]["date"], "%Y-%m-%d")
window_start = end_date - timedelta(days=6)
last7 = [item for item in daily if datetime.strptime(item["date"], "%Y-%m-%d") >= window_start]
peak = max(daily, key=lambda item: item["totalTokens"])

total_keys = ("inputTokens", "outputTokens", "cacheCreateTokens", "cacheReadTokens", "totalTokens", "reportedCostUsd")
totals = reported_total or {key: sum(item[key] for item in daily) for key in total_keys}
last7_tokens = sum(item["totalTokens"] for item in last7)
last7_cost = sum(item["reportedCostUsd"] for item in last7)
cache_tokens = totals["cacheCreateTokens"] + totals["cacheReadTokens"]
fresh_tokens = totals["inputTokens"] + totals["outputTokens"]
cache_share = round(cache_tokens / max(1, totals["totalTokens"]) * 100, 1)
attributed_total = max(1, sum(agent_totals.values()))
top_agent, top_agent_tokens = agent_totals.most_common(1)[0] if agent_totals else ("Unknown", 0)
top_agent_share = round(top_agent_tokens / attributed_total * 100, 1) if agent_totals else 0

if last7_tokens >= 4_000_000_000:
    commentary = f"{compact(last7_tokens)} in seven days. The agents did not take the week off."
elif last7_tokens >= 1_000_000_000:
    commentary = f"{compact(last7_tokens)} in seven days: serious agent throughput, not background noise."
else:
    commentary = f"{compact(last7_tokens)} in seven days. A quieter trace, but still enough to inspect."

if cache_share >= 80:
    nuance = (
        f"{cache_share:.1f}% is cache traffic. Do not market {compact(totals['totalTokens'])} "
        "as fresh reasoning; the honest story is high reuse and sustained iteration."
    )
else:
    nuance = f"Cache traffic is {cache_share:.1f}% of the measured total."

payload = {
    "schema": "tokenbar.usage_pulse.v1",
    "period": {"start": daily[0]["date"], "end": daily[-1]["date"], "activeDays": len(daily)},
    "totals": totals,
    "freshInputOutputTokens": fresh_tokens,
    "last7Days": {
        "start": window_start.strftime("%Y-%m-%d"),
        "end": daily[-1]["date"],
        "activeDays": len(last7),
        "totalTokens": last7_tokens,
        "reportedCostUsd": round(last7_cost, 2),
    },
    "peakDay": peak,
    "agentMix": [
        {"agent": name, "totalTokens": value, "sharePercent": round(value / attributed_total * 100, 1)}
        for name, value in agent_totals.most_common()
    ],
    "models": sorted(model for model in models if model),
    "cacheSharePercent": cache_share,
    "commentary": [commentary, nuance],
    "privacy": {
        "rawReportIncluded": False,
        "rawTranscriptsIncluded": False,
        "sourceCodeIncluded": False,
        "safeForSelectiveShare": True,
    },
    "disclaimer": "Costs are report estimates, not an official provider invoice. Token volume does not prove useful output.",
}

if json_mode:
    print(json.dumps(payload, indent=2, sort_keys=True))
    raise SystemExit(0)

use_color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")

def paint(code, value):
    return f"\033[{code}m{value}\033[0m" if use_color else str(value)

def bold(value):
    return paint("1", value)

def blue(value):
    return paint("38;5;39", value)

def amber(value):
    return paint("38;5;214", value)

def purple(value):
    return paint("38;5;141", value)

def dim(value):
    return paint("2", value)

print(bold("TokenBar Builder Pulse"))
print(dim(f"{daily[0]['date']} to {daily[-1]['date']} · {len(daily)} active days · local report"))
print()
print(purple(bold(f"{compact(totals['totalTokens'])} total tokens")))
print(commentary)
print(dim(nuance))
print(dim(f"Measured mix: {compact(fresh_tokens)} input/output · {compact(cache_tokens)} cache traffic"))
print()
print(bold("Recent pace"))
print(f"Last 7d: {blue(bold(compact(last7_tokens)))} · {len(last7)}/7 active days · reported estimate ${last7_cost:,.2f}")
print(f"Peak: {peak['date']} · {amber(bold(compact(peak['totalTokens'])))} · reported estimate ${peak['reportedCostUsd']:,.2f}")
print()
print(bold("Agent mix"))
if agent_totals:
    for name, value in agent_totals.most_common(5):
        share = value / attributed_total * 100
        print(f"{name:<12} {compact(value):>9}  {share:>5.1f}%")
else:
    print("Agent totals were not present in this export.")
print()
print(bold("Read this correctly"))
print(f"Top agent: {top_agent} at {top_agent_share:.1f}% of attributed usage.")
print(f"Models observed: {', '.join(sorted(models)[:8]) or 'not listed'}")
print(f"Reported all-time estimate: ${totals['reportedCostUsd']:,.2f} (not an official invoice)")
print("Token volume shows activity, not quality. Pair it with shipped work, verification, and recovery evidence.")
print()
print(dim("Privacy: this summary contains aggregate counts only; the raw report stays local."))
print(f"Share-safe JSON: {blue('tokenbar usage REPORT --json')}")
PY
}

usage_report() {
  local imported_path=""
  local json_mode=false
  local temp_report=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        cat <<'EOF'
Usage:
  tokenbar usage                    Read TokenBar's local usage index
  tokenbar usage REPORT.txt         Summarize an exported multi-agent usage table
  usage | tokenbar usage -          Read the exported report from stdin
  tokenbar usage REPORT.txt --json  Emit a share-safe aggregate payload

Raw reports, transcripts, source code, and local paths are never included in
the JSON payload. Reported costs remain estimates, not provider invoices.
EOF
        return 0
        ;;
      --json|--social-json)
        json_mode=true
        ;;
      --from)
        shift
        imported_path="${1:-}"
        ;;
      -)
        temp_report="$(mktemp "${TMPDIR:-/tmp}/tokenbar-usage-report.XXXXXX")"
        cat > "$temp_report"
        imported_path="$temp_report"
        ;;
      *)
        if [[ -z "$imported_path" ]]; then
          imported_path="$1"
        else
          printf 'Unknown tokenbar usage option: %s\n' "$1" >&2
          return 2
        fi
        ;;
    esac
    shift || true
  done

  if [[ -n "$imported_path" ]]; then
    if [[ ! -f "$imported_path" ]]; then
      printf 'Usage report not found: %s\n' "$imported_path" >&2
      return 1
    fi
    imported_usage_report "$imported_path" "$json_mode"
    if [[ -n "$temp_report" ]]; then
      rm -f "$temp_report"
    fi
    return 0
  fi

  local context
  context="$(usage_context_json 2>/dev/null || printf '{}')"
  TOKENBAR_USAGE_CONTEXT="$context" python3 - <<'PY'
import json
import os
import sys

ctx = json.loads(os.environ.get("TOKENBAR_USAGE_CONTEXT") or "{}")

use_color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")

def c(code, text):
    return f"\033[{code}m{text}\033[0m" if use_color else text

def bold(text):
    return c("1", text)

def blue(text):
    return c("38;5;39", text)

def green(text):
    return c("38;5;40", text)

def amber(text):
    return c("38;5;214", text)

def purple(text):
    return c("38;5;141", text)

def red(text):
    return c("38;5;203", text)

def dim(text):
    return c("2", text)

def bar(value, maximum, width=24, colorize=green):
    value = max(0, int(value or 0))
    maximum = max(1, int(maximum or 1))
    filled = max(1 if value else 0, min(width, round(width * value / maximum)))
    return colorize("#" * filled) + dim("." * (width - filled))

def volume_color(tokens):
    tokens = int(tokens or 0)
    if tokens >= 4_000_000_000:
        return purple
    if tokens >= 1_000_000_000:
        return amber
    if tokens >= 100_000_000:
        return blue
    return green

print(bold("TokenBar usage"))
print(dim("--------------"))
if not ctx.get("ready"):
    print(ctx.get("reason", "usage index unavailable"))
    print(f"Path: {ctx.get('path', '')}")
    if not ctx.get("tracking_enabled", True):
        print()
        print(bold("What tracking means"))
        print("Tracking watches your local coding-agent usage logs for new runs.")
        print("Your old index can still be read while tracking is paused.")
        print(f"Resume new tracking: {blue('tokenbar tracking on')}")
    raise SystemExit(0)

tracking = "on" if ctx.get("tracking_enabled", True) else "paused; showing historical index"
last7_tokens = int(ctx.get("last7_tokens") or 0)
last30_tokens = int(ctx.get("last30_tokens") or 0)
today_tokens = int(ctx.get("today_tokens") or 0)
peak_tokens = int(ctx.get("peak_tokens") or 0)
projected_next7 = int(ctx.get("projected_next7_tokens") or 0)
paint_last7 = volume_color(last7_tokens)
paint_30 = volume_color(last30_tokens)
paint_peak = volume_color(peak_tokens)

if last7_tokens >= 4_000_000_000:
    twist = "Wow. That is not a weekly coding session; that is a small compute weather event."
elif last7_tokens >= 1_000_000_000:
    twist = "Healthy burn. Your agents were not idle; they were doing laps around the repo."
elif last7_tokens > 0:
    twist = "Quiet but alive. The machine is still leaving fingerprints."
else:
    twist = "No recent indexed burn. Either peace has arrived, or tracking is taking a nap."

if not ctx.get("tracking_enabled", True):
    tracking_note = "Tracking is paused, so this is historical data. The dashboard is reading the old black box."
else:
    tracking_note = "Tracking is on, so new local runs can keep flowing into this index."

print(f"{bold('Last 7 days')}  {paint_last7(bold(ctx.get('last7_compact', '0')))} tokens")
print(bar(last7_tokens, max(last30_tokens, last7_tokens), colorize=paint_last7))
print(twist)
print(dim(tracking_note))
print()

print(bold("Snapshot"))
print(f"Today: {volume_color(today_tokens)(bold(ctx.get('today_compact', '0')))} tokens")
print(f"Last 30d: {paint_30(bold(ctx.get('last30_compact', '0')))}")
print(f"Active days: {bold(str(ctx.get('active_days_last30', 0)) + '/30')} | Sessions: {bold(ctx.get('sessions_indexed', 0))}")
print(f"Top model: {bold(ctx.get('top_local_model', 'unknown'))}")
print(f"Peak day: {ctx.get('peak_day', 'unknown')} at {paint_peak(bold(ctx.get('peak_compact', '0')))}")
print()
print(bold("Forecast"))
print(f"Next 7d: {volume_color(projected_next7)(bold(ctx.get('projected_next7_compact', '0')))} | Next 30d: {bold(ctx.get('projected_next30_compact', '0'))}")
print(f"Basis: {ctx.get('prediction_basis', 'history only')} | Uncertainty: +/-{ctx.get('uncertainty_percent', 0)}%")
if ctx.get("price_per_million") is not None:
    print(f"Cost: today ${ctx.get('today_cost', 0)} | projected week ${ctx.get('projected_weekly_cost', 0)}")
print()
print(bold("Where the tokens went"))
folders = ctx.get("top_folders") or []
if folders:
    max_folder_tokens = max(int(item.get("tokens") or 0) for item in folders[:5]) or 1
    for item in folders[:5]:
        marker = " live" if item.get("active") else ""
        folder_tokens = int(item.get("tokens") or 0)
        print(f"{bar(folder_tokens, max_folder_tokens, width=10, colorize=blue)} {item.get('compact', '0'):>8}  {item.get('sessions', 0):>3} sessions  {item.get('name', item.get('path', 'folder'))}{marker}")
else:
    print("No folder-level usage has been indexed yet.")
print()
print(bold("Controls"))
print(f"Tracking: {bold(tracking)}")
print("Tracking means: TokenBar watches local usage logs for new runs. It does not upload raw logs.")
print(f"Limits: daily {ctx.get('daily_guardrail_compact') or 'off'} | weekly {ctx.get('weekly_guardrail_compact') or 'off'} | 30d {ctx.get('thirty_day_guardrail_compact') or 'off'}")
if not ctx.get("tracking_enabled", True):
    print(f"Resume new tracking: {blue('tokenbar tracking on')}")
print(f"Open app: {blue('tokenbar open')} | More commands: {blue('tokenbar help')}")
PY
}

cost_passport_command() {
  local imported_path=""
  local range_start=""
  local range_end=""
  local json_mode=false
  local temp_report=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        cat <<'EOF'
Usage:
  tokenbar cost-passport
  tokenbar cost-passport json
  tokenbar cost-passport --from 2026-06-02 --to 2026-08-02 json
  tokenbar cost-passport --range 2026-06-02..2026-08-02
  tokenbar cost-passport REPORT.txt
  usage | tokenbar cost-passport -

Build a share-safe cost passport from local aggregate usage. Costs are estimates,
not provider invoices. Raw reports, prompts, transcripts, source code, local
paths, credentials, and private diffs are not included in the passport output.
EOF
        return 0
        ;;
      --json|json)
        json_mode=true
        ;;
      --from)
        shift
        if [[ "${1:-}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
          range_start="${1:-}"
        else
          imported_path="${1:-}"
        fi
        ;;
      --from-date|--start)
        shift
        range_start="${1:-}"
        ;;
      --to|--to-date|--end)
        shift
        range_end="${1:-}"
        ;;
      --range)
        shift
        range_start="${1%%..*}"
        range_end="${1##*..}"
        ;;
      -)
        temp_report="$(mktemp "${TMPDIR:-/tmp}/tokenbar-cost-report.XXXXXX")"
        cat > "$temp_report"
        imported_path="$temp_report"
        ;;
      *)
        if [[ -z "$imported_path" ]]; then
          imported_path="$1"
        else
          printf 'Unknown tokenbar cost-passport option: %s\n' "$1" >&2
          return 2
        fi
        ;;
    esac
    shift || true
  done

  local pulse_json=""
  local context_json=""
  if [[ -n "$imported_path" ]]; then
    if [[ ! -f "$imported_path" ]]; then
      printf 'Usage report not found: %s\n' "$imported_path" >&2
      return 1
    fi
    pulse_json="$(imported_usage_report "$imported_path" true)"
    if [[ -n "$temp_report" ]]; then
      rm -f "$temp_report"
    fi
  else
    context_json="$(usage_context_json 2>/dev/null || printf '{}')"
  fi

  TOKENBAR_COST_PASSPORT_JSON="$json_mode" \
  TOKENBAR_COST_RANGE_START="$range_start" \
  TOKENBAR_COST_RANGE_END="$range_end" \
  TOKENBAR_USAGE_PULSE="$pulse_json" \
  TOKENBAR_USAGE_CONTEXT="$context_json" \
  python3 - <<'PY'
import json
import os
import sys
from datetime import datetime, timezone

json_mode = os.environ.get("TOKENBAR_COST_PASSPORT_JSON") == "true"
range_start = (os.environ.get("TOKENBAR_COST_RANGE_START") or "").strip()
range_end = (os.environ.get("TOKENBAR_COST_RANGE_END") or "").strip()

def load_env_json(name):
    try:
        return json.loads(os.environ.get(name) or "{}")
    except Exception:
        return {}

def compact(value):
    try:
        value = float(value or 0)
    except Exception:
        value = 0
    value = max(0, value)
    if value >= 1_000_000_000:
        return f"{value / 1_000_000_000:.2f}B".replace(".00B", "B")
    if value >= 1_000_000:
        return f"{value / 1_000_000:.1f}M".replace(".0M", "M")
    if value >= 1_000:
        return f"{value / 1_000:.1f}K".replace(".0K", "K")
    return str(int(value))

def money(value):
    if value is None:
        return None
    try:
        value = float(value)
    except Exception:
        return None
    if value >= 100:
        return f"${value:,.0f}"
    return f"${value:,.2f}"

def safe_percent(value):
    try:
        return max(0, min(100, round(float(value))))
    except Exception:
        return 0

def parse_day(value):
    try:
        return datetime.strptime(str(value), "%Y-%m-%d").date()
    except Exception:
        return None

def selected_day_rows(ctx):
    rows = ctx.get("all_days") if isinstance(ctx.get("all_days"), list) else ctx.get("recent_days")
    if not isinstance(rows, list):
        rows = []
    start_day = parse_day(range_start)
    end_day = parse_day(range_end)
    if start_day and end_day and start_day > end_day:
        start_day, end_day = end_day, start_day
    selected = []
    for row in rows:
        date_text = str(row.get("date") or "")
        day = parse_day(date_text)
        if not day:
            continue
        if start_day and day < start_day:
            continue
        if end_day and day > end_day:
            continue
        selected.append({"date": date_text, "tokens": int(row.get("tokens") or 0), "compact": row.get("compact") or compact(row.get("tokens"))})
    return selected, start_day, end_day

def recommendation(flags):
    if any("price" in flag.lower() for flag in flags):
        return "Set a dollars-per-million assumption before using this as a budget signal."
    if any("limit" in flag.lower() for flag in flags):
        return "Set daily and weekly cost limits before the next long agent run."
    if any("uncertainty" in flag.lower() for flag in flags):
        return "Run one shorter, verifier-first pass before trusting a long forecast."
    return "Start the next run with a cost-saver header and a verifier named in the first response."

def local_passport(ctx):
    flags = []
    ready = bool(ctx.get("ready"))
    if not ready:
        flags.append(ctx.get("reason") or "usage index unavailable")
    if ctx.get("price_per_million") is None:
        flags.append("price assumption missing")
    if not ctx.get("daily_cost_limit_usd") and not ctx.get("weekly_cost_limit_usd"):
        flags.append("cost limits not configured")
    if not ctx.get("daily_guardrail_compact") and not ctx.get("weekly_guardrail_compact") and not ctx.get("thirty_day_guardrail_compact"):
        flags.append("token limits not configured")
    if int(ctx.get("uncertainty_percent") or 0) >= 55:
        flags.append("forecast uncertainty high")
    if ctx.get("tracking_enabled") is False:
        flags.append("tracking paused")

    recent = ctx.get("recent_days") if isinstance(ctx.get("recent_days"), list) else []
    selected_rows, selected_start, selected_end = selected_day_rows(ctx)
    nonzero_recent = [day for day in recent if int(day.get("tokens") or 0) > 0]
    nonzero_selected = [day for day in selected_rows if int(day.get("tokens") or 0) > 0]
    start = recent[0].get("date") if recent else None
    end = recent[-1].get("date") if recent else ctx.get("today_key")
    selected_tokens = sum(int(day.get("tokens") or 0) for day in selected_rows)
    selected_cost = (selected_tokens / 1_000_000) * ctx.get("price_per_million") if ctx.get("price_per_million") is not None else None
    selected_peak = max(selected_rows, key=lambda day: int(day.get("tokens") or 0), default=None)
    top_folders = []
    for folder in (ctx.get("top_folders") or [])[:4]:
        top_folders.append({
            "name": folder.get("name") or "project",
            "tokens": int(folder.get("tokens") or 0),
            "compact": folder.get("compact") or compact(folder.get("tokens")),
            "sessions": int(folder.get("sessions") or 0),
            "active": bool(folder.get("active")),
        })

    budget_left = None
    if ctx.get("budget_tokens") and ctx.get("remaining_budget_tokens") is not None:
        budget_left = safe_percent((float(ctx.get("remaining_budget_tokens") or 0) / max(1, float(ctx.get("budget_tokens") or 1))) * 100)

    return {
        "schema": "tokenbar.cost_passport.v1",
        "source": "local-usage-index",
        "generatedAt": datetime.now(timezone.utc).replace(microsecond=0).isoformat(),
        "window": {
            "start": selected_rows[0].get("date") if selected_rows else (selected_start.isoformat() if selected_start else start),
            "end": selected_rows[-1].get("date") if selected_rows else (selected_end.isoformat() if selected_end else end),
            "activeDays": len(nonzero_selected) if (range_start or range_end) else int(ctx.get("active_days_last30") or len(nonzero_recent)),
            "label": "selected local cost range" if (range_start or range_end) else "local 30-day operating window",
            "requestedStart": range_start or None,
            "requestedEnd": range_end or None,
            "daysReturned": len(selected_rows) if (range_start or range_end) else len(recent),
        },
        "summary": {
            "selectedRangeTokens": selected_tokens if (range_start or range_end) else int(ctx.get("last30_tokens") or 0),
            "selectedRange": compact(selected_tokens) if (range_start or range_end) else ctx.get("last30_compact") or compact(ctx.get("last30_tokens")),
            "selectedRangeCost": money(selected_cost) if (range_start or range_end) else money(ctx.get("estimated_30d_cost")),
            "selectedPeakDay": selected_peak.get("date") if selected_peak else ctx.get("peak_day"),
            "selectedPeakTokens": int(selected_peak.get("tokens") or 0) if selected_peak else int(ctx.get("peak_tokens") or 0),
            "selectedPeak": compact(selected_peak.get("tokens")) if selected_peak else ctx.get("peak_compact"),
            "todayTokens": int(ctx.get("today_tokens") or 0),
            "today": ctx.get("today_compact") or compact(ctx.get("today_tokens")),
            "last7Tokens": int(ctx.get("last7_tokens") or 0),
            "last7": ctx.get("last7_compact") or compact(ctx.get("last7_tokens")),
            "last30Tokens": int(ctx.get("last30_tokens") or 0),
            "last30": ctx.get("last30_compact") or compact(ctx.get("last30_tokens")),
            "projectedNext7": ctx.get("projected_next7_compact") or compact(ctx.get("projected_next7_tokens")),
            "projectedNext30": ctx.get("projected_next30_compact") or compact(ctx.get("projected_next30_tokens")),
            "estimated30dCost": money(ctx.get("estimated_30d_cost")),
            "projectedWeeklyCost": money(ctx.get("projected_weekly_cost")),
            "projected30dCost": money(ctx.get("projected_30d_cost")),
            "budgetLeftPercent": budget_left,
            "uncertainty": f"+/-{int(ctx.get('uncertainty_percent') or 0)}%",
            "basis": ctx.get("prediction_basis") or "history only",
        },
        "rangePassport": {
            "command": "tokenbar cost-passport --from YYYY-MM-DD --to YYYY-MM-DD json",
            "selectedRows": selected_rows[-14:] if (range_start or range_end) else recent,
            "estimatedCost": money(selected_cost) if (range_start or range_end) else money(ctx.get("estimated_30d_cost")),
            "peakDay": selected_peak.get("date") if selected_peak else ctx.get("peak_day"),
            "peakTokens": compact(selected_peak.get("tokens")) if selected_peak else ctx.get("peak_compact"),
            "copy": "Use this selected-range passport for planning; do not call it an invoice.",
        },
        "limits": {
            "dailyTokens": ctx.get("daily_guardrail_compact") or "off",
            "weeklyTokens": ctx.get("weekly_guardrail_compact") or "off",
            "thirtyDayTokens": ctx.get("thirty_day_guardrail_compact") or "off",
            "dailyCost": money(ctx.get("daily_cost_limit_usd")) or "off",
            "weeklyCost": money(ctx.get("weekly_cost_limit_usd")) or "off",
        },
        "providerOrProjectMix": top_folders,
        "wasteFlags": flags,
        "nextAction": recommendation(flags),
        "privacy": {
            "rawReportIncluded": False,
            "rawTranscriptsIncluded": False,
            "sourceCodeIncluded": False,
            "localPathsIncluded": False,
            "credentialsIncluded": False,
            "safeForSelectiveShare": True,
        },
        "disclaimer": "Costs are local estimates, not official provider invoices. Token volume is activity evidence, not output quality.",
    }

def imported_passport(pulse):
    totals = pulse.get("totals") if isinstance(pulse.get("totals"), dict) else {}
    last7 = pulse.get("last7Days") if isinstance(pulse.get("last7Days"), dict) else {}
    period = pulse.get("period") if isinstance(pulse.get("period"), dict) else {}
    agent_mix = pulse.get("agentMix") if isinstance(pulse.get("agentMix"), list) else []
    flags = []
    cache_share = pulse.get("cacheSharePercent")
    try:
        if float(cache_share or 0) >= 70:
            flags.append(f"cache traffic is {cache_share}% of measured tokens")
    except Exception:
        pass
    if not totals.get("reportedCostUsd"):
        flags.append("reported cost estimate missing")
    if not agent_mix:
        flags.append("agent attribution missing")

    return {
        "schema": "tokenbar.cost_passport.v1",
        "source": "imported-usage-report",
        "generatedAt": datetime.now(timezone.utc).replace(microsecond=0).isoformat(),
        "window": {
            "start": period.get("start"),
            "end": period.get("end"),
            "activeDays": int(period.get("activeDays") or 0),
            "label": "imported report window",
        },
        "summary": {
            "totalTokens": int(totals.get("totalTokens") or 0),
            "total": compact(totals.get("totalTokens")),
            "freshInputOutput": compact(pulse.get("freshInputOutputTokens")),
            "last7Tokens": int(last7.get("totalTokens") or 0),
            "last7": compact(last7.get("totalTokens")),
            "reportedTotalCost": money(totals.get("reportedCostUsd")),
            "reportedLast7Cost": money(last7.get("reportedCostUsd")),
            "cacheSharePercent": cache_share,
        },
        "limits": {
            "dailyTokens": "not in imported report",
            "weeklyTokens": "not in imported report",
            "thirtyDayTokens": "not in imported report",
            "dailyCost": "not in imported report",
            "weeklyCost": "not in imported report",
        },
        "providerOrProjectMix": [
            {
                "name": item.get("agent") or "agent",
                "tokens": int(item.get("totalTokens") or 0),
                "compact": compact(item.get("totalTokens")),
                "sharePercent": item.get("sharePercent"),
            }
            for item in agent_mix[:5]
        ],
        "wasteFlags": flags,
        "nextAction": recommendation(flags),
        "privacy": {
            "rawReportIncluded": False,
            "rawTranscriptsIncluded": False,
            "sourceCodeIncluded": False,
            "localPathsIncluded": False,
            "credentialsIncluded": False,
            "safeForSelectiveShare": True,
        },
        "disclaimer": pulse.get("disclaimer") or "Costs are local estimates, not official provider invoices.",
    }

pulse = load_env_json("TOKENBAR_USAGE_PULSE")
ctx = load_env_json("TOKENBAR_USAGE_CONTEXT")
passport = imported_passport(pulse) if pulse else local_passport(ctx)

if json_mode:
    print(json.dumps(passport, indent=2, sort_keys=True))
    raise SystemExit(0)

use_color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")

def paint(code, text):
    return f"\033[{code}m{text}\033[0m" if use_color else str(text)

def bold(text):
    return paint("1", text)

def cyan(text):
    return paint("38;5;51", text)

def amber(text):
    return paint("38;5;214", text)

def dim(text):
    return paint("2", text)

summary = passport.get("summary") or {}
window = passport.get("window") or {}
print(bold("TokenBar Cost Passport"))
print(dim(f"{passport['source']} · {window.get('label')} · {window.get('start') or '?'} to {window.get('end') or '?'}"))
print()
if passport["source"] == "imported-usage-report":
    print(f"Total: {cyan(bold(summary.get('total', '0')))} tokens · {amber(bold(summary.get('reportedTotalCost') or 'cost unavailable'))}")
    print(f"Last 7d: {summary.get('last7', '0')} · {summary.get('reportedLast7Cost') or 'cost unavailable'}")
    print(f"Fresh input/output: {summary.get('freshInputOutput', '0')} · cache share {summary.get('cacheSharePercent', 0)}%")
else:
    if window.get("label") == "selected local cost range":
        print(f"Selected range: {cyan(bold(summary.get('selectedRange', '0')))} · estimated {amber(bold(summary.get('selectedRangeCost') or 'set price'))}")
        print(f"Peak: {summary.get('selectedPeakDay') or '?'} · {summary.get('selectedPeak') or '0'}")
    print(f"Last 30d: {cyan(bold(summary.get('last30', '0')))} · estimated {amber(bold(summary.get('estimated30dCost') or 'set price'))}")
    print(f"Next 7d: {summary.get('projectedNext7', '0')} · projected {summary.get('projectedWeeklyCost') or 'set price'} · {summary.get('uncertainty')}")
    print(f"Budget left: {summary.get('budgetLeftPercent') if summary.get('budgetLeftPercent') is not None else 'not set'}")
print()
print(bold("Limits"))
limits = passport.get("limits") or {}
print(f"Tokens: daily {limits.get('dailyTokens')} | weekly {limits.get('weeklyTokens')} | 30d {limits.get('thirtyDayTokens')}")
print(f"Cost: daily {limits.get('dailyCost')} | weekly {limits.get('weeklyCost')}")
print()
print(bold("Mix"))
mix = passport.get("providerOrProjectMix") or []
if mix:
    for item in mix[:5]:
        suffix = f" · {item.get('sharePercent')}%" if item.get("sharePercent") is not None else ""
        print(f"  {item.get('name'):<22} {item.get('compact', compact(item.get('tokens'))):>8}{suffix}")
else:
    print("  No project or provider mix available yet.")
print()
print(bold("Waste flags"))
flags = passport.get("wasteFlags") or []
if flags:
    for flag in flags[:6]:
        print(f"  - {flag}")
else:
    print("  - no obvious aggregate waste flag")
print()
print(bold("Next action"))
print(passport.get("nextAction"))
print()
print(dim(passport.get("disclaimer")))
print(dim("Privacy: aggregate passport only; raw work stays local."))
PY
}

provider_report() {
  local format
  format="${1:-}"
  TOKENBAR_CODEX_INDEX="$usage_index" TOKENBAR_PROVIDER_FORMAT="$format" python3 - <<'PY'
import json
import os
from pathlib import Path

fmt = (os.environ.get("TOKENBAR_PROVIDER_FORMAT") or "").strip().lower()
index_path = Path(os.environ.get("TOKENBAR_CODEX_INDEX") or "")
try:
    index = json.loads(index_path.read_text(encoding="utf-8"))
except Exception:
    index = {}
if not isinstance(index, dict):
    index = {}

model_tokens = index.get("modelTokens") if isinstance(index.get("modelTokens"), dict) else {}

targets = [
    {
        "key": "codex",
        "name": "Codex",
        "aliases": ("codex", "gpt", "openai"),
        "setup": "Run tokenbar usage or refresh the local Codex usage index.",
    },
    {
        "key": "claude-code",
        "name": "Claude Code",
        "aliases": ("claude", "sonnet", "opus"),
        "setup": "Connect a user-approved Claude Code export or official usage API.",
    },
    {
        "key": "cursor",
        "name": "Cursor",
        "aliases": ("cursor",),
        "setup": "Add a user-approved Cursor usage export before calling it measured.",
    },
    {
        "key": "antigravity",
        "name": "Antigravity",
        "aliases": ("antigravity", "anti-gravity"),
        "setup": "Add Antigravity once reliable local usage evidence exists.",
    },
    {
        "key": "opencode",
        "name": "OpenCode",
        "aliases": ("opencode", "open code", "open-code"),
        "setup": "Connect an OpenCode local usage export for open-source IDE tracking.",
    },
]


def safe_int(value):
    try:
        return max(0, int(float(value or 0)))
    except Exception:
        return 0


def compact(value):
    numeric = safe_int(value)
    if numeric >= 1_000_000_000:
        return f"{numeric / 1_000_000_000:.2f}B".replace(".00B", "B")
    if numeric >= 1_000_000:
        return f"{numeric / 1_000_000:.1f}M".replace(".0M", "M")
    if numeric >= 1_000:
        return f"{numeric / 1_000:.1f}K".replace(".0K", "K")
    return str(numeric)


def matched_tokens(aliases):
    total = 0
    lowered = tuple(alias.lower() for alias in aliases)
    for raw_name, raw_tokens in model_tokens.items():
        name = str(raw_name).lower()
        if any(alias in name for alias in lowered):
            total += safe_int(raw_tokens)
    return total


providers = []
for target in targets:
    tokens = matched_tokens(target["aliases"])
    measured = tokens > 0
    providers.append(
        {
            "key": target["key"],
            "name": target["name"],
            "status": "measured" if measured else "setup",
            "tokens": tokens,
            "tokensLabel": compact(tokens),
            "proof": "usage-index modelTokens matched this provider" if measured else "No local aggregate token evidence yet",
            "evidenceNeeded": "Already measured from aggregate local modelTokens." if measured else "A user-approved local usage export or official usage API that exposes aggregate tokens.",
            "command": "tokenbar usage" if measured else "tokenbar providers",
            "setupFlow": [
                {"label": "Detect", "done": measured},
                {"label": "Connect", "done": measured},
                {"label": "Review", "done": measured},
            ],
        }
    )

payload = {
    "schema": "tokenbar.provider_truth.v1",
    "source": "local-model-token-aggregate",
    "providers": providers,
    "privacy": {
        "readOnly": True,
        "providerCalls": False,
        "accountMutation": False,
        "browserCookies": False,
        "credentials": False,
        "rawPrompts": False,
        "externalActions": False,
    },
    "disclaimer": "Measured means local aggregate token evidence exists. Setup means TokenBar has not measured that provider yet.",
}

if fmt in {"json", "--json"}:
    print(json.dumps(payload, indent=2, sort_keys=True))
    raise SystemExit(0)

print("TokenBar provider truth")
print("-----------------------")
measured_count = sum(1 for item in providers if item["status"] == "measured")
print(f"{measured_count} measured · {len(providers) - measured_count} setup")
print()
for item in providers:
    status = f"{item['status']} · {item['tokensLabel']}" if item["status"] == "measured" else "setup"
    print(f"{item['name']}: {status}")
    print(f"  Proof: {item['proof']}")
    print(f"  Need:  {item['evidenceNeeded']}")
    print("  Flow:  " + " -> ".join(f"{step['label']}{'✓' if step['done'] else ''}" for step in item["setupFlow"]))
    print(f"  Run:   {item['command']}")
print()
print("Privacy: read-only aggregate status. No provider API calls, account changes, cookies, credentials, raw prompts, or external actions.")
PY
}

waste_lens_report() {
  local format
  format="${1:-}"
  TOKENBAR_CODEX_INDEX="$usage_index" TOKENBAR_WASTE_FORMAT="$format" python3 - <<'PY'
import json
import os
from pathlib import Path

fmt = (os.environ.get("TOKENBAR_WASTE_FORMAT") or "").strip().lower()
index_path = Path(os.environ.get("TOKENBAR_CODEX_INDEX") or "")
try:
    index = json.loads(index_path.read_text(encoding="utf-8"))
except Exception:
    index = {}
if not isinstance(index, dict):
    index = {}

day_tokens = index.get("dayTokens") if isinstance(index.get("dayTokens"), dict) else {}


def safe_int(value):
    try:
        return max(0, int(float(value or 0)))
    except Exception:
        return 0


def compact(value):
    numeric = safe_int(value)
    if numeric >= 1_000_000_000:
        return f"{numeric / 1_000_000_000:.2f}B".replace(".00B", "B")
    if numeric >= 1_000_000:
        return f"{numeric / 1_000_000:.1f}M".replace(".0M", "M")
    if numeric >= 1_000:
        return f"{numeric / 1_000:.1f}K".replace(".0K", "K")
    return str(numeric)


values = [safe_int(value) for _, value in list(day_tokens.items())[-90:]]
recent = values[-14:]
last7 = values[-7:]
today = values[-1] if values else 0
last7_total = sum(last7)
last30_total = sum(values[-30:])
active_last7 = [value for value in last7 if value > 0]
active_last30 = [value for value in values[-30:] if value > 0]
avg_active = int(sum(active_last7) / max(1, len(active_last7))) if active_last7 else 0
burst_ratio = today / max(1, avg_active) if avg_active else 0
burst_score = min(34, round(max(0, burst_ratio - 1) * 18))
volume_score = min(34, round(last7_total / 1_000_000_000 * 9))
consistency_score = 0 if len(active_last30) >= 4 else 14
score = max(0, min(100, 18 + burst_score + volume_score + consistency_score))
label = "High" if score >= 72 else "Watch" if score >= 42 else "Clear"

drivers = []
if burst_score:
    drivers.append(f"Today is {compact(today)} against a {compact(avg_active)} active-day baseline.")
if volume_score:
    drivers.append(f"The last 7 days used {compact(last7_total)} aggregate tokens.")
if consistency_score:
    drivers.append("Local history is sparse, so a scoped prompt protects the next broad run.")
if not drivers:
    drivers.append("Aggregate usage is below the current waste lens threshold.")

levers = [
    {
        "key": "mission-lock",
        "title": "Scope before run",
        "copy": "Start with budget, route, timebox, context cap, and stop conditions.",
        "impact": "Prevents runaway context and vague delegation.",
        "command": "tokenbar playbooks copy mission-lock",
    },
    {
        "key": "output-budget",
        "title": "Shorten output",
        "copy": "Ask for proof, blockers, and one next action before long prose.",
        "impact": "Cuts answer spillover while preserving review signal.",
        "command": "tokenbar playbooks copy output-budget",
    },
    {
        "key": "cost-passport",
        "title": "Review cost",
        "copy": "Open the cost passport before another broad autonomous loop.",
        "impact": "Turns token volume into a budget decision.",
        "command": "tokenbar cost-passport",
    },
]

payload = {
    "schema": "tokenbar.waste_lens.v1",
    "source": "local-aggregate-usage-shape",
    "score": score,
    "label": label,
    "summary": {
        "today": compact(today),
        "last7": compact(last7_total),
        "last30": compact(last30_total),
        "activeDays30": len(active_last30),
        "peakRecent": compact(max(recent or [0])),
        "basis": "Aggregate token shape only; TokenBar does not judge output quality or read raw prompts.",
    },
    "primaryDriver": drivers[0],
    "drivers": drivers[:3],
    "levers": levers,
    "privacy": {
        "readOnly": True,
        "rawPrompts": False,
        "rawTranscripts": False,
        "sourceCode": False,
        "localPaths": False,
        "credentials": False,
        "providerCalls": False,
        "accountMutation": False,
        "externalActions": False,
        "qualityJudgment": False,
    },
    "disclaimer": "Waste lens is a local aggregate heuristic. It does not read prompt text, source code, transcripts, credentials, provider accounts, or output quality.",
}

if fmt in {"json", "--json"}:
    print(json.dumps(payload, indent=2, sort_keys=True))
    raise SystemExit(0)

print("TokenBar waste lens")
print("-------------------")
print(f"{payload['label']} · {payload['score']}/100")
print(payload["primaryDriver"])
print()
print("Saver levers")
for lever in payload["levers"]:
    print(f"- {lever['title']}: {lever['copy']}")
    print(f"  Run: {lever['command']}")
print()
print("Privacy: aggregate usage shape only; no raw prompts, transcripts, source code, credentials, provider calls, account changes, or output-quality judgment.")
PY
}

