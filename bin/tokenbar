        "No Product Hunt or Macapp Supply submission from this command.",
        "No Stripe, subscription, or entitlement changes from this command.",
        "No account switching, credential use, posting, upload, cleanup, or external automation.",
        "No raw prompts, transcripts, source code, private diffs, local paths, or credentials in public proof.",
    ],
    "siteUrl": site_url,
}

if fmt in {"json", "--json"}:
    print(json.dumps(payload, indent=2, sort_keys=True))
    raise SystemExit(0)

print("TokenBar launch map")
print(payload["principle"])
print()
for ring in payload["rings"]:
    print(f"{ring['name']} [{ring['state']}]")
    for item in ring["items"]:
        print(f"  - {item['label']}: {item['proof']}")
    print()
print("Commands")
for row in payload["commands"]:
    print(f"  {row['label']}: {row['command']}")
print()
print("Approval gates")
for gate in payload["approvalGates"]:
    print(f"  - {gate}")
PY
}

coach_command() {
  local format
  format="${1:-}"
  local context_json
  context_json="$(usage_context_json 2>/dev/null || printf '{}')"

  TOKENBAR_COACH_FORMAT="$format" \
  TOKENBAR_USAGE_CONTEXT="$context_json" \
  TOKENBAR_INSTALL_COMMAND_VALUE="$install_command" \
  python3 - <<'PY'
import json
import os

fmt = (os.environ.get("TOKENBAR_COACH_FORMAT") or "").strip().lower()
install_command = os.environ.get("TOKENBAR_INSTALL_COMMAND_VALUE") or "curl -fsSL https://raw.githubusercontent.com/Arnie016/TokenBar/main/install.sh | bash"

try:
    ctx = json.loads(os.environ.get("TOKENBAR_USAGE_CONTEXT") or "{}")
except Exception:
    ctx = {}

def compact(value):
    try:
        value = float(value or 0)
    except Exception:
        value = 0
    if value >= 1_000_000_000:
        return f"{value / 1_000_000_000:.2f}B".replace(".00B", "B")
    if value >= 1_000_000:
        return f"{value / 1_000_000:.1f}M".replace(".0M", "M")
    if value >= 1_000:
        return f"{value / 1_000:.1f}K".replace(".0K", "K")
    return str(int(max(0, value)))

def boolish(value):
    return value is True or str(value).lower() == "true"

ready = bool(ctx.get("ready"))
today = int(ctx.get("today_tokens") or 0)
last7 = int(ctx.get("last7_tokens") or 0)
projected7 = int(ctx.get("projected_next7_tokens") or 0)
tracking = ctx.get("tracking_enabled")
price = ctx.get("price_per_million")
activity = ctx.get("activity_signals_enabled")

choices = [
    {
        "key": "install",
        "label": "Install the cockpit",
        "command": install_command,
        "why": "Use this when TokenBar is not on the Mac yet or the app needs a refresh.",
        "approvalRequired": False,
    },
    {
        "key": "analyze",
        "label": "Analyze local usage",
        "command": "tokenbar usage",
        "why": "Build the local usage story before changing budgets or publishing proof.",
        "approvalRequired": False,
    },
    {
        "key": "budget",
        "label": "Set a budget brief",
        "command": "tokenbar reminders",
        "why": "Turn token pressure into a suggested-only reminder and next-run cap.",
        "approvalRequired": True,
    },
    {
        "key": "playbook",
        "label": "Copy a cheaper prompt",
        "command": "tokenbar playbooks copy budget-runway",
        "why": "Start the next long run with budget, route, timebox, context cap, verifier, and stop.",
        "approvalRequired": False,
    },
    {
        "key": "proof",
        "label": "Review proof packet",
        "command": "tokenbar proof-packet",
        "why": "Prepare launch, directory, or investor proof without exposing raw work.",
        "approvalRequired": True,
    },
]

if not ready:
    recommended = "install"
    state = "setup"
    reason = ctx.get("reason") or "TokenBar has not found enough local aggregate usage yet."
elif tracking is False:
    recommended = "analyze"
    state = "paused"
    reason = "Tracking is paused, so new local sessions may not appear in the current story."
elif price is None:
    recommended = "budget"
    state = "cost-blind"
    reason = "Token pressure is visible, but dollar-cost reminders need a price assumption."
elif projected7 and last7 and projected7 > last7 * 1.2:
    recommended = "playbook"
    state = "rising"
    reason = f"The next 7 days project to {compact(projected7)}, above the recent {compact(last7)} window."
elif today > 0:
    recommended = "proof"
    state = "ready"
    reason = f"TokenBar has local usage today ({compact(today)}) and can package safe proof for review."
else:
    recommended = "analyze"
    state = "quiet"
    reason = "Usage is quiet; refresh local evidence before making a claim."

recommended_choice = next(choice for choice in choices if choice["key"] == recommended)
payload = {
    "schema": "tokenbar.coach.v1",
    "product": "TokenBar",
    "state": state,
    "question": "What should TokenBar help with before your next AI coding run?",
    "recommended": recommended_choice,
    "choices": choices,
    "localContext": {
        "ready": ready,
        "todayTokens": today,
        "last7Tokens": last7,
        "projected7Tokens": projected7,
        "trackingEnabled": tracking,
        "activitySignalsEnabled": activity,
        "pricePerMillionSet": price is not None,
    },
    "reason": reason,
    "commands": [
        {"label": "Open icon bar", "command": "tokenbar open"},
        {"label": "Start local API", "command": "tokenbar api"},
        {"label": "Browser companion", "command": "tokenbar browser-companion"},
        {"label": "Launch map", "command": "tokenbar runway"},
    ],
    "privacy": {
        "rawPrompts": False,
        "transcripts": False,
        "sourceCode": False,
        "credentials": False,
        "providerCalls": False,
        "accountMutation": False,
        "externalActions": False,
        "scheduledNotifications": False,
    },
    "disclaimer": "Suggested-only local guide. TokenBar does not schedule reminders, change accounts, call providers, publish proof, enable payments, close apps, or upload private work from this command.",
}

if fmt in {"json", "--json"}:
    print(json.dumps(payload, indent=2, sort_keys=True))
    raise SystemExit(0)

print("TokenBar coach")
print(payload["question"])
print()
print(f"State: {payload['state']}")
print(f"Why: {payload['reason']}")
print()
print("Recommended")
print(f"  {recommended_choice['label']}: {recommended_choice['command']}")
print(f"  {recommended_choice['why']}")
print(f"  Approval required: {str(recommended_choice['approvalRequired']).lower()}")
print()
print("Other choices")
for choice in payload["choices"]:
    if choice["key"] == recommended_choice["key"]:
        continue
    print(f"  - {choice['label']}: {choice['command']}")
print()
print("Bridge commands")
for row in payload["commands"]:
    print(f"  {row['label']}: {row['command']}")
print()
print(payload["disclaimer"])
PY
}

identity_quickstart() {
  local endpoint action_endpoint
  endpoint="${TOKENBAR_PROFILE_UPLOAD_URL:-$site_url/api/profiles}"
  action_endpoint="${TOKENBAR_ACTION_URL:-${TOKENBAR_ACTION_ENDPOINT:-$site_url/api/actions}}"

  TOKENBAR_QUICKSTART_CONTEXT="{}" \
  TOKENBAR_QUICKSTART_ENDPOINT="$endpoint" \
  TOKENBAR_QUICKSTART_ACTION_ENDPOINT="$action_endpoint" \
  python3 - <<'PY'
import json
import os
from urllib.parse import urlsplit

ctx = json.loads(os.environ.get("TOKENBAR_QUICKSTART_CONTEXT") or "{}")
endpoint = os.environ.get("TOKENBAR_QUICKSTART_ENDPOINT") or ""
action_endpoint = os.environ.get("TOKENBAR_QUICKSTART_ACTION_ENDPOINT") or ""
providers = ctx.get("provider_sources") if isinstance(ctx.get("provider_sources"), list) else []
analyses = ctx.get("provider_analyses") if isinstance(ctx.get("provider_analyses"), dict) else {}
sessions = ctx.get("session_analysis") if isinstance(ctx.get("session_analysis"), dict) else {}
base_url = endpoint.split("/api/profiles", 1)[0].rstrip("/") if "/api/profiles" in endpoint else ""
if not base_url and endpoint:
    parsed = urlsplit(endpoint)
    if parsed.scheme and parsed.netloc:
        base_url = f"{parsed.scheme}://{parsed.netloc}".rstrip("/")
profile_url = f"{base_url}/profile" if base_url else "/profile"
social_url = f"{base_url}/social" if base_url else "/social"
rankings_url = f"{base_url}/rankings" if base_url else "/rankings"

print("TokenBar identity quickstart")
print()
print("Social / hackathon path")
print("   tokenbar join --project \"My Codex App\"")
print("   Runs local analysis, attaches this repo as a public project card, returns direct profile/social/ranking links.")
print()
print("Fast path")
print("   tokenbar prove")
print("   Runs the local identity analysis, publishes only generated safe proof fields, and returns a TBAR token.")
print()
print("Private review path")
print("1. Claim your private builder identity")
print("   tokenbar claim")
print("   Creates local HTML/PDF-ready report files, identity JSON, Skill.md, and a TBAR token.")
print()
print("Specific session/project story")
print("   tokenbar claim 019e...")
print("   Optional: tokenbar claim 019e... --spotlight-project \"AI video editor\"")
print("   Optional: add --spotlight-struggle, --spotlight-feature, and --spotlight-progress.")
print("   This names the session/project in your report, feed, proof card, and trailer without reading or uploading the raw thread.")
print()
print("2. Inspect before sharing")
print("   tokenbar card")
print("   tokenbar skill")
print("   tokenbar verify")
print()
print("3. Optional: publish a safe proof card")
print("   tokenbar publish-proof")
print("   Sends generated identity evidence only, then returns a proof card, profile link, For You feed entry, and rankings proof.")
print()
print("4. Paste the returned TBAR token into the website")
print(f"   {profile_url}")
print(f"   {social_url}")
print(f"   {rankings_url}")
print("   These pages open the public profile, For You proof feed, and proof/loop/specificity leaderboards.")
print()
print("5. Inspect local report history and evolution")
print("   tokenbar history")
print("   tokenbar rankings")
print("   tokenbar timeline")
print()
print("6. Compare against an older report when you have one")
print("   tokenbar compare latest")
print("   tokenbar compare old.identity.json new.identity.json")
print()
print("7. Create a portable portfolio bundle")
print("   tokenbar bundle")
print("   tokenbar proof")
print()
print("8. View aggregate opt-in stats")
print("   tokenbar stats")
print()
print("Proof action endpoint")
print(f"   {action_endpoint}")
print()
print("Advanced profile JSON endpoint")
print(f"   {endpoint}")
print()
print("Privacy boundary")
print("   Local analysis reads aggregate usage and bounded/redacted session signals.")
print("   Exports do not include raw transcripts or source code.")
print("   Publishing uploads only generated identity/proof fields after you run tokenbar publish-proof.")
print()
print("Local signal status")
if sessions.get("available"):
    print(f"   Codex: {sessions.get('promptCount', 0)} sampled prompts, raw transcripts included = {sessions.get('rawTranscriptsIncluded')}")
else:
    print(f"   Codex: unavailable ({sessions.get('reason', 'no local signal')})")
for item in providers:
    name = item.get("name", "Provider")
    status = item.get("status", "unknown")
    found = "found" if item.get("found") else "not found"
    analysis = analyses.get(item.get("key")) if isinstance(analyses.get(item.get("key")), dict) else {}
    parsed = ""
    if analysis:
        if analysis.get("available"):
            parsed = f"; parsed {analysis.get('promptCount', analysis.get('artifactCount', 0))} signals"
        elif analysis.get("reason"):
            parsed = f"; {analysis.get('reason')}"
    print(f"   {name}: {status}, {found}{parsed}")
print()
print("Install/distribution")
print("   pip install tokenbar")
print("   tokenbar quickstart")
print("   tokenbar claim")
PY
}

identity_readiness() {
  local endpoint
  endpoint="${TOKENBAR_PROFILE_UPLOAD_URL:-$site_url/api/profiles}"

  TOKENBAR_READINESS_DIR="$support_dir/profiles" TOKENBAR_READINESS_ENDPOINT="$endpoint" python3 - <<'PY'
import json
import os
import zipfile
from pathlib import Path

root = Path(os.environ["TOKENBAR_READINESS_DIR"]).expanduser()
endpoint = os.environ.get("TOKENBAR_READINESS_ENDPOINT") or ""
identity_paths = sorted(root.glob("*.identity.json"), key=lambda item: item.stat().st_mtime, reverse=True) if root.exists() else []
manifest_paths = sorted(root.glob("*.manifest.json"), key=lambda item: item.stat().st_mtime, reverse=True) if root.exists() else []
skill_paths = sorted(root.glob("*.skill.md"), key=lambda item: item.stat().st_mtime, reverse=True) if root.exists() else []
timeline_paths = sorted(root.glob("*timeline*.html"), key=lambda item: item.stat().st_mtime, reverse=True) if root.exists() else []
proof_paths = sorted(root.glob("*proof*.zip"), key=lambda item: item.stat().st_mtime, reverse=True) if root.exists() else []

checks = []
next_steps = []

def add(name, ok, detail, next_step=None):
    checks.append((name, ok, detail))
    if not ok and next_step:
        next_steps.append(next_step)

latest = None
latest_path = identity_paths[0] if identity_paths else None
if latest_path:
    try:
        latest = json.loads(latest_path.read_text(encoding="utf-8"))
    except Exception as exc:
        latest = None
        add("Latest identity JSON", False, f"unreadable: {exc}", "Run tokenbar identity")
else:
    add("Latest identity JSON", False, "none found", "Run tokenbar identity")

if latest:
    privacy = latest.get("privacy") if isinstance(latest.get("privacy"), dict) else {}
    shipping = latest.get("shippingAnalysis") if isinstance(latest.get("shippingAnalysis"), dict) else {}
    session = latest.get("sessionAnalysis") if isinstance(latest.get("sessionAnalysis"), dict) else {}
    label_model = latest.get("labelModel") if isinstance(latest.get("labelModel"), dict) else {}
    add("Latest identity JSON", latest.get("schema") == "tokenbar.identity.v1", str(latest_path), "Regenerate with tokenbar identity")
    add("Privacy boundary", privacy.get("rawTranscriptsIncluded") is False and privacy.get("sourceCodeIncluded") is False, f"raw={privacy.get('rawTranscriptsIncluded')} source={privacy.get('sourceCodeIncluded')}", "Regenerate and verify with tokenbar verify")
    add("Probabilistic label model", int(label_model.get("possibleLabels") or 0) > 0, f"{label_model.get('possibleLabels', 0)} buckets", "Regenerate with the latest tokenbar analyze")
    add("Session analysis", bool(session.get("available")), f"{session.get('promptCount', 0)} prompts" if session.get("available") else session.get("reason", "unavailable"), "Use Codex locally, then rerun tokenbar analyze")
    add("Shipping evidence", bool(shipping.get("available")), f"{shipping.get('commitCount', 0)} commits; net LOC {shipping.get('netLoc', 0)}" if shipping.get("available") else shipping.get("reason", "unavailable"), "Run tokenbar analyze from inside a git repository")

add("Skill.md export", bool(skill_paths), str(skill_paths[0]) if skill_paths else "none found", "Run tokenbar skill --output ./TOKENBAR_SKILL.md")
add("Share manifest", bool(manifest_paths), str(manifest_paths[0]) if manifest_paths else "none found", "Run tokenbar identity")
add("Timeline report", bool(timeline_paths), str(timeline_paths[0]) if timeline_paths else "none found", "Run tokenbar timeline")

proof_ok = False
proof_detail = "none found"
if proof_paths:
    proof_detail = str(proof_paths[0])
    try:
        with zipfile.ZipFile(proof_paths[0]) as zf:
            manifest = json.loads(zf.read("tokenbar-proof-manifest.json").decode("utf-8"))
            privacy = manifest.get("privacy") if isinstance(manifest.get("privacy"), dict) else {}
            proof_ok = manifest.get("schema") == "tokenbar.proof-packet.v1" and privacy.get("rawTranscriptsIncluded") is False and privacy.get("sourceCodeIncluded") is False
    except Exception as exc:
        proof_detail = f"{proof_paths[0]} unreadable: {exc}"
add("Proof packet", proof_ok, proof_detail, "Run tokenbar proof, then tokenbar verify path/to/proof.zip")

hosted_configured = endpoint.startswith("http")
add("Hosted endpoint configured", hosted_configured, endpoint or "missing", "Set TOKENBAR_PROFILE_UPLOAD_URL or use the default hosted endpoint")

ready_count = sum(1 for _, ok, _ in checks if ok)
print("TokenBar identity readiness")
print(f"Profiles dir: {root}")
print(f"Ready checks: {ready_count}/{len(checks)}")
print()
for name, ok, detail in checks:
    marker = "PASS" if ok else "TODO"
    print(f"[{marker}] {name}: {detail}")

if latest:
    print()
    print("Latest profile")
    print(f"  Title: {latest.get('title')}")
    print(f"  Token: {latest.get('token')}")
    print(f"  Specificity: {latest.get('specificityScore', 0)}/100")
    print(f"  NPC class: {latest.get('npcClass')}")

if next_steps:
    print()
    print("Next steps")
    for item in dict.fromkeys(next_steps):
        print(f"  - {item}")
else:
    print()
    print("Ready: local identity, packet, and hosted share path look prepared.")
PY
}

