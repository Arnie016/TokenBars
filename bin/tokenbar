def professional_domain_profile_records():
    skill_lift_base = clamp(traits["orchestration"] * 0.34 + traits["artifact"] * 0.24 + traits["engineering"] * 0.18 + traits["research_depth"] * 0.14 + traits["taste"] * 0.10)
    domains = [
        ("Software Engineering", 18, clamp(traits["engineering"] * 0.42 + traits["planning"] * 0.20 + traits["execution"] * 0.18 + traits["orchestration"] * 0.20), "Best when the agent has repo structure, tests, and a clear stop condition."),
        ("Infrastructure & Systems", 13, clamp(traits["infrastructure"] * 0.38 + traits["orchestration"] * 0.25 + traits["engineering"] * 0.22 + traits["local_first"] * 0.15), "Strong when skills encode setup, env, webhooks, deployment, and observability steps."),
        ("Product & Growth", 12, clamp(traits["product_instinct"] * 0.40 + traits["monetization"] * 0.25 + traits["taste"] * 0.18 + traits["artifact"] * 0.17), "Useful for pricing, activation, trial, share, leaderboard, and proof-loop work."),
        ("Research & Synthesis", 11, clamp(traits["research_depth"] * 0.42 + traits["planning"] * 0.18 + traits["identitySignal"] if "identitySignal" in traits else traits["session_identity"] * 0.16 + traits["engineering"] * 0.24), "Works when the skill forces source boundaries, comparison, methodology, and evidence notes."),
        ("Finance & Economics", 9, clamp(traits["monetization"] * 0.35 + traits["product_instinct"] * 0.25 + traits["research_depth"] * 0.20 + traits["planning"] * 0.20), "Fits market, pricing, trial, entitlement, and unit-economics reasoning."),
        ("Design & Media", 10, clamp(traits["taste"] * 0.52 + traits["artifact"] * 0.24 + traits["product_instinct"] * 0.14 + traits["research_depth"] * 0.10), "Strong when the skill contains examples, art direction, output formats, and visual QA."),
        ("Security & Privacy", 8, clamp(traits["local_first"] * 0.44 + traits["engineering"] * 0.24 + traits["planning"] * 0.18 + traits["research_depth"] * 0.14), "Important for local-first claims, secret boundaries, redaction, and share manifests."),
        ("Operations & Support", 10, clamp(traits["execution"] * 0.28 + traits["consistency"] * 0.22 + traits["orchestration"] * 0.22 + traits["artifact"] * 0.16 + traits["planning"] * 0.12), "Fits runbooks, correction workflows, report feedback, email delivery, and customer support loops."),
    ]
    records = []
    for idx, (name, tasks, base_score, read) in enumerate(domains):
        lift = clamp(skill_lift_base * 0.10 + (idx % 3) * 2 + (6 if base_score >= 60 else 10))
        without_skills = int(clamp(base_score - max(4, lift * 0.45)))
        with_skills = int(clamp(base_score + lift))
        records.append({
            "domain": name,
            "tasks": tasks,
            "withoutSkills": without_skills,
            "withSkills": with_skills,
            "skillLift": with_skills - without_skills,
            "read": read,
        })
    return sorted(records, key=lambda item: item["withSkills"], reverse=True)

professional_domain_records = professional_domain_profile_records()

def professional_domain_svg():
    width = 620
    height = 560
    cx = width / 2
    cy = height / 2 + 12
    radius = 190
    ordered = professional_domain_records
    def point(score, idx):
        angle = -math.pi / 2 + idx * (2 * math.pi / len(ordered))
        r = radius * (score / 100)
        return cx + math.cos(angle) * r, cy + math.sin(angle) * r
    rings = "\n".join(
        f"<circle class='domain-ring' cx='{cx:.1f}' cy='{cy:.1f}' r='{radius * step / 5:.1f}' />"
        for step in range(1, 6)
    )
    axes = []
    labels = []
    skill_points = []
    base_points = []
    for idx, item in enumerate(ordered):
        angle = -math.pi / 2 + idx * (2 * math.pi / len(ordered))
        ax = cx + math.cos(angle) * radius
        ay = cy + math.sin(angle) * radius
        lx = cx + math.cos(angle) * (radius + 56)
        ly = cy + math.sin(angle) * (radius + 56)
        axes.append(f"<line class='domain-axis' x1='{cx:.1f}' y1='{cy:.1f}' x2='{ax:.1f}' y2='{ay:.1f}' />")
        labels.append(f"<text class='domain-label' x='{lx:.1f}' y='{ly:.1f}' text-anchor='middle'>{esc(item['domain'])}</text>")
        sx, sy = point(item["withSkills"], idx)
        bx, by = point(item["withoutSkills"], idx)
        skill_points.append(f"{sx:.1f},{sy:.1f}")
        base_points.append(f"{bx:.1f},{by:.1f}")
    return f"""
<svg class="domain-profile-svg" viewBox="0 0 {width} {height}" role="img" aria-label="Professional domain profile with and without agent skills">
  <defs>
    <linearGradient id="domainSkillFill" x1="0%" x2="100%">
      <stop offset="0%" stop-color="{theme['accent']}" stop-opacity=".42" />
      <stop offset="100%" stop-color="{theme['green'] if 'green' in theme else theme['accent2']}" stop-opacity=".28" />
    </linearGradient>
  </defs>
  <rect x="18" y="18" width="{width - 36}" height="{height - 36}" rx="28" />
  <text x="42" y="58">PROFESSIONAL-DOMAIN PROFILE</text>
  <text x="42" y="82" style="font-size:13px">solid = with skills · pale = unaided builder signal</text>
  {rings}
  {''.join(axes)}
  <polygon class="domain-base" points="{' '.join(base_points)}" />
  <polygon class="domain-skill" points="{' '.join(skill_points)}" />
  {''.join(labels)}
</svg>
"""

professional_domain_chart = professional_domain_svg()
domain_profile_rows = "\n".join(
    f"<div class='domain-row'><div><strong>{esc(item['domain'])}</strong><small>{item['tasks']} evaluated tasks</small></div>"
    f"<span>{item['withoutSkills']} → {item['withSkills']}%</span><i><b style='width:{item['withSkills']}%'></b></i>"
    f"<em>+{item['skillLift']} skill lift</em><p>{esc(item['read'])}</p></div>"
    for item in professional_domain_records[:5]
)

def identity_pitch_svg():
    markers = []
    trails = []
    ordered = []
    for name, score_value, copy in power_axes:
        position, base_x, base_y, pitch_copy = axis_positions.get(name, (name, 300, 180, copy))
        bias = (score_value - 50) / 50
        x = base_x + (bias * 22 if base_x != 300 else bias * 12)
        y = base_y - bias * 18
        ordered.append((x, y))
        markers.append(
            f"<g class='pitch-dot'><circle cx='{x:.1f}' cy='{y:.1f}' r='13' />"
            f"<text x='{x:.1f}' y='{y - 22:.1f}' text-anchor='middle'>{score_value}</text>"
            f"<title>{esc(position)}: {score_value}. {esc(pitch_copy)}</title></g>"
        )
    if ordered:
        trails.append(" ".join(f"{x:.1f},{y:.1f}" for x, y in ordered + [ordered[0]]))
    return f"""
<svg class="identity-pitch-svg" viewBox="0 0 600 330" role="img" aria-label="TokenBar builder scouting pitch">
  <defs>
    <linearGradient id="pitchTrail" x1="0%" x2="100%">
