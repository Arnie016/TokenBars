def band_for_score(value):
    value = int(value or 0)
    if value >= 85:
        return "signature strength"
    if value >= 70:
        return "strong pattern"
    if value >= 55:
        return "emerging pattern"
    if value >= 40:
        return "thin signal"
    return "under-sampled"

def fine_grained_signal_records():
    session = ctx.get("session_analysis") if isinstance(ctx.get("session_analysis"), dict) else {}
    prompt_count = int(session.get("promptCount") or 0)
    command_ratio = int(float(session.get("commandPromptRatio") or 0) * 100)
    short_ratio = int(float(session.get("shortPromptRatio") or 0) * 100)
    redirection = int(float(session.get("redirectionSignal") or 0) * 100)
    planning = int(float(session.get("planningSignal") or 0) * 100)
    visual = int(float(session.get("visualSignal") or 0) * 100)
    identity = int(float(session.get("identitySignal") or 0) * 100)
    monetization = int(float(session.get("monetizationSignal") or 0) * 100)
    privacy = int(float(session.get("privacySignal") or 0) * 100)
    facts = [
        ("Prompt compression", clamp(short_ratio * 0.62 + command_ratio * 0.30 + traits["steering"] * 0.08), "How much steering happens in short, high-context commands.", "Keep reusable prompt macros for repeated moves."),
        ("Correction pressure", clamp(redirection * 0.72 + traits["steering"] * 0.18 + traits["volatility"] * 0.10), "How often the human redirects, tightens scope, or corrects the run.", "Tag corrections by cause: wrong file, weak taste, missing proof, or risky assumption."),
        ("Planning before motion", clamp(planning * 0.58 + traits["planning"] * 0.32 + traits["engineering"] * 0.10), "Whether the work gets framed before code or assets start moving.", "Make the pre-run plan one screen: intent, files, stop condition, verification."),
        ("Artifact maturity", clamp(traits["artifact"] * 0.48 + traits["taste"] * 0.30 + visual * 0.22), "Whether sessions become PDFs, pages, docs, reports, Skill.md files, or share packets.", "Name the artifact before the run starts so the output has a destination."),
        ("Commercial instinct", clamp(traits["monetization"] * 0.46 + traits["product_instinct"] * 0.32 + monetization * 0.22), "How often the work touches pricing, trust, access, conversion, support, or renewal.", "Pair every checkout or launch change with a buyer promise and failure path."),
        ("Privacy boundary", clamp(traits["local_first"] * 0.52 + privacy * 0.36 + traits["engineering"] * 0.12), "Whether the product can explain what stays local and what gets shared.", "Put the upload boundary in every share flow and exported report."),
        ("Toolchain breadth", clamp(traits["orchestration"] * 0.44 + traits["infrastructure"] * 0.34 + min(100, len(provider_sources) * 18) * 0.22), "How much value comes from connecting Codex, Claude Code, Cursor, Antigravity, OpenCode, APIs, webhooks, and local logs.", "Turn provider support into a visible inventory with status and evidence."),
        ("Evidence discipline", clamp(traits["research_depth"] * 0.38 + traits["engineering"] * 0.22 + traits["planning"] * 0.18 + (100 if shipping_analysis.get("available") else 35) * 0.22), "How strongly the report can defend claims with metadata, commits, sessions, or artifacts.", "Separate claims from proof: each strong claim should cite one local metadata source."),
        ("Rhythm consistency", clamp(traits["consistency"] * 0.62 + traits["density"] * 0.20 + max(0, 100 - traits["volatility"]) * 0.18), "Whether the work style is steady or bursty.", "Compare weekday rhythm against shipping outcomes, not token volume alone."),
        ("Spike risk", clamp(traits["volatility"] * 0.50 + traits["surge"] * 0.30 + traits["projection_pressure"] * 0.20), "How likely the profile is driven by intense bursts that need cleanup afterward.", "After spikes, require a stabilization pass and a report note on what remains brittle."),
        ("Portfolio proof", clamp(traits["artifact"] * 0.34 + traits["product_instinct"] * 0.24 + traits["taste"] * 0.24 + traits["local_first"] * 0.18), "How easily the work can become resume, LinkedIn, school, hiring, or investor proof.", "Export one public-safe card plus one private detailed PDF for each serious project."),
        ("Identity specificity", clamp(specificity_score * 0.48 + identity * 0.28 + prompt_count * 0.08 + traits["artifact"] * 0.16), "How sharply this builder differs from a generic coding-agent user.", "Increase specificity by linking repeated behaviors to concrete project outcomes."),
    ]
    records = []
    for name, value, interpretation, next_step in facts:
        value = int(clamp(value))
        records.append({
            "name": name,
            "score": value,
            "band": band_for_score(value),
            "interpretation": interpretation,
            "nextStep": next_step,
        })
    return sorted(records, key=lambda item: item["score"], reverse=True)

