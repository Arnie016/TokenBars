  latest="$(ls -t "$output_dir"/tokenbar-profile-*.html 2>/dev/null | head -n 1 || true)"
  html_path="$latest"

  if [[ "$pdf_report" == true ]]; then
    if [[ -z "$html_path" ]]; then
      echo "Could not locate the generated profile HTML for PDF export." >&2
      return 1
    fi
    pdf_path="${html_path%.html}.pdf"
    if render_profile_pdf "$html_path" "$pdf_path"; then
