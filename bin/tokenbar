def report_spine_svg():
    nodes = [
        ("Profile", top_dimension[1], theme["accent"]),
        ("Evidence", second_dimension[1], theme["accent2"]),
        ("Surprise", max((item.get("value") for item in []), default=leaderboard_score), theme["warm"]),
        ("Growth", weak_dimension[1], "#0b1220"),
    ]
    coords = []
    for idx, (name, score_value, color) in enumerate(nodes):
        x = 58 + idx * 168
        y = 122 - (min(100, max(0, int(score_value))) * 0.62)
        coords.append((x, y, name, score_value, color))
    path = " ".join(f"{x:.1f},{y:.1f}" for x, y, _, _, _ in coords)
    dots = "".join(
        f"<g><circle cx='{x:.1f}' cy='{y:.1f}' r='11' fill='{color}' />"
        f"<text x='{x:.1f}' y='146' text-anchor='middle'>{esc(name)}</text>"
        f"<text x='{x:.1f}' y='{y - 18:.1f}' text-anchor='middle'>{int(score_value)}</text></g>"
        for x, y, name, score_value, color in coords
    )
    return f"""
<svg class="report-spine-svg" viewBox="0 0 590 170" role="img" aria-label="Report-wide narrative spine">
  <defs>
    <linearGradient id="reportSpineTrail" x1="0%" x2="100%">
      <stop offset="0%" stop-color="{theme['accent']}" />
      <stop offset="50%" stop-color="{theme['accent2']}" />
      <stop offset="100%" stop-color="{theme['warm']}" />
    </linearGradient>
  </defs>
  <rect x="18" y="20" width="554" height="126" rx="22" />
  <path d="M{path}" />
  {dots}
</svg>
"""

report_spine = report_spine_svg()

