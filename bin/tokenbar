      manifest_path="${html_path%.html}.manifest.json"
      if [[ -f "$manifest_path" ]]; then
        TOKENBAR_PROFILE_MANIFEST_PATH="$manifest_path" TOKENBAR_PROFILE_PDF_PATH="$pdf_path" python3 - <<'PY'
import json
import os
from pathlib import Path

manifest_path = Path(os.environ["TOKENBAR_PROFILE_MANIFEST_PATH"])
pdf_path = Path(os.environ["TOKENBAR_PROFILE_PDF_PATH"])
try:
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
except Exception:
    manifest = {}
files = manifest.get("files")
if not isinstance(files, dict):
    files = {}
files["pdf"] = str(pdf_path)
manifest["files"] = files
manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
      fi
    else
      return 1
    fi
  fi

  if [[ -n "$email_to" ]]; then
    if [[ -z "${pdf_path:-}" || ! -f "$pdf_path" ]]; then
      echo "Could not locate the generated profile PDF for email delivery." >&2
      return 1
    fi
    send_profile_email "$email_to" "$pdf_path"
  fi

  if [[ "$open_report" == true ]]; then
    if [[ -n "${pdf_path:-}" && -f "$pdf_path" ]]; then
      open "$pdf_path"
    elif [[ -n "$html_path" ]]; then
      open "$html_path"
    fi
  fi
}

share_profile() {
  local identity_path endpoint
  identity_path="${1:-}"
  endpoint="${TOKENBAR_PROFILE_UPLOAD_URL:-$site_url/api/profiles}"

  if [[ "$identity_path" == "latest" ]]; then
    identity_path=""
  fi

  if [[ -z "$identity_path" ]]; then
    identity_path="$(ls -t "$support_dir"/profiles/*.identity.json 2>/dev/null | head -n 1 || true)"
  fi

  if [[ -z "$identity_path" || ! -f "$identity_path" ]]; then
    cat >&2 <<'EOF'
No identity JSON found.
Generate one first:
  tokenbar identity

Or pass a file:
  tokenbar share /path/to/profile.identity.json
EOF
    return 1
  fi

  local verify_log
  verify_log="$(mktemp "${TMPDIR:-/tmp}/tokenbar-share-verify.XXXXXX")"
  if ! verify_identity_artifact "$identity_path" >"$verify_log" 2>&1; then
    cat "$verify_log" >&2
    rm -f "$verify_log"
    return 1
  fi
  rm -f "$verify_log"

  TOKENBAR_SHARE_IDENTITY_PATH="$identity_path" TOKENBAR_PROFILE_UPLOAD_ENDPOINT="$endpoint" TOKENBAR_PROFILE_OWNER_KEY_PATH="$support_dir/proof-owner-key" TOKENBAR_ACTION_WRITE_TOKEN="${TOKENBAR_ACTION_WRITE_TOKEN:-}" python3 - <<'PY'
import json
import os
import secrets
import urllib.error
import urllib.request
from pathlib import Path

path = Path(os.environ["TOKENBAR_SHARE_IDENTITY_PATH"]).expanduser()
endpoint = os.environ["TOKENBAR_PROFILE_UPLOAD_ENDPOINT"]
payload = json.loads(path.read_text(encoding="utf-8"))

privacy = payload.get("privacy") or {}
if privacy.get("rawTranscriptsIncluded") or privacy.get("sourceCodeIncluded"):
    raise SystemExit("Refusing to upload an identity file that claims to include raw transcripts or source code.")

# Direct profile upload is a legacy compatibility path. Keep the same compact
# public boundary as publish-proof instead of sending local report/visual data.
allowed = {
    "schema",
    "token",
    "title",
    "subtitle",
    "primaryArchetype",
    "npcClass",
    "identityLabel",
    "labelRationale",
    "archetypeDistribution",
    "modifierDistribution",
    "stanceDistribution",
    "labelDistribution",
    "labelModel",
    "specificityScore",
    "estimatedRarityPercent",
    "proofScore",
    "loopMaturity",
    "loopScore",
    "loopScale",
    "privacy",
    "dimensions",
    "usage",
    "sessionAnalysis",
    "shippingAnalysis",
    "providerAnalyses",
    "builderSignalInbox",
    "socialLearningSignals",
    "publicProfile",
    "hackathonSubmission",
    "submittedProject",
    "leaderboard",
    "spotlightSources",
    "generatedAt",
}
payload = {key: value for key, value in payload.items() if key in allowed}
payload.setdefault("privacy", {})["rawTranscriptsIncluded"] = False
payload.setdefault("privacy", {})["sourceCodeIncluded"] = False
payload.setdefault("privacy", {})["publicMetadataOnly"] = True
encoded_payload = json.dumps(payload).encode("utf-8")
if len(encoded_payload) > 240_000:
    raise SystemExit(
        f"Public-safe identity payload is still too large ({len(encoded_payload)} bytes); use tokenbar publish-proof."
    )

owner_path = Path(os.environ["TOKENBAR_PROFILE_OWNER_KEY_PATH"]).expanduser()
owner_path.parent.mkdir(parents=True, exist_ok=True)
if owner_path.exists():
    owner_key = owner_path.read_text(encoding="utf-8").strip()
else:
    owner_key = secrets.token_urlsafe(48)
    descriptor = os.open(owner_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(descriptor, (owner_key + "\n").encode("utf-8"))
    finally:
        os.close(descriptor)
if not 32 <= len(owner_key) <= 512:
    raise SystemExit(f"TokenBar owner key is invalid: {owner_path}")
try:
    owner_path.chmod(0o600)
except OSError:
    pass

headers = {
    "Content-Type": "application/json",
    "User-Agent": "TokenBar CLI",
    "X-TokenBar-Owner-Key": owner_key,
}
write_token = (os.environ.get("TOKENBAR_ACTION_WRITE_TOKEN") or "").strip()
if write_token:
    headers["Authorization"] = f"Bearer {write_token}"

request = urllib.request.Request(
    endpoint,
    data=encoded_payload,
    headers=headers,
    method="POST",
)

try:
    with urllib.request.urlopen(request, timeout=30) as response:
        data = json.loads(response.read().decode("utf-8"))
except urllib.error.HTTPError as exc:
    body = exc.read().decode("utf-8", "replace")
    raise SystemExit(f"Profile upload failed: HTTP {exc.code} {body}") from exc
except Exception as exc:
    raise SystemExit(f"Profile upload failed: {exc}") from exc

if not data.get("ok"):
    raise SystemExit(f"Profile upload failed: {data}")

print(f"Uploaded identity JSON: {path}")
print(f"Public-safe payload: {len(encoded_payload)} bytes")
print(f"Public profile: {data.get('shareUrl')}")
print(f"Aggregate stats: {data.get('statsUrl')}")
population = data.get("population") or {}
profile_title = payload.get("title") or (payload.get("identityLabel") or {}).get("title") or "TokenBar identity profile"
archetype = payload.get("primaryArchetype") or "builder"
npc = payload.get("npcClass") or "agentic builder"
specificity = payload.get("specificityScore", 0)
bucket_share = population.get("bucketSharePercent")
specificity_percentile = population.get("specificityPercentile")
if population:
    print("Population context:")
    print(f"  Opt-in profiles: {population.get('profileCount', 0)}")
    print(f"  Bucket share: {bucket_share or 0}%")
    print(f"  Archetype share: {population.get('archetypeSharePercent', 0)}%")
    print(f"  NPC class share: {population.get('npcClassSharePercent', 0)}%")
    if specificity_percentile is not None:
        print(f"  Specificity percentile: {specificity_percentile}%")
print()
print("Share copy:")
rarity_line = f" Bucket share in opt-in TokenBar profiles: {bucket_share}%." if bucket_share is not None else ""
percentile_line = f" Specificity percentile: {specificity_percentile}%." if specificity_percentile is not None else ""
print(
    f"I generated my TokenBar AI builder identity: {profile_title}. "
    f"Archetype: {archetype}. NPC class: {npc}. Specificity: {specificity}/100."
    f"{rarity_line}{percentile_line} {data.get('shareUrl')}"
)
PY
}

builder_identity_action() {
  local identity_path endpoint share_visibility redact_owner redact_tokens redact_sessions redact_region action_write_token
  local spotlight_sessions spotlight_projects spotlight_notes spotlight_insights spotlight_struggles spotlight_features spotlight_progress
  identity_path=""
  share_visibility="${TOKENBAR_SHARE_VISIBILITY:-public}"
  redact_owner="${TOKENBAR_REDACT_OWNER:-0}"
  redact_tokens="${TOKENBAR_REDACT_TOKENS:-0}"
  redact_sessions="${TOKENBAR_REDACT_SESSIONS:-0}"
  redact_region="${TOKENBAR_REDACT_REGION:-0}"
  spotlight_sessions="${TOKENBAR_SPOTLIGHT_SESSIONS:-}"
  spotlight_projects="${TOKENBAR_SPOTLIGHT_PROJECTS:-}"
  spotlight_notes="${TOKENBAR_SPOTLIGHT_NOTES:-}"
  spotlight_insights="${TOKENBAR_SPOTLIGHT_INSIGHTS:-}"
  spotlight_struggles="${TOKENBAR_SPOTLIGHT_STRUGGLES:-}"
  spotlight_features="${TOKENBAR_SPOTLIGHT_FEATURES:-}"
  spotlight_progress="${TOKENBAR_SPOTLIGHT_PROGRESS:-}"
  endpoint="${TOKENBAR_ACTION_URL:-${TOKENBAR_ACTION_ENDPOINT:-$site_url/api/actions}}"
  action_write_token="${TOKENBAR_ACTION_WRITE_TOKEN:-}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --visibility|--share-mode)
        shift
        share_visibility="${1:-$share_visibility}"
        ;;
      --public)
        share_visibility="public"
        ;;
      --unlisted)
        share_visibility="unlisted"
        ;;
      --private)
        share_visibility="private"
        ;;
      --hide-owner|--redact-owner|--anonymous|--anonymous-owner)
        redact_owner="1"
        ;;
      --hide-tokens|--redact-tokens)
        redact_tokens="1"
        ;;
      --hide-sessions|--redact-sessions)
        redact_sessions="1"
        ;;
      --hide-region|--redact-region)
        redact_region="1"
        ;;
      --spotlight-session|--session)
        shift
        spotlight_sessions="${spotlight_sessions}${spotlight_sessions:+,}${1:-}"
        ;;
      --spotlight-project)
        shift
        spotlight_projects="${spotlight_projects}${spotlight_projects:+,}${1:-}"
        ;;
      --spotlight-note)
        shift
        spotlight_notes="${spotlight_notes}${spotlight_notes:+|}${1:-}"
        ;;
      --spotlight-insight)
        shift
        spotlight_insights="${spotlight_insights}${spotlight_insights:+|}${1:-}"
        ;;
      --spotlight-struggle)
        shift
        spotlight_struggles="${spotlight_struggles}${spotlight_struggles:+|}${1:-}"
        ;;
      --spotlight-feature)
        shift
        spotlight_features="${spotlight_features}${spotlight_features:+|}${1:-}"
        ;;
      --spotlight-progress)
        shift
        spotlight_progress="${spotlight_progress}${spotlight_progress:+|}${1:-}"
        ;;
      --help|-h)
        cat <<'EOF'
Usage:
  tokenbar publish-proof [latest|/path/to/*.identity.json] [--public|--unlisted|--private] [--hide-owner] [--hide-tokens] [--hide-sessions] [--hide-region]
  tokenbar publish-proof SESSION_ID
                         [--spotlight-session ID] [--spotlight-project NAME] [--spotlight-note TEXT]
                         [--spotlight-insight TEXT] [--spotlight-struggle TEXT] [--spotlight-feature TEXT] [--spotlight-progress TEXT]

Examples:
  tokenbar publish-proof
  tokenbar publish-proof 019e7a08-b6d6-7863-be79-66b20c9353df
  tokenbar publish-proof --unlisted --hide-owner --hide-tokens --hide-sessions
  tokenbar publish-proof --spotlight-session 019e... --spotlight-project "AI video editor" --spotlight-note "Built the trailer manifest"

Spotlight anchors are public labels you choose to attach to the proof. TokenBar
does not upload raw session transcripts, source code, private diffs, or secrets.
EOF
        return 0
        ;;
      *)
        if looks_like_session_id "$1"; then
          spotlight_sessions="${spotlight_sessions}${spotlight_sessions:+,}$1"
        elif [[ -z "$identity_path" ]]; then
          identity_path="$1"
        else
          echo "Unknown publish-proof argument: $1" >&2
          return 2
        fi
        ;;
    esac
    shift || true
  done

  if [[ "$identity_path" == "latest" ]]; then
    identity_path=""
  fi

  if [[ -z "$identity_path" ]]; then
    identity_path="$(ls -t "$support_dir"/profiles/*.identity.json 2>/dev/null | head -n 1 || true)"
  fi

  if [[ -z "$identity_path" || ! -f "$identity_path" ]]; then
    cat >&2 <<'EOF'
No identity JSON found.
Generate one first:
  tokenbar claim

Then run:
  tokenbar publish-proof
EOF
    return 1
  fi

  local verify_log
  verify_log="$(mktemp "${TMPDIR:-/tmp}/tokenbar-action-verify.XXXXXX")"
  if ! verify_identity_artifact "$identity_path" >"$verify_log" 2>&1; then
    cat "$verify_log" >&2
    rm -f "$verify_log"
    return 1
  fi
  rm -f "$verify_log"

  TOKENBAR_ACTION_IDENTITY_PATH="$identity_path" TOKENBAR_ACTION_ENDPOINT="$endpoint" TOKENBAR_ACTION_WRITE_TOKEN="$action_write_token" TOKENBAR_ACTION_OWNER_KEY_PATH="$support_dir/proof-owner-key" TOKENBAR_SHARE_VISIBILITY="$share_visibility" TOKENBAR_REDACT_OWNER="$redact_owner" TOKENBAR_REDACT_TOKENS="$redact_tokens" TOKENBAR_REDACT_SESSIONS="$redact_sessions" TOKENBAR_REDACT_REGION="$redact_region" TOKENBAR_SPOTLIGHT_SESSIONS="$spotlight_sessions" TOKENBAR_SPOTLIGHT_PROJECTS="$spotlight_projects" TOKENBAR_SPOTLIGHT_NOTES="$spotlight_notes" TOKENBAR_SPOTLIGHT_INSIGHTS="$spotlight_insights" TOKENBAR_SPOTLIGHT_STRUGGLES="$spotlight_struggles" TOKENBAR_SPOTLIGHT_FEATURES="$spotlight_features" TOKENBAR_SPOTLIGHT_PROGRESS="$spotlight_progress" TOKENBAR_PROOF_RECEIPT_DIR="$support_dir/proof-receipts" python3 - <<'PY'
import hashlib
import json
import os
import secrets
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

path = Path(os.environ["TOKENBAR_ACTION_IDENTITY_PATH"]).expanduser()
endpoint = os.environ["TOKENBAR_ACTION_ENDPOINT"]
identity = json.loads(path.read_text(encoding="utf-8"))

def truthy(value):
    return str(value or "").strip().lower() in {"1", "true", "yes", "on"}

visibility = (os.environ.get("TOKENBAR_SHARE_VISIBILITY") or "public").strip().lower()
if visibility not in {"public", "unlisted", "private"}:
    visibility = "public"
share_controls = {
    "visibility": visibility,
    "redactions": {
        "owner": truthy(os.environ.get("TOKENBAR_REDACT_OWNER")),
        "tokens": truthy(os.environ.get("TOKENBAR_REDACT_TOKENS")),
        "sessions": truthy(os.environ.get("TOKENBAR_REDACT_SESSIONS")),
        "region": truthy(os.environ.get("TOKENBAR_REDACT_REGION")),
    },
}

privacy = identity.get("privacy") or {}
if privacy.get("rawTranscriptsIncluded") or privacy.get("sourceCodeIncluded"):
    raise SystemExit("Refusing to run an action on an identity file that claims to include raw transcripts or source code.")

allowed = {
    "schema",
    "token",
    "title",
    "subtitle",
    "primaryArchetype",
    "npcClass",
    "identityLabel",
    "labelRationale",
    "archetypeDistribution",
    "modifierDistribution",
    "stanceDistribution",
    "labelDistribution",
    "labelModel",
    "specificityScore",
    "estimatedRarityPercent",
    "proofScore",
    "loopMaturity",
    "loopScore",
    "loopScale",
    "privacy",
    "dimensions",
    "usage",
    "sessionAnalysis",
    "shippingAnalysis",
    "providerAnalyses",
    "builderSignalInbox",
    "socialLearningSignals",
    "publicProfile",
    "hackathonSubmission",
    "submittedProject",
    "leaderboard",
    "spotlightSources",
    "generatedAt",
}
identity = {key: value for key, value in identity.items() if key in allowed}

def split_env_list(name, sep=",", limit=8, item_limit=120):
    raw = os.environ.get(name) or ""
    rows = []
    for value in raw.split(sep):
        text = value.replace("\x00", "").strip()
        if text:
            rows.append(text[:item_limit])
        if len(rows) >= limit:
            break
    return rows

spotlight_sessions = split_env_list("TOKENBAR_SPOTLIGHT_SESSIONS", ",", 8, 96)
spotlight_projects = split_env_list("TOKENBAR_SPOTLIGHT_PROJECTS", ",", 8, 120)
spotlight_notes = split_env_list("TOKENBAR_SPOTLIGHT_NOTES", "|", 8, 240)
spotlight_insights = split_env_list("TOKENBAR_SPOTLIGHT_INSIGHTS", "|", 4, 240)
spotlight_struggles = split_env_list("TOKENBAR_SPOTLIGHT_STRUGGLES", "|", 4, 240)
spotlight_features = split_env_list("TOKENBAR_SPOTLIGHT_FEATURES", "|", 4, 240)
spotlight_progress = split_env_list("TOKENBAR_SPOTLIGHT_PROGRESS", "|", 4, 240)
if spotlight_sessions or spotlight_projects or spotlight_notes or spotlight_insights or spotlight_struggles or spotlight_features or spotlight_progress:
    existing_spotlight = identity.get("spotlightSources") if isinstance(identity.get("spotlightSources"), dict) else {}
    existing_story = existing_spotlight.get("story") if isinstance(existing_spotlight.get("story"), dict) else {}
    existing_privacy = existing_spotlight.get("privacy") if isinstance(existing_spotlight.get("privacy"), dict) else {}
    project_text = ", ".join(spotlight_projects[:2]) if spotlight_projects else "the selected work"
    session_text = ", ".join(spotlight_sessions[:2]) if spotlight_sessions else "the selected session trail"
    note_text = spotlight_notes[0] if spotlight_notes else ""
    story = {
        "insight": spotlight_insights[0] if spotlight_insights else existing_story.get("insight") or f"{project_text} is now tied to a visible proof trail instead of an unstructured chat history.",
        "struggle": spotlight_struggles[0] if spotlight_struggles else existing_story.get("struggle") or "The hard part was compressing scattered agent work into public evidence without exposing private context.",
        "features": spotlight_features[0] if spotlight_features else existing_story.get("features") or (note_text or f"Attached {session_text} as a public-safe anchor for the builder profile."),
        "progress": spotlight_progress[0] if spotlight_progress else existing_story.get("progress") or f"TokenBar can now turn {project_text} into a proof card, profile surface, social feed item, and trailer storyboard.",
    }
    identity["spotlightSources"] = {
        "schema": "tokenbar.spotlight_sources.v1",
        "sessions": spotlight_sessions,
        "projects": spotlight_projects,
        "notes": spotlight_notes,
        "story": story,
        "privacy": {
            "userProvidedOnly": existing_privacy.get("userProvidedOnly", True),
            "rawTranscriptsIncluded": False,
            "sourceCodeIncluded": False,
            "sessionFilesRead": existing_privacy.get("sessionFilesRead", False),
            "localInference": existing_privacy.get("localInference", False),
            "storedRawExcerpts": False,
            "maxSessionBytesRead": existing_privacy.get("maxSessionBytesRead", 0),
            "matchedSessionFiles": existing_privacy.get("matchedSessionFiles", 0),
        },
    }
    if existing_spotlight.get("storyBeats"):
        identity["spotlightSources"]["storyBeats"] = existing_spotlight["storyBeats"]

usage_index = Path.home() / "Library/Application Support/CodexLimitBar/usage-index.json"
try:
    index = json.loads(usage_index.read_text(encoding="utf-8"))
except Exception:
    index = {}
if isinstance(index, dict):
    usage = identity.get("usage")
    if not isinstance(usage, dict):
        usage = {}
    day_tokens = index.get("dayTokens") if isinstance(index.get("dayTokens"), dict) else {}
    model_tokens = index.get("modelTokens") if isinstance(index.get("modelTokens"), dict) else {}
    session_paths = index.get("sessionPaths") if isinstance(index.get("sessionPaths"), list) else []
    total_tokens = sum(int(value or 0) for value in model_tokens.values())
    last30_tokens = sum(int(value or 0) for value in day_tokens.values())
    top_model = None
    if model_tokens:
        top_model = max(model_tokens.items(), key=lambda item: int(item[1] or 0))[0]
    usage.setdefault("totalTokens", total_tokens)
    usage["last30"] = usage.get("last30") or last30_tokens
    usage["sessionsIndexed"] = usage.get("sessionsIndexed") or len(session_paths)
    usage["activeDaysLast30"] = usage.get("activeDaysLast30") or len([value for value in day_tokens.values() if int(value or 0) > 0])
    usage["topLocalModel"] = usage.get("topLocalModel") or top_model
    identity["usage"] = usage

digest = hashlib.sha256(json.dumps(identity, sort_keys=True).encode("utf-8")).hexdigest()
payload = {
    "action": "builder_identity.proof_card.v1",
    "idempotencyKey": digest,
    "identity": identity,
    "shareControls": share_controls,
}

def load_or_create_owner_key():
    override = (os.environ.get("TOKENBAR_ACTION_OWNER_KEY") or "").strip()
    if override:
        if not 32 <= len(override) <= 512:
            raise SystemExit("TOKENBAR_ACTION_OWNER_KEY must be 32-512 characters.")
        return override

    owner_path = Path(os.environ["TOKENBAR_ACTION_OWNER_KEY_PATH"]).expanduser()
    owner_path.parent.mkdir(parents=True, exist_ok=True)
    if owner_path.exists():
        key = owner_path.read_text(encoding="utf-8").strip()
        if not 32 <= len(key) <= 512:
            raise SystemExit(f"TokenBar owner key is invalid: {owner_path}")
        try:
            owner_path.chmod(0o600)
        except OSError:
            pass
        return key

    candidate = secrets.token_urlsafe(48)
    try:
        descriptor = os.open(owner_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        key = owner_path.read_text(encoding="utf-8").strip()
        if not 32 <= len(key) <= 512:
            raise SystemExit(f"TokenBar owner key is invalid: {owner_path}")
        return key
    try:
        os.write(descriptor, (candidate + "\n").encode("utf-8"))
    finally:
        os.close(descriptor)
    return candidate

owner_key = load_or_create_owner_key()
headers = {
    "Content-Type": "application/json",
    "Accept": "application/json",
    "User-Agent": "TokenBar CLI",
    "X-TokenBar-Owner-Key": owner_key,
}
owner_token = os.environ.get("TOKENBAR_ACTION_WRITE_TOKEN", "").strip()
if owner_token:
    headers["Authorization"] = f"Bearer {owner_token}"
request = urllib.request.Request(
    endpoint,
    data=json.dumps(payload).encode("utf-8"),
    headers=headers,
    method="POST",
)

try:
    with urllib.request.urlopen(request, timeout=30) as response:
        data = json.loads(response.read().decode("utf-8"))
except urllib.error.HTTPError as exc:
    body = exc.read().decode("utf-8", "replace")
    raise SystemExit(f"Builder action failed: HTTP {exc.code} {body}") from exc
except Exception as exc:
    raise SystemExit(f"Builder action failed: {exc}") from exc

if not data.get("ok"):
    raise SystemExit(f"Builder action failed: {data}")

print(f"Builder proof run: {data.get('runId')}")
for item in data.get("stages") or []:
    print(f"  ✓ {item.get('name')}: {item.get('note')}")
result = data.get("result") or {}
proof = data.get("proof") or {}
story = proof.get("builderStory") if isinstance(proof.get("builderStory"), dict) else {}
privacy = proof.get("privacy") if isinstance(proof.get("privacy"), dict) else {}
share_controls = proof.get("shareControls") if isinstance(proof.get("shareControls"), dict) else {}
redactions = share_controls.get("redactions") if isinstance(share_controls.get("redactions"), dict) else {}
surface_bundle = proof.get("surfaceBundle") if isinstance(proof.get("surfaceBundle"), dict) else result.get("surfaceBundle") if isinstance(result.get("surfaceBundle"), dict) else {}
share_receipt = proof.get("shareReceipt") if isinstance(proof.get("shareReceipt"), dict) else {}

def surface_url(key, fallback=""):
    surfaces = surface_bundle.get("surfaces") if isinstance(surface_bundle.get("surfaces"), list) else []
    for surface in surfaces:
        if isinstance(surface, dict) and surface.get("key") == key and surface.get("url"):
            return surface.get("url")
    return fallback

def compact_tokens(value):
    try:
        number = float(value or 0)
    except Exception:
        number = 0
    if number >= 1_000_000_000:
        return f"{number / 1_000_000_000:.2f}B".replace(".00B", "B")
    if number >= 1_000_000:
        return f"{number / 1_000_000:.1f}M".replace(".0M", "M")
    if number >= 1_000:
        return f"{number / 1_000:.1f}K".replace(".0K", "K")
    return str(int(number))

share_mode = proof.get("publicVisibility") or share_controls.get("visibility") or privacy.get("shareMode") or "public"
receipt_path = None
receipt_dir = os.environ.get("TOKENBAR_PROOF_RECEIPT_DIR")
if receipt_dir:
    private_audit_url = result.get("auditRunUrl")
    if share_mode == "private":
        surfaces = {"privateAudit": private_audit_url}
    else:
        surfaces = {
            "proofCard": surface_url("proofCard", result.get("proofCardUrl") or proof.get("proofCardUrl")),
            "publicProfile": surface_url("publicProfile", result.get("profileUrl") or proof.get("profileUrl")),
            "socialFeed": surface_url("socialFeed", result.get("socialUrl") or proof.get("socialUrl")),
            "rankings": surface_url("rankings", result.get("rankingsUrl") or proof.get("rankingsUrl")),
            "loopRankings": surface_url("loopRankings", result.get("loopRankingsUrl") or proof.get("loopRankingsUrl")),
            "identityTrailer": surface_url("identityTrailer", result.get("trailerUrl") or proof.get("trailerUrl")),
        }
    token = str(proof.get("token") or "").strip()
    run_id = str(data.get("runId") or "").strip()
    if share_mode == "private":
        share_copy = (
            f"Private TokenBar builder identity audit {run_id}: {proof.get('title') or 'Builder Identity'}. "
            f"Proof {proof.get('proofScore', 0)}/100, loop maturity {proof.get('loopMaturity', 0)}/100. "
            "No public token, profile, feed, or ranking lookup is enabled. "
            "Raw transcripts and source code were not uploaded."
        )
        if private_audit_url:
            share_copy = f"{share_copy} Audit: {private_audit_url}"
    else:
        share_copy = proof.get("shareCopy") or result.get("summary") or "TokenBar proof card is ready."
    local_receipt = {
        "schema": "tokenbar.local_proof_receipt.v1",
        "generatedAt": datetime.now(timezone.utc).isoformat(),
        "token": token,
        "runId": run_id,
        "identity": proof.get("title") or "Builder Identity",
        "proofScore": proof.get("proofScore", 0),
        "loopMaturity": proof.get("loopMaturity", 0),
        "shareMode": share_mode,
        "ownerBound": True,
        "revoked": False,
        "redactions": redactions,
        "surfaces": {key: value for key, value in surfaces.items() if value},
        "shareReceipt": share_receipt,
        "privacy": {
            "rawTranscriptsUploaded": bool(privacy.get("rawTranscriptsIncluded")),
            "sourceCodeUploaded": bool(privacy.get("sourceCodeIncluded")),
            "uploaded": "generated proof card + aggregate identity fields",
        },
        "shareCopy": share_copy,
    }
    root = Path(receipt_dir).expanduser()
    root.mkdir(parents=True, exist_ok=True)
    targets = [root / "latest.json"]
    for value in (token, run_id):
        safe = "".join(ch for ch in value if ch.isalnum() or ch in {"-", "_"})
        if safe:
            targets.append(root / f"{safe}.json")
    for target in targets:
        target.write_text(json.dumps(local_receipt, indent=2, sort_keys=True), encoding="utf-8")
    receipt_path = str(root / "latest.json")

print()
if share_mode == "private":
    print(f"Safe token: {proof.get('token')} (private audit only)")
    print(f"Private proof audit: {result.get('auditRunUrl')}")
    print("Proof bundle: disabled by --private")
    print("Public proof card: disabled by --private")
    print("Public profile: disabled by --private")
    print("For You feed: not listed")
    print("Leaderboards: not listed")
else:
    print(f"Safe token: {proof.get('token')}")
    print("Proof bundle:")
    print(f"  Proof card: {surface_url('proofCard', result.get('proofCardUrl') or proof.get('proofCardUrl'))}")
    print(f"  Public profile: {surface_url('publicProfile', result.get('profileUrl') or proof.get('profileUrl'))}")
    print(f"  For You feed: {surface_url('socialFeed', result.get('socialUrl') or proof.get('socialUrl'))}")
    print(f"  Leaderboards: {surface_url('rankings', result.get('rankingsUrl') or proof.get('rankingsUrl'))}")
    print(f"  Loop rankings: {surface_url('loopRankings', result.get('loopRankingsUrl') or proof.get('loopRankingsUrl'))}")
    print(f"  Identity trailer: {surface_url('identityTrailer', result.get('trailerUrl') or proof.get('trailerUrl'))}")
    print(f"Proof card: {surface_url('proofCard', result.get('proofCardUrl') or proof.get('proofCardUrl'))}")
    print(f"Profile link: {surface_url('publicProfile', result.get('profileUrl') or proof.get('profileUrl'))}")
    print(f"Trailer link: {surface_url('identityTrailer', result.get('trailerUrl') or proof.get('trailerUrl'))}")
print()
print("Public proof summary:")
print(f"  Identity: {proof.get('title') or 'Builder Identity'}")
print(f"  Proof score: {proof.get('proofScore', 0)}/100")
print(f"  Loop maturity: {proof.get('loopMaturity', 0)}/100")
print(f"  Safe aggregate: {compact_tokens(proof.get('totalTokens'))} tokens across {proof.get('sessionCount', 0)} indexed sessions")
if story.get("nextFrontier"):
    print(f"  Next frontier: {story.get('nextFrontier')}")
print()
print("Privacy contract:")
print(f"  Share mode: {share_mode}")
enabled_redactions = ", ".join(name for name, enabled in redactions.items() if enabled) or "none"
print(f"  Redactions: {enabled_redactions}")
print(f"  Uploaded: generated proof card + aggregate identity fields")
print(f"  Raw transcripts uploaded: {'yes' if privacy.get('rawTranscriptsIncluded') else 'no'}")
print(f"  Source code uploaded: {'yes' if privacy.get('sourceCodeIncluded') else 'no'}")
if share_receipt:
    never_public = ", ".join(str(item) for item in (share_receipt.get("neverPublic") or [])[:5])
    print()
    print("Share receipt:")
    print(f"  Schema: {share_receipt.get('schema')}")
    print(f"  Public material: {share_receipt.get('publicMaterial')}")
    print(f"  Stayed local: {never_public}")
    print(f"  Copy-safe: {share_receipt.get('copySafeSummary')}")
print()
print("Share copy:")
print(proof.get("shareCopy") or result.get("summary") or "TokenBar proof card is ready.")
if receipt_path:
    print()
    print(f"Local receipt: {receipt_path}")
    print("Reprint later: tokenbar proof latest")
PY
}

revoke_proof() {
  local selector endpoint action_write_token
  selector="${1:-latest}"
  endpoint="${TOKENBAR_ACTION_URL:-${TOKENBAR_ACTION_ENDPOINT:-$site_url/api/actions}}"
  action_write_token="${TOKENBAR_ACTION_WRITE_TOKEN:-}"

  case "$selector" in
    --help|-h|help)
      cat <<'EOF'
Usage:
  tokenbar revoke latest
  tokenbar revoke TBAR-TOKEN

Removes the proof card, public profile, For You entry, and rankings entry tied
to a proof you published from this device. Your private identity JSON, HTML,
PDF, Skill.md, and local usage history are kept.
EOF
      return 0
      ;;
    latest|TBAR-*) ;;
    *)
      echo "Expected 'latest' or a TBAR proof token." >&2
      return 2
      ;;
  esac

  TOKENBAR_REVOKE_SELECTOR="$selector" TOKENBAR_ACTION_ENDPOINT="$endpoint" TOKENBAR_ACTION_WRITE_TOKEN="$action_write_token" TOKENBAR_ACTION_OWNER_KEY_PATH="$support_dir/proof-owner-key" TOKENBAR_PROOF_RECEIPT_DIR="$support_dir/proof-receipts" python3 - <<'PY'
import json
import os
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import urlsplit

selector = os.environ.get("TOKENBAR_REVOKE_SELECTOR") or "latest"
receipt_dir = Path(os.environ["TOKENBAR_PROOF_RECEIPT_DIR"]).expanduser()

def load_receipt(path):
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None
    if not isinstance(data, dict) or data.get("schema") != "tokenbar.local_proof_receipt.v1":
        return None
    return data

if selector.startswith("TBAR-"):
    receipt_path = receipt_dir / f"{selector}.json"
    receipt = load_receipt(receipt_path)
    if receipt is None:
        raise SystemExit("No local ownership receipt exists for that token. Only its publishing device can revoke it.")
else:
    candidates = []
    for path in receipt_dir.glob("*.json"):
        receipt = load_receipt(path)
        if not receipt or receipt.get("revoked") or receipt.get("shareMode") == "private":
            continue
        token = str(receipt.get("token") or "")
        if not token.startswith("TBAR-"):
            continue
        surfaces = receipt.get("surfaces") if isinstance(receipt.get("surfaces"), dict) else {}
        if not (surfaces.get("proofCard") or surfaces.get("publicProfile")):
            continue
        candidates.append((path.stat().st_mtime, path, receipt))
    if not candidates:
        raise SystemExit("No active public proof receipt found. Run: tokenbar prove")
    _, receipt_path, receipt = max(candidates, key=lambda item: item[0])

if receipt.get("revoked"):
    raise SystemExit(f"Proof {receipt.get('token')} is already revoked.")
if receipt.get("ownerBound") is not True:
    raise SystemExit("This proof predates device ownership receipts and cannot be safely revoked from the CLI. Publish a new proof first.")

owner_path = Path(os.environ["TOKENBAR_ACTION_OWNER_KEY_PATH"]).expanduser()
try:
    owner_key = owner_path.read_text(encoding="utf-8").strip()
except Exception as exc:
    raise SystemExit("TokenBar cannot find this device's private proof-owner key. Revocation was not attempted.") from exc
if not 32 <= len(owner_key) <= 512:
    raise SystemExit("TokenBar's private proof-owner key is invalid. Revocation was not attempted.")

token = str(receipt.get("token") or "").strip()
endpoint = os.environ.get("TOKENBAR_ACTION_ENDPOINT") or ""
surfaces = receipt.get("surfaces") if isinstance(receipt.get("surfaces"), dict) else {}
surface_url = surfaces.get("proofCard") or surfaces.get("publicProfile") or ""
if surface_url:
    parsed = urlsplit(surface_url)
    if parsed.scheme in {"http", "https"} and parsed.netloc:
        endpoint = f"{parsed.scheme}://{parsed.netloc}/api/actions"

payload = {"action": "builder_identity.revoke.v1", "token": token}
headers = {
    "Content-Type": "application/json",
    "Accept": "application/json",
    "User-Agent": "TokenBar CLI",
    "X-TokenBar-Owner-Key": owner_key,
}
owner_token = (os.environ.get("TOKENBAR_ACTION_WRITE_TOKEN") or "").strip()
if owner_token:
    headers["Authorization"] = f"Bearer {owner_token}"
request = urllib.request.Request(endpoint, data=json.dumps(payload).encode("utf-8"), headers=headers, method="POST")
try:
    with urllib.request.urlopen(request, timeout=30) as response:
        result = json.loads(response.read().decode("utf-8"))
except urllib.error.HTTPError as exc:
    body = exc.read().decode("utf-8", "replace")
    raise SystemExit(f"Proof revocation failed: HTTP {exc.code} {body}") from exc
except Exception as exc:
    raise SystemExit(f"Proof revocation failed: {exc}") from exc
if not result.get("ok"):
    raise SystemExit(f"Proof revocation failed: {result}")

revoked_at = datetime.now(timezone.utc).isoformat()
for path in receipt_dir.glob("*.json"):
    candidate = load_receipt(path)
    if not candidate or candidate.get("token") != token:
        continue
    candidate["revoked"] = True
    candidate["revokedAt"] = revoked_at
    candidate["surfaces"] = {}
    candidate["shareCopy"] = "This TokenBar public proof was revoked by its owner. The private local report was kept."
    candidate["revocation"] = {
        "serverConfirmed": True,
        "publicSurfacesRemoved": bool(result.get("publicSurfacesRemoved")),
        "localArtifactsDeleted": False,
        "runId": result.get("runId"),
    }
    path.write_text(json.dumps(candidate, indent=2, sort_keys=True), encoding="utf-8")

print("TokenBar proof revoked")
print(f"  Token: {token}")
if result.get("publicSurfacesRemoved"):
    print("  Public proof, profile, feed, and rankings: removed")
else:
    print("  This device's proof: removed; the same safe token remains published by another owner")
print("  Private identity, reports, and usage history: kept")
PY
}

proof_latest() {
  local json_output="0"
  local public_output="0"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        json_output="1"
        ;;
      --public|--shareable)
        public_output="1"
        ;;
      --help|-h)
        cat <<'EOF'
Usage:
  tokenbar proof latest [--json]
  tokenbar proof latest --public
  tokenbar share latest

Print the latest safe proof token, share links, privacy receipt, and share copy
without rerunning local analysis or uploading anything.

Use --public to recover the newest shareable proof if the latest receipt is a
private audit.
EOF
        return 0
        ;;
      *)
        echo "Unknown proof latest argument: $1" >&2
        return 2
        ;;
    esac
    shift
  done

  TOKENBAR_PROOF_RECEIPT_PATH="$support_dir/proof-receipts/latest.json" TOKENBAR_PROOF_RECEIPT_DIR="$support_dir/proof-receipts" TOKENBAR_PROOF_RECEIPT_JSON="$json_output" TOKENBAR_PROOF_RECEIPT_PUBLIC="$public_output" python3 - <<'PY'
import json
import os
from pathlib import Path

path = Path(os.environ["TOKENBAR_PROOF_RECEIPT_PATH"]).expanduser()
want_public = os.environ.get("TOKENBAR_PROOF_RECEIPT_PUBLIC") == "1"

def load_receipt(candidate):
    try:
        data = json.loads(candidate.read_text(encoding="utf-8"))
    except Exception:
        return None
    if not isinstance(data, dict) or data.get("schema") != "tokenbar.local_proof_receipt.v1":
        return None
    return data

receipt_dir = Path(os.environ.get("TOKENBAR_PROOF_RECEIPT_DIR") or path.parent).expanduser()
candidates = []
for candidate in receipt_dir.glob("*.json"):
    data = load_receipt(candidate)
    if not data or data.get("revoked"):
        continue
    if want_public and data.get("shareMode") == "private":
        continue
    surfaces = data.get("surfaces") if isinstance(data.get("surfaces"), dict) else {}
    if want_public and not (surfaces.get("proofCard") or surfaces.get("publicProfile")):
        continue
    candidates.append((candidate.stat().st_mtime, candidate, data))
if not candidates:
    label = "shareable " if want_public else "active "
    raise SystemExit(f"No {label}local proof receipt found. Run: tokenbar prove")
_, path, receipt = max(candidates, key=lambda item: item[0])

if os.environ.get("TOKENBAR_PROOF_RECEIPT_JSON") == "1":
    print(json.dumps(receipt, indent=2, sort_keys=True))
    raise SystemExit(0)

surfaces = receipt.get("surfaces") if isinstance(receipt.get("surfaces"), dict) else {}
share_receipt = receipt.get("shareReceipt") if isinstance(receipt.get("shareReceipt"), dict) else {}
privacy = receipt.get("privacy") if isinstance(receipt.get("privacy"), dict) else {}
redactions = receipt.get("redactions") if isinstance(receipt.get("redactions"), dict) else {}

print("Latest safe TokenBar proof")
print(f"  Token: {receipt.get('token') or 'private/no-token'}")
print(f"  Run: {receipt.get('runId') or 'unknown'}")
print(f"  Identity: {receipt.get('identity') or 'Builder Identity'}")
print(f"  Proof score: {receipt.get('proofScore', 0)}/100")
print(f"  Loop maturity: {receipt.get('loopMaturity', 0)}/100")
print(f"  Share mode: {receipt.get('shareMode') or 'public'}")
enabled_redactions = ", ".join(name for name, enabled in redactions.items() if enabled) or "none"
print(f"  Redactions: {enabled_redactions}")
if receipt.get("token"):
    print()
    print("Paste this token")
    print("  Use it on /profile to open your profile.")
    print("  Use it on /social to join the shipped-work feed.")
    print("  Use it on /rankings to place yourself on leaderboards.")
print()
if surfaces:
    print("Safe surfaces")
    labels = {
        "proofCard": "Proof card",
        "publicProfile": "Public profile",
        "socialFeed": "For You feed",
        "rankings": "Leaderboards",
        "loopRankings": "Loop rankings",
        "privateAudit": "Private audit",
    }
    for key in ("proofCard", "publicProfile", "socialFeed", "rankings", "loopRankings", "privateAudit"):
        if surfaces.get(key):
            print(f"  {labels.get(key, key)}: {surfaces[key]}")
    print()
print("Privacy boundary")
print(f"  Uploaded: {privacy.get('uploaded') or 'generated proof only'}")
print(f"  Raw transcripts uploaded: {'yes' if privacy.get('rawTranscriptsUploaded') else 'no'}")
print(f"  Source code uploaded: {'yes' if privacy.get('sourceCodeUploaded') else 'no'}")
if share_receipt:
    stayed_local = ", ".join(str(item) for item in (share_receipt.get("neverPublic") or [])[:5]) or "raw private material"
    print()
    print("Share receipt")
    print(f"  Public material: {share_receipt.get('publicMaterial') or 'safe proof summary'}")
    print(f"  Stayed local: {stayed_local}")
    print(f"  Copy-safe: {share_receipt.get('copySafeSummary') or 'No raw transcripts or source code.'}")
print()
print("Share copy")
print(receipt.get("shareCopy") or "TokenBar proof card is ready.")
if receipt.get("shareMode") == "private":
    print()
    print("Need a shareable profile link? Run: tokenbar proof latest --public")
    print("Need to create one now? Run: tokenbar prove")
else:
    print()
    print("Submitting a hackathon repo?")
    print('  Run: tokenbar submit --project "My Codex App" --repo https://github.com/me/app --demo https://app.example.com')
    print("  Raw prompts, transcripts, source code, and secrets still stay local.")
print()
print(f"Receipt file: {path}")
PY
}

open_proof_surface() {
  local surface selector print_only surface_url label
  surface="${1:-profile}"
  shift || true
  selector="latest"
  print_only="${TOKENBAR_NO_OPEN:-0}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      latest|--latest)
        selector="latest"
        ;;
      TBAR-*)
        selector="$1"
        ;;
      --print|--no-open)
        print_only="1"
        ;;
      --help|-h)
        cat <<'EOF'
Usage:
  tokenbar profile latest [--print]
  tokenbar social latest [--print]
  tokenbar rankings latest [--print]
  tokenbar open-proof [profile|social|rankings|loop|card|trailer] [latest|TBAR-TOKEN] [--print]

Reads the newest shareable local proof receipt and opens the exact safe surface
returned by the proof action. It does not rerun analysis or publish anything.
EOF
        return 0
        ;;
      *)
        echo "Unknown proof surface argument: $1" >&2
        return 2
        ;;
    esac
    shift
  done

  case "$surface" in
    profile|public-profile) label="public profile" ;;
    social|feed|for-you) label="For You feed" ;;
    rankings|leaderboard|leaderboards) label="leaderboards" ;;
    loop|loop-rankings) label="loop rankings" ;;
    card|proof|proof-card) label="proof card" ;;
    trailer|video) label="identity trailer" ;;
    *)
      echo "Unknown proof surface: $surface" >&2
      return 2
      ;;
  esac

  surface_url="$(TOKENBAR_PROOF_RECEIPT_DIR="$support_dir/proof-receipts" TOKENBAR_PROOF_SURFACE="$surface" TOKENBAR_PROOF_SELECTOR="$selector" TOKENBAR_PROOF_SITE_URL="$site_url" python3 - <<'PY'
import json
import os
import sys
from pathlib import Path
from urllib.parse import quote

surface = os.environ.get("TOKENBAR_PROOF_SURFACE", "profile")
selector = os.environ.get("TOKENBAR_PROOF_SELECTOR", "latest")
site_url = os.environ.get("TOKENBAR_PROOF_SITE_URL", "").rstrip("/")
receipt_dir = Path(os.environ["TOKENBAR_PROOF_RECEIPT_DIR"]).expanduser()

aliases = {
    "public-profile": "profile",
    "feed": "social",
    "for-you": "social",
    "leaderboard": "rankings",
    "leaderboards": "rankings",
    "loop-rankings": "loop",
    "proof": "card",
    "proof-card": "card",
    "video": "trailer",
}
surface = aliases.get(surface, surface)
surface_keys = {
    "profile": "publicProfile",
    "social": "socialFeed",
    "rankings": "rankings",
    "loop": "loopRankings",
    "card": "proofCard",
    "trailer": "identityTrailer",
}
fallback_paths = {
    "profile": "/profile",
    "social": "/social",
    "rankings": "/rankings",
    "loop": "/rankings",
    "card": "/api/actions",
    "trailer": "/api/actions",
}

def fallback_url(token):
    url = f"{site_url}{fallback_paths[surface]}?token={quote(token)}"
    if surface == "loop":
        url += "#loop"
    elif surface == "trailer":
        url += "&view=trailer"
    return url

if selector.startswith("TBAR-"):
    explicit_receipt = receipt_dir / f"{selector}.json"
    if explicit_receipt.is_file():
        try:
            explicit_data = json.loads(explicit_receipt.read_text(encoding="utf-8"))
        except Exception:
            explicit_data = {}
        if explicit_data.get("revoked"):
            sys.stderr.write(f"Proof {selector} was revoked by this device.\n")
            raise SystemExit(1)
    print(fallback_url(selector))
    raise SystemExit(0)

candidates = []
seen = set()
for candidate in [receipt_dir / "latest.json", *sorted(receipt_dir.glob("*.json"), key=lambda item: item.stat().st_mtime, reverse=True)]:
    if candidate in seen or not candidate.is_file():
        continue
    seen.add(candidate)
    try:
        receipt = json.loads(candidate.read_text(encoding="utf-8"))
    except Exception:
        continue
    if not isinstance(receipt, dict) or receipt.get("schema") != "tokenbar.local_proof_receipt.v1":
        continue
    if receipt.get("revoked") or receipt.get("shareMode") == "private":
        continue
    candidates.append(receipt)

for receipt in candidates:
    surfaces = receipt.get("surfaces") if isinstance(receipt.get("surfaces"), dict) else {}
    url = surfaces.get(surface_keys[surface])
    if url:
        print(url)
        raise SystemExit(0)
    token = str(receipt.get("token") or "")
    if token.startswith("TBAR-"):
        print(fallback_url(token))
        raise SystemExit(0)

sys.stderr.write("No shareable local proof receipt found. Run: tokenbar prove\n")
raise SystemExit(1)
PY
)" || return $?

  echo "TokenBar $label"
  echo "$surface_url"
  echo "Receipt-only handoff: no analysis rerun and no new upload."
  if [[ "$print_only" != "1" ]] && command -v open >/dev/null 2>&1; then
    open "$surface_url" >/dev/null 2>&1 || true
  fi
}

publish_profile() {
  local output_dir endpoint identity_path previous_endpoint
  local args=()
  output_dir="$support_dir/profiles"
  endpoint="${TOKENBAR_PROFILE_UPLOAD_URL:-$site_url/api/profiles}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --output-dir)
        args+=("$1")
        shift
        output_dir="${1:-$output_dir}"
        args+=("$output_dir")
        ;;
      --endpoint|--upload-url)
        shift
        endpoint="${1:-$endpoint}"
        ;;
      *)
        args+=("$1")
        ;;
    esac
    shift || true
  done

  profile_report "${args[@]}"
  identity_path="$(ls -t "$output_dir"/*.identity.json 2>/dev/null | head -n 1 || true)"
  if [[ -z "$identity_path" ]]; then
    echo "Generated profile, but could not locate the identity JSON in $output_dir." >&2
    return 1
  fi

  previous_endpoint="${TOKENBAR_PROFILE_UPLOAD_URL:-}"
  TOKENBAR_PROFILE_UPLOAD_URL="$endpoint" share_profile "$identity_path"
  if [[ -n "$previous_endpoint" ]]; then
    export TOKENBAR_PROFILE_UPLOAD_URL="$previous_endpoint"
  else
    unset TOKENBAR_PROFILE_UPLOAD_URL
  fi
}

patch_identity_spotlight() {
  local identity_path
  identity_path="${1:-}"
  if [[ -z "$identity_path" || ! -f "$identity_path" ]]; then
    return 0
  fi

  TOKENBAR_ACTION_IDENTITY_PATH="$identity_path" \
  TOKENBAR_SPOTLIGHT_SESSIONS="${TOKENBAR_SPOTLIGHT_SESSIONS:-}" \
  TOKENBAR_SPOTLIGHT_PROJECTS="${TOKENBAR_SPOTLIGHT_PROJECTS:-}" \
  TOKENBAR_SPOTLIGHT_NOTES="${TOKENBAR_SPOTLIGHT_NOTES:-}" \
  TOKENBAR_SPOTLIGHT_INSIGHTS="${TOKENBAR_SPOTLIGHT_INSIGHTS:-}" \
  TOKENBAR_SPOTLIGHT_STRUGGLES="${TOKENBAR_SPOTLIGHT_STRUGGLES:-}" \
  TOKENBAR_SPOTLIGHT_FEATURES="${TOKENBAR_SPOTLIGHT_FEATURES:-}" \
  TOKENBAR_SPOTLIGHT_PROGRESS="${TOKENBAR_SPOTLIGHT_PROGRESS:-}" \
  python3 - <<'PY'
import json
import os
import re
from pathlib import Path

path = Path(os.environ["TOKENBAR_ACTION_IDENTITY_PATH"]).expanduser()
try:
    identity = json.loads(path.read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(0)

def split_env_list(name, sep=",", limit=8, item_limit=120):
    raw = os.environ.get(name) or ""
    rows = []
    for value in raw.split(sep):
        text = value.replace("\x00", "").strip()
        text = re.sub(r"[\r\n\t]+", " ", text)
        if text:
            rows.append(text[:item_limit])
        if len(rows) >= limit:
            break
    return rows

def infer_local_spotlight_story(sessions, projects):
    if not sessions:
        return {}
    root = Path.home() / ".codex" / "sessions"
    if not root.exists():
        return {}

    wanted = [str(item).strip() for item in sessions if str(item).strip()]
    matches = []
    try:
        candidates = sorted(root.rglob("*"), key=lambda item: item.stat().st_mtime, reverse=True)
    except Exception:
        return {}

    for candidate in candidates[:300]:
        if not candidate.is_file():
            continue
        name = candidate.name
        if not any(session_id in name for session_id in wanted):
            continue
        matches.append(candidate)
        if len(matches) >= 3:
            break

    if not matches:
        for candidate in candidates[:80]:
            if not candidate.is_file():
                continue
            try:
                sample = candidate.read_text(encoding="utf-8", errors="replace")[:4096]
            except Exception:
                continue
            if any(session_id in sample for session_id in wanted):
                matches.append(candidate)
                break

    if not matches:
        return {}

    max_bytes = 48000
    chunks = []
    bytes_read = 0
    for match in matches:
        if bytes_read >= max_bytes:
            break
        try:
            text = match.read_text(encoding="utf-8", errors="replace")[: max_bytes - bytes_read]
        except Exception:
            continue
        chunks.append(text)
        bytes_read += len(text.encode("utf-8", errors="ignore"))

    lower = "\n".join(chunks).lower()
    project_text = ", ".join(projects[:2]) if projects else "the selected work"
    has_video = any(word in lower for word in ("video", "trailer", "hyperframes", "motion", "remotion"))
    has_privacy = any(word in lower for word in ("privacy", "private", "raw transcript", "raw prompts", "leak"))
    has_feature = any(word in lower for word in ("feature", "implemented", "added", "proof card", "profile", "feed"))
    has_progress = any(word in lower for word in ("progress", "verified", "smoke", "passed", "shipped", "built"))

    if has_video:
        insight = f"The selected {project_text} thread reads like a video-agent research session: the builder turned messy exploration into a reusable identity trailer brief."
    else:
        insight = f"The selected {project_text} thread shows the builder compressing scattered agent work into a public-safe proof story."
    if has_privacy:
        struggle = "The hard part was keeping the story specific without leaking private prompts, raw session text, or source code."
    else:
        struggle = "The hard part was separating useful builder evidence from noisy chat history without making the public profile feel generic."
    if has_feature:
        features = "New feature evidence: proof cards now carry session anchors, project anchors, and a 30-second trailer surface."
    else:
        features = "New feature evidence: selected session and project anchors can now travel with the builder identity."
    if has_progress:
        progress = "Progress: the safe local summary now appears in proof, profile, feed, and trailer views while the raw thread stays private."
    else:
        progress = "Progress: TokenBar can now attach the selected session to a readable builder story instead of a bare ID."

    return {
        "story": {
            "insight": insight,
            "struggle": struggle,
            "features": features,
            "progress": progress,
        },
        "privacy": {
            "userProvidedOnly": False,
            "rawTranscriptsIncluded": False,
            "sourceCodeIncluded": False,
            "sessionFilesRead": True,
            "localInference": True,
            "storedRawExcerpts": False,
            "maxSessionBytesRead": max_bytes,
            "matchedSessionFiles": len(matches),
        },
        "storyBeats": [
            {
                "label": "Selected session",
                "text": sessions[0][:96],
            },
            {
                "label": "Local inference",
                "text": "TokenBar read a bounded local session sample and stored only this safe summary.",
            },
        ],
    }

sessions = split_env_list("TOKENBAR_SPOTLIGHT_SESSIONS", ",", 8, 96)
projects = split_env_list("TOKENBAR_SPOTLIGHT_PROJECTS", ",", 8, 120)
notes = split_env_list("TOKENBAR_SPOTLIGHT_NOTES", "|", 8, 240)
insights = split_env_list("TOKENBAR_SPOTLIGHT_INSIGHTS", "|", 4, 240)
struggles = split_env_list("TOKENBAR_SPOTLIGHT_STRUGGLES", "|", 4, 240)
features = split_env_list("TOKENBAR_SPOTLIGHT_FEATURES", "|", 4, 240)
progress = split_env_list("TOKENBAR_SPOTLIGHT_PROGRESS", "|", 4, 240)
if not (sessions or projects or notes or insights or struggles or features or progress):
    raise SystemExit(0)

project_text = ", ".join(projects[:2]) if projects else "the selected work"
session_text = ", ".join(sessions[:2]) if sessions else "the selected session trail"
note_text = notes[0] if notes else ""
inferred = infer_local_spotlight_story(sessions, projects) if not (insights or struggles or features or progress) else {}
inferred_story = inferred.get("story") if isinstance(inferred.get("story"), dict) else {}
inferred_privacy = inferred.get("privacy") if isinstance(inferred.get("privacy"), dict) else {}
story = {
    "insight": insights[0] if insights else inferred_story.get("insight") or f"{project_text} is now tied to a visible proof trail instead of an unstructured chat history.",
    "struggle": struggles[0] if struggles else inferred_story.get("struggle") or "The hard part was compressing scattered agent work into public evidence without exposing private context.",
    "features": features[0] if features else inferred_story.get("features") or (note_text or f"Attached {session_text} as a public-safe anchor for the builder profile."),
    "progress": progress[0] if progress else inferred_story.get("progress") or f"TokenBar can now turn {project_text} into a proof card, profile surface, social feed item, and trailer storyboard.",
}
identity["spotlightSources"] = {
    "schema": "tokenbar.spotlight_sources.v1",
    "sessions": sessions,
    "projects": projects,
    "notes": notes,
    "story": story,
    "privacy": {
        "userProvidedOnly": inferred_privacy.get("userProvidedOnly", True),
        "rawTranscriptsIncluded": False,
        "sourceCodeIncluded": False,
        "sessionFilesRead": inferred_privacy.get("sessionFilesRead", False),
        "localInference": inferred_privacy.get("localInference", False),
        "storedRawExcerpts": False,
        "maxSessionBytesRead": inferred_privacy.get("maxSessionBytesRead", 0),
        "matchedSessionFiles": inferred_privacy.get("matchedSessionFiles", 0),
    },
}
if inferred.get("storyBeats"):
    identity["spotlightSources"]["storyBeats"] = inferred["storyBeats"]
path.write_text(json.dumps(identity, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
}

claim_profile() {
  local output_dir endpoint action_endpoint identity_path publish_now legacy_share previous_endpoint previous_action_endpoint
  local spotlight_sessions spotlight_projects spotlight_notes spotlight_insights spotlight_struggles spotlight_features spotlight_progress
  local args=()
  local publish_args=()
  output_dir="$support_dir/profiles"
  endpoint="${TOKENBAR_PROFILE_UPLOAD_URL:-$site_url/api/profiles}"
  action_endpoint="${TOKENBAR_ACTION_URL:-${TOKENBAR_ACTION_ENDPOINT:-$site_url/api/actions}}"
  publish_now=false
  legacy_share=false
  spotlight_sessions="${TOKENBAR_SPOTLIGHT_SESSIONS:-}"
  spotlight_projects="${TOKENBAR_SPOTLIGHT_PROJECTS:-}"
  spotlight_notes="${TOKENBAR_SPOTLIGHT_NOTES:-}"
  spotlight_insights="${TOKENBAR_SPOTLIGHT_INSIGHTS:-}"
  spotlight_struggles="${TOKENBAR_SPOTLIGHT_STRUGGLES:-}"
  spotlight_features="${TOKENBAR_SPOTLIGHT_FEATURES:-}"
  spotlight_progress="${TOKENBAR_SPOTLIGHT_PROGRESS:-}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        cat <<'EOF'
Usage:
  tokenbar claim [--pdf] [--days N] [--focus TEXT] [--publish-proof]
  tokenbar claim SESSION_ID
                 [--spotlight-session ID] [--spotlight-project NAME] [--spotlight-note TEXT]
                 [--spotlight-insight TEXT] [--spotlight-struggle TEXT] [--spotlight-feature TEXT] [--spotlight-progress TEXT]
  tokenbar prove

Creates a private Builder Identity claim on this Mac. Nothing public is uploaded
unless you add --publish-proof or run tokenbar prove.

What you get:
  - Identity JSON
  - HTML report
  - Skill.md profile
  - Share manifest
  - Optional PDF with --pdf
  - Optional public spotlight anchors when you publish proof

Shortcut:
  tokenbar claim 019e7a08-b6d6-7863-be79-66b20c9353df
  tokenbar prove 019e7a08-b6d6-7863-be79-66b20c9353df
  These attach that Codex/ChatGPT session id as the story anchor.

Privacy:
  Raw prompts, transcripts, source code, credentials, private diffs, and env
  files stay local. Publishing proof uploads only generated aggregate identity
  fields plus your chosen redactions.
EOF
        return 0
        ;;
      --publish|--publish-proof|--proof|--activate)
        publish_now=true
        ;;
      --public|--unlisted|--private|--hide-owner|--hide-tokens|--hide-sessions|--hide-region)
        publish_args+=("$1")
        ;;
      --spotlight-session|--session)
        publish_args+=("$1")
        shift
        publish_args+=("${1:-}")
        spotlight_sessions="${spotlight_sessions}${spotlight_sessions:+,}${1:-}"
        ;;
      --spotlight-project)
        publish_args+=("$1")
        shift
        publish_args+=("${1:-}")
        spotlight_projects="${spotlight_projects}${spotlight_projects:+,}${1:-}"
        ;;
      --spotlight-note)
        publish_args+=("$1")
        shift
        publish_args+=("${1:-}")
        spotlight_notes="${spotlight_notes}${spotlight_notes:+|}${1:-}"
        ;;
      --spotlight-insight)
        publish_args+=("$1")
        shift
        publish_args+=("${1:-}")
        spotlight_insights="${spotlight_insights}${spotlight_insights:+|}${1:-}"
        ;;
      --spotlight-struggle)
        publish_args+=("$1")
        shift
        publish_args+=("${1:-}")
        spotlight_struggles="${spotlight_struggles}${spotlight_struggles:+|}${1:-}"
        ;;
      --spotlight-feature)
        publish_args+=("$1")
        shift
        publish_args+=("${1:-}")
        spotlight_features="${spotlight_features}${spotlight_features:+|}${1:-}"
        ;;
      --spotlight-progress)
        publish_args+=("$1")
        shift
        publish_args+=("${1:-}")
        spotlight_progress="${spotlight_progress}${spotlight_progress:+|}${1:-}"
        ;;
      --legacy-share|--share|--upload)
        legacy_share=true
        ;;
      --output-dir)
        args+=("$1")
        shift
        output_dir="${1:-$output_dir}"
        args+=("$output_dir")
        ;;
      --endpoint|--upload-url)
        shift
        endpoint="${1:-$endpoint}"
        ;;
      --action-endpoint|--action-url)
        shift
        action_endpoint="${1:-$action_endpoint}"
        ;;
      *)
        if looks_like_session_id "$1"; then
          publish_args+=("--spotlight-session" "$1")
          spotlight_sessions="${spotlight_sessions}${spotlight_sessions:+,}$1"
        else
          args+=("$1")
        fi
        ;;
    esac
    shift || true
  done

  profile_report "${args[@]}"
  identity_path="$(ls -t "$output_dir"/*.identity.json 2>/dev/null | head -n 1 || true)"
  if [[ -z "$identity_path" ]]; then
    echo "Generated profile, but could not locate the identity JSON in $output_dir." >&2
    return 1
  fi

  TOKENBAR_SPOTLIGHT_SESSIONS="$spotlight_sessions" \
  TOKENBAR_SPOTLIGHT_PROJECTS="$spotlight_projects" \
  TOKENBAR_SPOTLIGHT_NOTES="$spotlight_notes" \
  TOKENBAR_SPOTLIGHT_INSIGHTS="$spotlight_insights" \
  TOKENBAR_SPOTLIGHT_STRUGGLES="$spotlight_struggles" \
  TOKENBAR_SPOTLIGHT_FEATURES="$spotlight_features" \
  TOKENBAR_SPOTLIGHT_PROGRESS="$spotlight_progress" \
  patch_identity_spotlight "$identity_path"

  echo
  echo "Private builder claim is ready."
  echo "Identity JSON: $identity_path"
  echo "Nothing public was uploaded."
  echo
  echo "Private inspection:"
  echo "  tokenbar card"
  echo "  tokenbar verify"
  echo
  echo "When you choose to share safe proof only:"
  echo "  tokenbar publish-proof"
  echo "  This returns a TBAR token plus proof/profile/social/rankings links."
  if [[ -n "$spotlight_sessions$spotlight_projects$spotlight_notes$spotlight_insights$spotlight_struggles$spotlight_features$spotlight_progress" ]]; then
    echo "  Your spotlight story is already attached to the local identity JSON."
  fi
  echo
  TOKENBAR_CLAIM_PROFILE_ENDPOINT="$endpoint" TOKENBAR_CLAIM_ACTION_ENDPOINT="$action_endpoint" python3 - <<'PY'
import os
from urllib.parse import urlsplit

profile_endpoint = os.environ.get("TOKENBAR_CLAIM_PROFILE_ENDPOINT") or ""
action_endpoint = os.environ.get("TOKENBAR_CLAIM_ACTION_ENDPOINT") or ""

base_url = profile_endpoint.split("/api/profiles", 1)[0].rstrip("/") if "/api/profiles" in profile_endpoint else ""
if not base_url and profile_endpoint:
    parsed = urlsplit(profile_endpoint)
    if parsed.scheme and parsed.netloc:
        base_url = f"{parsed.scheme}://{parsed.netloc}".rstrip("/")

if base_url:
    print("Paste the returned TBAR token here:")
    print(f"  {base_url}/profile")
    print(f"  {base_url}/social")
    print(f"  {base_url}/rankings")
else:
    print("Paste the returned TBAR token into /profile, /social, or /rankings.")
print()
print("Configured action endpoint:")
print(f"  {action_endpoint}")
PY
  echo
  echo "Advanced legacy profile JSON upload:"
  echo "  tokenbar claim --legacy-share"

  if [[ "$publish_now" == true ]]; then
    previous_action_endpoint="${TOKENBAR_ACTION_URL:-}"
    TOKENBAR_ACTION_URL="$action_endpoint" builder_identity_action "$identity_path" "${publish_args[@]}"
    if [[ -n "$previous_action_endpoint" ]]; then
      export TOKENBAR_ACTION_URL="$previous_action_endpoint"
    else
      unset TOKENBAR_ACTION_URL
    fi
  fi

  if [[ "$legacy_share" == true ]]; then
    previous_endpoint="${TOKENBAR_PROFILE_UPLOAD_URL:-}"
    TOKENBAR_PROFILE_UPLOAD_URL="$endpoint" share_profile "$identity_path"
    if [[ -n "$previous_endpoint" ]]; then
      export TOKENBAR_PROFILE_UPLOAD_URL="$previous_endpoint"
    else
      unset TOKENBAR_PROFILE_UPLOAD_URL
    fi
  fi
}

submit_profile() {
  local project event track repo demo tagline visibility
  local redaction_args=()
  local spotlight_args=()
  project="${TOKENBAR_PROJECT_TITLE:-}"
  event="${TOKENBAR_HACKATHON_EVENT:-OpenAI Build Week}"
  track="${TOKENBAR_PROJECT_TRACK:-Apps for Your Life}"
  repo="${TOKENBAR_PROJECT_REPO:-}"
  demo="${TOKENBAR_PROJECT_DEMO:-}"
  tagline="${TOKENBAR_PROJECT_TAGLINE:-}"
  visibility="--public"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project|--name)
        shift
        project="${1:-}"
        ;;
      --event)
        shift
        event="${1:-$event}"
        ;;
      --track)
        shift
        track="${1:-$track}"
        ;;
      --repo|--github)
        shift
        repo="${1:-}"
        ;;
      --demo|--url)
        shift
        demo="${1:-}"
        ;;
      --tagline|--proof)
        shift
        tagline="${1:-}"
        ;;
      --public|--unlisted|--private)
        visibility="$1"
        ;;
      --hide-owner|--hide-tokens|--hide-sessions|--hide-region)
        redaction_args+=("$1")
        ;;
      --spotlight-session|--session|--spotlight-project|--spotlight-note|--spotlight-insight|--spotlight-struggle|--spotlight-feature|--spotlight-progress)
        spotlight_args+=("$1")
        shift
        spotlight_args+=("${1:-}")
        ;;
      --help|-h)
        cat <<'EOF'
Usage:
  tokenbar submit [--project NAME] [--event EVENT] [--track TRACK] [--repo URL] [--demo URL] [--tagline TEXT] [--public|--unlisted|--private]
                  [--spotlight-session ID] [--spotlight-project NAME] [--spotlight-note TEXT]

Examples:
  tokenbar submit --project "My Codex App" --repo https://github.com/me/app --demo https://app.example.com
  tokenbar submit --event "OpenAI Build Week" --track "Apps for Your Life" --unlisted
  tokenbar submit --project "TokenBar" --spotlight-session 019e... --spotlight-note "Converted usage logs into a proof story"

What happens:
  - TokenBar analyzes local coding-agent evidence on this machine.
  - Raw prompts, transcripts, source code, and secrets stay local.
  - Only generated identity/proof fields and the project metadata above are published.
  - The command prints a TBAR token plus profile, feed, and leaderboard links.
EOF
        return 0
        ;;
      *)
        if [[ -z "$project" ]]; then
          project="$1"
        else
          echo "Unknown submit argument: $1" >&2
          return 2
        fi
        ;;
    esac
    shift || true
  done

  if [[ -z "$project" ]]; then
    project="$(basename "$PWD")"
  fi

  if [[ -z "$repo" ]]; then
    repo="$(git config --get remote.origin.url 2>/dev/null || true)"
  fi

  echo "Submitting a safe TokenBar builder profile for: $project"
  echo "Event: $event"
  echo "Track: $track"
  echo "Visibility: ${visibility#--}"
  echo "Privacy: raw prompts, transcripts, source code, and secrets stay local."
  echo "After analysis: copy the printed Safe token and paste it on /social to join the board."
  echo

  # claim_profile generates the identity through a child Python process. Export
  # the deliberately selected public metadata so that process receives it;
  # without this, `submit` would print the project name but publish a fallback.
  export TOKENBAR_HACKATHON_EVENT="$event"
  export TOKENBAR_PROJECT_TITLE="$project"
  export TOKENBAR_PROJECT_TAGLINE="$tagline"
  export TOKENBAR_PROJECT_TRACK="$track"
  export TOKENBAR_PROJECT_REPO="$repo"
  export TOKENBAR_PROJECT_DEMO="$demo"
  claim_profile --publish-proof "$visibility" "${redaction_args[@]}" "${spotlight_args[@]}"
}

identity_card() {
  local identity_path
  identity_path="${1:-}"

  if [[ -z "$identity_path" ]]; then
    identity_path="$(ls -t "$support_dir"/profiles/*.identity.json 2>/dev/null | head -n 1 || true)"
  fi

  if [[ -z "$identity_path" || ! -f "$identity_path" ]]; then
    cat >&2 <<'EOF'
No identity JSON found.
Generate one first:
  tokenbar claim

Or pass a file:
  tokenbar card /path/to/profile.identity.json
EOF
    return 1
  fi

  TOKENBAR_IDENTITY_CARD_PATH="$identity_path" python3 - <<'PY'
import json
import os
from pathlib import Path

path = Path(os.environ["TOKENBAR_IDENTITY_CARD_PATH"]).expanduser()
data = json.loads(path.read_text(encoding="utf-8"))

label = data.get("identityLabel") if isinstance(data.get("identityLabel"), dict) else {}
rationale = data.get("labelRationale") if isinstance(data.get("labelRationale"), dict) else {}
usage = data.get("usage") if isinstance(data.get("usage"), dict) else {}
session = data.get("sessionAnalysis") if isinstance(data.get("sessionAnalysis"), dict) else {}
provider_analyses = data.get("providerAnalyses") if isinstance(data.get("providerAnalyses"), dict) else {}
providers = data.get("providerSources") if isinstance(data.get("providerSources"), list) else []
privacy = data.get("privacy") if isinstance(data.get("privacy"), dict) else {}
shipping = data.get("shippingAnalysis") if isinstance(data.get("shippingAnalysis"), dict) else {}

print("TokenBar Identity Card")
print(f"Title: {data.get('title') or label.get('title') or 'Unknown'}")
print(f"Token: {data.get('token') or 'unissued'}")
print(f"NPC class: {data.get('npcClass') or 'unknown'}")
print(f"Bucket: {label.get('bucketKey') or 'legacy'}")
print(f"Specificity: {data.get('specificityScore', 0)}/100")
print(f"Proof score: {data.get('proofScore', data.get('specificityScore', 0))}/100")
print(f"Loop maturity: {data.get('loopMaturity', data.get('loopScore', 0))}/100")
print(f"Estimated rarity: {data.get('estimatedRarityPercent', 'unknown')}%")
print(f"Window: {data.get('windowDays', '?')} days; sessions: {usage.get('sessionsIndexed', '?')}; last 7d: {usage.get('last7', '?')}")
print()

summary = rationale.get("summary") or data.get("subtitle") or ""
if summary:
    print("Why this label")
    print(f"  {summary}")
    print()

print("Top probabilities")
for item in (data.get("archetypeDistribution") or [])[:5]:
    print(f"  {item.get('probability', 0):>5}%  {item.get('name', 'Unknown')} ({item.get('npcClass', 'builder')})")
print()

label_model = data.get("labelModel") if isinstance(data.get("labelModel"), dict) else {}
label_distribution = data.get("labelDistribution") if isinstance(data.get("labelDistribution"), list) else []
if label_distribution:
    print("Nearest identity buckets")
    if label_model.get("possibleLabels"):
        print(f"  Label space: {label_model.get('possibleLabels')} local buckets")
    for item in label_distribution[:6]:
        print(f"  {item.get('probability', 0):>6}%  {item.get('title', 'Unknown')} ({item.get('npcClass', 'builder')})")
    print()

drivers = rationale.get("topTraitDrivers") or []
if drivers:
    print("Trait drivers")
    for item in drivers[:7]:
        print(f"  {str(item.get('trait', 'Trait')):<24} {item.get('score', 0)}/100")
    print()

loop_scale = data.get("loopScale") if isinstance(data.get("loopScale"), list) else []
if loop_scale:
    print("Builder Loop Scale")
    for item in sorted(loop_scale, key=lambda row: float(row.get("score") or 0), reverse=True)[:5]:
        print(f"  {str(item.get('name', 'Loop dimension')):<24} {item.get('score', 0)}/100")
        if item.get("evidence"):
            print(f"           {item.get('evidence')}")
    print()

if session.get("available"):
    print("Session signals")
    print(f"  Prompts sampled: {session.get('promptCount', 0)}")
    print(f"  Command style: {float(session.get('commandPromptRatio') or 0) * 100:.1f}%")
    print(f"  Redirection: {float(session.get('redirectionSignal') or 0) * 100:.1f}%")
    print(f"  Visual/product: {float(session.get('visualSignal') or 0) * 100:.1f}%")
    print(f"  Identity/report: {float(session.get('identitySignal') or 0) * 100:.1f}%")
    print()

patterns = session.get("behaviorPatterns") if isinstance(session.get("behaviorPatterns"), list) else []
if patterns:
    print("Behavior patterns")
    print(f"  Operating mode: {session.get('operatingMode') or 'unknown'}")
    for item in patterns[:5]:
        print(f"  {item.get('score', 0):>5}/100  {item.get('name', 'Pattern')}")
        if item.get("evidence"):
            print(f"           {item.get('evidence')}")
    print()

if shipping:
    print("Shipping evidence")
    if shipping.get("available"):
        print(f"  Repo: {shipping.get('repo')}")
        print(f"  Commits: {shipping.get('commitCount', 0)} in {shipping.get('windowDays', '?')} days")
        print(
            f"  Net LOC: {shipping.get('netLoc', 0)} "
            f"({shipping.get('insertions', 0)} insertions / {shipping.get('deletions', 0)} deletions)"
        )
        peak = shipping.get("peakCommitDay") if isinstance(shipping.get("peakCommitDay"), dict) else {}
        if peak:
            print(f"  Peak commit day: {peak.get('date')} ({peak.get('commits')} commits)")
    else:
        print(f"  Unavailable: {shipping.get('reason', 'not inside a git repository')}")
    print()

if providers:
    print("Provider sources")
    for item in providers[:6]:
        name = item.get("name", "Provider")
        status = item.get("status", "unknown")
        found = "found" if item.get("found") else "not found"
        print(f"  {name:<14} {status} ({found})")
    print()

if provider_analyses:
    print("Parsed provider signals")
    for key, item in list(provider_analyses.items())[:5]:
        if not isinstance(item, dict):
            continue
        print(
            f"  {item.get('provider', key):<14} prompts={item.get('promptCount', 0)} "
            f"command={float(item.get('commandPromptRatio') or 0) * 100:.1f}% "
            f"identity={float(item.get('identitySignal') or 0) * 100:.1f}%"
        )
    print()

print("Files")
print(f"  Identity JSON: {path}")
html_path = path.with_suffix(".html")
skill_path = path.with_suffix(".skill.md")
pdf_path = path.with_suffix(".pdf")
if html_path.exists():
    print(f"  HTML report: {html_path}")
if pdf_path.exists():
    print(f"  PDF report: {pdf_path}")
if skill_path.exists():
    print(f"  Skill.md: {skill_path}")
print()
print(
    "Privacy: raw transcripts="
    f"{bool(privacy.get('rawTranscriptsIncluded'))}; source code={bool(privacy.get('sourceCodeIncluded'))}; "
    f"share requires user action={bool(privacy.get('shareRequiresUserAction', True))}"
)
PY
}

identity_skill() {
  local input_path output_path print_full copy_clipboard
  input_path=""
  output_path=""
  print_full=false
  copy_clipboard=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --print|print)
        print_full=true
        ;;
      --copy|copy)
        copy_clipboard=true
        ;;
      --output|-o)
        shift
        output_path="${1:-}"
        ;;
      *)
        if [[ -z "$input_path" ]]; then
          input_path="$1"
        fi
        ;;
    esac
    shift || true
  done

  if [[ -z "$input_path" ]]; then
    input_path="$(ls -t "$support_dir"/profiles/*.skill.md 2>/dev/null | head -n 1 || true)"
  fi

  TOKENBAR_SKILL_INPUT="$input_path" TOKENBAR_SKILL_OUTPUT="$output_path" TOKENBAR_SKILL_PRINT="$print_full" TOKENBAR_SKILL_COPY="$copy_clipboard" python3 - <<'PY'
import json
import os
import shutil
import subprocess
from pathlib import Path

raw = os.environ.get("TOKENBAR_SKILL_INPUT") or ""
output_raw = os.environ.get("TOKENBAR_SKILL_OUTPUT") or ""
print_full = os.environ.get("TOKENBAR_SKILL_PRINT") == "true"
copy_clipboard = os.environ.get("TOKENBAR_SKILL_COPY") == "true"

if not raw:
    print("No local TokenBar Skill.md found.")
    print("Generate one first: tokenbar identity")
    raise SystemExit(1)

path = Path(raw).expanduser()
if path.name.endswith(".identity.json"):
    path = path.with_name(path.name[:-len(".identity.json")] + ".skill.md")
elif path.name.endswith(".manifest.json"):
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
        skill_value = (manifest.get("files") or {}).get("skillMd")
        if skill_value:
            path = Path(skill_value).expanduser()
    except Exception:
        pass
elif path.suffix == ".json":
    path = path.with_suffix(".skill.md")

if not path.exists():
    print(f"Skill.md not found: {path}")
    print("Pass a .skill.md path, .identity.json path, or generate a new profile.")
    raise SystemExit(1)

text = path.read_text(encoding="utf-8")
if output_raw:
    output = Path(output_raw).expanduser()
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(text, encoding="utf-8")
    print(f"Skill.md exported: {output}")

if copy_clipboard:
    pbcopy = shutil.which("pbcopy")
    if not pbcopy:
        print("Clipboard copy unavailable: pbcopy not found.")
        raise SystemExit(1)
    subprocess.run([pbcopy], input=text, text=True, check=True)
    print("Skill.md copied to clipboard.")

if print_full:
    print(text.rstrip())
else:
    lines = text.splitlines()
    print("TokenBar identity Skill.md")
    print(f"Path: {path}")
    print()
    preview = []
    for line in lines:
        if line.startswith("# ") or line.startswith("## ") or line.startswith("- "):
            preview.append(line)
        if len(preview) >= 18:
            break
    print("\n".join(preview) if preview else "\n".join(lines[:18]))
    print()
    print("Use --print for the full Skill.md, --copy for clipboard, or --output PATH for a portable copy.")
PY
}

compare_identity_profiles() {
  local before_path after_path
  before_path="${1:-}"
  after_path="${2:-}"

  if [[ "$before_path" == "latest" || "$before_path" == "recent" || "$before_path" == "last" ]]; then
    before_path="$(ls -t "$support_dir"/profiles/*.identity.json 2>/dev/null | sed -n '2p' || true)"
    after_path="$(ls -t "$support_dir"/profiles/*.identity.json 2>/dev/null | sed -n '1p' || true)"
  fi

  if [[ -z "$before_path" || -z "$after_path" ]]; then
    cat >&2 <<'EOF'
Compare two TokenBar identity snapshots:
  tokenbar compare /path/to/old.identity.json /path/to/new.identity.json
  tokenbar compare latest

Tip:
  ls -t "$HOME/Library/Application Support/CodexLimitBar/profiles"/*.identity.json
EOF
    return 1
  fi

  if [[ ! -f "$before_path" || ! -f "$after_path" ]]; then
    echo "Both compare inputs must be existing identity JSON files." >&2
    return 1
  fi

  TOKENBAR_COMPARE_BEFORE="$before_path" TOKENBAR_COMPARE_AFTER="$after_path" python3 - <<'PY'
import json
import os
from pathlib import Path

before_path = Path(os.environ["TOKENBAR_COMPARE_BEFORE"]).expanduser()
after_path = Path(os.environ["TOKENBAR_COMPARE_AFTER"]).expanduser()
before = json.loads(before_path.read_text(encoding="utf-8"))
after = json.loads(after_path.read_text(encoding="utf-8"))

def label(profile):
    item = profile.get("identityLabel") if isinstance(profile.get("identityLabel"), dict) else {}
    return item.get("title") or profile.get("title") or item.get("bucketKey") or "unknown"

def bucket(profile):
    item = profile.get("identityLabel") if isinstance(profile.get("identityLabel"), dict) else {}
    return item.get("bucketKey") or "legacy"

def usage(profile, key):
    item = profile.get("usage") if isinstance(profile.get("usage"), dict) else {}
    return item.get(key)

def dim_map(profile):
    return {
        item.get("name"): float(item.get("score") or 0)
        for item in (profile.get("dimensions") or [])
        if isinstance(item, dict) and item.get("name")
    }

def pattern_map(profile):
    session = profile.get("sessionAnalysis") if isinstance(profile.get("sessionAnalysis"), dict) else {}
    return {
        item.get("name"): float(item.get("score") or 0)
        for item in (session.get("behaviorPatterns") or [])
        if isinstance(item, dict) and item.get("name")
    }, session.get("operatingMode")

def provider_counts(profile):
    rows = {}
    for key, item in (profile.get("providerAnalyses") or {}).items():
        if not isinstance(item, dict):
            continue
        name = item.get("provider") or key
        rows[name] = int(item.get("promptCount") or item.get("artifactCount") or 0)
    return rows

def print_delta_rows(title, old, new, limit=8):
    keys = sorted(set(old) | set(new), key=lambda key: abs(float(new.get(key, 0)) - float(old.get(key, 0))), reverse=True)
    print(title)
    if not keys:
        print("  none")
        return
    for key in keys[:limit]:
        before_value = float(old.get(key, 0))
        after_value = float(new.get(key, 0))
        delta = after_value - before_value
        sign = "+" if delta >= 0 else ""
        print(f"  {key:<24} {before_value:>5.1f} -> {after_value:>5.1f} ({sign}{delta:.1f})")

before_dims = dim_map(before)
after_dims = dim_map(after)
before_patterns, before_mode = pattern_map(before)
after_patterns, after_mode = pattern_map(after)
before_providers = provider_counts(before)
after_providers = provider_counts(after)

print("TokenBar identity comparison")
print(f"Before: {before_path}")
print(f"After:  {after_path}")
print()
print("Identity")
print(f"  Label:       {label(before)} -> {label(after)}")
print(f"  Bucket:      {bucket(before)} -> {bucket(after)}")
print(f"  Archetype:   {before.get('primaryArchetype', 'unknown')} -> {after.get('primaryArchetype', 'unknown')}")
print(f"  NPC class:   {before.get('npcClass', 'unknown')} -> {after.get('npcClass', 'unknown')}")
print(f"  Specificity: {before.get('specificityScore', 0)}/100 -> {after.get('specificityScore', 0)}/100")
print(f"  Window:      {before.get('windowDays', '?')}d -> {after.get('windowDays', '?')}d")
print()
print("Usage")
print(f"  Last 7d:     {usage(before, 'last7')} -> {usage(after, 'last7')}")
print(f"  Last 30d:    {usage(before, 'last30')} -> {usage(after, 'last30')}")
print(f"  Sessions:    {usage(before, 'sessionsIndexed')} -> {usage(after, 'sessionsIndexed')}")
print()
print_delta_rows("Dimension shifts", before_dims, after_dims)
print()
print(f"Operating mode: {before_mode or 'unknown'} -> {after_mode or 'unknown'}")
print_delta_rows("Behavior pattern shifts", before_patterns, after_patterns)
print()
print_delta_rows("Provider signal count shifts", before_providers, after_providers)
print()
print("Privacy")
for name, profile in (("Before", before), ("After", after)):
    privacy = profile.get("privacy") if isinstance(profile.get("privacy"), dict) else {}
    print(
        f"  {name}: raw transcripts={bool(privacy.get('rawTranscriptsIncluded'))}; "
        f"source code={bool(privacy.get('sourceCodeIncluded'))}"
    )
PY
}

identity_history() {
  local limit
  limit="${1:-8}"
  TOKENBAR_HISTORY_DIR="$support_dir/profiles" TOKENBAR_HISTORY_LIMIT="$limit" python3 - <<'PY'
import json
import os
from pathlib import Path

root = Path(os.environ["TOKENBAR_HISTORY_DIR"]).expanduser()
try:
    limit = max(1, min(50, int(os.environ.get("TOKENBAR_HISTORY_LIMIT") or "8")))
except Exception:
    limit = 8

paths = sorted(root.glob("*.identity.json"), key=lambda item: item.stat().st_mtime, reverse=True) if root.exists() else []
if not paths:
    print("No local TokenBar identity snapshots found.")
    print("Generate one first: tokenbar identity")
    raise SystemExit(0)

print("Recent TokenBar identity snapshots")
for index, path in enumerate(paths[:limit], start=1):
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        print(f"{index:>2}. unreadable  {path}")
        continue
    label = data.get("identityLabel") if isinstance(data.get("identityLabel"), dict) else {}
    title = label.get("title") or data.get("title") or path.stem
    session = data.get("sessionAnalysis") if isinstance(data.get("sessionAnalysis"), dict) else {}
    mode = session.get("operatingMode")
    specificity = data.get("specificityScore", "?")
    window = data.get("windowDays", "?")
    created = data.get("generatedAt") or data.get("createdAt") or "unknown time"
    print(f"{index:>2}. {title}")
    suffix = f" · {mode}" if mode else ""
    print(f"    {created} · {window}d · specificity {specificity}/100{suffix}")
    print(f"    {path}")

if len(paths) >= 2:
    print()
    print("Compare newest two:")
    print("  tokenbar compare latest")
PY
}

identity_rankings() {
  local limit
  limit="${1:-25}"
  TOKENBAR_RANKINGS_DIR="$support_dir/profiles" TOKENBAR_RANKINGS_LIMIT="$limit" python3 - <<'PY'
import json
import os
from collections import Counter
from pathlib import Path

root = Path(os.environ["TOKENBAR_RANKINGS_DIR"]).expanduser()
try:
    limit = max(2, min(100, int(os.environ.get("TOKENBAR_RANKINGS_LIMIT") or "25")))
except Exception:
    limit = 25

paths = sorted(root.glob("*.identity.json"), key=lambda item: item.stat().st_mtime, reverse=True) if root.exists() else []
profiles = []
for path in paths[:limit]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        continue
    label = data.get("identityLabel") if isinstance(data.get("identityLabel"), dict) else {}
    session = data.get("sessionAnalysis") if isinstance(data.get("sessionAnalysis"), dict) else {}
    profiles.append({
        "path": path,
        "title": label.get("title") or data.get("title") or path.stem,
        "bucket": label.get("bucketKey") or "legacy",
        "archetype": data.get("primaryArchetype") or "unknown",
        "npc": data.get("npcClass") or "unknown",
        "specificity": float(data.get("specificityScore") or 0),
        "mode": session.get("operatingMode") or "unknown",
    })

if not profiles:
    print("No local TokenBar identity snapshots found.")
    print("Generate one first: tokenbar identity")
    raise SystemExit(0)

def print_counter(title, counter):
    print(title)
    if not counter:
        print("  none")
        return
    total = sum(counter.values()) or 1
    width = max(len(str(name)) for name in counter)
    for name, count in counter.most_common(8):
        print(f"  {str(name):<{width}}  {count} ({(count / total) * 100:.1f}%)")

def print_rare(title, counter):
    print(title)
    if not counter:
        print("  none")
        return
    total = sum(counter.values()) or 1
    rows = sorted(counter.items(), key=lambda item: (item[1], item[0]))[:8]
    width = max(len(str(name)) for name, _ in rows)
    for name, count in rows:
        rarity = "unique" if count == 1 else "uncommon" if count <= 3 else "common"
        print(f"  {str(name):<{width}}  {count} ({(count / total) * 100:.1f}%)  {rarity}")

archetypes = Counter(item["archetype"] for item in profiles)
npcs = Counter(item["npc"] for item in profiles)
buckets = Counter(item["bucket"] for item in profiles)
modes = Counter(item["mode"] for item in profiles)

print("TokenBar local identity rankings")
print(f"Snapshots: {len(profiles)} from {root}")
print()
print_counter("Top archetypes", archetypes)
print()
print_counter("NPC classes", npcs)
print()
print_counter("Operating modes", modes)
print()
print_rare("Rarest local identity buckets", buckets)
print()
print("Most specific local reports")
for item in sorted(profiles, key=lambda profile: (-profile["specificity"], profile["title"]))[:8]:
    print(f"  {item['specificity']:>5.1f}/100  {item['title']} ({item['npc']})")
print()
print("These rankings are local-only. Run tokenbar publish or tokenbar share to opt in to public aggregate stats.")
PY
}

identity_timeline() {
  local limit output_path
  limit="12"
  output_path=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --limit)
        shift
        limit="${1:-12}"
        ;;
      --output)
        shift
        output_path="${1:-}"
        ;;
      *)
        if [[ "$1" =~ ^[0-9]+$ ]]; then
          limit="$1"
        elif [[ -z "$output_path" ]]; then
          output_path="$1"
        fi
        ;;
    esac
    shift || true
  done

  TOKENBAR_TIMELINE_DIR="$support_dir/profiles" TOKENBAR_TIMELINE_LIMIT="$limit" TOKENBAR_TIMELINE_OUTPUT="$output_path" python3 - <<'PY'
import html
import json
import os
import time
from pathlib import Path

root = Path(os.environ["TOKENBAR_TIMELINE_DIR"]).expanduser()
try:
    limit = max(2, min(50, int(os.environ.get("TOKENBAR_TIMELINE_LIMIT") or "12")))
except Exception:
    limit = 12
output_raw = os.environ.get("TOKENBAR_TIMELINE_OUTPUT") or ""
output = Path(output_raw).expanduser() if output_raw else root / f"tokenbar-identity-timeline-{time.strftime('%Y%m%d-%H%M')}.html"

paths = sorted(root.glob("*.identity.json"), key=lambda item: item.stat().st_mtime) if root.exists() else []
paths = paths[-limit:]
profiles = []
for path in paths:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        continue
    label = data.get("identityLabel") if isinstance(data.get("identityLabel"), dict) else {}
    session = data.get("sessionAnalysis") if isinstance(data.get("sessionAnalysis"), dict) else {}
    dims = {item.get("name"): float(item.get("score") or 0) for item in (data.get("dimensions") or []) if isinstance(item, dict) and item.get("name")}
    patterns = {item.get("name"): float(item.get("score") or 0) for item in (session.get("behaviorPatterns") or []) if isinstance(item, dict) and item.get("name")}
    profiles.append({
        "path": path,
        "title": label.get("title") or data.get("title") or path.stem,
        "bucket": label.get("bucketKey") or "legacy",
        "archetype": data.get("primaryArchetype") or "unknown",
        "npc": data.get("npcClass") or "unknown",
        "specificity": float(data.get("specificityScore") or 0),
        "generated": data.get("generatedAt") or data.get("createdAt") or "unknown time",
        "window": data.get("windowDays") or "?",
        "mode": session.get("operatingMode") or "unknown",
        "dims": dims,
        "patterns": patterns,
    })

if len(profiles) < 2:
    print("Need at least two local identity snapshots for a timeline.")
    print("Generate reports first:")
    print("  tokenbar identity")
    print("  tokenbar analyze my identity --days 14")
    raise SystemExit(1)

all_dims = sorted({key for item in profiles for key in item["dims"]})
all_patterns = sorted({key for item in profiles for key in item["patterns"]})

def esc(value):
    return html.escape(str(value), quote=True)

def delta(current, previous, key):
    if previous is None:
        return ""
    change = current.get(key, 0) - previous.get(key, 0)
    if abs(change) < 0.05:
        return "0"
    return f"{change:+.1f}"

cards = []
for index, profile in enumerate(profiles):
    prev = profiles[index - 1] if index else None
    top_dims = sorted(profile["dims"].items(), key=lambda item: item[1], reverse=True)[:4]
    top_patterns = sorted(profile["patterns"].items(), key=lambda item: item[1], reverse=True)[:4]
    label_change = "first snapshot" if not prev else ("same label" if prev["bucket"] == profile["bucket"] else f"changed from {prev['title']}")
    cards.append(f"""
      <article class="snapshot">
        <div class="meta">{esc(profile['generated'])} · {esc(profile['window'])}d · {esc(label_change)}</div>
        <h2>{esc(profile['title'])}</h2>
        <p>{esc(profile['archetype'])} · {esc(profile['npc'])}</p>
        <div class="score">Specificity <strong>{profile['specificity']:.0f}/100</strong>{' <span>' + delta({'specificity': profile['specificity']}, {'specificity': prev['specificity']} if prev else None, 'specificity') + '</span>' if prev else ''}</div>
        <div class="mode">{esc(profile['mode'])}</div>
        <h3>Top dimensions</h3>
        <ul>{''.join(f"<li>{esc(name)} <b>{score:.0f}</b></li>" for name, score in top_dims) or '<li>none</li>'}</ul>
        <h3>Behavior patterns</h3>
        <ul>{''.join(f"<li>{esc(name)} <b>{score:.0f}</b></li>" for name, score in top_patterns) or '<li>none</li>'}</ul>
        <code>{esc(profile['path'])}</code>
      </article>
    """)

dim_rows = []
for name in all_dims:
    values = [profile["dims"].get(name, 0) for profile in profiles]
    start, end = values[0], values[-1]
    dim_rows.append((abs(end - start), f"<tr><td>{esc(name)}</td><td>{start:.1f}</td><td>{end:.1f}</td><td>{end-start:+.1f}</td></tr>"))
dim_html = "".join(row for _, row in sorted(dim_rows, reverse=True))

pattern_rows = []
for name in all_patterns:
    values = [profile["patterns"].get(name, 0) for profile in profiles]
    start, end = values[0], values[-1]
    pattern_rows.append((abs(end - start), f"<tr><td>{esc(name)}</td><td>{start:.1f}</td><td>{end:.1f}</td><td>{end-start:+.1f}</td></tr>"))
pattern_html = "".join(row for _, row in sorted(pattern_rows, reverse=True))

html_doc = f"""<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TokenBar Identity Timeline</title>
  <style>
    body {{ margin: 0; font: 15px/1.5 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #0e1117; color: #eef2ff; }}
    main {{ max-width: 1120px; margin: 0 auto; padding: 44px 24px; }}
    h1 {{ font-size: 42px; line-height: 1.05; margin: 0 0 10px; }}
    h2 {{ margin: 8px 0 6px; font-size: 22px; }}
    h3 {{ margin: 18px 0 6px; font-size: 13px; color: #9fb3d9; text-transform: uppercase; letter-spacing: .08em; }}
    .lede {{ max-width: 760px; color: #aeb8cc; }}
    .grid {{ display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; margin-top: 26px; }}
    .snapshot {{ background: #171c26; border: 1px solid #293247; border-radius: 8px; padding: 18px; }}
    .meta, code {{ color: #8d9bb4; font-size: 12px; word-break: break-all; }}
    .score, .mode {{ margin-top: 12px; padding: 10px 12px; background: #20283a; border-radius: 6px; }}
    .score span {{ color: #8ee6a2; margin-left: 8px; }}
    ul {{ padding-left: 18px; margin: 6px 0 0; }}
    table {{ width: 100%; border-collapse: collapse; margin-top: 12px; background: #171c26; border: 1px solid #293247; }}
    th, td {{ text-align: left; padding: 10px 12px; border-bottom: 1px solid #293247; }}
    th {{ color: #9fb3d9; font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }}
    section {{ margin-top: 34px; }}
  </style>
</head>
<body>
  <main>
    <h1>TokenBar Identity Timeline</h1>
    <p class="lede">Local-only longitudinal profile across {len(profiles)} identity snapshots. This report summarizes generated identity JSON files and does not include raw transcripts or source code.</p>
    <section class="grid">{''.join(cards)}</section>
    <section>
      <h2>Dimension Movement</h2>
      <table><thead><tr><th>Dimension</th><th>First</th><th>Latest</th><th>Change</th></tr></thead><tbody>{dim_html}</tbody></table>
    </section>
    <section>
      <h2>Behavior Pattern Movement</h2>
      <table><thead><tr><th>Pattern</th><th>First</th><th>Latest</th><th>Change</th></tr></thead><tbody>{pattern_html or '<tr><td colspan="4">No behavior patterns captured.</td></tr>'}</tbody></table>
    </section>
  </main>
</body>
</html>
"""

output.parent.mkdir(parents=True, exist_ok=True)
output.write_text(html_doc, encoding="utf-8")
print(f"Identity timeline: {output}")
print(f"Snapshots: {len(profiles)}")
print("Open locally or bundle/share selected identity snapshots when ready.")
PY
}

verify_identity_artifact() {
  local input_path
  input_path="${1:-}"

  if [[ -z "$input_path" ]]; then
    input_path="$(ls -t "$support_dir"/profiles/*.manifest.json 2>/dev/null | head -n 1 || true)"
    if [[ -z "$input_path" ]]; then
      input_path="$(ls -t "$support_dir"/profiles/*.identity.json 2>/dev/null | head -n 1 || true)"
    fi
  fi

  if [[ -z "$input_path" || ! -f "$input_path" ]]; then
    cat >&2 <<'EOF'
No identity artifact found.
Generate one first:
  tokenbar identity

Or pass a file:
  tokenbar verify /path/to/profile.identity.json
  tokenbar verify /path/to/profile.manifest.json
EOF
    return 1
  fi

  TOKENBAR_VERIFY_INPUT_PATH="$input_path" python3 - <<'PY'
import hashlib
import json
import re
import sys
import zipfile
from pathlib import Path

input_path = Path(__import__("os").environ["TOKENBAR_VERIFY_INPUT_PATH"]).expanduser()

def load_json(path):
    return json.loads(path.read_text(encoding="utf-8"))

def sibling_files_from_identity(identity_path):
    if identity_path.name.endswith(".identity.json"):
        stem = identity_path.with_name(identity_path.name[:-len(".identity.json")])
    else:
        stem = identity_path.with_suffix("")
    return {
        "identityJson": identity_path,
        "html": stem.with_suffix(".html"),
        "skillMd": stem.with_suffix(".skill.md"),
        "manifest": stem.with_suffix(".manifest.json"),
        "pdf": stem.with_suffix(".pdf"),
    }

if input_path.suffix.lower() == ".zip":
    errors = []
    warnings = []
    try:
        with zipfile.ZipFile(input_path) as zf:
            names = set(zf.namelist())
            if "tokenbar-bundle-manifest.json" in names and "tokenbar-proof-manifest.json" not in names:
                manifest = json.loads(zf.read("tokenbar-bundle-manifest.json").decode("utf-8"))
                if manifest.get("schema") != "tokenbar.portable-bundle.v1":
                    errors.append("bundle schema is not tokenbar.portable-bundle.v1")
                privacy = manifest.get("privacy") if isinstance(manifest.get("privacy"), dict) else {}
                if privacy.get("rawTranscriptsIncluded") is not False:
                    errors.append("bundle privacy.rawTranscriptsIncluded must be false")
                if privacy.get("sourceCodeIncluded") is not False:
                    errors.append("bundle privacy.sourceCodeIncluded must be false")
                if privacy.get("localPathsIncluded") is not False:
                    errors.append("bundle privacy.localPathsIncluded must be false")

                bundle_files = manifest.get("files") if isinstance(manifest.get("files"), dict) else {}
                identity_name = bundle_files.get("identityJson")
                if not isinstance(identity_name, str) or identity_name not in names:
                    errors.append("bundle is missing its sanitized identity JSON")
                    identity = {}
                else:
                    identity = json.loads(zf.read(identity_name).decode("utf-8"))
                    identity_privacy = identity.get("privacy") if isinstance(identity.get("privacy"), dict) else {}
                    if identity.get("schema") != "tokenbar.identity.v1":
                        errors.append("bundle identity schema is not tokenbar.identity.v1")
                    if identity_privacy.get("rawTranscriptsIncluded") is not False:
                        errors.append("bundle identity includes raw transcripts")
                    if identity_privacy.get("sourceCodeIncluded") is not False:
                        errors.append("bundle identity includes source code")

                local_path_pattern = re.compile(r"(?:/Users/|/home/|/private/var/|/var/folders/|/tmp/)")
                secret_patterns = [
                    r"(?<!\w)(?:sk|rk|whsec|ghp|github_pat|xox[baprs])[-_][A-Za-z0-9_=-]{12,}",
                    r"(?<!\w)[A-Fa-f0-9]{48,}(?!\w)",
                ]
                for name in names:
                    if not name.endswith((".json", ".html", ".md", ".txt")):
                        continue
                    text_payload = zf.read(name).decode("utf-8", errors="ignore")
                    if local_path_pattern.search(text_payload):
                        errors.append(f"bundle leaks a local filesystem path: {name}")
                    if any(re.search(pattern, text_payload) for pattern in secret_patterns):
                        errors.append(f"bundle appears to contain a secret-like value: {name}")

                print("TokenBar portable bundle verification")
                print(f"Artifact: {input_path}")
                print(f"Schema: {manifest.get('schema') or 'missing'}")
                print(f"Identity: {manifest.get('title') or 'missing'}")
                print(f"Privacy: raw transcripts={privacy.get('rawTranscriptsIncluded')}; source code={privacy.get('sourceCodeIncluded')}; local paths={privacy.get('localPathsIncluded')}")
                if errors:
                    print("FAILED:")
                    for item in errors:
                        print(f"  - {item}")
                    raise SystemExit(1)
                print("PASS: portable bundle is safe to move between local tools. Public upload still requires explicit user action.")
                raise SystemExit(0)

            if "tokenbar-proof-manifest.json" not in names:
                errors.append("zip is missing tokenbar-proof-manifest.json")
                manifest = {}
            else:
                manifest = json.loads(zf.read("tokenbar-proof-manifest.json").decode("utf-8"))

            if manifest.get("schema") != "tokenbar.proof-packet.v1":
                errors.append("proof packet schema is not tokenbar.proof-packet.v1")
            privacy = manifest.get("privacy") if isinstance(manifest.get("privacy"), dict) else {}
            if privacy.get("rawTranscriptsIncluded") is not False:
                errors.append("proof privacy.rawTranscriptsIncluded must be false")
            if privacy.get("sourceCodeIncluded") is not False:
                errors.append("proof privacy.sourceCodeIncluded must be false")
            if privacy.get("shareRequiresUserAction") is not True:
                warnings.append("proof shareRequiresUserAction is not explicitly true")

            required_names = {
                "README.md",
                "index.html",
                "local-rankings.txt",
                "compare-latest.txt",
                "timeline.html",
                "tokenbar-proof-verification.json",
            }
            for name in sorted(required_names - names):
                warnings.append(f"proof packet is missing {name}")

            if "tokenbar-proof-verification.json" in names:
                verification = json.loads(zf.read("tokenbar-proof-verification.json").decode("utf-8"))
                if verification.get("schema") != "tokenbar.proof-verification.v1":
                    errors.append("proof verification schema is not tokenbar.proof-verification.v1")
                verified_files = verification.get("files") if isinstance(verification.get("files"), dict) else {}
                if not verified_files:
                    errors.append("proof verification file ledger is empty")
                for name, expected in verified_files.items():
                    if name not in names:
                        errors.append(f"verified payload is missing: {name}")
                        continue
                    if not isinstance(expected, dict):
                        errors.append(f"invalid verification entry: {name}")
                        continue
                    payload = zf.read(name)
                    actual_hash = hashlib.sha256(payload).hexdigest()
                    if expected.get("sha256") != actual_hash:
                        errors.append(f"SHA-256 mismatch: {name}")
                    if expected.get("bytes") != len(payload):
                        errors.append(f"byte count mismatch: {name}")

            text_names = [
                name for name in names
                if name.endswith((".json", ".html", ".md", ".txt"))
            ]
            local_path_pattern = re.compile(r"(?:/Users/|/home/|/private/var/|/var/folders/|/tmp/)")
            for name in text_names:
                text_payload = zf.read(name).decode("utf-8", errors="ignore")
                if local_path_pattern.search(text_payload):
                    errors.append(f"proof packet leaks a local filesystem path: {name}")

            identity_names = [name for name in names if name.startswith("latest/") and name.endswith(".identity.json")]
            if not identity_names:
                errors.append("proof packet is missing latest identity JSON")
                identity = {}
            else:
                identity = json.loads(zf.read(identity_names[0]).decode("utf-8"))
                identity_privacy = identity.get("privacy") if isinstance(identity.get("privacy"), dict) else {}
                if identity.get("schema") != "tokenbar.identity.v1":
                    errors.append("latest identity schema is not tokenbar.identity.v1")
                if identity_privacy.get("rawTranscriptsIncluded") is not False:
                    errors.append("latest identity privacy.rawTranscriptsIncluded must be false")
                if identity_privacy.get("sourceCodeIncluded") is not False:
                    errors.append("latest identity privacy.sourceCodeIncluded must be false")
                builder_signals = identity.get("builderSignalInbox") if isinstance(identity.get("builderSignalInbox"), dict) else {}
                if builder_signals:
                    signal_privacy = builder_signals.get("privacy") if isinstance(builder_signals.get("privacy"), dict) else {}
                    if signal_privacy.get("urlsIncluded") is not False:
                        errors.append("latest identity builderSignalInbox must not include raw URLs")
                    if signal_privacy.get("titlesIncluded") is not False:
                        errors.append("latest identity builderSignalInbox must not include titles")
                    if signal_privacy.get("notesIncluded") is not False:
                        errors.append("latest identity builderSignalInbox must not include notes")
                raw_identity = json.dumps(identity, sort_keys=True)
                secret_patterns = [
                    r"(?<!\w)(?:sk|rk|whsec)_[A-Za-z0-9_=-]{12,}",
                    r"(?<!\w)[A-Fa-f0-9]{48,}(?!\w)",
                ]
                if any(re.search(pattern, raw_identity) for pattern in secret_patterns):
                    errors.append("latest identity JSON appears to contain a secret-like token")

            suspicious = [
                name for name in names
                if name.startswith("/") or ".." in Path(name).parts or name.endswith((".env", ".key", ".pem"))
            ]
            for name in suspicious[:8]:
                errors.append(f"proof packet contains unsafe path/name: {name}")
    except Exception as exc:
        raise SystemExit(f"TokenBar verify failed: could not read proof packet: {exc}") from exc

    print("TokenBar proof packet verification")
    print(f"Artifact: {input_path}")
    print(f"Schema: {manifest.get('schema') or 'missing'}")
    print(f"Latest token: {manifest.get('latestToken') or 'missing'}")
    print(f"Snapshots: {manifest.get('snapshotCount', 0)}")
    print(f"Privacy: raw transcripts={privacy.get('rawTranscriptsIncluded')}; source code={privacy.get('sourceCodeIncluded')}")
    if warnings:
        print("Warnings:")
        for item in warnings:
            print(f"  - {item}")
    if errors:
        print("FAILED:")
        for item in errors:
            print(f"  - {item}")
        raise SystemExit(1)
    print("PASS: proof packet is safe to share. Public upload still requires tokenbar share/publish.")
    raise SystemExit(0)

errors = []
warnings = []
files = {}
identity = {}
manifest = {}

try:
    if input_path.name.endswith(".manifest.json"):
        manifest = load_json(input_path)
        if manifest.get("schema") != "tokenbar.share-manifest.v1":
            errors.append("manifest schema is not tokenbar.share-manifest.v1")
        for key, value in (manifest.get("files") or {}).items():
            if value:
                files[key] = Path(value).expanduser()
        files.setdefault("manifest", input_path)
        identity_path = files.get("identityJson")
        if not identity_path or not identity_path.exists():
            errors.append("manifest does not point to an existing identity JSON")
        else:
            identity = load_json(identity_path)
    else:
        files.update(sibling_files_from_identity(input_path))
        identity = load_json(input_path)
except Exception as exc:
    raise SystemExit(f"TokenBar verify failed: could not read artifact: {exc}") from exc

if identity.get("schema") != "tokenbar.identity.v1":
    errors.append("identity schema is not tokenbar.identity.v1")
token = str(identity.get("token") or "")
if not token.startswith("TBAR-"):
    errors.append("identity token is missing or invalid")

privacy = identity.get("privacy") if isinstance(identity.get("privacy"), dict) else {}
if privacy.get("rawTranscriptsIncluded") is not False:
    errors.append("privacy.rawTranscriptsIncluded must be false")
if privacy.get("sourceCodeIncluded") is not False:
    errors.append("privacy.sourceCodeIncluded must be false")
if privacy.get("shareRequiresUserAction") is not True:
    warnings.append("shareRequiresUserAction is not explicitly true")

session = identity.get("sessionAnalysis") if isinstance(identity.get("sessionAnalysis"), dict) else {}
if session and session.get("rawTranscriptsIncluded") is not False:
    errors.append("sessionAnalysis.rawTranscriptsIncluded must be false")
providers = identity.get("providerAnalyses") if isinstance(identity.get("providerAnalyses"), dict) else {}
for key, item in providers.items():
    if isinstance(item, dict) and item.get("rawTranscriptsIncluded") not in (False, None):
        errors.append(f"providerAnalyses.{key}.rawTranscriptsIncluded must be false")
builder_signals = identity.get("builderSignalInbox") if isinstance(identity.get("builderSignalInbox"), dict) else {}
if builder_signals:
    signal_privacy = builder_signals.get("privacy") if isinstance(builder_signals.get("privacy"), dict) else {}
    if signal_privacy.get("networkUploaded") is not False:
        errors.append("builderSignalInbox.privacy.networkUploaded must be false")
    if signal_privacy.get("urlsIncluded") is not False:
        errors.append("builderSignalInbox.privacy.urlsIncluded must be false")
    if signal_privacy.get("titlesIncluded") is not False:
        errors.append("builderSignalInbox.privacy.titlesIncluded must be false")
    if signal_privacy.get("notesIncluded") is not False:
        errors.append("builderSignalInbox.privacy.notesIncluded must be false")
    raw_signals = json.dumps(builder_signals, sort_keys=True)
    if "http://" in raw_signals or "https://" in raw_signals:
        errors.append("builderSignalInbox must not include raw URLs")

required = [
    "title",
    "identityLabel",
    "labelRationale",
    "archetypeDistribution",
    "specificityScore",
    "dimensions",
]
for key in required:
    if key not in identity:
        errors.append(f"missing required identity field: {key}")

label_model = identity.get("labelModel") if isinstance(identity.get("labelModel"), dict) else {}
if label_model:
    if int(label_model.get("possibleLabels") or 0) <= 0:
        errors.append("labelModel.possibleLabels must be positive")
else:
    warnings.append("labelModel is missing; profile may be an older schema")

if not identity.get("labelDistribution"):
    warnings.append("labelDistribution is missing; nearest bucket ranking will not travel")
if not identity.get("modifierDistribution"):
    warnings.append("modifierDistribution is missing")
if not identity.get("stanceDistribution"):
    warnings.append("stanceDistribution is missing")

for key in ("identityJson", "html", "skillMd", "manifest"):
    path = files.get(key)
    if path and not path.exists():
        warnings.append(f"{key} file is referenced but missing: {path}")
if files.get("html") and not files["html"].exists():
    warnings.append("HTML report file is missing")

raw = json.dumps(identity, sort_keys=True)
secret_patterns = [
    r"(?<!\w)(?:sk|rk|whsec)_[A-Za-z0-9_=-]{12,}",
    r"(?<!\w)[A-Fa-f0-9]{48,}(?!\w)",
]
if any(re.search(pattern, raw) for pattern in secret_patterns):
    errors.append("identity JSON appears to contain a secret-like token")

print("TokenBar identity artifact verification")
print(f"Artifact: {input_path}")
print(f"Token: {token or 'missing'}")
print(f"Title: {identity.get('title') or 'missing'}")
print(f"Privacy: raw transcripts={privacy.get('rawTranscriptsIncluded')}; source code={privacy.get('sourceCodeIncluded')}")
if label_model:
    print(
        "Label model: "
        f"{label_model.get('possibleLabels')} buckets "
        f"({label_model.get('baseArchetypes')} archetypes x {label_model.get('modifiers')} modifiers x {label_model.get('stances')} stances)"
    )
print("Files:")
for key, path in files.items():
    print(f"  {key}: {path} {'ok' if path.exists() else 'missing'}")

if warnings:
    print("Warnings:")
    for item in warnings:
        print(f"  - {item}")
if errors:
    print("FAILED:")
    for item in errors:
        print(f"  - {item}")
    raise SystemExit(1)

print("PASS: safe to bundle or share. Upload still requires tokenbar share/publish.")
PY
}

profile_bundle() {
  local input_path output_path
  input_path="${1:-}"
  output_path=""

  if [[ "${2:-}" == "--output" || "${2:-}" == "-o" ]]; then
    output_path="${3:-}"
  fi

  if [[ -z "$input_path" ]]; then
    input_path="$(ls -t "$support_dir"/profiles/*.manifest.json 2>/dev/null | head -n 1 || true)"
    if [[ -z "$input_path" ]]; then
      input_path="$(ls -t "$support_dir"/profiles/*.identity.json 2>/dev/null | head -n 1 || true)"
    fi
  fi

  if [[ -z "$input_path" || ! -f "$input_path" ]]; then
    cat >&2 <<'EOF'
No profile manifest or identity JSON found.
Generate one first:
  tokenbar identity

Or pass a file:
  tokenbar bundle /path/to/profile.manifest.json
  tokenbar bundle /path/to/profile.identity.json
EOF
    return 1
  fi

  TOKENBAR_BUNDLE_INPUT_PATH="$input_path" TOKENBAR_BUNDLE_OUTPUT_PATH="$output_path" python3 - <<'PY'
import json
import os
import re
import time
import zipfile
from pathlib import Path

input_path = Path(os.environ["TOKENBAR_BUNDLE_INPUT_PATH"]).expanduser()
output_raw = os.environ.get("TOKENBAR_BUNDLE_OUTPUT_PATH") or ""

def load_json(path):
    return json.loads(path.read_text(encoding="utf-8"))

def sibling_files_from_identity(identity_path):
    if identity_path.name.endswith(".identity.json"):
        stem = identity_path.with_name(identity_path.name[:-len(".identity.json")])
    else:
        stem = identity_path.with_suffix("")
    return {
        "identityJson": identity_path,
        "html": stem.with_suffix(".html"),
        "skillMd": stem.with_suffix(".skill.md"),
        "manifest": stem.with_suffix(".manifest.json"),
        "pdf": stem.with_suffix(".pdf"),
    }

PUBLIC_IDENTITY_FIELDS = {
    "schema", "generatedAt", "title", "subtitle", "primaryArchetype", "npcClass",
    "identityLabel", "labelRationale", "archetypeDistribution", "modifierDistribution",
    "stanceDistribution", "labelDistribution", "labelModel", "specificityScore",
    "estimatedRarityPercent", "proofScore", "loopMaturity", "loopScore", "loopScale",
    "dimensions", "signatureMoves", "curiousFacts", "growthEdge", "usage",
    "sessionAnalysis", "shippingAnalysis", "providerAnalyses", "leaderboard",
}
BLOCKED_KEY_PARTS = (
    "path", "transcript", "sourcecode", "source_code", "secret", "credential",
    "rawcontent", "raw_content",
)
BLOCKED_KEYS = {
    "email", "prompt", "prompts", "prompttext", "prompt_text", "promptcontent",
    "prompt_content", "signaturephrases", "signature_phrases",
}
LOCAL_PATH_RE = re.compile(
    r"(?:/Users/[^/\s]+|/home/[^/\s]+|/private/var|/var/folders|/tmp)(?:/[^\s\"']*)?"
)
SECRET_RE = re.compile(r"\b(?:sk|rk|whsec|ghp|github_pat|xox[baprs])[-_][A-Za-z0-9_-]{8,}\b")
EMAIL_RE = re.compile(r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b")

def sanitize_public(value, *, key="", depth=0):
    if depth > 8:
        return None
    normalized = key.replace("-", "_").lower()
    if normalized in BLOCKED_KEYS or any(part in normalized for part in BLOCKED_KEY_PARTS):
        return None
    if value is None or isinstance(value, (bool, int, float)):
        return value
    if isinstance(value, str):
        text = LOCAL_PATH_RE.sub("[local path removed]", value.replace("\x00", ""))
        text = SECRET_RE.sub("[secret removed]", text)
        return EMAIL_RE.sub("[email removed]", text)[:1600]
    if isinstance(value, list):
        cleaned = [sanitize_public(item, depth=depth + 1) for item in value[:120]]
        return [item for item in cleaned if item is not None]
    if isinstance(value, dict):
        cleaned = {}
        for child_key, child_value in list(value.items())[:120]:
            name = str(child_key)[:100]
            safe_value = sanitize_public(child_value, key=name, depth=depth + 1)
            if safe_value is not None:
                cleaned[name] = safe_value
        return cleaned
    return str(value)[:1600]

bundle_manifest = {
    "schema": "tokenbar.portable-bundle.v1",
    "createdAt": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    "sourceArtifact": input_path.name,
    "files": {},
    "privacy": {
        "rawTranscriptsIncluded": False,
        "sourceCodeIncluded": False,
        "localPathsIncluded": False,
        "personalEmailsIncluded": False,
        "secretsIncluded": False,
        "redactedExcerptsOnly": True,
    },
}

files = {}
identity = {}
if input_path.name.endswith(".manifest.json"):
    manifest = load_json(input_path)
    for key, value in (manifest.get("files") or {}).items():
        if value:
            files[key] = Path(value).expanduser()
    if "manifest" not in files:
        files["manifest"] = input_path
    identity_path = files.get("identityJson")
    if identity_path and identity_path.exists():
        identity = load_json(identity_path)
    html_path = files.get("html")
    if html_path and html_path.exists() and "pdf" not in files:
        pdf_path = html_path.with_suffix(".pdf")
        if pdf_path.exists():
            files["pdf"] = pdf_path
else:
    files.update(sibling_files_from_identity(input_path))
    identity = load_json(input_path)

privacy = identity.get("privacy") if isinstance(identity.get("privacy"), dict) else {}
if privacy.get("rawTranscriptsIncluded") or privacy.get("sourceCodeIncluded"):
    raise SystemExit("Refusing to bundle an identity file that claims to include raw transcripts or source code.")

bundle_manifest["token"] = identity.get("token")
bundle_manifest["title"] = sanitize_public(identity.get("title"))
bundle_manifest["identityLabel"] = sanitize_public(identity.get("identityLabel"))
bundle_manifest["labelRationale"] = sanitize_public(identity.get("labelRationale"))
bundle_manifest["privacy"].update({
    "rawTranscriptsIncluded": bool(privacy.get("rawTranscriptsIncluded")),
    "sourceCodeIncluded": bool(privacy.get("sourceCodeIncluded")),
    "redactedExcerptsOnly": bool(privacy.get("redactedExcerptsOnly", True)),
})

public_identity = {
    key: sanitize_public(identity[key], key=key)
    for key in PUBLIC_IDENTITY_FIELDS
    if key in identity
}
public_identity["schema"] = "tokenbar.identity.v1"
public_identity["privacy"] = {
    "localFirst": True,
    "rawTranscriptsIncluded": False,
    "sourceCodeIncluded": False,
    "localPathsIncluded": False,
    "personalEmailsIncluded": False,
    "secretsIncluded": False,
    "shareRequiresUserAction": True,
    "material": "generated identity fields and aggregate usage only",
}

existing = []
for key, path in files.items():
    if key != "manifest" and path and path.exists() and path.is_file():
        existing.append((key, path))

if not existing:
    raise SystemExit("No bundleable profile files were found.")

if output_raw:
    output_path = Path(output_raw).expanduser()
else:
    safe_token = str(identity.get("token") or input_path.stem).replace("/", "-")
    output_path = input_path.parent / f"{safe_token}-tokenbar-profile-bundle.zip"
output_path.parent.mkdir(parents=True, exist_ok=True)

with zipfile.ZipFile(output_path, "w", compression=zipfile.ZIP_DEFLATED) as zf:
    for key, path in existing:
        arcname = path.name
        if key == "identityJson":
            zf.writestr(arcname, json.dumps(public_identity, indent=2, sort_keys=True) + "\n")
        else:
            zf.write(path, arcname)
        bundle_manifest["files"][key] = arcname
    zf.writestr("tokenbar-bundle-manifest.json", json.dumps(bundle_manifest, indent=2, sort_keys=True) + "\n")

print(f"Bundle: {output_path}")
print("Included:")
for key, path in existing:
    print(f"  {key}: {path.name}")
print("  bundleManifest: tokenbar-bundle-manifest.json")
print("Privacy: no raw prompts, transcripts, source code, local paths, personal emails, credentials, or secrets are included.")
PY
}

identity_proof_packet() {
  local output_path limit
  output_path=""
  limit="12"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --output|-o)
        shift
        output_path="${1:-}"
        ;;
      --limit)
        shift
        limit="${1:-12}"
        ;;
      *)
        if [[ -z "$output_path" ]]; then
          output_path="$1"
        fi
        ;;
    esac
    shift || true
  done

  TOKENBAR_PROOF_DIR="$support_dir/profiles" TOKENBAR_PROOF_OUTPUT="$output_path" TOKENBAR_PROOF_LIMIT="$limit" python3 - <<'PY'
import hashlib
import html
import json
import os
import re
import tempfile
import time
import zipfile
from collections import Counter
from pathlib import Path

root = Path(os.environ["TOKENBAR_PROOF_DIR"]).expanduser()
output_raw = os.environ.get("TOKENBAR_PROOF_OUTPUT") or ""
try:
    limit = max(2, min(50, int(os.environ.get("TOKENBAR_PROOF_LIMIT") or "12")))
except Exception:
    limit = 12

identity_paths = sorted(root.glob("*.identity.json"), key=lambda item: item.stat().st_mtime, reverse=True) if root.exists() else []
if not identity_paths:
    print("No local TokenBar identity snapshots found.")
    print("Generate one first: tokenbar identity")
    raise SystemExit(1)

profiles = []
for path in identity_paths[:limit]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        continue
    privacy = data.get("privacy") if isinstance(data.get("privacy"), dict) else {}
    if privacy.get("rawTranscriptsIncluded") or privacy.get("sourceCodeIncluded"):
        raise SystemExit(f"Refusing proof packet: unsafe privacy flags in {path}")
    label = data.get("identityLabel") if isinstance(data.get("identityLabel"), dict) else {}
    session = data.get("sessionAnalysis") if isinstance(data.get("sessionAnalysis"), dict) else {}
    profiles.append({
        "path": path,
        "data": data,
        "title": label.get("title") or data.get("title") or path.stem,
        "bucket": label.get("bucketKey") or "legacy",
        "archetype": data.get("primaryArchetype") or "unknown",
        "npc": data.get("npcClass") or "unknown",
        "specificity": float(data.get("specificityScore") or 0),
        "mode": session.get("operatingMode") or "unknown",
        "generated": data.get("generatedAt") or data.get("createdAt") or "unknown time",
    })

if not profiles:
    raise SystemExit("No readable safe identity snapshots found.")

latest = profiles[0]
if output_raw:
    output_path = Path(output_raw).expanduser()
else:
    token = str(latest["data"].get("token") or "tokenbar").replace("/", "-")
    output_path = root / f"{token}-proof-packet-{time.strftime('%Y%m%d-%H%M')}.zip"
if output_path.suffix.lower() != ".zip":
    output_path = output_path.with_suffix(".zip")
output_path.parent.mkdir(parents=True, exist_ok=True)

archetypes = Counter(item["archetype"] for item in profiles)
npcs = Counter(item["npc"] for item in profiles)
buckets = Counter(item["bucket"] for item in profiles)
modes = Counter(item["mode"] for item in profiles)

def counter_lines(title, counter):
    total = sum(counter.values()) or 1
    rows = [title]
    for name, count in counter.most_common(10):
        rows.append(f"- {name}: {count} ({(count / total) * 100:.1f}%)")
    if len(rows) == 1:
        rows.append("- none")
    return rows

rankings_text = "\n".join([
    "TokenBar Local Identity Rankings",
    f"Snapshots: {len(profiles)}",
    "",
    *counter_lines("Top archetypes", archetypes),
    "",
    *counter_lines("NPC classes", npcs),
    "",
    *counter_lines("Operating modes", modes),
    "",
    "Rarest identity buckets",
    *[
        f"- {bucket}: {count} ({(count / (sum(buckets.values()) or 1)) * 100:.1f}%) {'unique' if count == 1 else 'uncommon' if count <= 3 else 'common'}"
        for bucket, count in sorted(buckets.items(), key=lambda item: (item[1], item[0]))[:10]
    ],
    "",
    "Most specific reports",
    *[f"- {item['specificity']:.1f}/100: {item['title']} ({item['npc']})" for item in sorted(profiles, key=lambda item: (-item["specificity"], item["title"]))[:10]],
    "",
    "Privacy: local-only summary; no raw transcripts or source code included.",
]) + "\n"

compare_text = "Need at least two snapshots for comparison.\n"
if len(profiles) >= 2:
    before = profiles[1]
    after = profiles[0]
    compare_text = "\n".join([
        "TokenBar Latest Identity Comparison",
        f"Before: {before['title']} ({before['generated']})",
        f"After: {after['title']} ({after['generated']})",
        "",
        f"Label: {before['title']} -> {after['title']}",
        f"Bucket: {before['bucket']} -> {after['bucket']}",
        f"Archetype: {before['archetype']} -> {after['archetype']}",
        f"NPC class: {before['npc']} -> {after['npc']}",
        f"Specificity: {before['specificity']:.1f}/100 -> {after['specificity']:.1f}/100 ({after['specificity'] - before['specificity']:+.1f})",
        f"Operating mode: {before['mode']} -> {after['mode']}",
        "",
        "Privacy: local-only comparison; no raw transcripts or source code included.",
    ]) + "\n"

def esc(value):
    return html.escape(str(value), quote=True)

PUBLIC_IDENTITY_FIELDS = {
    "schema",
    "generatedAt",
    "title",
    "subtitle",
    "primaryArchetype",
    "npcClass",
    "identityLabel",
    "labelRationale",
    "archetypeDistribution",
    "modifierDistribution",
    "stanceDistribution",
    "labelDistribution",
    "labelModel",
    "specificityScore",
    "estimatedRarityPercent",
    "proofScore",
    "loopMaturity",
    "loopScore",
    "loopScale",
    "dimensions",
    "signatureMoves",
    "curiousFacts",
    "growthEdge",
    "usage",
    "sessionAnalysis",
    "shippingAnalysis",
    "providerAnalyses",
    "leaderboard",
}
BLOCKED_KEY_PARTS = (
    "path",
    "transcript",
    "sourcecode",
    "source_code",
    "secret",
    "credential",
    "rawcontent",
    "raw_content",
)
BLOCKED_KEYS = {
    "email",
    "prompt",
    "prompts",
    "prompttext",
    "prompt_text",
    "promptcontent",
    "prompt_content",
    "signaturephrases",
    "signature_phrases",
}
LOCAL_PATH_RE = re.compile(
    r"(?:/Users/[^/\s]+|/home/[^/\s]+|/private/var|/var/folders|/tmp)(?:/[^\s\"']*)?"
)
SECRET_RE = re.compile(r"\b(?:sk|rk|whsec|ghp|github_pat|xox[baprs])[-_][A-Za-z0-9_-]{8,}\b")
EMAIL_RE = re.compile(r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b")

def sanitize_public(value, *, key="", depth=0):
    if depth > 8:
        return None
    normalized = key.replace("-", "_").lower()
    if normalized in BLOCKED_KEYS or any(part in normalized for part in BLOCKED_KEY_PARTS):
        return None
    if value is None or isinstance(value, (bool, int, float)):
        return value
    if isinstance(value, str):
        text = value.replace("\x00", "")
        text = LOCAL_PATH_RE.sub("[local path removed]", text)
        text = SECRET_RE.sub("[secret removed]", text)
        text = EMAIL_RE.sub("[email removed]", text)
        return text[:1600]
    if isinstance(value, list):
        cleaned = [sanitize_public(item, depth=depth + 1) for item in value[:120]]
        return [item for item in cleaned if item is not None]
    if isinstance(value, dict):
        cleaned = {}
        for child_key, child_value in list(value.items())[:120]:
            name = str(child_key)[:100]
            safe_value = sanitize_public(child_value, key=name, depth=depth + 1)
            if safe_value is not None:
                cleaned[name] = safe_value
        return cleaned
    return str(value)[:1600]

public_identity = {
    key: sanitize_public(latest["data"][key], key=key)
    for key in PUBLIC_IDENTITY_FIELDS
    if key in latest["data"]
}
public_identity["schema"] = "tokenbar.identity.v1"
public_identity["privacy"] = {
    "localFirst": True,
    "rawTranscriptsIncluded": False,
    "sourceCodeIncluded": False,
    "localPathsIncluded": False,
    "personalEmailsIncluded": False,
    "secretsIncluded": False,
    "shareRequiresUserAction": True,
    "material": "generated identity fields and aggregate usage only",
}

identity_label = public_identity.get("identityLabel") if isinstance(public_identity.get("identityLabel"), dict) else {}
usage = public_identity.get("usage") if isinstance(public_identity.get("usage"), dict) else {}
dimensions = public_identity.get("dimensions") if isinstance(public_identity.get("dimensions"), list) else []
signature_moves = public_identity.get("signatureMoves") if isinstance(public_identity.get("signatureMoves"), list) else []

dimension_rows = []
for dimension in dimensions[:8]:
    if not isinstance(dimension, dict):
        continue
    try:
        score = max(0, min(100, int(float(dimension.get("score") or 0))))
    except (TypeError, ValueError):
        score = 0
    dimension_rows.append(f"""
      <div class="signal-row">
        <div><strong>{esc(dimension.get('name') or 'Signal')}</strong><span>{esc(dimension.get('note') or '')}</span></div>
        <div class="track" aria-label="{esc(dimension.get('name') or 'Signal')} {score} out of 100"><i style="width:{score}%"></i></div>
        <b>{score}</b>
      </div>
    """)

evidence_rows = "".join(
    f"<li><span>{index:02d}</span><p>{esc(item)}</p></li>"
    for index, item in enumerate(signature_moves[:4], start=1)
    if isinstance(item, str) and item.strip()
)
if not evidence_rows:
    evidence_rows = "<li><span>01</span><p>No share-safe evidence summary was generated for this snapshot.</p></li>"

index_html = f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{esc(public_identity.get('title') or 'TokenBar Builder Identity')}</title><link rel="icon" href="data:,">
<style>
:root{{--ink:#f4f4f1;--muted:#9a9b98;--panel:#191a1a;--line:#2c2e2d;--amber:#f2ad57;--cyan:#63aec0;--green:#65b88a;--bg:#111212}}
*{{box-sizing:border-box}}html{{color-scheme:dark}}body{{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}}
body:before{{content:"";position:fixed;inset:0;pointer-events:none;opacity:.035;background-image:repeating-linear-gradient(90deg,#fff 0,#fff 1px,transparent 1px,transparent 4px)}}
main{{width:min(1100px,calc(100% - 40px));margin:0 auto;padding:28px 0 56px}}header{{display:flex;align-items:center;justify-content:space-between;padding:0 0 22px;border-bottom:1px solid var(--line)}}
.brand{{display:flex;align-items:center;gap:10px;font-weight:700}}.mark{{display:grid;place-items:center;width:30px;height:30px;border:1px solid #555;border-radius:8px;background:#202121;color:var(--green);font-size:11px;letter-spacing:.08em}}.privacy{{color:var(--muted);font-size:12px}}
.hero{{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:48px;padding:48px 0 38px;border-bottom:1px solid var(--line)}}.eyebrow,.section-label{{margin:0 0 13px;color:var(--muted);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}}
h1{{max-width:790px;margin:0;font-size:clamp(34px,5vw,58px);line-height:1.02;letter-spacing:0;font-weight:680}}.subtitle{{max-width:760px;margin:18px 0 0;color:#b9bab7;font-size:18px;line-height:1.55}}.pills{{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}}.pill{{padding:7px 10px;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:#c8c9c6;font-size:12px}}
.scoreboard{{align-self:end;border-left:1px solid var(--line);padding-left:28px}}.scoreboard dl{{display:grid;grid-template-columns:1fr auto;gap:12px;margin:0}}.scoreboard dt{{color:var(--muted);font-size:12px}}.scoreboard dd{{margin:0;font:650 20px/1 ui-monospace,SFMono-Regular,Menlo,monospace}}.scoreboard dd:first-of-type{{color:var(--amber)}}
.section{{padding:34px 0;border-bottom:1px solid var(--line)}}.signal-row{{display:grid;grid-template-columns:270px minmax(160px,1fr) 42px;gap:18px;align-items:center;min-width:0;padding:12px 0}}.signal-row>div{{min-width:0}}.signal-row strong{{display:block;font-size:14px}}.signal-row span{{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--muted);font-size:12px;margin-top:2px}}.signal-row b{{text-align:right;font:650 14px ui-monospace,SFMono-Regular,Menlo,monospace}}.track{{height:7px;min-width:0;background:#202222;border-radius:5px;overflow:hidden}}.track i{{display:block;height:100%;background:var(--cyan);border-radius:5px}}.signal-row:first-of-type .track i{{background:var(--amber)}}
.story-grid{{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.65fr);gap:18px}}.evidence,.frontier{{border:1px solid var(--line);background:var(--panel);padding:22px;border-radius:8px}}.evidence ol{{list-style:none;padding:0;margin:0}}.evidence li{{display:grid;grid-template-columns:34px 1fr;gap:12px;padding:13px 0;border-top:1px solid var(--line)}}.evidence li:first-child{{border-top:0;padding-top:0}}.evidence li span{{color:var(--amber);font:700 11px ui-monospace,SFMono-Regular,Menlo,monospace}}.evidence li p{{margin:0;color:#c4c5c2}}.frontier h2{{margin:0;font-size:23px;line-height:1.15}}.frontier p{{color:#c4c5c2;margin:14px 0 0}}.frontier:before{{content:"NEXT FRONTIER";display:block;margin-bottom:14px;color:var(--green);font-size:10px;font-weight:800;letter-spacing:.14em}}
footer{{display:flex;justify-content:space-between;gap:24px;padding-top:24px;color:var(--muted);font-size:12px}}footer strong{{color:#d0d1ce}}@media(max-width:760px){{main{{width:min(100% - 28px,1100px)}}.hero,.story-grid{{grid-template-columns:1fr}}.hero{{gap:28px;padding-top:34px}}.scoreboard{{border-left:0;border-top:1px solid var(--line);padding:22px 0 0}}.signal-row{{grid-template-columns:minmax(0,1fr) 42px}}.signal-row .track{{grid-column:1/-1;grid-row:2}}footer{{display:block}}}}
@media print{{body{{background:#fff;color:#111}}body:before{{display:none}}:root{{--ink:#111;--muted:#555;--panel:#fff;--line:#ddd;--bg:#fff}}main{{width:100%;padding:0}}}}
</style></head><body><main>
<header><div class="brand"><span class="mark">TB</span>TokenBar</div><div class="privacy">Verified local proof · no raw sessions</div></header>
<section class="hero"><div><p class="eyebrow">Private builder intelligence</p><h1>{esc(public_identity.get('title') or 'Builder Identity')}</h1><p class="subtitle">{esc(public_identity.get('subtitle') or 'A generated account of how this builder directs, ships, and improves with coding agents.')}</p><div class="pills"><span class="pill">{esc(public_identity.get('primaryArchetype') or 'Builder')}</span><span class="pill">{esc(identity_label.get('stance') or public_identity.get('npcClass') or 'Developing')}</span><span class="pill">Generated {esc(public_identity.get('generatedAt') or 'locally')}</span></div></div>
<aside class="scoreboard"><p class="section-label">Evidence board</p><dl><dt>Proof</dt><dd>{esc(public_identity.get('proofScore') or 0)}</dd><dt>Loop maturity</dt><dd>{esc(public_identity.get('loopScore') or 0)}</dd><dt>Rarity</dt><dd>top {esc(public_identity.get('estimatedRarityPercent') or 0)}%</dd><dt>Analyzed sessions</dt><dd>{esc(usage.get('sessionsIndexed') or 0)}</dd><dt>Last 7 days</dt><dd>{esc(usage.get('last7') or '0')}</dd></dl></aside></section>
<section class="section"><p class="section-label">Signal profile</p>{''.join(dimension_rows)}</section>
<section class="section story-grid"><div class="evidence"><p class="section-label">What the evidence says</p><ol>{evidence_rows}</ol></div><div class="frontier"><h2>One move that changes the next report.</h2><p>{esc(public_identity.get('growthEdge') or 'Run another focused build loop and verify the result with a concrete artifact.')}</p></div></section>
<footer><p><strong>Proof boundary:</strong> generated identity fields and aggregate usage only. Raw prompts, transcripts, source code, paths, personal emails, and secrets are excluded.</p><p>Verify this packet with <strong>tokenbar verify &lt;proof.zip&gt;</strong></p></footer>
</main></body></html>"""

timeline_cards = []
for item in reversed(profiles):
    timeline_cards.append(f"""
      <article>
        <p>{esc(item['generated'])} · specificity {item['specificity']:.0f}/100</p>
        <h2>{esc(item['title'])}</h2>
        <span>{esc(item['archetype'])} · {esc(item['npc'])}</span>
        <code>{esc(item['bucket'])}</code>
      </article>
    """)

timeline_html = f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>TokenBar Proof Timeline</title>
<style>
body{{margin:0;background:#0e1117;color:#eef2ff;font:15px/1.5 ui-sans-serif,system-ui;padding:32px}}
main{{max-width:980px;margin:0 auto}}h1{{font-size:38px}}section{{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px}}
article{{border:1px solid #2a3448;background:#171c26;border-radius:8px;padding:16px}}p,span,code{{color:#aeb8cc}}code{{display:block;margin-top:10px;word-break:break-all}}
</style></head><body><main>
<h1>TokenBar Proof Timeline</h1>
<p>Local-only profile evolution across {len(profiles)} identity snapshots. No raw transcripts or source code are included.</p>
<section>{''.join(timeline_cards)}</section>
</main></body></html>
"""

readme = "\n".join([
    "# TokenBar Builder Identity Proof Packet",
    "",
    f"Latest profile: {latest['title']}",
    f"Token: {latest['data'].get('token') or 'unknown'}",
    f"Created: {time.strftime('%Y-%m-%dT%H:%M:%S%z')}",
    "",
    "Open `index.html` first. It is a self-contained, offline overview of the Builder Identity.",
    "",
    "## What is included",
    "",
    "- index.html: share-safe Builder Identity overview in TokenBar's native visual language.",
    "- Latest sanitized identity JSON, HTML report, Skill.md, and PDF when present.",
    "- local-rankings.txt: offline archetype/NPC/bucket rankings from local snapshots.",
    "- compare-latest.txt: newest-vs-previous identity comparison when available.",
    "- timeline.html: local profile evolution view.",
    "- tokenbar-proof-manifest.json: packet metadata and privacy boundary.",
    "- tokenbar-proof-verification.json: SHA-256 and byte counts for every packaged payload.",
    "",
    "## Privacy",
    "",
    "This packet is generated locally from TokenBar identity artifacts. It does not include raw prompts, transcripts, source code, local paths, personal emails, credentials, or secrets. TokenBar's public support contact may appear in report footers. Public sharing remains opt-in.",
    "",
    "Verify it before sharing:",
    "",
    "    tokenbar verify /path/to/proof.zip",
]) + "\n"

manifest = {
    "schema": "tokenbar.proof-packet.v1",
    "createdAt": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    "latestToken": latest["data"].get("token"),
    "latestTitle": latest["title"],
    "snapshotCount": len(profiles),
    "entrypoint": "index.html",
    "verification": "tokenbar-proof-verification.json",
    "privacy": {
        "rawTranscriptsIncluded": False,
        "sourceCodeIncluded": False,
        "localPathsIncluded": False,
        "personalEmailsIncluded": False,
        "secretsIncluded": False,
        "redactedExcerptsOnly": True,
        "shareRequiresUserAction": True,
    },
    "included": [],
}

latest_stem = latest["path"].with_name(latest["path"].name[:-len(".identity.json")])
candidate_files = {
    "identityJson": latest["path"],
    "html": latest_stem.with_suffix(".html"),
    "skillMd": latest_stem.with_suffix(".skill.md"),
    "pdf": latest_stem.with_suffix(".pdf"),
}

payloads = {
    "index.html": index_html.encode("utf-8"),
    "README.md": readme.encode("utf-8"),
    "local-rankings.txt": rankings_text.encode("utf-8"),
    "compare-latest.txt": compare_text.encode("utf-8"),
    "timeline.html": timeline_html.encode("utf-8"),
}

for key, path in candidate_files.items():
    if not path.exists() or not path.is_file():
        continue
    archive_path = f"latest/{path.name}"
    if key == "identityJson":
        payloads[archive_path] = (json.dumps(public_identity, indent=2, sort_keys=True) + "\n").encode("utf-8")
    else:
        payloads[archive_path] = path.read_bytes()
    manifest["included"].append({"key": key, "path": archive_path})

for key, name in (
    ("entrypoint", "index.html"),
    ("readme", "README.md"),
    ("rankings", "local-rankings.txt"),
    ("comparison", "compare-latest.txt"),
    ("timeline", "timeline.html"),
):
    manifest["included"].append({"key": key, "path": name})

verification = {
    "schema": "tokenbar.proof-verification.v1",
    "createdAt": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    "algorithm": "SHA-256",
    "scope": "packaged payloads; integrity evidence, not an identity signature",
    "files": {
        name: {
            "sha256": hashlib.sha256(payload).hexdigest(),
            "bytes": len(payload),
        }
        for name, payload in sorted(payloads.items())
    },
    "privacy": manifest["privacy"],
}
verification_bytes = (json.dumps(verification, indent=2, sort_keys=True) + "\n").encode("utf-8")
manifest["included"].append({"key": "verification", "path": "tokenbar-proof-verification.json"})
manifest_bytes = (json.dumps(manifest, indent=2, sort_keys=True) + "\n").encode("utf-8")

with zipfile.ZipFile(output_path, "w", compression=zipfile.ZIP_DEFLATED) as zf:
    for name, payload in payloads.items():
        zf.writestr(name, payload)
    zf.writestr("tokenbar-proof-verification.json", verification_bytes)
    zf.writestr("tokenbar-proof-manifest.json", manifest_bytes)

print(f"Proof packet: {output_path}")
print(f"Latest profile: {latest['title']}")
print(f"Snapshots summarized: {len(profiles)}")
print("Open first: index.html")
print("Included: sanitized identity, latest report artifacts, local rankings, comparison, timeline, privacy manifest, SHA-256 receipt")
print("Privacy: no raw prompts, transcripts, source code, local paths, personal emails, credentials, or secrets are included.")
PY
}

profile_stats() {
  local endpoint
  endpoint="${TOKENBAR_PROFILE_STATS_URL:-${TOKENBAR_PROFILE_UPLOAD_URL:-$site_url/api/profiles}}"

  TOKENBAR_PROFILE_STATS_ENDPOINT="$endpoint" python3 - <<'PY'
import json
import os
import urllib.error
import urllib.request

endpoint = os.environ["TOKENBAR_PROFILE_STATS_ENDPOINT"]
request = urllib.request.Request(endpoint, headers={"Accept": "application/json", "User-Agent": "TokenBar CLI"})

try:
    with urllib.request.urlopen(request, timeout=20) as response:
        payload = json.loads(response.read().decode("utf-8"))
except urllib.error.HTTPError as exc:
    body = exc.read().decode("utf-8", "replace")
    raise SystemExit(f"Could not load TokenBar stats: HTTP {exc.code} {body}") from exc
except Exception as exc:
    raise SystemExit(f"Could not load TokenBar stats: {exc}") from exc

stats = payload.get("stats") or {}
print("TokenBar public identity stats")
print(f"Profiles: {stats.get('profileCount', 0)}")
print(f"Average specificity: {stats.get('averageSpecificity', 0)}/100")
if stats.get("labelSpaceSize"):
    print(
        f"Label-space coverage: {stats.get('uniqueLabelBucketCount', 0)}/"
        f"{stats.get('labelSpaceSize')} buckets ({float(stats.get('labelSpaceCoveragePercent') or 0):.3f}%)"
    )
print()

def print_table(title, values, percentages=None):
    print(title)
    entries = list((values or {}).items())[:8]
    if not entries:
        print("  none yet")
        return
    width = max(len(str(name)) for name, _ in entries)
    for name, count in entries:
        percent = (percentages or {}).get(name)
        if percent is None:
            print(f"  {str(name):<{width}}  {count}")
        else:
            print(f"  {str(name):<{width}}  {count} ({float(percent):.1f}%)")

def print_bucket_ranking(title, rows):
    print(title)
    entries = list(rows or [])[:8]
    if not entries:
        print("  none yet")
        return
    width = max(len(str(item.get("bucket") or "unknown")) for item in entries)
    for item in entries:
        bucket = str(item.get("bucket") or "unknown")
        count = int(item.get("count") or 0)
        share = float(item.get("sharePercent") or 0)
        rarity = item.get("rarity") or "bucket"
        print(f"  {bucket:<{width}}  {count} ({share:.1f}%)  {rarity}")

print_table("Archetypes", stats.get("archetypes"), stats.get("archetypePercentages"))
print()
print_table("NPC classes", stats.get("npcClasses"), stats.get("npcClassPercentages"))
print()
print_table("Identity buckets", stats.get("labelBuckets"), stats.get("labelBucketPercentages"))
print()
rankings = stats.get("publicRankings") if isinstance(stats.get("publicRankings"), dict) else {}
print_bucket_ranking("Rarest identity buckets", rankings.get("rarestBuckets") or stats.get("rarestLabelBuckets"))
print()
print_bucket_ranking("Common identity buckets", rankings.get("commonBuckets") or stats.get("commonLabelBuckets"))
print()
print_table("Specificity bands", stats.get("specificityBands"), stats.get("specificityBandPercentages"))
print()
print_table("Provider coverage", stats.get("providerCoverage"), stats.get("providerCoveragePercentages"))
print()
top_profiles = stats.get("topSpecificProfiles") or []
if top_profiles:
    print("Most specific public profiles")
    for item in top_profiles[:6]:
        print(
            f"  {item.get('specificityScore', 0):>5}/100  "
            f"{item.get('title') or item.get('bucket') or item.get('token')} "
            f"({item.get('npcClass', 'builder')})"
        )
    print()
signals = stats.get("sessionSignalAverages") or {}
if signals:
    print("Session signals")
    labels = {
        "planningSignal": "Planning",
        "redirectionSignal": "Redirection",
        "urgencySignal": "Urgency",
        "visualSignal": "Visual/product",
        "monetizationSignal": "Monetization",
        "privacySignal": "Privacy",
        "identitySignal": "Identity/report",
        "commandPromptRatio": "Command style",
        "shortPromptRatio": "Short prompts",
    }
    for key, value in list(signals.items())[:9]:
        print(f"  {labels.get(key, key):<16}  {float(value):.1f}%")
    print()
print(f"Stats endpoint: {endpoint}")
print("Upload boundary: opt-in identity JSON only; no source code or raw transcripts.")
PY
}

video_brief() {
  local context format
  format="${1:-}"
  context="$(quick_usage_context_json 2>/dev/null || usage_context_json 2>/dev/null || printf '{}')"

  TOKENBAR_VIDEO_CONTEXT="$context" TOKENBAR_VIDEO_FORMAT="$format" python3 - <<'PY'
import json
import os
from datetime import datetime
from html import escape
from pathlib import Path

ctx = json.loads(os.environ.get("TOKENBAR_VIDEO_CONTEXT") or "{}")
format_value = (os.environ.get("TOKENBAR_VIDEO_FORMAT") or "").strip().lower()
json_mode = format_value in {"--json", "json"}
